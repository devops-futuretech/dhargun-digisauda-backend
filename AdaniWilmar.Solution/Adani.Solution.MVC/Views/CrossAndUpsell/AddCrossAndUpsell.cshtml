@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.CrossAndUpsellConfigurationDto
@{
    ViewBag.Title = "AddCrossAndUpSellConfiguration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    if (string.IsNullOrEmpty(Model.EncryptedId) && Model != null)
    {
        Model.StartDate = DateTime.Now;
        Model.EndDate = DateTime.Today.AddHours(23).AddMinutes(59);
    }
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="saudaconditionalbookingconfig" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Add Cross-Selling & Upselling</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Cross-Selling & Upselling Settings</a><span class="icon-right"></span></li>
        <li><a href="/CrossAndUpsell/CrossAndUpsellList"> Cross-Selling & Upselling List</a> <span class="icon-right"></span></li>
        <li>Add Cross-Selling & Upselling </li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row " id="divLoader">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">

            @using (Html.BeginForm("AddCrossAndUpsell", "CrossAndUpsell", FormMethod.Post, new { id = "frmAddCrossAndUpsell", @class = "form-validate-jquery" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.LoginUserId)
                @Html.HiddenFor(m => m.EncryptedId)
                @Html.HiddenFor(m => m.Id)
                <div class="col-md-12" style="padding-bottom: 20px;display:none" id="successAlert">
                    <div class="alert alert-success no-border">
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>
                        <span class="text-semibold" id="successContent"></span>
                    </div>
                </div>

                <div class="row form-group">
                    <div class="col-md-12 lbldoc">
                        <label> <b>@Helper.GetResourceString("lbl_CrossUpsellConfigurations")</b></label>
                    </div>
                    <hr />
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label" for="ddlSalesOrganization">
                            @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownListFor(m => m.SalesOrganizationId)
                            .Name("ddlSalesOrganization")
                            .OptionLabel(@Helper.GetResourceString("plho-SelectSales"))
                            .DataTextField("SalesOrganizationName")
                            .Events(e => e.Change("onSaleChange"))
                            .DataValueField("Id")
                            .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                            ).HtmlAttributes(new { id="ddlSalesOrganization", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                        )
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label" for="ddlDistributionChannel">
                            @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
                           .Name("ddlDistributionChannel")
                          .OptionLabel(@Helper.GetResourceString("plho-SelectDistChannel"))
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { id="ddlDistributionChannel", tabindex = "2", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label" for="ddlVertical">
                            @Helper.GetResourceString("lbl_VerticleType") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownListFor(m => m.DivisionId)
                          .Name("ddVerticalType")
                          .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                          .DataTextField("Name")
                          .DataValueField("Id")
                          .Events(e => e.Change("onVerticalChange"))
                          .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { id = "ddlVertical", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_VerticleType"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3" id="zoneContainer">
                        <label class="custom_label" for="ddlZone"> @Helper.GetResourceString("lbl_Zone") <span class="text-danger">*</span></label>
                        @(Html.Kendo().MultiSelect().Name("ZoneId")
                            .Events(events => events.Change("onZoneChange").DataBound("onZoneDataBound"))
                            .Placeholder("Select Zone")
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .AutoClose(false)
                            .TagMode(TagMode.Single)
                            .DataSource(source => source.Read(read => read.Action("GetZoneListddl", "Lookup", new { isToReturnInactiveData = false }))
                            .ServerFiltering(false))
                            .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zoneSelectAll'> Select All</label>")
                            .HtmlAttributes(new { id = "ddlZone", @class = "", tabindex = "4", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Zone"), @style = "width:100%" }))
                    </div>                    
                </div>

                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3" id="stateContainer">
                        <label class="custom_label" for="ddlState"> @Helper.GetResourceString("lbl_State") <span class="text-danger">*</span></label>
                        @(Html.Kendo().MultiSelectFor(m => m.StateId)
                            .Events(events => events.Change("onStateChange").DataBound("onStateDataBound"))
                            .Placeholder("Select State")
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .AutoClose(false)
                            .TagMode(TagMode.Single)
                            .DataSource(source => source.Read(read => read.Action("GetStatesBasedOnZoneIds", "Lookup").Data("StateAdditionalInfo"))
                            .ServerFiltering(false))
                            .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='stateSelectAll'> Select All</label>")
                            .HtmlAttributes(new { id = "ddlState", @class = "", tabindex = "5", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label" for="dpFromDate"> @Helper.GetResourceString("lbl_StartDate") <span class="text-danger">*</span></label>
                        @(Html.Kendo().DateTimePickerFor(m => m.StartDate)
                        .Format(Settings.DateTimeFormat)
                        .Interval(1)
                        .Events(e => e.Change("fromChange"))
                        .HtmlAttributes(new { id = "dpFromDate", onkeydown = "return isFocus(event);", tabindex = "6", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label" for="dpToDate"> @Helper.GetResourceString("lbl_EndDate") <span class="text-danger">*</span></label>
                        @(Html.Kendo().DateTimePickerFor(m => m.EndDate)
                              .Format(Settings.DateTimeFormat)
                              .Interval(1)
                              .HtmlAttributes(new { id = "dpToDate", onkeydown = "return isFocus(event);", tabindex = "7", style = "width: 100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3" style="margin-left: 0px">
                        <label class="custom_label" for="cbActiveInactive">Status</label>
                        <div class="custom_checkbox_main">
                            <label class="custom_checkbox" for="cbActiveInactive">
                                @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "8" })
                                <span class="checkmark check_tick"></span>
                                <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-12 lbldoc">
                        <label><b>@Helper.GetResourceString("lbl_SkuDetails")</b></label>
                    </div>
                    <hr />
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label" htmlFor="ddlEssOilType">  @Helper.GetResourceString("lbl_OilType") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().MultiSelect()
                           .Name("EssOilTypeId")
                           .DataTextField("Name")
                           .DataValueField("Id")
                           .Placeholder(@Helper.GetResourceString("plho_SelectOilType"))
                           .AutoClose(false)
                           .TagMode(TagMode.Single)
                           .Events(e => e.Change("onOiltypeChangeEss").DataBound("onOiltypeBoundEss"))
                           .DataSource(source => source.Read(read => read.Action("GetOilTypesBasedOnVerticalId", "Lookup").Data("oilTypeAdditionalInfo"))
                           .ServerFiltering(true))
                           .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='oilTypeEssSelectAll'> Select All</label>")
                           .HtmlAttributes(new { id = "ddlEssOilType", @class = "", tabindex = "9", data_msg_required = Helper.GetSelectMsgRequired("lbl_OilType"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label" for="ddlEssOilPackingType"> @Helper.GetResourceString("lbl_PackGroup") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownList()
                           .Name("EssPackGroupId")
                           .OptionLabel(@Helper.GetResourceString("plho_SelectOilPackingType"))
                           .DataTextField("Name")
                           .DataValueField("Id")
                           .Events(e => e.Change("onPackGroupChangeEss"))
                           .DataSource(source => source.Read(read => read.Action("GetOilPackingTypeListAsync", "Lookup", new { isToReturnInactiveData = true }))
                           .ServerFiltering(true))
                           .HtmlAttributes(new { id = "ddlEssOilPackingType", @class = "", tabindex = "10", @style = "width:100%", data_msg_required = Helper.GetSelectMsgRequired("lbl_PackGroup") }))
                    </div>
                    <div class="col-lg-4 col-sm-6 mb-4" id="skuContainer">
                        <label class="custom_label" for="ddlEssentialSku">  @Helper.GetResourceString("lbl_EssentialSku") </label>
                        @(Html.Kendo().MultiSelect()
                          .Name("EssentialSku")
                          .DataTextField("Name")
                          .DataValueField("Id")
                          .Placeholder(@Helper.GetResourceString("plho_SelectSku"))
                          .AutoClose(false)
                          .TagMode(TagMode.Single)
                          .Events(e => e.Change("onSkuChange").DataBound("onSkuDataBound"))
                          .DataSource(source => source.Read(read => read.Action("GetSkuListByOilTypeIdsPackGroupIdsForDropdown", "Lookup").Data("skuEssentialAdditionalInfo"))
                          .ServerFiltering(true))
                          .ItemTemplate("<span class=\"skuid\">#= Code # - #= Name #</span>")
                          .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='EssentialSkuSelectAll'> Select All</label>")
                          .HtmlAttributes(new { id = "ddlEssentialSku", @class = "", tabindex = "11", data_msg_required = Helper.GetSelectMsgRequired("lbl_Sku"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-2 col-sm-3 mb-2" style="margin-left: 0px">
                        <label class="custom_label" for="cbSkuActiveInactive">Status</label>
                        <div class="custom_checkbox_main">
                            <label class="custom_checkbox" for="cbSkuActiveInactive">
                                @Html.CheckBoxFor(m => m.LineItemIsActive, new { id = "cbSkuActiveInactive", tabindex = "12" })
                                <span class="checkmark check_tick"></span>
                                <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3" >
                        <label class="custom_label" htmlFor="ddlManOilType">  @Helper.GetResourceString("lbl_OilType") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().MultiSelect()
                           .Name("ManOilTypeId")
                           .DataTextField("Name")
                           .DataValueField("Id")
                           .Placeholder(@Helper.GetResourceString("plho_SelectOilType"))
                           .AutoClose(false)
                           .TagMode(TagMode.Single)
                           .Events(e => e.Change("onOiltypeChangeMan").DataBound("onOilTypeBoundMan"))
                           .DataSource(source => source.Read(read => read.Action("GetOilTypesBasedOnVerticalId", "Lookup").Data("oilTypeAdditionalInfo"))
                           .ServerFiltering(true))
                           .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='oilTypeManSelectAll'> Select All</label>")
                           .HtmlAttributes(new { id = "ddlManOilType", @class = "", tabindex = "13", data_msg_required = Helper.GetSelectMsgRequired("lbl_OilType"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label" for="ddlManOilPackingType"> @Helper.GetResourceString("lbl_PackGroup") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownList()
                           .Name("ManPackGroupId")
                           .OptionLabel(@Helper.GetResourceString("plho_SelectOilPackingType"))
                           .DataTextField("Name")
                           .DataValueField("Id")
                           .Events(e => e.Change("onPackGroupChangeMan"))
                           .DataSource(source => source.Read(read => read.Action("GetOilPackingTypeListAsync", "Lookup", new { isToReturnInactiveData = true }))
                           .ServerFiltering(true))
                           .HtmlAttributes(new { id = "ddlManOilPackingType", @class = "", tabindex = "14", @style = "width:100%", data_msg_required = Helper.GetSelectMsgRequired("lbl_PackGroup") }))
                    </div>
                    <div class="col-lg-4 col-sm-6 mb-4" id="skuContainer">
                        <label class="custom_label" for="ddlMandatorySku">  @Helper.GetResourceString("lbl_MandatorySku") </label>
                        @(Html.Kendo().MultiSelect()
                          .Name("MandatorySku")
                          .DataTextField("Name")
                          .DataValueField("Id")
                          .Placeholder(@Helper.GetResourceString("plho_SelectSku"))
                          .AutoClose(false)
                          .TagMode(TagMode.Single)
                          .Events(e => e.Change("onMandatorySkuChange").DataBound("onMandatorySkuDataBound"))
                          .DataSource(source => source.Read(read => read.Action("GetSkuListByOilTypeIdsPackGroupIdsForDropdown", "Lookup").Data("skuMandatoryAdditionalInfo"))
                          .ServerFiltering(true))
                          .ItemTemplate("<span class=\"skuid\">#= Code # - #= Name #</span>")
                          .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='MandatorySkuSelectAll'> Select All</label>")
                          .HtmlAttributes(new { id = "ddlMandatorySku", @class = "", tabindex = "15", data_msg_required = Helper.GetSelectMsgRequired("lbl_Sku"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-2 col-sm-6 mb-2" style="bottom: -15px">
                        <button type="button" id="btnSkuAdd" class="k-primary k-button">
                            @Helper.GetResourceString("Btn_AddSku")
                        </button>
                    </div>
                </div> 

                <div class="row form-group">

                    <div>
                        @(Html.Kendo().Grid<SaudaConditionalBookingSkuDto>()
                                  .Name("SaudaBookingCombinationList")
                                  .Columns(columns =>
                                  {
                                      columns.Bound(c => c.Id).Visible(false);
                                      columns.Bound(c => c.EssentialSkuName).Visible(true).Width(Settings.GridColumnMaxWidth250);
                                      columns.Bound(c => c.IsActive)
                                       .Title("Status")
                                       .ClientTemplate(
                                           @"<div style='text-align: center;'>
                                                     # if (IsActive) { #
                                                         <a title='" + Helper.GetResourceString("msg_Active") + @"'>
                                                             <i class='icon-checkbox-checked2 faicon-green'></i>
                                                         </a>
                                                     # } else { #
                                                         <a title='" + Helper.GetResourceString("msg_Inactive") + @"'>
                                                             <i class='icon-cancel-square2 faicon-red'></i>
                                                         </a>
                                                     # } #
                                                 </div>")
                                        .Width(Settings.GridFilterColumnWidth);
                                      columns.Command(command => command.Custom("Delete").Click("onSkusDelete")).Width(Settings.GridFilterColumnWidth).Title("Actions");
                                  })
                                    .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                    .BindTo(Model.SkuBookingCombinationList)
                                    .Editable(edit => edit.Mode(GridEditMode.InCell))
                                    .HtmlAttributes(new { data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), required = "required" })
                                    .Selectable(selectable => selectable
                                    .Mode(GridSelectionMode.Multiple)
                                    .Type(GridSelectionType.Row))
                                    .Scrollable(s => s.Enabled(true).Height("500"))
                                    .Reorderable(reorder => reorder.Columns(true))
                                    .ClientDetailTemplateId("template")
                                    .Events(e => e.DetailInit("OnExpandSkus").DataBound("OnDataBound"))
                                    .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .PageSize(Settings.MinimumPageSize)
                                    .Model(model =>
                                    {
                                        model.Id(m => m.Id);
                                        model.Field(c => c.EssentialSkuName).Editable(false);
                                    })
                                  ))

                        <script id="template" type="text/kendo-tmpl">
                         @(Html.Kendo().Grid<SaudaConditionalBookingSkuMappingListDto>()
                               .Name("SaudaBookingCombinationListChild_#=Id#")
                               .Columns(columns =>
                               {
                                   columns.Bound(c => c.MandatorySkuName).Title(@Helper.GetResourceString("lbl_MandatorySkuName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                                   columns.Bound(c => c.MandatorySkuCode).Title(@Helper.GetResourceString("lbl_MandatorySkuCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                                   columns.Bound(c => c.MandatoryBookingQuantityPercentage).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Percentage")).Width(Settings.GridColumnButtonWidth);
                               })
                               .Scrollable(s => s.Enabled(true).Height("300"))
                               .Reorderable(reorder => reorder.Columns(true))
                               .Resizable(resize => resize.Columns(true))
                               .Editable(edit => edit.Mode(GridEditMode.InCell))
                               .DataSource(dataSource => dataSource
                                .Ajax()
                                .ServerOperation(false)
                                .PageSize(Settings.MandatorySkuPageSize)
                                .Model(model =>
                                {
                                    model.Id(m => m.Id);
                                    model.Field(c => c.MandatorySkuName).Editable(false);
                                    model.Field(c => c.MandatorySkuCode).Editable(false);
                                    model.Field(c => c.MandatoryBookingQuantityPercentage).DefaultValue(0);
                                }))
                               .ToClientTemplate())
                        </script>
                    </div>
                </div>


                <div class="col-md-12 text-right">
                    <button id="btnClose" type="button" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Close")</button>
                    <button id="btnSave" type="submit" class="k-primary k-button custom-btns" @(string.IsNullOrEmpty(Model.EncryptedId) ? "disabled" : "")>
                        @(string.IsNullOrEmpty(Model.EncryptedId) ? "Save" : "Update")
                    </button>
                </div>
            }

        </div>
    </div>

</div>

@(Html.Kendo().Window()
    .Name("EssentialSkuWindow")
    .Title("Essential Sku List")
    .Visible(false)
    .Modal(true)
    .Draggable(true)
    .Width(800)
    .Actions(actions => actions.Close())
    .Events(events => events.Activate("onEssentialWindowActivate"))
    .Content(@<text>
        <div id="EssentialGridContainer">
            <div class="row">
            @(Html.Kendo().Grid<SaudaConditionalBookingSkuMappingListDto>()
                .Name("EssentialSkus")
                .Columns(columns =>
                {
                    columns.Bound(c => c.EssentialSkuName).Title(@Helper.GetResourceString("lbl_EssentialSkuName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                    columns.Bound(c => c.EssentialSkuCode).Title(@Helper.GetResourceString("lbl_EssentialSkuCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                })
                .Scrollable()
                .Pageable()
                .DataSource(dataSource => dataSource
                   .Ajax()
                   .ServerOperation(false)
                   .PageSize(Settings.MinimumPageSize)
                )
            )
            </div>
        </div>
    </text>)
)
@(Html.Kendo().Window()
    .Name("MultiselectData")
    .Title("Essential Sku List")
    .Visible(false)
    .Modal(true)
    .Draggable(true)
    .Width(800)
    .Actions(actions => actions.Close())
    .Events(events => events.Activate("onEssentialWindowActivate"))
    .Content(@<text>
        <div id="dvMultiselectData">
            <div class="content main-section-content row">
                <div class="panel panel-flat">
                    <div class="panel-body visible-block">
                        <div class="scrollable-list">
                            <ul id="multiselectDescription_ul" class="list-group"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </text>)
)

<style type="text/css">

    .k-window-titlebar {
        background-color: #E71928 !important;
    }

    .k-widget k-window {
        min-height: 100px !important;
        height: auto !important;
        max-height: 600px !important;
    }

    #EssentialSkus .k-grid-content {
        height: auto !important;
    }

    .visible-block {
        display: block;
    }

    .scrollable-list {
        max-height: 250px;
        overflow-y: auto;
    }
    .lbldoc {
        margin-bottom: 7px !important;
    }
</style>

<script type="text/javascript">

    var parentGridId = 0;
    var childGridData = [];
    var skipDetailInit = false;
    var isMandatoryBound = false;
    var dropdownIds = [
        "ddlSalesOrganization",
        "ddlDistributionChannel",
        "ddlVertical"
        //"ddlEssOilType",
        //"ddlManOilType",
        //"ddlEssOilPackingType",
       // "ddlManOilPackingType"
    ];

    var multiselectIds = [
        "ddlZone",
        "ddlState"
        //"ddlEssOilType",
        //"ddlManOilType"
    ];


    $(document).ready(function ()
    {
        var currentDate = new Date();

        window.kendo.ui.progress($("#divLoader"), true);

        if ('@TempData["SuccessMessage"]'.length) {
            ShowSuccessMessage('@TempData["SuccessMessage"]');
        }
        if ('@TempData["ErrorMessage"]') {
            ShowErrorMessage('@TempData["ErrorMessage"]');
        }

        @if (Model.SkuBookingCombinationList != null && Model.SkuBookingCombinationList.Any())
        {
            <text>
                var skuCombinationList = @Html.Raw(Json.Encode(Model.SkuBookingCombinationList));
                skuCombinationList.forEach(function (val) {
                    if (val.MandatorySkuMappingList && val.MandatorySkuMappingList.length > 0) {
                        val.MandatorySkuMappingList.forEach(function (skuval) {
                            childGridData.push(skuval);
                        });
                    }
                });

                parentGridId = childGridData.length > 0 ? Math.max(...childGridData.map(item => item.ParentId)) : 0;

                dropdownIds.forEach(function (id) {
                    var dropdown = $("#" + id).data("kendoDropDownList");
                    if (dropdown) {
                        dropdown.readonly(true);
                    }
                });

                multiselectIds.forEach(function (id) {
                    var dropdown = $("#" + id).data("kendoMultiSelect");
                   if (dropdown) {
                      dropdown.readonly(true);
                   }
                });

                var startDate = $("#dpFromDate").data("kendoDateTimePicker").value();
