    function ValidateSkus() {
        var skuGrid = $("#SaudaBookingCombinationList").data("kendoGrid");
        if (skuGrid.dataSource.data().length === 0) {
            ShowErrorMessage("Essential and Mandatory SKUs are required to be added.");
            return false;
        }
        return true;
    }

    function OnExpandSkus(e) {
        var dataItem = e.data;
        if (skipDetailInit) return;
        waitForChildGridAndAddData(dataItem.Id, childGridData);
        return;
    }

    function waitForChildGridAndAddData(id, dataToAdd, attempt = 0) {
        var childGrid = $("#SaudaBookingCombinationListChild_" + id).data("kendoGrid");

        if (childGrid) {
            var filteredData = dataToAdd.filter(item => item.ParentId === id);

            setTimeout(function () {
                filteredData.forEach(item => {
                    if (!childGrid.dataSource.data().some(d => d.MandatorySkuId === item.MandatorySkuId)) {
                        childGrid.dataSource.add(item);
                    }
                });
            }, 700);

        }
        else if (attempt < 10) {
            setTimeout(() => waitForChildGridAndAddData(id, dataToAdd, attempt + 1), 100);
        }
    }

    function OnDataBound(e) {
        var grid = this;
        grid.tbody.find("tr").on("dblclick", function (e) {
            var dataItem = grid.dataItem(this);
            if (dataItem) {
                LoadEssentialSkusPopup(dataItem);
            }
        });
    }


    function LoadEssentialSkusPopup(data) {
        var popup = $("#EssentialSkuWindow").data("kendoWindow");
        popup.center().open();

        var essentialSku = $("#EssentialSkus").data("kendoGrid");

        if (data) {
            essentialSku.dataSource.data([]);
            data.EssentialSkuData.forEach(function (val) {
                essentialSku.dataSource.add({
                    EssentialSkuName: val.SkuName || val.Name,
                    EssentialSkuCode: val.SkuCode || val.Code,
                });
            });
        }
    }


    function onMandatorySkuDataBound(e) {
        if (isMandatoryBound) return;
        isMandatoryBound = true;

        var essentialSku = $("#ddlEssentialSku").data("kendoMultiSelect");
        var mandatorySku = $("#ddlMandatorySku").data("kendoMultiSelect");

        if (essentialSku && mandatorySku) {
            var essentialSkuValues = essentialSku.value();
            var dataSource = mandatorySku.dataSource;
            var originalData = dataSource.data().slice();

            var filteredData = originalData.filter(function (item) {
                return !essentialSkuValues.includes(item.Id);
            });

            dataSource.data(filteredData);
        }

        isMandatoryBound = false;
    }

    function onEssentialWindowActivate() {
        var popup = $("#EssentialSkuWindow").data("kendoWindow");
        popup.center();
    }

    function UpdateMandatorySkuData(e) {
        childGridData.forEach(function (val, index) {
            var childGrid = $("#SaudaBookingCombinationListChild_" + val.ParentId).data("kendoGrid");

            if (childGrid && childGrid.dataSource.data().length > 0) {
                $.each(childGrid.dataSource.data(), function (_, mandatorySku) {
                    if (mandatorySku.ParentId === val.ParentId) {
                        if (mandatorySku.MandatorySkuId === val.MandatorySkuId)
                           val.MandatoryBookingQuantityPercentage = mandatorySku.MandatoryBookingQuantityPercentage;
                    }
                });
            }
        });
    }
</script>