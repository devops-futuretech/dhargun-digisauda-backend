    function BindSkuInformation(e) {
        var grid = $("#SaudaBookingCombinationList").data("kendoGrid");
        var essentialSku = $("#ddlEssentialSku").data("kendoMultiSelect");
        var essentialrawData = essentialSku.dataItems();
        var essentialSkuNameData = Array.isArray(essentialrawData) ? essentialrawData : [essentialrawData];
        var essentialSkuName = essentialSku.dataItems().map(item => item.Name).join(",");

        var essentialSkuId = $("#ddlEssentialSku").data("kendoMultiSelect").value();
        var mandatorySku = $("#ddlMandatorySku").data("kendoMultiSelect");
        var rawData = mandatorySku.dataItems();
        var mandatorySkuNameList = Array.isArray(rawData) ? rawData : [rawData];

        var essentialOilTypeId = $("#ddlEssOilType").data("kendoMultiSelect").value();
        var essentialPackGroupId = $("#ddlEssOilPackingType").data("kendoDropDownList").value();
        var mandatoryOilTypeId = $("#ddlManOilType").data("kendoMultiSelect").value();
        var mandatoryPackGroupId = $("#ddlManOilPackingType").data("kendoDropDownList").value();

        var mandatorySkuId = $("#ddlMandatorySku").data("kendoMultiSelect").value();
        var isActive = $("#cbSkuActiveInactive").is(":checked");
        parentGridId += 1;
        var id = parentGridId;

        UpdateMandatorySkuData(this);

        var data = {
            Id: id,
            EssentialSkuName: essentialSkuName,
            EssentialSkuData: essentialSkuNameData,
            IsActive: isActive,
            EssentialSkuId: essentialSkuId,
            EssentialOilTypeId: essentialOilTypeId,
            EssentialPackGroupId: essentialPackGroupId
        };

        if (essentialSkuId.length !== 0 && mandatorySkuId.length != 0) {

            var filteredSkuData = grid.dataSource.data().filter(item => {
                const essentialSku = [...item.EssentialSkuId].sort();
                const newEssentialSku = [...essentialSkuId].sort();

                return essentialSku.length === newEssentialSku.length
                    && essentialSku.every((val, index) => val === newEssentialSku[index]);
            });

            var mandatorySkuData = childGridData.filter(item =>
            {
                const newEssentialSku = [...essentialSkuId];
                return newEssentialSku.includes(Number(item.MandatorySkuId))
            });

            if (filteredSkuData.length > 0 || mandatorySkuData.length > 0) {
                ShowErrorMessage("The essential or mandatory SKU combination already exists");
                $("#ddlMandatorySku").data("kendoMultiSelect").value([]);
                $("#ddlEssentialSku").data("kendoMultiSelect").value([]);
                $("#cbSkuActiveInactive").prop("checked", false);
                $("#ddlEssOilType").data("kendoMultiSelect").value([]);
                $("#ddlEssOilPackingType").data("kendoDropDownList").value(0);
                $("#ddlManOilType").data("kendoMultiSelect").value([]);
                $("#ddlManOilPackingType").data("kendoDropDownList").value(0);
                return;
            }

            if (essentialSkuId !== mandatorySkuId) {
                grid.dataSource.add(data);

                var parentRow = grid.table.find("tr[data-uid]").filter(function () {
                    var dataItem = grid.dataItem(this);
                    return dataItem.Id === data.Id;
                });

                skipDetailInit = true;
                grid.expandRow(parentRow);
                skipDetailInit = false;

                setTimeout(function () {

                    var childGrid = $("#SaudaBookingCombinationListChild_" + data.Id).data("kendoGrid");

                    if (childGrid) {
                        if (mandatorySkuNameList && mandatorySkuNameList.length > 0) {
                            mandatorySkuNameList.forEach(function (val) {
                                var childData = {
                                    ParentId:data.Id,
                                    MandatorySkuName: val.Name,
                                    MandatorySkuCode: val.Code,
                                    MandatoryBookingQuantityPercentage: 0,
                                    MandatorySkuId: val.Id,
                                    MandatoryOilTypeId: val.OilTypeId,
                                    MandatoryPackGroupId: val.PackGroupId
                                };

                                childGridData.push(childData);
                                childGrid.dataSource.add(childData);
                            });
                        }
                    }
                }, 700);

                $("#ddlMandatorySku").data("kendoMultiSelect").value([]);
                $("#ddlEssentialSku").data("kendoMultiSelect").value([]);
                $("#MandatorySkuPercentage").val(null).trigger("change");
                //$("#MandatorySkuPercentage").focus();
                $("#cbSkuActiveInactive").prop("checked", false);
                $("#ddlEssOilType").data("kendoMultiSelect").value([]);
                $("#ddlEssOilPackingType").data("kendoDropDownList").value(0);
                $("#ddlManOilType").data("kendoMultiSelect").value([]);
                $("#ddlManOilPackingType").data("kendoDropDownList").value(0);
            }
            else {
                ShowErrorMessage("Essential Sku and Mandatory Sku shouldn't be the same.");
            }
        } else {
            if (essentialSkuId.length === 0)
                ShowErrorMessage("Please select Essential Sku.");
            else if (mandatorySkuId.length === 0)
                ShowErrorMessage("Please select Mandatory Sku.");
        }

        $("#btnSave").removeAttr("disabled");
    }

   function SubmitFormData()
   {
        window.kendo.ui.progress($("#divLoader"), true);

        var isValidForm = $("#frmAddCrossAndUpsell").valid();
        if (!isValidForm || !ValidateSkus()) {
            window.kendo.ui.progress($("#divLoader"), false);
            return;
        }

        var token = $('input[name="__RequestVerificationToken"]', $('#frmAddCrossAndUpsell')).val();
        var skuDataList = [];

        var essentialSkuGrid = $("#SaudaBookingCombinationList").data("kendoGrid");

        var isValid = true;

        if (essentialSkuGrid.dataSource.data().length > 0) {
            $.each(essentialSkuGrid.dataSource.data(), function (index, essentialSku) {
                var mandatorySkuInfoList = [];
                var mandatorySkuGrid = $("#SaudaBookingCombinationListChild_" + essentialSku.Id).data("kendoGrid");
                var input = mandatorySkuGrid.tbody.find("input[name='MandatoryBookingQuantityPercentage']");
                var editedValue = input.val();
                if (editedValue !== undefined) {
                    ShowErrorMessage("The percentage value \"" + editedValue + "\" is not valid.");
                    isValid = false;
                    return;
                }

                if (mandatorySkuGrid.dataSource.data().length > 0) {
                    $.each(mandatorySkuGrid.dataSource.data(), function (index, mandatorySku) {

                        if (mandatorySku.MandatoryBookingQuantityPercentage > 100) {
                            ShowErrorMessage("The mandatory SKU " + mandatorySku.MandatorySkuCode + " percentage shouldn't exceed 100.");
                            isValid = false;
                            return false;
                        }

                        if (mandatorySku.MandatoryBookingQuantityPercentage > 0)
                        {
                            mandatorySkuInfoList.push({
                                ParentId: mandatorySku.ParentId,
                                MandatorySkuName: mandatorySku.MandatorySkuName,
                                MandatoryBookingQuantityPercentage: mandatorySku.MandatoryBookingQuantityPercentage,
                                MandatorySkuId: mandatorySku.MandatorySkuId,
                                MandatorySkuCode: mandatorySku.MandatorySkuCode,
                                MandatoryOilTypeId: mandatorySku.MandatoryOilTypeId,
                                MandatoryPackGroupId: mandatorySku.MandatoryPackGroupId
                            });
                        }
                        else
                        {
                            ShowErrorMessage("The mandatory SKU " + mandatorySku.MandatorySkuCode + " percentage shouldn't be set to 0.");
                            isValid = false;
                            return false;
                        }
                    });
                }
                else {
                    $.each(childGridData.filter(item => item.ParentId === essentialSku.Id), function (index, mandatorySku) {
                        if (mandatorySku.MandatoryBookingQuantityPercentage > 0) {
                            mandatorySkuInfoList.push({
                                ParentId: mandatorySku.ParentId,
                                MandatorySkuName: mandatorySku.MandatorySkuName,
                                MandatoryBookingQuantityPercentage: mandatorySku.MandatoryBookingQuantityPercentage,
                                MandatorySkuId: mandatorySku.MandatorySkuId,
                                MandatorySkuCode: mandatorySku.MandatorySkuCode,
                                MandatoryOilTypeId: mandatorySku.MandatoryOilTypeId,
                                MandatoryPackGroupId: mandatorySku.MandatoryPackGroupId
                            });
                        } else {
                            ShowErrorMessage("The mandatory SKU '" + mandatorySku.MandatorySkuCode + "' percentage shouldn't be 0.");
                            isValid = false;
                            return false;
                        }
                    });
                }

                skuDataList.push({
                    Id: essentialSku.Id,
                    EssentialSkuName: essentialSku.EssentialSkuName,
                    IsActive: essentialSku.IsActive,
                    EssentialSkuId: essentialSku.EssentialSkuId,
                    EssentialSkuData: [],
                    EssentialOilTypeId: essentialSku.EssentialOilTypeId,
                    EssentialPackGroupId: essentialSku.EssentialPackGroupId,
                    MandatorySkuMappingList: mandatorySkuInfoList
                });
            });
        }

        if (!isValid) {
            window.kendo.ui.progress($("#divLoader"), false);
            return;
        }

        var saudaBookingCombinationData = {
            Id: $("#Id").val(),
            EncryptedId: $("#EncryptedId").val(),
            SalesOrganizationId: $("#ddlSalesOrganization").data("kendoDropDownList").value(),
            DistributionChannelId: $("#ddlDistributionChannel").data("kendoDropDownList").value(),
            DivisionId: $("#ddlVertical").data("kendoDropDownList").value(),
            ZoneId: $("#ddlZone").data("kendoMultiSelect").value(),
            StateId: $("#ddlState").data("kendoMultiSelect").value(),                     
            StartDate: $("#dpFromDate").val(),
            EndDate: $("#dpToDate").val(),
            IsActive: $("#cbActiveInactive").is(":checked"),
            LoginUserId: $("#LoginUserId").val(),
            SkuBookingCombinationList: []
        };

        moduleCommon.Common.AjaxCall({
            type: 'POST',
            url: '@Url.Action("AddCrossAndUpsell", "CrossAndUpsell")',
            data: {
                __RequestVerificationToken: token,
                InputModel: saudaBookingCombinationData,
                SkuBookingCombinationString: JSON.stringify(skuDataList)
            },
            success: function (result) {
                if (result.IsSuccess === true) {
                    ShowSuccessMessage(result.SuccessDto.Message);
                    setTimeout(function () {
                        window.kendo.ui.progress($("#divLoader"), false);
                        window.location.href = '@Url.Action("CrossAndUpsellList", "CrossAndUpsell")';
                    }, 1000);
                } else {
                    ShowErrorMessage(result.PostMessage);
                    window.kendo.ui.progress($("#divLoader"), false);
                }
            },
            error: function (err) {
                console.error(err.Message);
                window.kendo.ui.progress($("#divLoader"), false);
            }
        });
   }

