<script>

    $(document).ready(function () {
        FilterContains();

        $("#ViewSaudaList").data("kendoGrid").dataSource.read();


        if ('ConfigHelper.IsEnabledRefreshGoogleAnalyticsData' == 'True') {
            var intervalTimeMin = parseInt('ConfigHelper.GoogleAnalyticsIntervalTimeInMin');
            setTimeout(function () {
            GetGoogleAnalyticsData();
        }, intervalTimeMin * 60000);
}

    });

    function downloadSaudhaList() {

         $.ajax({
            type: "POST",
            url: '@Url.Action("GetSaudaListExport", "ReverseAuction")',
             data: additionalParams(),
            success: function (responce) {

                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Report")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");

                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function GetGoogleAnalyticsData()
{
        moduleCommon.Common.AjaxCall({
            url: '/Home/GetGoogleAnalyticsData',
            type: 'Get',
            contentType: 'application/json; charset=utf-8',
            success: function (result) {
                debugger;
                if (result != null) {
                    //$("#WebtotalLoginDistri").text(result.ActiveUserCount);
                    $("#WebtotalLoginUsers").text(result.TotalUserCount);
                    $("#totalLoginSales").text(result.TotalLoginsBySales);
                    $("#WebtotalLoginDistri").text(result.TotalLoginsByDistributor);
                    $("#totalEmpLoggedIn").text(result.TotalEmployeesLoggedIn);
                    //$("#MobileActiveUserCount").text(result.ActiveMobileUserCount);
                    //$("#MobileRecentUserCount").text(result.RecentMobileUsersCount);
                }
            }
      });

    if ('ConfigHelper.IsEnabledRefreshGoogleAnalyticsData' == 'True') {
        var intervalTimeMin = parseInt('ConfigHelper.GoogleAnalyticsIntervalTimeInMin');
        setTimeout(function () {
            GetGoogleAnalyticsData();
        }, intervalTimeMin * 60000);
    }
}

    function additionalParams() {
        var statusId = 0;
        var checkedValDataFilter = 3;
        var divisionId = 0;
        var oiltypeId = 0;
        var skuId = 0;
        var DistributionChannelId = 0;
        var salesOrganizationId = 0;
        var zoneId = 0;
        var stateId = 0;
        var cityId = 0;
        var district = 0;
        var data = {
            fromDate: new Date().toDateString(),
            todate: new Date().toDateString(),
            statusId: statusId,
            dataFilter: checkedValDataFilter,
            divisionId: divisionId,
            salesOrganizationId: salesOrganizationId,
            DistributionChannelId: DistributionChannelId,
            OilTypeId: oiltypeId,
            SkuId: skuId,
            ZoneId: zoneId,
            StateId: stateId,
            DistrictId: district,
            CityId: cityId
        };
        return data;
    }
    function onFinalPricingtDataBound(e) {
        SetEmptyRow(e);

        var selectedOrders = [];
        if ($("#hdSelectedIds").val()) {
            selectedOrders = $("#hdSelectedIds").val().split(",");
        }

        $("#masterCBAllPaymentReceived").prop('checked', false);
        $('input:checkbox.' + 'chkbxAllPaymentReceived').each(function () {
            if ($.inArray(this.value, selectedOrders) > -1) {
                this.checked = true;
            }
            else {
                this.checked = false;
            }
        });
    }
</script>

