@model dynamic
@using Kendo.Mvc.UI;
@using Adani.Solution.DTO.Enums;
@using Adani.Solution.MVC.Common;
@using Adani.Solution.MVC.Helpers;
@{
    ViewBag.Title = "DataUpload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="configurationImportData" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title"> @Helper.GetResourceString("lbl_ImportData")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Configurations</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_ImportData")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row form-group">
                <div class="col-lg-3 col-sm-6 mb-3 ">
                    <label class="custom_label">
                        @Helper.GetResourceString("lbl_Entity") <span class="text-danger">*</span>
                    </label>
                    @(Html.Kendo().DropDownList()
                          .Name("Enity")
                          .OptionLabel("Select Entity")
                          .DataTextField("Name")
                          .DataValueField("EntityTypeId")
                          .OptionLabel("Select Entity")
                          .Events(e => e.DataBound("OnEntityDataBound").Change("OnEntityChange"))
                          .DataSource(source => source.Read(read => read.Action("GetEnityList", "Import"))
                          .ServerFiltering(false))
                          .HtmlAttributes(new { id = "ddlEntity", @class = "", @style = "width:100%" }))
                </div>
                <div class="col-lg-9 col-sm-6 mb-3 text-left">
                    <label class="custom_label">Download Template</label>
                    <div class="s-data control-link">
                        @*<a href="~/Files/State.xlsx" id="templateLinkId">Download Excel Template</a>*@
                        <a href="#" id="templateLinkId">Download Excel Template With Sample Data</a>
                    </div>
                </div>
            </div>
            <div class="row form-group">
                <form id="frm_upload" method="post" action='@Url.Action("Submit")'>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">Select File</label>
                        @(Html.Kendo().Upload()
                              .Name("files").Events(events => events.Select("onSelect"))
                              .Multiple(false)
                              .HtmlAttributes(new { aria_label = "files", accept = Settings.AcceptedImportFileFormat }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mt-3 mb-3">
                        @if (Helper.CheckClaims(Claims.ImportData))
                        {
                            <button type="button" id="btnUpload" class="k-primary k-button custom-btns" onclick="uploadSubmit()">Upload </button>
                        }
                    </div>

                </form>
            </div>
            <div class="row form-group">
                <div class="col-lg-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick='ExportToExcel("ImportExcelGrid")' type="button">Excel</span>
                            </div>
                        </div>
                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("ImportExcelGrid")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                    </div>
                    @(Html.Kendo().Grid<dynamic>()
                          .Name("ImportExcelGrid")
                          .Columns(columns =>
                          {
                              if (Model != null)

                                  foreach (System.Data.DataColumn column in Model.Columns)
                                  {

                                      if (column.DataType == typeof(DateTime))
                                          columns.Bound(column.ColumnName).Format("{0:dd/MM/yyyy h:mm tt}").Width(Settings.GridOtherColumnWidth);
                                      else if (column.ColumnName == "ConsentImage")
                                          columns.Bound(column.ColumnName).ClientTemplate("<img src='#=ConsentImage#'  width='200px' />");
                                      else if (column.ColumnName == "Message")
                                      {
                                          columns.Bound(column.ColumnName).Width(Settings.GridColumnMaxWidth250);
                                      }
                                      else
                                          columns.Bound(column.ColumnName).Width("50px");
                                  }
                          })
                          //.HtmlAttributes(new { style = "height: 550px;" })
                          .Resizable(resize => resize.Columns(true))
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Excel(excel => excel.FileName("ImportReport" + DateTime.Now + ".xlsx").AllPages(true))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Resizable(resize => resize.Columns(true))
                          .Events(events => events.DataBound("onListDataBound"))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .PageSize(Settings.DefaultPageSize)
                          .ServerOperation(false)
                          .Events(events => events.Error("error_handler"))
                          .Model(model =>
                          {
                              if (Model != null)
                              {
                                  //var id = Model.PrimaryKey[0].ColumnName;
                                  //model.Id("id");
                                  foreach (System.Data.DataColumn column in Model.Columns)
                                  {
                                      model.Field(column.ColumnName, column.DataType);
                                  }
                              }
                          })
                          .Read(read => read.Action("Products_Read", "Import"))))
                </div>
            </div>
            <div class="text-right marginT20">
                @if (Helper.CheckClaims(Claims.ImportData))
                {
                    <button type="button" id="btnSaveAssignBatch" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                }
            </div>

        </div>
    </div>
</div>
<style>
    .k-grid th, .k-grid td {
