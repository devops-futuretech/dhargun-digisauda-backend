        $('#btnSaveAssignBatch').on('click', function () {
            window.kendo.ui.progress($("#div_Progress"), true);
            var postUrl;
            var paramValue;
            var gridData = $("#ImportExcelGrid").data("kendoGrid").dataSource.data();
            postUrl = '@Url.Content("~/Import/Products_Update")';
            //paramValue = btoa(JSON.stringify(gridData));
            paramValue = btoa(unescape(encodeURIComponent(JSON.stringify(gridData))));

            $.ajax({
                url: postUrl,
                type: 'POST',
                dataType: 'json',
                data: { 'items': paramValue, dynamicList: JSON.parse(JSON.stringify($("#ImportExcelGrid").data("kendoGrid").dataSource.data())) },
                success: function (result) {
                    window.kendo.ui.progress($("#div_Progress"), false);
                    $.each(result.Data, function (index, value) {
                        if (value.ValidFrom !== undefined && value.ValidFrom !== null && value.ValidFrom.length > 0) {
                            var convertedValidFromDate = new Date(parseInt(value.ValidFrom.substr(6)));
                            value.ValidFrom = kendo.toString(convertedValidFromDate, emamiGlobal.constant.DateTimeFormat);
                        }
                        if (value.ValidTo !== undefined && value.ValidTo !== null && value.ValidTo.length > 0) {
                            //value.ValidTo = new Date(parseInt(value.ValidTo.substr(6))).toLocaleDateString('en-us');

                            var convertedValidToDate = new Date(parseInt(value.ValidTo.substr(6)));
                            value.ValidTo = kendo.toString(convertedValidToDate, emamiGlobal.constant.DateTimeFormat);
                        }
                        if (value.SaudaDate !== undefined && value.SaudaDate !== null && value.SaudaDate.length > 0) {
                            var convertedSaudaDate = new Date(parseInt(value.SaudaDate.substr(6)));
                            value.SaudaDate = kendo.toString(convertedSaudaDate, emamiGlobal.constant.DateTimeFormat);
                        }
                        if (value.ContractDate !== undefined && value.ContractDate !== null && value.ContractDate.length > 0) {
                            var convertedContractDate = new Date(parseInt(value.ContractDate.substr(6)));
                            value.ContractDate = kendo.toString(convertedContractDate, emamiGlobal.constant.DateTimeFormat);
                        }
                    });

                    var myresult = JSON.stringify(result['Data']);

                    var dataSource = new kendo.data.DataSource({
                        data: JSON.parse(myresult),
                        pageSize: 10
                    });

                    $("#ImportExcelGrid").data("kendoGrid").setDataSource(dataSource);
                    ShowSuccessMessage("Import data process completed successfully, check the message in the grid");
                    $("#btnSaveAssignBatch").prop("disabled", true);
                },
                error: function (objAjaxRequest, strError) {
                    window.kendo.ui.progress($("#div_Progress"), false);
                    var respText = objAjaxRequest.responseText;
                }
            });

            if (sessionStorage.getItem("entityId") === '@((int)Entity.GeographyDiscount)') {
                setTimeout(function (e) {
                    ReloadGeographyDiscountStatus();
                    //startGeographyDiscountRefresh();
                 },5000)
             }
        });


        $("#chkKendoFilterShowHide").prop("checked", true);
        FilterContains();
    });

    function ReloadGeographyDiscountStatus()
    {
        $.ajax({
            url: '@Url.Action("GetGeographyDiscountStatus", "Import")',
            type: 'GET',
            dataType: 'json',
            success: function (result) {
                window.kendo.ui.progress($("#div_Progress"), false);

                $.each(result, function (index, value) {
                    if (value.ValidFrom !== undefined && value.ValidFrom !== null) {
                        var convertedValidFromDate = new Date(parseInt(value.ValidFrom.substr(6)));
                        value.ValidFrom = kendo.toString(convertedValidFromDate, emamiGlobal.constant.DateTimeFormat);
                    }
                    if (value.ValidTo !== undefined && value.ValidTo !== null) {
                        var convertedValidToDate = new Date(parseInt(value.ValidTo.substr(6)));
                        value.ValidTo = kendo.toString(convertedValidToDate, emamiGlobal.constant.DateTimeFormat);
                    }
                });

                var myresult = JSON.stringify(result);
                var dataSource = new kendo.data.DataSource({
                    data: JSON.parse(myresult),
                    pageSize: 10
                });

                $("#ImportExcelGrid").data("kendoGrid").setDataSource(dataSource);
            },
            error: function (objAjaxRequest, strError) {
                window.kendo.ui.progress($("#div_Progress"), false);
                var respText = objAjaxRequest.responseText;
            }
        });

        startGeographyDiscountRefresh();
    }

    let geoDiscountRefreshCount = 1;
    function startGeographyDiscountRefresh() {
        if (geoDiscountRefreshCount <= 15) {
            setTimeout(function () {
                geoDiscountRefreshCount++;
                ReloadGeographyDiscountStatus();
            }, geoDiscountRefreshCount * 10000);
        }
    }

