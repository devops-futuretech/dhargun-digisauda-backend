    function DeleteMedia(mediaEncryptedId, mediaDivId, mediaPath) {
       var r = confirm("Are you sure you want to delete the media?");
        if (r == true) {
            window.kendo.ui.progress($("#popupAttachmentDetails"), true);
            moduleCommon.Common.AjaxCall({
                url: '@Url.Action("DeleteConsentImageAsync", "Lookup")',
                type: 'Post',
                dataType: 'json',
                data: { consentImageId: mediaEncryptedId, fileName: mediaPath },
                success: function (result) {
                   if (result.PostStatus === true) {
                        ShowSuccessMessage(result.PostMessage);
                        $("#".concat(mediaDivId)).remove();
                    }
                    else {
                       ShowErrorMessage(result.PostMessage);
                    }
                    window.kendo.ui.progress($("#popupAttachmentDetails"), false);
                }
            });
        }
    }


