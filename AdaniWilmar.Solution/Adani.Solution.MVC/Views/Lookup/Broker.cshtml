                            {
                                <div style="display:inline-block;width:100%;">
                                    <div> <p class="attachement-title">Images</p></div>
                                    @foreach (var data in Model.Attachments)
                                    {
                                        var mediaPath = Settings.GetAPIMediaPathFromFolder(data.FileName, (int)PageType.ConsentImages);
                                        <div id="@mediaDivId" class="col-md-2 media-box">
                                            <a class="Info" data-popup="lightbox" target="_blank" href="@mediaPath" rel="gallery"> <i class="icon-eye cursor-pointer faicon-red"></i> </a>
                                            <a class="cursor-pointer" onclick="DeleteMedia('@data.ConsentImageId', '@mediaDivId', '@data.FileName')"><i class="icon-cancel-square2 faicon-red"></i> </a>
                                            <img src="@mediaPath" width="200" height="200" />
                                        </div>
                                        mediaDivId = "media" + index++;
                                    }
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>

