        <div id="popupAttachmentDetails" class="modal fade" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" id="popupCancelButton" onclick="popupClose();" class="close closeButton" data-dismiss="modal">&times;</button>
                        <h6 class="panel-title"><span class="text-semibold" style="color: white;">Consent Images</span></h6>
                    </div>
                    <div class="modal-body" id="dvModalBody">
                        <div>
                            @{

                                var mediaDivId = "media" + index++;
                            }
