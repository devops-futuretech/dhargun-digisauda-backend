<script>
    $(document).ready(function ()
    {
        $('#popupAttachmentDetails').modal('hide');
        $("#IsActiveCallForCustomer").hide();
        $("#viewImages").hide();
        sapDataReadOnly();       //Sap data readonly
        disableFields();  //sauda booking type readonly

        //Edit: password field hide and required false
        if ('@Model.Id' > 0) {
            //$("#hsPassword").hide();
            //$("#txtPassword").prop("required", false);
            $('#txtCode').attr('readonly', 'true');
        } else {
            $("#txtSaudaValidityPeriod").val('');
            $("#txtSaudaLimit").val('');
        }


        //$("#ddlSaudaBookingType").data("kendoDropDownList").value(1);
        //$("#ddlSaudaBookingType").data("kendoDropDownList").readonly();
        //$("#ddlSaudaBookingType").data("kendoDropDownList").enable(false);
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
            $(window).scrollTop(0);
        }

        if ('@Model.Id' > 0 && '@Model.Attachments.Count' > 0) {
            $("#viewImages").show();
            $("#IsActiveCallForCustomer").show();
        }

        var selectedDepotIds = $("#hdSelectedDealerIds").val();
        if (selectedDepotIds) {
            $(".dealerSelect").prop('checked', true);
        }

        $('input[type="text"]').keypress(function (e) {
            var code = e.keyCode || e.which;
            if (code === 13) {
                e.preventDefault();
            }
        });

        $('#btnSave').on('click', function (e)
        {
            var isValid = $('#frmBroker').valid();

            //var selectedDepotIds = $("#ddlDepot").data("kendoMultiSelect").value();
            //if (!(selectedDepotIds != null && selectedDepotIds.length > 0)) {
            //    $("#lblDepot").css("display", "block");
            //    isValid = false;
            //    return false;
            //}

            if (isValid)
            {
                if ($("#ViewDivisionDetails").data("kendoGrid").dataSource.data().length > 0)
                {
                    window.kendo.ui.progress($("#dvUser"), true);
                    $("#DivisionList").val(JSON.stringify($("#ViewDivisionDetails").data("kendoGrid").dataSource.data()));
                    var frm = $("#frmBroker").serialize();

                    //$("#ddlSaudaBookingType").data("kendoDropDownList").readonly(false);
                    //$("#ddlSaudaBookingType").data("kendoDropDownList").enable(true);

                    $('#frmBroker').submit();
                    window.kendo.ui.progress($("#dvUser"), false);
                } else {
                    ShowErrorMessage('@Helper.GetResourceString("msg_divReq")');
                }

            }
        });
        $(document).on("click", " #deleteRow", function (e) {
            var grid = $("#ViewDivisionDetails").data("kendoGrid");
            var item = grid.dataItem($(this).closest("tr"));
            grid.removeRow($(this).closest("tr"));
            onVerticalChange();

        });

        $("#btnAdd").click(function () {
            if ($("#ddlSalesOrganization").val() == "") {
                ShowErrorMessage('@Helper.GetResourceString("msg_salesorgmiss")');
            } else if ($("#ddlDistributionChannel").val() == "") {
                ShowErrorMessage('@Helper.GetResourceString("msg_distChanmiss")');
            } else if ($("#ddlVertical").val() == "") {
                ShowErrorMessage('@Helper.GetResourceString("msg_divisionmiss")');
            } else {
                AddDivisionToList();
                onVerticalChange();
            }

        });


        // Dealer,Broker Checkbox events
        $(".dealerSelect").click(function () {
            if ($(this).is(":checked")) {
                //loadDealerGrid(true);
                $('#dvDealerCont').modal('show');
            } else {
                $("#hdSelectedDealerIds").val("");
                $("#lblDealerSelectedCount").html(0);
                $('#ViewDepotGrid').data('kendoGrid').refresh();
            }
        });

        $('#dealerSelectId').on('click', function (e) {
            $('#dvDealerCont').modal('show');
            //loadDealerGrid(true);
        });

        $("#toggle_pass").click(() => {

            if ($("#txtPassword").attr("type") == "Password") {
                $('#icps').toggleClass("fa-eye");
                $('#icps').toggleClass("fa-eye-slash");
                $("#txtPassword").attr("type", "text");
            } else {
                $('#icps').toggleClass("fa-eye-slash");
                $('#icps').toggleClass("fa-eye");
                $("#txtPassword").attr("type", "Password");
            }
        });

        loadDealerGrid(false);

    });

    function disableFields() {
        @*if ('@Model.SaudaBookingTypeId' > 0) {
            $("#ddlSaudaBookingType").data("kendoDropDownList").readonly();
        }*@
        if ('@Model.VerticalId' > 0) {
            $("#ddlVertical").data("kendoDropDownList").readonly();
        }
    }

    function ImportPincodeOnFocusOut(event) {
        var error = $("#txtPincode-error").text();
        var pincodeValue = $("#" + event.currentTarget.id).val();
        if (pincodeValue!=="" && error === "") {

            var pincodeFlag = PincodeValidation(pincodeValue, '@Helper.GetResourceString("msg_PincodeError")');

            if (pincodeFlag) {
                GetAddressByPincode(pincodeValue);
            }
        }
    }

    function GetAddressByPincode(pincode)
    {
        window.kendo.ui.progress($("#dvUser"), true);
        if (pincode !== "") {
            moduleCommon.Common.AjaxCall({
                type: 'Post',
                url: "@Url.Action("GetAddressByPincode", "Lookup")",
                data: {
                    pincode: pincode
                },
                success: function (result) {
                    if (result !== null && result.PostStatus) {
                        $("#txtCity").val(result.CityName);
                        $("#hdnCityId").val(result.CityId);
                        $("#txtDistrict").val(result.DistrictName);
                        $("#txtState").val(result.StateName);
                        var ddlArea = $('#ddlArea').data("kendoDropDownList");
                        ddlArea.setDataSource(result.Areas);
                        ddlArea.select(function (dataItem) {
                            return dataItem.AreaName === "@Model.Area";
                        });
                        window.kendo.ui.progress($("#dvUser"), false);
                    }
                    else {
                        if (result.PostStatusMessage!=="")
                            ShowErrorMessage(result.PostStatusMessage);
                        else
                            ShowErrorMessage('@Helper.GetResourceString("msg_PincodeError")');


                        ClearAddressFields();
                        $(window).scrollTop(0);
                        window.kendo.ui.progress($("#dvUser"), false);
                    }
                },
                error: function (result) {
                    ShowErrorMessage('@Helper.GetResourceString("msg_PincodeError")');
                    ClearAddressFields();
                    $(window).scrollTop(0);
                    window.kendo.ui.progress($("#dvUser"), false);
                }
            });
        }
        window.kendo.ui.progress($("#dvUser"), false);
    }

    function ClearAddressFields() {
        $("#txtCity").val("");
        $("#hdnCityId").val("");
        $("#txtDistrict").val("");
        $("#hdnDistrictId").val("");
    }


    function loadDealerGrid(isRemoveDepotId) {
        var verticalId = "";
        var grid = $("#ViewDivisionDetails").data("kendoGrid");
        var datasource = grid.dataSource;
        for (var i = 0; i < datasource.data().length; i += 1) {
            var id = datasource.data()[i].DivisionId;
            verticalId = verticalId.concat(id + ",");

        }
        //var verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        //var saudaBookingType = $("#ddlSaudaBookingType").data("kendoDropDownList").value();

            window.kendo.ui.progress($("#dvUser"), true);
            moduleCommon.Common.AjaxCall({
                url: '@Url.Action("DealerGridPartial", "Lookup")',
                type: 'Get',
                data: { IsRemoveSelectedDealerIdsFromSession: isRemoveDepotId, VerticalIdString: verticalId/*, SaudaBookingTypeId: saudaBookingType*/ },
                contentType: 'application/json; charset=utf-8',
                    success: function (result) {
                        $("#dvDealerPopup").html(result);
                        window.kendo.ui.progress($("#dvUser"), false);
                    }
                });
    }

    //Grid row check event
    function findCheckedItemsSaveItToHidden(ele, id, hiddenId, masterCheckBoxId, checkBoxClass, lblSelectedCount, gridId) {
        var idList = [];
        var removeIdList = [];
        if ($("#" + hiddenId).val() != "") {
            idList = $("#" + hiddenId).val().split(",");
        }
        //else {
        //    $("#hdSelectedGridIds").val("");
        //}

        //Get removed ids
        if ($("#hdRemovedDealerIds").val() != "") {
            removeIdList = $("#hdRemovedDealerIds").val().split(",");
        }

        var masterCheckBox = $(ele).is(':checked');
        var selectedCount = Number($("#" + lblSelectedCount).html());

        if (masterCheckBox) {
            idList.push(id);
            $("#" + lblSelectedCount).html(selectedCount + 1);


            if (removeIdList) {
                removeIdList = jQuery.grep(removeIdList, function (value) {
                    return value != id;
                });
            }
        }
        else {
            idList = jQuery.grep(idList, function (value) {
                return value != id;
            });
            if (selectedCount > 0)
                $("#" + lblSelectedCount).html(selectedCount - 1);

            var pId = Number($("#txtId").val());
            if (pId) {
                removeIdList.push(id);
            }
        }
        if (idList) {
            $("#" + hiddenId).val(idList.join(","));
        }
        else {
            $("#" + hiddenId).val("");
        }

        if (removeIdList) {
            $("#hdRemovedDealerIds").val(removeIdList.join(","));
        }
        else {
            $("#hdRemovedDealerIds").val("");
        }
    }


    //State
    function onStateChange(e) {
        //$("#ddlTerritory").data("kendoDropDownList").dataSource.read();
        @*$("#ddlFreightZone").data("kendoDropDownList").dataSource.read();*@
        $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
    }

