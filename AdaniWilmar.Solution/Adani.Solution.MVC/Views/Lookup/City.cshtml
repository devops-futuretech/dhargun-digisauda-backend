@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.CityDto
@{
    ViewBag.Title = "City";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="mastercity" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_AddOrUpdateCity")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li><a href="Cities">@Helper.GetResourceString("lbl_City")</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_AddOrUpdateCity")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="dvDistrict">
                <div class="col-md-12">
                    @using (Html.BeginForm("District", "Lookup", FormMethod.Post, new { id = "frmCity", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(s => s.EncryptedId, new { id = "EncryptedId" })
                        @Html.HiddenFor(m => m.DistrictId)


                        <div class="row form-group">

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">  @Helper.GetResourceString("lbl_State") <span class="text-danger">*</span> </label>
                                @(Html.Kendo().DropDownListFor(m => m.StateId)
                                                        .OptionLabel(@Helper.GetResourceString("plho_SelectState"))
                                                        .Events(events => events.Change("onStateChange").DataBound("OnStateDataBound"))
                                                        .DataTextField("StateName")
                                                        .DataValueField("StateId")
                                                        .DataSource(source => source.Read(read => read.Action("GetStateListAsync", "Lookup"))
                                                        .ServerFiltering(false))
                                                        .HtmlAttributes(new { id = "ddlState", tabindex = "1", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                            </div>

                            @*<div class="col-lg-3 col-sm-6 mb-3">
                    <label class="custom_label"> @Helper.GetResourceString("lbl_Territory") <span class="text-danger">*</span> </label>
                    @(Html.Kendo().DropDownListFor(m => m.TerritoryId)
                                           .OptionLabel(@Helper.GetResourceString("plho_SelectTerritory"))
                                           .DataTextField("Name")
                                           .DataValueField("Id")
                                           .Events(e => e.Change("territoryChange").DataBound("OnTerritoryDataBound"))
                                           .DataSource(source => source.Read(read => read.Action("GerTerritoryStateBase", "Lookup").Data("territoryAdditionalInfo"))
                                           .ServerFiltering(false))
                                           .HtmlAttributes(new { id = "ddlTerritory", tabindex = "2", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Territory"), @style = "width:100%" }))
                </div>*@

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">  @Helper.GetResourceString("lbl_District") <span class="text-danger">*</span> </label>
                                @(Html.Kendo().DropDownListFor(m => m.DistrictId)
                                                        .OptionLabel(@Helper.GetResourceString("plho_SelectDistrict"))
                                                        .DataTextField("DistrictName")
                                                        .DataValueField("DistrictId")
                                                        .DataSource(source => source.Read(read => read.Action("GetDistrictListBaseTerritory", "Lookup").Data("additionalDistrictByStateInfo"))
                                                        .ServerFiltering(false))
                                                        .HtmlAttributes(new { id = "ddlDistrict", tabindex = "3", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_District"), @style = "width:100%" }))
                            </div>

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label"> @Helper.GetResourceString("lbl_City") <span class="text-danger">*</span> </label>
                                @Html.TextBoxFor(m => m.CityName, new { id = "txtCityName", tabindex = "4", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_City"), @maxlength = (int)InputMaxLength.String })
                            </div>

                        </div>

                        <div class="row form-group">
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">Status</label>
                                <div class="custom_checkbox_main">
                                    <label class="custom_checkbox">
                                        @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "5" })
                                        <span class="checkmark check_tick"></span>
                                        <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-12 text-center">
                                <button type="button" tabindex="7" id="btnCancel" onclick="location.href = '@Url.Action("Cities", "Lookup")'" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.ManageMaster))
                                {
                                    <button type="button" tabindex="6" id="btnSave" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                                }
                            </div>
                        </div>
                    }
                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function ()
    {
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        $('#btnSave').on('click', function (e)
        {
            window.kendo.ui.progress($("#dvDistrict"), true);
            var form = $('#frmCity')
            var token = $('input[name="__RequestVerificationToken"]', form).val();

            var model = {
                EncryptedId: $("#EncryptedId").val(),
                CityId: $("#CityId").val(),
                CityName: $("#txtCityName").val(),
                StateId: $("#ddlState").data("kendoDropDownList").value(),
                TerritoryId: 0,
                DistrictId: $("#ddlDistrict").data("kendoDropDownList").value(),
                IsActive: $('#cbActiveInactive').is(':checked')
            };
        	moduleCommon.Common.AjaxCall({
                url: "/Lookup/City",
			    type: 'POST',
                data: { __RequestVerificationToken: token, inputDto: model },
			    success: function (result) {
				    if (result.PostStatus) {
					    var url = '@Url.Action("Cities", "Lookup")';
					    window.location.href = url;
				    } else {
					    ShowErrorMessage(result.PostMessage);
                        window.kendo.ui.progress($("#dvDistrict"), false);
					    return false;
				    }
			    }
		    });
        });
    });

    function onStateChange(e) {
        $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
        //$("#ddlTerritory").data("kendoDropDownList").dataSource.read();
    }

    function OnStateDataBound(e) {
        var stateId = $("#ddlState").data("kendoDropDownList").value();
        if (stateId > 0) {
            $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
        }
    }
    function additionalDistrictByStateInfo() {
        return {
            territoryId: Number($("#ddlState").val())
        };
    }

    //Territory
    function territoryAdditionalInfo() {
        return {
            stateId: Number($("#ddlState").val())
        }
    }

    function territoryChange() {
        $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
    }

    function OnTerritoryDataBound() {
        var territoryId = Number($("#ddlTerritory").val());
        if (territoryId > 0) {
            $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
        }
    }
</script>




