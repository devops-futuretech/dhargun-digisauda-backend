@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@model Adani.Solution.DTO.CompetitorDto

@{
    ViewBag.Title = "RouteAreaMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="masterCompetitorMaster" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_AddOrUpdateCompetitor")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li><a href="CompetitorList">@Helper.GetResourceString("lbl_Competitors")</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_AddOrUpdateCompetitor")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="CompetitorLoader">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddOrUpdateCompetitor", "Lookup", FormMethod.Post, new { id = "frmCompetitor", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.EncryptedId, new { id = "txtId" })
                        
                            <div class="row form-group">

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">  @Helper.GetResourceString("lbl_Name") <span class="text-danger">*</span> </label>
                                    @Html.TextBoxFor(m => m.Name, new { id = "txtDepotName", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_DepotName"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                                </div>

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label"> @Helper.GetResourceString("lbl_Zone") <span class="text-danger">*</span> </label>
                                    @(Html.Kendo().DropDownListFor(m => m.ZoneId)
                                                          .OptionLabel(@Helper.GetResourceString("plho_SelectZone"))
                                                          .DataTextField("Name")
                                                          .DataValueField("Id")
                                                          .Events(e => e.Change("onZoneChange"))
                                                          .DataSource(source => source.Read(read => read.Action("GetZoneListddl", "Lookup", new { isToReturnInactiveData = false }))
                                                          .ServerFiltering(false))
                                                          .HtmlAttributes(new { id = "ddlZone", tabindex = "2", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Zone"), @style = "width:100%" }))
                                </div>

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label"> @Helper.GetResourceString("lbl_State") <span class="text-danger">*</span> </label>
                                    @(Html.Kendo().DropDownListFor(m => m.StateId)
                                                          .OptionLabel(@Helper.GetResourceString("plho_SelectState"))
                                                          //.Events(events => events.Change("onStateChange").DataBound("OnStateDataBound"))
                                                          .DataTextField("StateName")
                                                          .DataValueField("StateId")
                                                          .DataSource(source => source.Read(read => read.Action("GetZoneMappedStatesddl", "Lookup").Data("stateLoadParam"))
                                                          .ServerFiltering(false))
                                                          .HtmlAttributes(new { id = "ddlState", tabindex = "3", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                                </div>

                            
                            @*<div class="row form-group">
                                    <div class="col-lg-3 col-sm-6 mb-3">
                                        @Helper.GetResourceString("lbl_Territory") <span class="text-danger">*</span>
                                    </div>
                                    <div class="col-md-4">
                                        @(Html.Kendo().DropDownListFor(m => m.TerritoryId)
                                           .OptionLabel(@Helper.GetResourceString("plho_SelectTerritory"))
                                           .DataTextField("Name")
                                           .DataValueField("Id")
                                           .Events(e => e.Change("territoryChange").DataBound("OnTerritoryDataBound"))
                                           .DataSource(source => source.Read(read => read.Action("GerTerritoryStateBase", "Lookup").Data("territoryAdditionalInfo"))
                                           .ServerFiltering(false))
                                           .HtmlAttributes(new { id = "ddlTerritory", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Territory"), @style = "width:100%" }))
                                    </div>
                                </div>

                                <div class="row form-group">
                                    <div class="col-lg-3 col-sm-6 mb-3">
                                        @Helper.GetResourceString("lbl_District") <span class="text-danger">*</span>
                                    </div>
                                    <div class="col-md-4">
                                        @(Html.Kendo().DropDownListFor(m => m.DistrictId)
                                            .OptionLabel(@Helper.GetResourceString("plho_SelectDistrict"))
                                            .Events(events => events.Change("onDistrictChange").DataBound("OnDistrictDataBound"))
                                            .DataTextField("DistrictName")
                                            .DataValueField("DistrictId")
                                            .DataSource(source => source.Read(read => read.Action("GetDistrictListBaseTerritory", "Lookup").Data("additionalDistrictByStateInfo"))
                                            .ServerFiltering(false))
                                            .HtmlAttributes(new { id = "ddlDistrict", tabindex = "4", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_District"), @style = "width:100%" }))
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col-lg-3 col-sm-6 mb-3">
                                        @Helper.GetResourceString("lbl_City") <span class="text-danger">*</span>
                                    </div>
                                    <div class="col-md-4">
                                        @(Html.Kendo().DropDownListFor(m => m.CityId)
                                            .OptionLabel(@Helper.GetResourceString("plho_SelectCity"))
                                            .DataTextField("CityName")
                                            .DataValueField("CityId")
                                            .DataSource(source => source.Read(read => read.Action("GetCityListByDistrictName", "Lookup").Data("additionalCityByDistrictInfo"))
                                            .ServerFiltering(false))
                                            .HtmlAttributes(new { id = "ddlCity", tabindex = "5", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_City"), @style = "width:100%" }))
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col-lg-3 col-sm-6 mb-3">
                                        @Helper.GetResourceString("lbl_Pincode") <span class="text-danger">*</span>
                                    </div>
                                    <div class="col-md-4">
                                        @Html.TextBoxFor(m => m.Pincode, new { id = "txtPinCode", tabindex = "6", @class = "form-control", required = "required", @onkeypress = "return isNumber(event);", data_msg_required = Helper.GetMsgRequired("lbl_Pincode"), @maxlength = (int)InputMaxLength.Pincode })
                                    </div>
                                </div>*@

                            
                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">  @Helper.GetResourceString("lbl_Location") <span class="text-danger">*</span> </label>
                                    @Html.TextAreaFor(m => m.Address, new { id = "txtDepotLocation", tabindex = "4", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Location"), @maxlength = (int)InputMaxLength.TextAreaString })
                                </div>

                            </div>

                            <div class="row form-group">

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">Status</label>
                                    <div class="custom_checkbox_main">
                                        <label class="custom_checkbox">
                                            @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "5", })
                                            <span class="checkmark check_tick"></span>
                                            <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                        </label>
                                    </div>
                                    
                                </div>

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label"> @Helper.GetResourceString("lbl_Sku") </label>
                                    <div>@(Html.Kendo().CheckBoxFor(m => m.SelectedSkuIds).Name("Dealer").HtmlAttributes(new { @class = "skuSelect", tabindex = "6" }).Label(@Helper.GetResourceString("lbl_Sku")))</div>
                                    <br />
                                    <a id="depotSelectId"> <label id="lblSkuSelectedCount">@Model.SelectedSkuIdsCount</label> @Helper.GetResourceString("msg_ItemsSelected")</a>
                                </div>

                            </div>
                            @Html.HiddenFor(m => m.SelecteSkuId, new { id = "hdSelecteSkuIds" })
                            @Html.HiddenFor(m => m.RemovedSkuId, new { id = "hdRemovedSkuIds" })
                            @Html.HiddenFor(m => m.SelectedOilTypeIdString, new { id = "hdSelectedOiltypeId" })

                   

                        <div class="row form-group">
                            <div class="col-md-12 text-right buttons-align">
                                <button type="button" id="btnCancel" tabindex = "8" onclick="location.href = '@Url.Action("CompetitorList", "Lookup")'" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.ManageMaster))
                                {
                                    <button type="button" id="btnSave" tabindex = "7" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                                }
                            </div>
                        </div>
                    }
                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>

    <div id="dvSkuPopup" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close closeDealer" data-dismiss="modal">&times;</button>
                    <h6 class="panel-title"><span class="text-semibold">SKU</span></h6>
                </div>

                <div class="modal-body">
                    <div id="dvSkuData">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" onclick="popupClose('hdSelectedDepotIds');" class="k-button closeDealer" data-dismiss="modal">@Helper.GetResourceString("btn_Close")</button>
                </div>
            </div>
        </div>
    </div>

</div>

<script>

    $(document).ready(function () {

        if ('@Model.SelectedSkuIdsCount' > 0) {
            $(".skuSelect").prop('checked', true);
        }

        $("#btnSave").click(function () {
            var isValidForm = $("#frmCompetitor").valid();

            if (isValidForm) {
                window.kendo.ui.progress($("#CompetitorLoader"), true);
                $("#frmCompetitor").submit();
                window.kendo.ui.progress($("#CompetitorLoader"), false);
            }
        });

        $(".skuSelect").click(function () {
            if ($(this).is(":checked")) {
                $("#dvSkuPopup").modal("show");
                loadCompetitor();
            } else {
                $("#hdSelecteSkuIds").val("");
                $("#lblSkuSelectedCount").html(0);
            }
        });

    });

    function loadCompetitor() {
        window.kendo.ui.progress($("#CompetitorLoader"), true);
        var oiltypeIds = [];

        var param = {
            IsToRemoveSelectedIdFromSession: true
        };

        moduleCommon.Common.AjaxCall({
                url: '@Url.Action("CompetitorSkuGridPartial", "Lookup")',
                type: 'Get',
                data: { inputDto: param },
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    $("#dvSkuData").html(result);
                    if ($("#hdSelectedOiltypeId").val()) {
                        oiltypeIds = $("#hdSelectedOiltypeId").val().split(',');
                        $("#ddlOiltype").data("kendoMultiSelect").value(oiltypeIds);
                    }
                    window.kendo.ui.progress($("#CompetitorLoader"), false);
                }
                });
    }

    //Verticle data onBound events
    function verticleDataBounted() {
        $("#ddlOiltype").data("kendoMultiSelect").dataSource.read();
    }

    function onVerticalTypeChange() {
        $("#ddlOiltype").data("kendoMultiSelect").dataSource.read();
    }

    function onOiltypeChange() {
        $("#ddlSku").data("kendoDropDownList").dataSource.read();
    }

    function oilTypeAdditionalInfo() {
        var verticleId = $("#ddVerticalType").data("kendoDropDownList").value();
        return {
            verticalId: Number(verticleId)
        }
    }

    function skuAdditionalInfo() {
        var oilTypeId = $("#SelectedOilTypeIds").data("kendoMultiSelect").value();
        return {
            oiltypeId: Number(oilTypeId)
        }
    }

    //Oil Type change event
    function oiltypeChange() {
        refreshGrid();
    }

    //Grid additional param
    function additionalParam() {
        var ids = [];
        if ($("#ddlOiltype").val()) {
            ids = $("#ddlOiltype").val();
        }
        return {
            isToReturnInactiveData: true,
            oilTypeIds: ids
        }
    }

    function oilTypeDataBound() {
        refreshGrid();
    }

    function refreshGrid() {
        $("#ViewCompetitorSku").data("kendoGrid").dataSource.read();
    }


    //Grid row check event
    function findCheckedItemsSaveItToHidden(ele, id, hiddenId, masterCheckBoxId, checkBoxClass, lblSelectedCount, gridId) {
        
        var idList = [];
        var removeIdList = [];
        if ($("#" + hiddenId).val() != "") {
            idList = $("#" + hiddenId).val().split(",");
        }
        //else {
        //    $("#hdSelectedGridIds").val("");
        //}

        //Get removed ids
        if ($("#hdRemovedSkuIds").val() != "") {
            removeIdList = $("#hdRemovedSkuIds").val().split(",");
        }

        var masterCheckBox = $(ele).is(':checked');
        var selectedCount = Number($("#" + lblSelectedCount).html());

        if (masterCheckBox) {
            idList.push(id);
            $("#" + lblSelectedCount).html(selectedCount + 1);
            if (removeIdList) {
                removeIdList = jQuery.grep(removeIdList, function (value) {
                    return value != id;
                });
            }
        }
        else {
            idList = jQuery.grep(idList, function (value) {
                return value != id;
            });
            if (selectedCount > 0)
                $("#" + lblSelectedCount).html(selectedCount - 1);

            var pId = Number($("#txtId").val());
            if (pId) {
                removeIdList.push(id);
            }
        }
        if (idList) {
            $("#" + hiddenId).val(idList.join(","));
        }
        else {
            $("#" + hiddenId).val("");
        }

        if (removeIdList) {
            $("#hdRemovedSkuIds").val(removeIdList.join(","));
        }
        else {
            $("#hdRemovedSkuIds").val("");
        }
    }

    //Zone
    function onZoneChange() {
        $("#ddlState").data("kendoDropDownList").dataSource.read();
    }

    function stateLoadParam() {
        var zoneId = $("#ddlZone").data("kendoDropDownList").value();
        return {
            zoneId: zoneId
        };
    }
    //State
    function onStateChange(e) {
        $("#ddlTerritory").data("kendoDropDownList").dataSource.read();
    }

    function OnStateDataBound(e) {
        var stateId = $("#ddlState").data("kendoDropDownList").value();
        if (stateId > 0) {
            $("#ddlTerritory").data("kendoDropDownList").dataSource.read();
        }
    }


    //Territory
    function territoryAdditionalInfo() {
        return {
            stateId: Number($("#ddlState").val())
        }
    }

    function territoryChange() {
        $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
    }

    function OnTerritoryDataBound() {
        var territoryId = Number($("#ddlTerritory").val());
        if (territoryId > 0) {
            $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
        }
    }

    //District
    function onDistrictChange(e) {
        $("#ddlCity").data("kendoDropDownList").dataSource.read();
    }

    function OnDistrictDataBound(e) {
        var districtId = $("#ddlDistrict").data("kendoDropDownList").value();
        if (districtId > 0) {
            $("#ddlCity").data("kendoDropDownList").dataSource.read();
        }
    }

    function additionalDistrictByStateInfo() {
        return {
            territoryId: Number($("#ddlTerritory").val())
        };
    }

    //City
    function additionalCityByDistrictInfo() {
        var districtId = $("#ddlDistrict").data("kendoDropDownList").value();
        return {
            districtId: districtId
        };
    }

</script>