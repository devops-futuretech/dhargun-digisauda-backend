        //$("#ddlSaudaBookingType").data("kendoDropDownList").enable(false);
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        loadDealerGrid(false);

        $('input[type="text"]').keypress(function (e) {
            var code = e.keyCode || e.which;
            if (code === 13) {
                e.preventDefault();
            }
        });

        if ('@Model.RoleId' === '@((long)Role.StateTrader)') {
            $('#dvDealerBroker').show();
            $(".dealerSelect").prop('checked', true);
        }

        $('#btnSave').on('click', function (e) {

            /*AddUserToDatabase();*/
            var isValid = $('#frmUser').valid();
            if (isValid) {
                if ($("#ViewDivisionDetails").data("kendoGrid").dataSource.data().length > 0)
                {
                    window.kendo.ui.progress($("#dvUser"), true);
                    $("#DivisionList").val(JSON.stringify($("#ViewDivisionDetails").data("kendoGrid").dataSource.data()));
                    var frm = $("#frmUser").serialize();

                    //$("#ddlSaudaBookingType").data("kendoDropDownList").readonly(false);
                    //$("#ddlSaudaBookingType").data("kendoDropDownList").enable(true);

                    $('#frmUser').submit();
                    window.kendo.ui.progress($("#dvUser"), false);

                } else {
                    ShowErrorMessage('@Helper.GetResourceString("msg_divReq")');
                }


            }
        });
        $("#btnAdd").click(function () {
            if ($("#ddlSalesOrganization").val() == "") {
                ShowErrorMessage('@Helper.GetResourceString("msg_salesorgmiss")');
            } else if ($("#ddlDistributionChannel").val() == "") {
                ShowErrorMessage('@Helper.GetResourceString("msg_distChanmiss")');
            } else if ($("#ddlVertical").val() == "") {
                ShowErrorMessage('@Helper.GetResourceString("msg_divisionmiss")');
            } else {
                AddDivisionToList();
                onVerticalChange();
            }

            //AddDivisionToList();
        });
        $('#dealerBrokerSelect').on('click', function (e) {
            $('#dvDealerBrokerCont').modal('show');
            //loadDealerGrid(true);
        });


        // Dealer,Broker Checkbox events
        $(".dealerSelect").click(function () {
            debugger;
            if ($(this).is(":checked")) {
                $('#dvDealerBrokerCont').modal('show');
            }
            else {
                $("#hdSelectedDealerIds").val("");
                $("#lblDealerSelectedCount").html(0);
                //$('#ViewDealerBrokers').data('kendoGrid').refresh();
            }
        });

        $(document).on("click", " #deleteRow", function (e) {
            var grid = $("#ViewDivisionDetails").data("kendoGrid");
            var item = grid.dataItem($(this).closest("tr"));
            grid.removeRow($(this).closest("tr"));
            onVerticalChange();

        });

        $("#toggle_pass").click(() => {

            if ($("#txtPassword").attr("type") == "Password") {
                $('#icps').toggleClass("fa-eye");
                $('#icps').toggleClass("fa-eye-slash");
                $("#txtPassword").attr("type", "text");
            } else {
                $('#icps').toggleClass("fa-eye-slash");
                $('#icps').toggleClass("fa-eye");
                $("#txtPassword").attr("type", "Password");
            }
        });

    });

    //Role dropdown change events
    //Method to role drop down change event
    function onRoleSelect(e) {
        debugger;
        if ($("#ddlRole").val() == '@((int)Role.StateTrader)' || $("#ddlRole").val() == '@((int)Role.KAM)') {
            debugger;
            $("#hdSelectedDealerIds").val("");
            $("#lblDealerSelectedCount").text(0);
            $("#hdRemovedDealerBrokerIds").val("");

            //BrokerDealer grid refresh
            loadDealerGrid(true);
        } else {
            $("#dvDealerBroker").hide();
            refreshSelectedDealer();
        }
        //Refresh ReportingTo dropdown
        $("#ddlOrganizationReportingTo").data("kendoMultiSelect").dataSource.read();
        //$("#ddlSalesReportingTo").data("kendoDropDownList").dataSource.read();
        //$("#ddlSpecialityFatReportingTo").data("kendoDropDownList").dataSource.read();
    }

    function onVerticalChange() {
        $("#ddlOrganizationReportingTo").data("kendoMultiSelect").dataSource.read();
        loadDealerGrid(false);
        //$("#ddlSalesReportingTo").data("kendoDropDownList").dataSource.read();
        //refreshSelectedDealer();
        //loadDealerGrid(true);
    }

    //Get dealer,broker details page load
    function loadDealerGrid(isRemoveDealerId) {
        debugger;
        if ($("#ddlRole").val() == '@((int)Role.StateTrader)' || $("#ddlRole").val() == '@((int)Role.KAM)') {
            $("#dvDealerBroker").show();
            var roleId = $("#ddlRole").data("kendoDropDownList").value();
            var verticalId = $("#ddlVertical").data("kendoDropDownList").value();
            //var saudaBookingType = $("#ddlSaudaBookingType").data("kendoDropDownList").value();
            var userId = $("#txtId").val();


            var divisionId = "";
            var salesOrganizationId = "";
            var distributionChannelId = "";
            var grid = $("#ViewDivisionDetails").data("kendoGrid");
            var datasource = grid.dataSource;
            for (var i = 0; i < datasource.data().length; i += 1) {
                var divid = datasource.data()[i].DivisionId;
                var salesid = datasource.data()[i].SalesOrganizationId;
                var distchanid = datasource.data()[i].DistributionChannelId;
                divisionId = divisionId.concat(divid + ",");
                salesOrganizationId = salesOrganizationId.concat(salesid + ",");
                distributionChannelId = distributionChannelId.concat(distchanid + ",");

            }

            window.kendo.ui.progress($("#dvUser"), true);
            moduleCommon.Common.AjaxCall({
                url: '@Url.Action("DealerBrokerGridPartial", "Lookup")',
                type: 'Get',
                data: { roleId: roleId, IsRemoveSelectedDealerIdsFromSession: isRemoveDealerId, VerticalIdString: divisionId, SalesOrg: salesOrganizationId, DistChannel: distributionChannelId/*, SaudaBookingTypeId: saudaBookingType*/, Id:userId },
                contentType: 'application/json; charset=utf-8',
                    success: function (result) {
                        $("#dvDealerBrokerPopup").html(result);
                        window.kendo.ui.progress($("#dvUser"), false);
                    }
                });
        }
        else {
            $("#dvDealerBroker").hide();
            $("#hdRemovedDealerBrokerIds").val("");
            $("#hdSelectedDealerIds").val("");
            $("#lblDealerSelectedCount").text(0);
        }
    }

