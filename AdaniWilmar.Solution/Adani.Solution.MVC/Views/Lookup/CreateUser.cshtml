    function ClearAddressFields() {
        $("#txtCity").val("");
        $("#hdnCityId").val("");
        $("#txtDistrict").val("");
        $("#hdnDistrictId").val("");
    }

    function additionalParam() {
        var selectedRoleId = $("#ddlRole").data("kendoDropDownList").value();
        var divisionId = "";
        var salesOrganizationId = "";
        var distributionChannelId = "";
        var grid = $("#ViewDivisionDetails").data("kendoGrid");
        var datasource = grid.dataSource;
        for (var i = 0; i < datasource.data().length; i += 1) {
            var divid = datasource.data()[i].DivisionId;
            var salesid = datasource.data()[i].SalesOrganizationId;
            var distchanid = datasource.data()[i].DistributionChannelId;
            divisionId = divisionId.concat(divid+ ",");
            salesOrganizationId = salesOrganizationId.concat(salesid+ ",");
            distributionChannelId = distributionChannelId.concat(distchanid+ ",");

        }
        //var verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        return {
            roleId: Number(selectedRoleId),
            divisionId: divisionId,
            salesOrganizationId: salesOrganizationId,
            distributionChannelId: distributionChannelId,
        };
    }

    //Grid row check event
    function findCheckedItemsSaveItToHidden(ele, id, hiddenId, masterCheckBoxId, checkBoxClass, lblSelectedCount, gridId) {
        debugger;
        var idList = [];
        var removeIdList = [];
        if ($("#" + hiddenId).val() != "") {
            idList = $("#" + hiddenId).val().split(",");
        }

        //Get removed ids
        if ($("#hdRemovedDealerBrokerIds").val() != "") {
            removeIdList = $("#hdRemovedDealerBrokerIds").val().split(",");
        }

        var masterCheckBox = $(ele).is(':checked');
        var selectedCount = Number($("#" + lblSelectedCount).html());

        if (masterCheckBox) {
            idList.push(id);
            $("#" + lblSelectedCount).html(selectedCount + 1);


            if (removeIdList) {
                removeIdList = jQuery.grep(removeIdList, function (value) {
                    return value != id;
                });
            }
        }
        else {
            idList = jQuery.grep(idList, function (value) {
                return value != id;
            });
            if (selectedCount > 0)
                $("#" + lblSelectedCount).html(selectedCount - 1);

            var pId = $("#txtId").val();
            if (pId) {
                removeIdList.push(id);
            }
        }
        if (idList) {
            $("#" + hiddenId).val(idList.join(","));
        }
        else {
            $("#" + hiddenId).val("");
        }

        if (removeIdList) {
            $("#hdRemovedDealerBrokerIds").val(removeIdList.join(","));
        }
        else {
            $("#hdRemovedDealerBrokerIds").val("");
        }
    }



