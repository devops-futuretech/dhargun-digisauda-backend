                                      columns.Bound(c => c.DivisionId).Visible(false);
                                      columns.Bound(c => c.DistributionChannelId).Visible(false);
                                      columns.Bound(c => c.SalesOrganizationId).Visible(false);
                                      columns.Bound(c => c.Division).Title(Helper.GetResourceString("lbl_Division")).Width(Settings.GridOtherColumnWidth);
                                      columns.Bound(c => c.DistributionChannel).Title(Helper.GetResourceString("lbl_Distribution")).Width(Settings.GridOtherColumnWidth);
