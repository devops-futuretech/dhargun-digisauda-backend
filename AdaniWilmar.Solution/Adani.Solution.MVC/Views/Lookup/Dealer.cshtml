<script>
    $(document).ready(function () {
        $('#popupAttachmentDetails').modal('hide');
        //$("#IsActiveCallForCustomer").hide();
        $("#viewImages").hide();
        $("#remarks").hide();
        sapDataReadOnly();       //Sap data readonly
        disableFields();      //sauda booking type,vartical readonly

        $("#toggle_pass").click(() => {

            if ($("#txtPassword").attr("type") == "Password") {
                $('#icps').toggleClass("fa-eye");
                $('#icps').toggleClass("fa-eye-slash");
                $("#txtPassword").attr("type", "text");
            } else {
                $('#icps').toggleClass("fa-eye-slash");
                $('#icps').toggleClass("fa-eye");
                $("#txtPassword").attr("type", "Password");
            }
        });

        //$("#ddlSaudaBookingType").data("kendoDropDownList").value(1);
        //$("#ddlSaudaBookingType").data("kendoDropDownList").readonly();
        //$("#ddlSaudaBookingType").data("kendoDropDownList").enable(false);

        //Edit: password field hide and required false
        if ('@Model.Id' > 0)
        {
            loadDealerGrid(false);
            $('#txtCode').attr('readonly', 'true');
            if ($("#cbActiveInactive").is(":checked"))
                $("#remarks").hide();
