                        <script>



                            function onPlantGridDataBound(e) {
                                var ms = e.sender;
                                if (!ms || !ms.element) return;
                                var cur = ms.value ? ms.value() : [];
                                if (!cur || !cur.length) {
                                    var init = ms.element.attr("data-initial");
                                    if (init) {
                                        var v = init.split(",")
                                            .map(function (x) { return +x; })
                                            .filter(function (x) { return !isNaN(x); });
                                        if (v.length) ms.value(v);
                                    }
                                }
                            }


                            function onPlantGridChange(e) {
                                var ms = e.sender;
                                var g = $("#ViewDivisionDetails").data("kendoGrid");
                                if (!g) return;

                                var $row = ms.element.closest("tr");
                                var dataItem = g.dataItem($row);
                                if (!dataItem) return;

                                var ids = ms.value() || [];

                             
                                var names = (ms.dataItems() || [])
                                    .map(x => x.Name)
                                    .join(", ");

                                dataItem.set("UserDivisionPlantCodes", names);

                                dataItem.set("UserDivisionPlantIds", ids);

                                dataItem.dirty = true;


                            }

                            function onListChangeDataBound(e) {
                                var items = e.sender.dataSource.data(); 

                                items.forEach(function (i) {
                                    i.dirty = true;  
                                });
                            }
    




                        </script>
                        
                       




