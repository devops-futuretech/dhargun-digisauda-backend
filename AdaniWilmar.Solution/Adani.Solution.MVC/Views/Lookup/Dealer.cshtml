        // Fix: jQuery 3.x breaks Kendo 2017 InCell editing.
        // Kendo's wrapper focusout sets a 1ms timer to close the cell editor.
        // Kendo's wrapper focusin should cancel it, but jQuery 3.x native
        // focusin/focusout timing differs from jQuery 1.x's simulated events,
        // so the focusin doesn't cancel the timer in time.
        // Fix: Remove Kendo's handlers and replace with popup-aware versions.
        (function () {
            var grid = $("#ViewDivisionDetails").data("kendoGrid");
            if (!grid) return;

            // Remove Kendo's problematic focusout/focusin handlers
            grid.wrapper.off("focusout focusin");

            // Our focusout: 200ms delay + check for focus in grid/popup
            grid.wrapper.on("focusout", function () {
                if (!grid.editable) return;
                clearTimeout(grid.timer);
                grid.timer = setTimeout(function () {
                    var focused = document.activeElement;
                    var inGrid = grid.wrapper[0].contains(focused);
                    var inPopup = $(focused).closest(
                        ".k-animation-container, .k-list-container, .k-popup"
                    ).length > 0;

                    if (inGrid || inPopup) return;

                    if (grid.editable) {
                        grid.editable.end();
                        grid.closeCell();
                    }
                }, 200);
            });

            // Our focusin: always clear timer when focus returns to grid
            grid.wrapper.on("focusin", function () {
                clearTimeout(grid.timer);
                grid.timer = null;
            });

            // Re-focus: When the cell enters edit mode, the MultiSelect's native
            // <select> gets focus briefly, then Kendo replaces it with custom UI
            // and focus falls to <body>. Re-focus the MultiSelect input so the
            // focusin handler cancels the close timer.
            grid.bind("edit", function (e) {
                setTimeout(function () {
                    var ms = e.container.find("[data-role='multiselect']").data("kendoMultiSelect");
                    if (ms && ms.input) {
                        ms.input.focus();
                    }
                }, 50);
            });
        })();

