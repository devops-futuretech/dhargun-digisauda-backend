
@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.DistributionChannelDto
@{
    ViewBag.Title = "DistributionChannel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="masterDistributionChannel" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_AddorUpdateDistributionChannel")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li><a href="DistributionChannelList">Distribution Channel List</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_AddorUpdateDistributionChannel")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="dvAddSubCategory">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddOrUpdateDistributionChannel", "Lookup", FormMethod.Post, new { id = "frmDistributionChannel", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.EncryptedId)
                    <div class="row form-group">
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">@Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span></label>
                            @(Html.Kendo().DropDownListFor(d => d.SalesOrganizationId)
                                          .OptionLabel("Select Sales Organization")
                                          .DataTextField("SalesOrganizationName")
                                          .DataValueField("Id")
                                          .DataSource(source => source.Read(resd => resd.Action("GetSalesOrganizationddl", "Lookup"))
                                          .ServerFiltering(false))
                                          .HtmlAttributes(new { id = "ddlSalesOrganization", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" }))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">@Helper.GetResourceString("lbl_SAPCode") <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.SAPCode, new { id = "txtSAPCode", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_SAPCode"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">@Helper.GetResourceString("lbl_Name") <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Name, new { id = "txtName", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Name"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">Status</label>
                            <div class="custom_checkbox_main">
                                <label class="custom_checkbox">
                                    @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "2" })
                                    <span class="checkmark check_tick"></span>
                                    <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                </label>
                            </div>
                        </div>
                     </div>
                        <div class="row form-group">
                            <div class="col-md-12 text-right">
                                <button type="button" tabindex="4" id="btnCancel" onclick="location.href = '@Url.Action("DistributionChannelList", "Lookup")'" class="k-button k-cancel custom-btns">Cancel</button>
                                @if (Helper.CheckClaims(Claims.ManageMaster))
                                {
                                    <button type="button" tabindex="3" id="btnSave" class="k-primary k-button custom-btns">@(Model != null && Model.Id == 0 ? @Helper.GetResourceString("btn_SaveDistributionChannel") : @Helper.GetResourceString("btn_UpdateDistributionChannel")) </button>
                                }
                                </div>
                        </div>
                    }
                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }
     if ('@Model.EncryptedId'!=null && '@Model.EncryptedId'!='')
        {
            $('#txtSAPCode').attr('readonly', 'true');
        }
        

        $('input[type="text"]').keypress(function (e) {
            var code = e.keyCode || e.which;
            if (code === 13) {
                e.preventDefault();
            }
        });

        $('#btnSave').on('click', function (e) {
            var isValid = $('#frmDistributionChannel').valid();
            if (isValid) {
                window.kendo.ui.progress($("#div_Progress"), true);
                $('#frmDistributionChannel').submit();
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    });
</script>















