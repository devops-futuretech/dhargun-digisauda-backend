@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.DistrictDto
@{
    ViewBag.Title = "District";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="masterdistrict" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_AddOrUpdateDistrict")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li><a href="Districts">@Helper.GetResourceString("lbl_District")</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_AddOrUpdateDistrict")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="dvDistrict">
                <div class="col-md-12">
                    @using (Html.BeginForm("District", "Lookup", FormMethod.Post, new { id = "frmDistrict", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(s => s.EncryptedId, new { id = "EncryptedId" })
                        @Html.HiddenFor(m => m.StateId)


                        <div class="row form-group">

                            <div class="col-lg-4 col-sm-6 mb-3">
                                <label class="custom_label">  @Helper.GetResourceString("lbl_State") <span class="text-danger">*</span> </label>
                                @(Html.Kendo().DropDownListFor(m => m.StateId)
                                                .OptionLabel(@Helper.GetResourceString("plho_SelectState"))
                                                .DataTextField("StateName")
                                                .DataValueField("StateId")
                                                //.Events(e=>e.Change("stateChange"))
                                                .DataSource(source => source.Read(read => read.Action("GetStateListAsync", "Lookup"))
                                                .ServerFiltering(false))
                                                .HtmlAttributes(new { id = "ddlState", tabindex = "1", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                            </div>

                            @*<div class="row form-group">
                    <div class="col-md-2 text-right">
                        @Helper.GetResourceString("lbl_TerritoryName") <span class="text-danger">*</span>
                    </div>
                    <div class="col-md-3">
                        @(Html.Kendo().DropDownListFor(m => m.TerritoryId)
                            .OptionLabel(@Helper.GetResourceString("plho_SelectState"))
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .DataSource(source => source.Read(read => read.Action("GerTerritoryStateBase", "Lookup").Data("additionalInfo"))
                            .ServerFiltering(false))
                            .HtmlAttributes(new { id = "ddlTerritory", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_TerritoryName"), @style = "width:100%" }))
                    </div>
                </div>*@

                            <div class="col-lg-4 col-sm-6 mb-3">
                                <label class="custom_label">  @Helper.GetResourceString("lbl_District") <span class="text-danger">*</span> </label>
                                @Html.TextBoxFor(m => m.DistrictName, new { id = "txtDistrictName", @class = "form-control", tabindex = "2", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_District"), @maxlength = (int)InputMaxLength.String })
                            </div>

                            <div class="col-lg-4 col-sm-6 mb-3">
                                <label class="custom_label">Status</label>
                                <div class="custom_checkbox_main">
                                    <label class="custom_checkbox">
                                        @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "3" })
                                        <span class="checkmark check_tick"></span>
                                        <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                    </label>
                                </div>
                            </div>

                        </div>

                        <div class="row form-group">
                            <div class="col-md-12 text-center">
                                <button type="button" tabindex="5" id="btnCancel" onclick="location.href = '@Url.Action("Districts", "Lookup")'" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.ManageMaster))
                                {
                                    <button type="button" tabindex="4" id="btnSave" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                                }
                            </div>
                        </div>
                    }
                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function ()
    {
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        $('#btnSave').on('click', function (e)
        {
            var isValidForm = $("#frmDistrict").valid();
            if (isValidForm) {
                    window.kendo.ui.progress($("#dvDistrict"), true);
                    var form = $('#frmDistrict')
                    var token = $('input[name="__RequestVerificationToken"]', form).val();

                var model = {
                        EncryptedId: $("#EncryptedId").val(),
                        DistrictId: $("#DistrictId").val(),
                        DistrictName: $("#txtDistrictName").val(),
                        StateId: $("#ddlState").data("kendoDropDownList").value(),
                        TerritoryId: $("#ddlTerritory").val(),
                        IsActive: $('#cbActiveInactive').is(':checked')
                        };

        	        moduleCommon.Common.AjaxCall({
                    url: "/Lookup/District",
			        type: 'POST',
                    data: { __RequestVerificationToken: token, inputDto: model },
			        success: function (result) {
				        if (result.PostStatus) {
					        var url = '@Url.Action("Districts", "Lookup")';
					        window.location.href = url;
				        } else {
					        ShowErrorMessage(result.PostMessage);
                            window.kendo.ui.progress($("#dvDistrict"), false);
					        return false;
				        }
			        }
                    });
            }
        });
    });




    function additionalInfo() {
        return {
            stateId: Number($("#ddlState").val())
        }
    }

    function stateChange() {
        $("#ddlTerritory").data("kendoDropDownList").dataSource.read();
    }
</script>




