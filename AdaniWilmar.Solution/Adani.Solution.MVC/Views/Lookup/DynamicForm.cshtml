    var questionIdToDelete
    function RemoveDataFromGrid(element) {
        var grid = $("#ViewSectionQuestions").data("kendoGrid");
        var row = $(element).closest("tr");
        var dataItem = grid.dataItem(row);

        if (dataItem) {
            questionIdToDelete = dataItem.QuestionId; // Store the QuestionId for deletion
            $('#deleteConfirmationModal').modal('show'); // Show the modal
        } else {
            ShowErrorMessage('Unable to retrieve question data.');
        }
    }
    $('#confirmDeleteBtn').on('click', function () {
        if (questionIdToDelete) {
            $.ajax({
                url: "/Lookup/DeleteQuestions",
                type: "POST",
                data: { QuestionId: questionIdToDelete },
                success: function (response) {
                    var grid = $("#ViewSectionQuestions").data("kendoGrid");
                    if (response.success) {
                        var row = grid.tbody.find("tr").filter(function () {
                            var dataItem = grid.dataItem(this);
                            return dataItem && dataItem.QuestionId === questionIdToDelete;
                        });
                        grid.removeRow(row);
                        ShowSuccessMessage('Question deleted successfully.');
                    } else {
                        ShowErrorMessage(response.message);
                    }
                    $('#deleteConfirmationModal').modal('hide'); // Hide the modal
                },
                error: function () {
                    ShowErrorMessage('Error deleting question.');
                    $('#deleteConfirmationModal').modal('hide'); // Hide the modal
                }
            });
        }
    });
