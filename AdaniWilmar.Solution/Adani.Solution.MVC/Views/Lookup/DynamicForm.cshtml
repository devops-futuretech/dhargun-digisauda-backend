                                    .HeaderTemplate("<div class='text-center' style = 'margin-left: 7px;'><input type='checkbox' id='masterCBAllSectionQuestions' onclick=\"masterfindCheckedItemsSaveItToHidden(this,'hdSelectedQuestionIds','chkbxAllSectionQuestions','lblQuestionsSelectedCount')\" /></div>").Width("40px");
                                    })
                                    .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
