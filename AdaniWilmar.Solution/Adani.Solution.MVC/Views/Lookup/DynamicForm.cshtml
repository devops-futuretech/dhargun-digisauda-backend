    function AddDataToGrid() {
        var gridData = $("#ViewSelectedQuestions").data("kendoGrid").dataSource.data();
        var gridDataLength = gridData.length;
        var jsonObj = [];

        $.each(gridData, function (idx2, val2) {
            jsonObj.push(val2.QuestionId);
        });

        var grid = $("#ViewSectionQuestions").data("kendoGrid");
        var datasource = grid.dataSource;

        var existingQuestionIds = [];
        $.each(datasource.data(), function (idx, item) {
            existingQuestionIds.push(item.QuestionId);
        });

        var newQuestions = jsonObj.filter(function (questionId) {
            return existingQuestionIds.indexOf(questionId) === -1;
        });

        if (newQuestions.length !== jsonObj.length) {
            ShowErrorMessage('The selected questions are already added.');
            return;
        }

        var total = datasource.data().length;
        var filteredQuestions = gridData.filter(function (item) {
            return newQuestions.indexOf(item.QuestionId) !== -1;
        });

        $.each(filteredQuestions, function (idx, val) {
            datasource.insert(total, {
                QuestionsCount: gridDataLength,
                QuestionId: val.QuestionId,
                Query: val.Query,
                QuestionTypeName: val.QuestionTypeName,
                SelectedQuestionsString: jsonObj.join(),
                UnselectedQuestionsString: $("#hdSavedQuestions").val()
            });
        });

        var model = {
            Questions: JSON.parse(JSON.stringify(filteredQuestions))
        };

        window.kendo.ui.progress($("#div_Progress"), true);

        $.ajax({
            url: "/Lookup/SaveSectionMappedQuestions",
            type: 'POST',
            data: { selectedQuestionsViewModel: JSON.parse(JSON.stringify(filteredQuestions)) },
            success: function (result) {
                window.kendo.ui.progress($("#div_Progress"), false);
                if (result.PostStatus) {
                    return true;
                } else {
                    ShowErrorMessage(result.PostMessage);
                    return false;
                }
            }
        });

        ResetFields();
    }


