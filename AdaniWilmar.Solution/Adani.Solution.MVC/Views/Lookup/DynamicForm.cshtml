<script type="text/javascript">
	var windowDelete; var mappedSectionQuestions; var SectionId; var selectedQuestionsCleared = false;
    $(document).ready(function () {
        if ('@TempData["SuccessMessage"]'.length) {
            ShowSuccessMessage('@TempData["SuccessMessage"]');
        }

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
		}

		/*Delete window click event from temporary grid*/
		windowDelete = $("#kWindow").kendoWindow({
            title: "Delete confirmation",
            modal: true,
            visible: false,
            resizable: false,
            width: 300
        }).data("kendoWindow");

		/*Save form click event*/
        $("#btnAddUpdateForm").click(function (e) {
            formSubmit();
		});

		/* move up */
        $("#btnMoveAllLeft").on("click", function (idx, elem) {
             var unmappedQuestionsGrid = $("#ViewQuestions").data("kendoGrid");
             var dataItem = unmappedQuestionsGrid.dataSource._data;
             var selectedQuestionsGrid = $("#ViewSelectedQuestions").data("kendoGrid");
			 if (dataItem.length > 0) {
				 $.each(dataItem, function (idx, elem) {
					 elem.IsChecked = false;
					 selectedQuestionsGrid.dataSource.add(elem);

				 });
                 $("#ViewQuestions").data('kendoGrid').dataSource.data([]);
			 }
			  else {
				 ShowErrorMessage('@Helper.GetResourceString("msg_NoRecordsFound")')
			 }
             $("#hdSelectedUnmappedQuestionIds").val("");
             $("#masterCBAllUnmappedQuestions").attr('checked', false);
        });

        /* move down */
		 $("#btnMoveSelectedLeft").on("click", function (idx, elem) {
             var unmappedQuestionsGrid = $("#ViewQuestions").data("kendoGrid");
             var dataItem = unmappedQuestionsGrid.dataSource._data;
             var selectedQuestionsGrid = $("#ViewSelectedQuestions").data("kendoGrid");
			 var sectionQuestions = [];
             if ($("#hdSelectedUnmappedQuestionIds").val() != "") {
                 var selectedRow = $("#hdSelectedUnmappedQuestionIds").val().split(',');
				 if (selectedRow.length > 0) {
					 $.each(selectedRow, function (idx, elem) {
                         var data = $.grep(dataItem, function (p) { return p.QuestionId == elem; })
							.map(function (p) { return p; });
                         selectedQuestionsGrid.dataSource.add(data[0]);
                         sectionQuestions.push(data[0]);
					 });
					 var Unselected = [];
					 $.grep(dataItem, function (el) {
                         if ($.inArray(el, sectionQuestions) == -1) {
							 Unselected.push(el);
						 }
					 });
                     $("#ViewQuestions").data('kendoGrid').dataSource.data(Unselected);
				 }
			 }
			 else {
				 ShowErrorMessage('@Helper.GetSelectMsgRequired("lbl_Query")')
			 }
             $("#hdSelectedUnmappedQuestionIds").val("");
             $("#masterCBAllUnmappedQuestions").attr('checked', false);
			return false;
        });

        /* move to top */
		 $("#btnMoveSelectedRight").on("click", function (idx, elem) {
             var selectedQuestionsGrid = $("#ViewSelectedQuestions").data("kendoGrid");
             var unmappedQuestionsGrid = $("#ViewQuestions").data("kendoGrid");
             var dataItem = selectedQuestionsGrid.dataSource._data;
			var unmappedSection = [];
             if ($("#hdSelectedQuestionIds").val() != "") {
                 var selectedRow = $("#hdSelectedQuestionIds").val().split(',');
				if (selectedRow.length > 0) {
					$.each(selectedRow, function (idx, elem) {
                        var data = $.grep(dataItem, function (p) { return p.QuestionId == elem; })
							.map(function (p) { return p; });
                        unmappedQuestionsGrid.dataSource.add(data[0]);
                        unmappedSection.push(data[0]);
					});
					var Unselected = [];
					$.grep(dataItem, function (el) {
						if ($.inArray(el, unmappedSection) == -1) {
							Unselected.push(el);
						}
					});
                    $("#ViewSelectedQuestions").data('kendoGrid').dataSource.data(Unselected);
				}
			}
			else {
					ShowErrorMessage('@Helper.GetSelectMsgRequired("lbl_Query")')
			}
             $("#hdSelectedQuestionIds").val("");
             $("#masterCBAllSectionQuestions").attr('checked', false);
			return false;
        });

        /* move to bottom */
		$("#btnMoveAllRight").on("click", function (idx, elem) {
            var unmappedQuestionsGrid = $("#ViewQuestions").data("kendoGrid");
            var selectedQuestionsGrid = $("#ViewSelectedQuestions").data("kendoGrid");
            var dataItem = selectedQuestionsGrid.dataSource._data;
			if (dataItem.length > 0) {
				$.each(dataItem, function (idx, elem) {
					elem.IsChecked = false;
                    unmappedQuestionsGrid.dataSource.add(elem);
				});
                $("#ViewSelectedQuestions").data('kendoGrid').dataSource.data([]);
			}
			 else {
				 ShowErrorMessage('@Helper.GetResourceString("msg_NoRecordsFound")')
			}
            $("#hdSelectedQuestionIds").val("");
            $("#masterCBAllSectionQuestions").attr('checked', false);
		});

		/*Create another click event*/
        $("#CreateAnother").click(function () {
            if ($("#CreateAnother").is(':checked')) {
                $("#hdnCreateAnother").val(true);
            }
            else {
                $("#hdnCreateAnother").val(false);
            }
		});

		/*Add Section to temporary grid click event*/
        $('#btnAddSection').on('click', function (e) {
			var errorFlag = false;
			var isValid = $('#frmAddUpdateForm').valid();

			var gridData = $("#ViewSelectedQuestions").data("kendoGrid").dataSource.data();
			var jsonObj = [];
			$.each(gridData, function (idx2, val2) {
				jsonObj.push(val2.QuestionId);
			});
			if (!isValid) {
				errorFlag = true;
			}
			if (gridData.length == 0) {
				ShowErrorMessage('@Helper.GetSelectMsgRequired("lbl_Query")');
				errorFlag = true;
			}
			@*var sectionId = $("#ddlSection").data("kendoDropDownList").value();
			if (sectionId <= 0) {
				ShowErrorMessage('@Helper.GetSelectMsgRequired("lbl_Section")');
                errorFlag = true;
            }*@

            if (!errorFlag)
            {
                AddDataToGrid();
                var grid = $("#ViewSectionQuestions").data("kendoGrid");

                grid.dataSource.page(1); 
                grid.dataSource.read();   
                grid.refresh();
            }
		});
        $('#zoneContainer').click(function () {
            $("#multiselectDescription_head").text("Selected Zones");
            $("#multiselectDescription").modal("show");
            var selectedItems = $("#ddlRoles").data('kendoMultiSelect').dataItems();
            var listContainer = $("#multiselectDescription_ul");
            listContainer.empty();

            selectedItems.forEach(function (item) {
                var listItem = $("<li>").text(item.Name);
                listContainer.append(listItem);
            });
        });
        $("#roleSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlRoles", "roleSelectAll");
        });
	});

    function onRolesChange() {
        //$("#ddlState").data("kendoMultiSelect").dataSource.read();
        MultiSelectEvents("ddlRoles", "roleSelectAll");
	}

	/*Change event for Dependent Form*/
	function onDependentFormSelect(e) {

	}

	/*Data bound event for SectionQuestions Hierarchical grid*/
	function onChildQuestionListDataBound(e) {
		SetEmptyRow(e);
	}

	/*Data bound event for form users dropdown*/
	function onToUserDatabound(e) {
	}

	/*Change event for Form users dropdown*/
	function onToUserChange() {
	}

	/*Change event for Section dropdown*/
    function onSectionChange(e) {
		//On section change, if selected questions are present, throw error message to move to the temporary grid
		var errorFlag = false;
		var gridDataMappedQuestions = $("#ViewSelectedQuestions").data("kendoGrid").dataSource.data();
		if (gridDataMappedQuestions.length > 0) {
			ShowErrorMessage('@Helper.GetResourceString("msg_AddSelectedQuestions")');
			errorFlag = true;
		}

		if (errorFlag) {
			$("#ddlSection").data("kendoDropDownList").value(SectionId);
		}
		else {
			//If selected section has been saved already, show the mapped and unmapped questions and remove from grid
			var selectedSectionId = $("#ddlSection").data("kendoDropDownList").value();
			var gridDataTemp = $("#ViewSectionQuestions").data("kendoGrid").dataSource.data();
			var grid = $("#ViewSectionQuestions").data("kendoGrid");
			var row = "";

			$.each(gridDataTemp, function (idx2, val2) {
				if (val2.SectionId == selectedSectionId) {
					row = grid.tbody.find("tr[data-uid='" + val2.uid + "']");
				}
			});

			if (row.length > 0) {
				//Update section mapped questions before data removal from temporary grid
				var selectedGridData = grid.dataItem(row);
				var parsedGridData = JSON.parse(JSON.stringify(selectedGridData));
				mappedSectionQuestions = "";
				mappedSectionQuestions = parsedGridData.Questions;

				//Update selected Question string
				$("#hdSelectedQuestionIds").val(parsedGridData.SelectedQuestionsString);

				if ($("#hdSelectedQuestionIds").val() != "") {
					$("#hdSavedQuestions").val($("#hdSelectedQuestionIds").val());
				}

				//Remove selected section from temporary grid
				grid.removeRow(row);
			}

			//Save selected section
			SectionId = "";
			SectionId = selectedSectionId;

			if (row.length > 0) {
				var sectionSelectedQuestionsGrid = $("#ViewSelectedQuestions").data("kendoGrid");
				sectionSelectedQuestionsGrid.dataSource.read();
				selectedQuestionsCleared = false;
			}
			else {
				selectedQuestionsCleared = true;
				$("#ViewSelectedQuestions").data("kendoGrid").dataSource.data([]);
			}
			var sectionQuestionsGrid = $("#ViewQuestions").data("kendoGrid");
			sectionQuestionsGrid.dataSource.read();
		}
	}

