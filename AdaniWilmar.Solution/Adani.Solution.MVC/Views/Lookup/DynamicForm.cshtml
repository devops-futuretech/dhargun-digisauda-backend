                        </div>
                    </div>

                    <div class="panel-heading">
                        <h3 class="panel-title">@Helper.GetResourceString("lbl_MappedSectionList")</h3>
                    </div>
                    <div class="panel-body" style="display: block;">
                        <div class="row" id="dvDealers">
                            <div class="col-md-12">
                                @(Html.Kendo().Grid<QuestionsViewDto>()
                                      .Name("ViewSectionQuestions")
                                      .Columns(columns =>
                                      {
                                          //columns.Bound(c => c.SectionId).Visible(false);
                                          //columns.Bound(c => c.SectionName).Title(Helper.GetResourceString("lbl_Section")).Width(Settings.GridOtherColumnWidth);
                                          //columns.Bound(c => c.QuestionsCount).Title(Helper.GetResourceString("lbl_No")).Width(Settings.GridOtherColumnWidth).Visible(false);
                                          //columns.Bound(c => c.SelectedQuestionsString).Visible(false);
                                          //columns.Bound(c => c.UnselectedQuestionsString).Visible(false);
                                          columns.Bound(c => c.Questions).Visible(false);
                                          columns.Bound(c => c.QuestionId).Visible(false);
                                          columns.Bound(c => c.Query).Title(@Helper.GetResourceString("lbl_Query")).Width(Settings.GridOtherColumnWidth);
                                          columns.Bound(c => c.QuestionTypeName).Title(@Helper.GetResourceString("lbl_QuestionType")).Width(Settings.GridOtherColumnWidth);
                                          columns.Template(c => c.Id).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Action")).ClientTemplate("<div style='text-align: center;'><a class='cursor-pointer'></a><a style='padding-left: 4px;' class='fa fa-trash-o deleteicon cursor-pointer' title='Remove the section' onclick='RemoveDataFromGrid(this)'></a></div>").Width(Settings.GridOtherColumnWidth);
                                      })
                                       .Pageable(paging => paging
                                       .PageSizes(new int[] { 10, 20, 50 })
                                       .ButtonCount(5)
                                       .Refresh(true))
                                       @*.Input(true))*@
                                      .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                      //.Filterable(filter => filter.Mode(GridFilterMode.Row))
                                      .Scrollable(s => s.Enabled(true).Height("auto"))
                                .Events(events => events.DataBound("onSectionQuestionListDataBound"))
                                .Reorderable(reorder => reorder.Columns(true))
                                .Resizable(resize => resize.Columns(true))
                                .DataSource(dataSource => dataSource
                                .Ajax()
                                .Read(read => read.Action("SectionEmptyListAsync", "Lookup").Data("additionalSectionGridInfo"))
                                .PageSize(10)))
                                @*<script id="sectionTemplate" type="text/kendo-tmpl">
                                        @(Html.Kendo().Grid<QuestionsViewDto>()
                                                    .Name("grid")
                                                    .Columns(columns =>
                                                    {
                                                        columns.Bound(c => c.QuestionId).Visible(false);
                                                        columns.Bound(c => c.OrderId).Visible(false);
                                                        columns.Bound(c => c.Query).Title(@Helper.GetResourceString("lbl_Query")).Width(Settings.GridOtherColumnWidth);
                                                        columns.Bound(c => c.QuestionTypeName).Title(@Helper.GetResourceString("lbl_QuestionType")).Width(Settings.GridOtherColumnWidth);
                                                        })
                                                    .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                                    .Events(events => events.DataBound("onChildQuestionListDataBound"))
                                                    .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Read(read => read.Action("GetSectionMappedQuestions", "Lookup", new { SectionId = "#=SectionId#" })))
                                                    .ToClientTemplate())
                                    </script>*@
                            </div>
                        </div>
                    </div>
                </fieldset>
                <div class="row form-group">
                    <div class="col-md-12 text-right buttons-align">
                        @*@(Html.Kendo().CheckBoxFor(m => m.CreateAnother).Name("CreateAnother").HtmlAttributes(new { id = "CreateAnother", tabindex = "12" }).Label(@Helper.GetResourceString("lbl_CreateAnother")))*@
                        <button type="button" tabindex="13" id="btnCancel" onclick="location.href = '@Url.Action("DynamicFormList", "Lookup")'" class="k-button k-cancel custom-btns">Cancel</button>
                        <button type="button" tabindex="14" id="btnAddUpdateForm" @*onclick="formSubmit()"*@ class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save")</button>
                    </div>
                </div>
            }
        </div>
    </div>
    <div id="kWindow">
        <h2>@Helper.GetResourceString("msg_DeleteConfirmation")</h2>
        <div class="col-md-12 text-center">
            <button id="yes" class="k-primary k-button">Yes</button>
            <button id="no" autofocus class="k-primary k-button">No</button>
        </div>
    </div>

    @*Model popup*@
    <!-- Delete Confirmation Modal -->
    <div id="deleteConfirmationModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog custom-modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header custom-modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                       @* <span aria-hidden="true">&times;</span>*@
                    </button>
                </div>
