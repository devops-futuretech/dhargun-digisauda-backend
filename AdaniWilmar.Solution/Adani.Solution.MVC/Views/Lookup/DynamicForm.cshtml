										columns.Bound(c => c.QuestionId).Visible(false);
										columns.Bound(c => c.OrderId).Visible(false);
										columns.Bound(c => c.Query).Title(@Helper.GetResourceString("lbl_Query")).Width(Settings.GridOtherColumnWidth);
										columns.Bound(c => c.QuestionTypeName).Visible(false);
										columns.Template(@<text></text>)
