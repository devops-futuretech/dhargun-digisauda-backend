	/*Method to save form*/
    function formSubmit() {
		var errorFlag = false;
		var form = $('#frmAddUpdateForm');
		var isValid = $("#frmAddUpdateForm").valid();
		var token = $('input[name="__RequestVerificationToken"]', form).val();

		if (!isValid) {
		    errorFlag = true;
		}
		if ($("#ViewSectionQuestions").data("kendoGrid").dataSource.data().length <= 0) {
		    ShowErrorMessage('@Helper.GetSelectMsgRequired("lbl_Query")');
		    errorFlag = true;
		}

		if (errorFlag) {
		    return false;
		} else {
        var formName = document.getElementById('txtName').value;
        if (isAlphaNumeric2(formName)) {
            // Get the selected Role IDs from the Kendo MultiSelect widget
            var roleIds = $("#ddlRoles").data("kendoMultiSelect").value();

            var model = {
                FormId: $("#hdnFormId").val(),
                FormName: $("#txtName").val(),
                RoleIds: roleIds, // Ensure this is the correct way to retrieve selected Role IDs
                //SectionQuestionsList: JSON.parse(JSON.stringify($("#ViewSectionQuestions").data("kendoGrid").dataSource.data())),
                IsActive: $("#cbActiveInactive").prop("checked"),
                CreateAnother: $("#hdnCreateAnother").val(),
            };
            console.log(model);
            window.kendo.ui.progress($("#div_Progress"), true);

            $.ajax({
                url: "/Lookup/DynamicForm",
                type: 'POST',
                data: { __RequestVerificationToken: token, formDetailsViewModel: model },
                success: function (result) {
                    window.kendo.ui.progress($("#div_Progress"), false);
                    if (result.PostStatus) {
                        window.location = result.redirectUrl;
                    } else {
                        ShowErrorMessage(result.PostMessage);
                        return false;
                    }
                }
            });
        } else {
            ShowErrorMessage('@Helper.GetResourceString("msg_AphaNumericError")');
        }
    }
