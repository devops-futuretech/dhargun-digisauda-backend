                                <button type="button" tabindex="8" id="btnMoveSelectedLeft" class="k-primary k-button btn-icon btn-rounded" title="@Helper.GetResourceString("lbl_MoveSelectedRight")"><i class="icon-arrow-right15"></i></button>
