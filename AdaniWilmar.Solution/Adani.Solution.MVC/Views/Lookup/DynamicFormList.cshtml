@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Models
@using Adani.Solution.DTO.Enums
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO
@{
    ViewBag.Title = "Dynamic Form List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="cmsdynamicform" />

<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_DynamicForms")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">@Helper.GetResourceString("lbl_cms")</a></li>
    </ol>

    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvDynaForms">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <!--<div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">-->
                        @*<span class="export-link" onclick='excelExport()' type="button">CSV</span>*@
                        <!--<span class="export-link" onclick='excelExport()' type="button">Excel</span>
                            </div>
                        </div>-->
                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='userListExport(true)' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        <div class="period-wrapper">
                            <a href="@Url.Action("DynamicFormEditRedirect","Lookup")" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateDynamicForm")</a>
                        </div>
                    </div>
                    @(Html.Kendo().Grid<FormDto>()
                          .Name("ViewDynamicForms")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.FormId).Visible(false);
                              columns.Bound(c => c.FormName).Title(@Helper.GetResourceString("lbl_FormName")).ClientTemplate(@"<div> <a style='text-decoration: underline;' href='" + Url.Action("DynamicFormEditRedirect", "Lookup", new { formId = "#=FormId#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=FormName#</a> </div>").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.ParentFormName).Title(@Helper.GetResourceString("lbl_DependentFormName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(t => t.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'> #if(IsActive == false) { #"
                                                                     + " <a  title='" + @Helper.GetResourceString("msg_Inactive") + "'><i class='icon-cancel-square2 faicon-red' ></i></a>   #}else{#<a title='" + @Helper.GetResourceString("msg_Active") + "'><i  class='icon-checkbox-checked2 faicon-green' ></i></a> #}# </div>").Width(Settings.GridColumnMaxWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Resizable(resize => resize.Columns(true))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Excel(excel => excel.AllPages(true).FileName(@Helper.GetResourceString("lbl_Users") + " " + DateTime.Now + ".xlsx").Filterable(true))
                          .Events(events => events.DataBound("onFormListDataBound"))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Resizable(resize => resize.Columns(true))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(model => { model.Id(p => p.FormId); })
                          .Sort(sort => sort.Add("FormId").Descending())
                          .ServerOperation(true)
                          .Read(read => read.Action("GetMasterDynamicListAsync", "Lookup"))))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();

         if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
		}
    });

    //Method to data bound event for form List
    function onFormListDataBound(e) {
        SetEmptyRow(e);
    }
</script>

