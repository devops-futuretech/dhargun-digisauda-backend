@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@using Adani.Solution.DTO
@model Adani.Solution.DTO.SaudaExtensionPolicyAddDto
@{
    ViewBag.Title = "ExtensionPolicy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="mastersaudaextensionpolicy" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title"> @Helper.GetResourceString("lbl_ExtensionPolicy")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_ExtensionPolicy")<span class="icon-right"></span></li>
    </ol>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="SaudaExtensionMasterLoader">
                @using (Html.BeginForm("AddExtensionPolicy", "Lookup", FormMethod.Post, new { id = "frmSaudaExtensionMaster", @class = "form-validate-jquery" }))
                {
                    @Html.AntiForgeryToken()


                    <div class="row form-group">
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">@Helper.GetResourceString("lbl_ZonalHead")<span class="text-danger">*</span> </label>
                            @(Html.Kendo().MultiSelectFor(m => m.ZonalHeadIds)
                              .Events(events => events.Change("onZonalHeadChange").DataBound("onZonalHeadMultiSelectDataBound"))
                              .Placeholder("Select Zonal Head")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              .DataSource(source => source.Read(read => read.Action("GetZonalHeadList", "Lookup", new { isToReturnInactiveData = false }))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zonalheadSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlZonalHead", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_ZonalHead"), @style = "width:100%" }))
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_State") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().MultiSelectFor(m => m.StateIds)
                              .Events(events => events.Change("onStateChange").DataBound("onStateMultiSelectDataBound"))
                              .Placeholder("Select State")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              .DataSource(source => source.Read(read => read.Action("GetStatesListBasedOnZonalHeadIds", "Lookup").Data("AddtionalParam"))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='stateselectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlState", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                        </div>


                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_OilType") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().MultiSelectFor(m => m.OilIds)
                              .Events(events => events.Change("onOilTypeChange").DataBound("onOilTypeMultiSelectDataBound"))
                              .Placeholder("Select OilType")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              .DataSource(source => source.Read(read => read.Action("GetOilTypesBasedOnVertical", "Lookup", new { verticalId = Model.VerticalId }))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='oiltypeSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlOilType", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_OilType"), @style = "width:100%" }))
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_ExtensionDays") <span class="text-danger">*</span> </label>
                            @Html.TextBoxFor(m => m.Days, new { @id = "txtExtensionDays", tabindex = "3", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_ExtensionDays") })
                        </div>
                    </div>

                    <div class="row form-group">

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_ValidFrom") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().DatePickerFor(m => m.ValidFrom)
                                          .Format(Settings.DateFormat)
                                          .Events(e => e.Change("fromChange"))
                                          .HtmlAttributes(new { id = "dpFromDate", onkeydown = "return isFocus(event);", tabindex = "5", style = "width: 100%" , required = "required", data_msg_required = Helper.GetMsgRequired("lbl_ValidFrom") }))
                        </div>


                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_ValidTo") <span class="text-danger">*</span></label>
                            @(Html.Kendo().DatePickerFor(m => m.ValidTo)
                                          .Format(Settings.DateFormat)
                                          .HtmlAttributes(new { id = "dpToDate", onkeydown = "return isFocus(event);", tabindex = "6", style = "width: 100%" , required = "required", data_msg_required = Helper.GetMsgRequired("lbl_ValidTo") }))
                        </div>



                    </div>

                    <div class="row form-group ">
                        <div class="col-md-12 text-center">
                            <button type="button" id="btnSave" tabindex="4" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                        </div>
                    </div>

                }
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick='excelExport()' type="button">Excel</span>
                            </div>
                        </div>

                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))

                    </div>

                    @(Html.Kendo().Grid<Adani.Solution.DTO.SaudaExtensionPolicyViewDto>()
                          .Name("ViewSaudaExtension")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.OilTypeName).Title(@Helper.GetResourceString("lbl_OilType")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.OilTypeCode).Title("OilType Code").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.StateName).Title(@Helper.GetResourceString("lbl_State")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Days).Title(@Helper.GetResourceString("lbl_ExtensionDays")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ValidFrom).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_ValidFrom")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ValidTo).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_ValidTo")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'>#if(IsActive){#<i class='icon-green_ckbox_tick faicon-green'><span class='path1'></span><span class='path2'></span></i>#}else{#<i class='icon-red_ckbox_tick faicon-red'><span class='path1'></span><span class='path2'></span></i>#}#</div>").Width(Settings.GridColumnMaxWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Selectable(selectable => selectable
                          .Mode(GridSelectionMode.Multiple)
                          .Type(GridSelectionType.Row))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          //.Events(events => events.DataBound("onBrokerListDataBound"))
                          .Reorderable(reorder => reorder.Columns(true))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(model => model.Id(m => m.Id))
                          .ServerOperation(true)
                          .Read(read => read.Action("GetSaudaExtensionList", "Lookup",new { verticalId = Model.VerticalId }))))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var verticalId = 0
    $(document).ready(function () {

        // kendo grid filter contains
        FilterContains();

        StartDateRange();

        if (@Model.VerticalId != null) {
            verticalId = @Model.VerticalId;
        }

        $("#zonalheadSelectAll").click(function () {
             MultiSelectSelectAll("ddlZonalHead", "zonalheadSelectAll");
            $("#ddlState").data("kendoMultiSelect").dataSource.read();
        });

        $("#oiltypeSelectAll").click(function () {
            MultiSelectSelectAll("ddlOilType", "oiltypeSelectAll");
        });

        $("#stateselectAll").click(function () {
           MultiSelectSelectAll("ddlState", "stateselectAll");
        });

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        $("#btnSave").click(function () {
			if ($("#txtExtensionDays").val() == 0) {
				ShowErrorMessage('@Helper.GetResourceString("msg_ExtensionDaysRequired")');
			}
			else {
				var isValidForm = $("#frmSaudaExtensionMaster").valid();
				if (isValidForm) {
					window.kendo.ui.progress($("#SaudaExtensionMasterLoader"), true);
					$("#frmSaudaExtensionMaster").submit();
					window.kendo.ui.progress($("#SaudaExtensionMasterLoader"), false);
				}
			}
        });
    });

    function fromChange() {
        var endPicker = $("#dpToDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#dpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }
    }

    function StartDateRange() {
        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#dpFromDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
        $("#dpToDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        var startPicker = $("#dpFromDate").data("kendoDatePicker");
        startPicker.min(dates);

        var endPicker = $("#dpToDate").data("kendoDatePicker");
        endPicker.min(dates);
    }

    function onZonalHeadChange() {
         MultiSelectIndividualSelect("ddlZonalHead", "zonalheadSelectAll");
        $("#ddlState").data("kendoMultiSelect").dataSource.read();
    }

    function onZonalHeadMultiSelectDataBound() {
        MultiSelectIndividualSelect("ddlZonalHead", "zonalheadSelectAll");
    }

    function onOilTypeChange() {
        MultiSelectIndividualSelect("ddlOilType", "oiltypeSelectAll");
    }

    function onOilTypeMultiSelectDataBound() {
        MultiSelectIndividualSelect("ddlOilType", "oiltypeSelectAll");
    }

    function onStateChange() {
        MultiSelectIndividualSelect("ddlState", "stateselectAll");
    }

    function onStateMultiSelectDataBound() {
        MultiSelectIndividualSelect("ddlState", "stateselectAll");
    }

    function AddtionalParam() {
        return {
            ZonalHeadIds: ($("#ddlZonalHead").val() ? $("#ddlZonalHead").val().join() : "")
        };
    }

    function excelExport() {
        window.kendo.ui.progress($("#div_Progress"), true);
        var data = { verticalId : verticalId };
        $.ajax({
            type: 'Post',
            url: '@Url.Action("ExportExtensionPolicy", "Lookup")',
            data: { verticalId },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }
</script>