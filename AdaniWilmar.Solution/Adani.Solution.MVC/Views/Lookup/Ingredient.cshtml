@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Common
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.VerticalDto

@{
    ViewBag.Title = "Ingredient";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="tpspecialityfatIngredient" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">@Helper.GetResourceString("lbl_Ingredients")</h2>
    <div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">
            <a id="btnAddVertical" href="#" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("lbl_AddIngredient")</a>
        </div>
    </div>
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvDealers">
                <div class="col-md-12">
                    <div class="text-right">
                        <button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("IngredientGrid")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                    </div>
                    @(Html.Kendo().Grid<IngredientDto>()
                          .Name("IngredientGrid")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.Vertical).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Vertical")).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Name).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Name")).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'>#if(IsActive){#<i class='icon-checkbox-checked2 faicon-green'></i>#}else{#<i class='icon-cancel-square2 faicon-red'></i>#}#</div>").Width(Settings.GridColumnMaxWidth);
                              columns.Template(t => t.Name).Title(@Helper.GetResourceString("lbl_Edit")).ClientTemplate(@"<div style='text-align: center;'>
                                                                                    <i onclick='editOil(this)' class='glyphicon glyphicon-pencil pointer' ></i></div>").Title(@Helper.GetResourceString("lbl_Edit")).Width(Settings.GridButtonColumnWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Resizable(resize => resize.Columns(true))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Excel(excel => excel.AllPages(true).FileName(@Helper.GetResourceString("lbl_Ingredients") + " " + DateTime.Now + ".xlsx").Filterable(true))
                          .Events(events => events.DataBound("onVerticleDataBound"))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Sort(sort => sort.Add("Id").Ascending())
                          .Model(model => { model.Id(p => p.Id); })
                          .ServerOperation(true)
                          .Read(read => read.Action("GetIngredientsAsync", "Lookup", new { IsToReturnInactiveData = true }))
                          ))
                </div>
            </div>
        </div>
    </div>
    <div id="addVerticalPopoup" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            @using (Html.BeginForm("frmOilType", "Lookup", FormMethod.Post, new { id = "frmOilType", @class = "form-validate-jquery" }))
            {
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close model-header-color" data-dismiss="modal">&times;</button>
                        <h6 class="panel-title model-header-color"><span class="text-semibold">@Helper.GetResourceString("lbl_AddUpdateIngredient")</span></h6>
                    </div>
                    <div class="modal-body">
                        @Html.HiddenFor(m => m.Id, new { id = "txtId" })

                        <div class="row form-group">

                            <div class="col-md-4 text-right">
                                @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-4">
                                @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel(@Helper.GetResourceString("plho-SelectSales"))
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-4 text-right">
                                @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-4">
                                @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel(@Helper.GetResourceString("plho-SelectDistChannel"))
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "5", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                            </div>
                        </div>


                        <div class="row form-group">
                            <div class="col-md-4 text-right">
                                @Helper.GetResourceString("lbl_VerticleType") <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-4">
                                @(Html.Kendo().DropDownListFor(m => m.VerticalId)
                                      .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                       .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                      .ServerFiltering(false))
                                      .HtmlAttributes(new { id = "ddlVertical", tabindex = "1", @class = "form-control", data_msg_required = Helper.GetSelectMsgRequired("lbl_VerticleType"), @style = "width:100%" }))

                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-4 text-right">
                                @Helper.GetResourceString("lbl_Name") <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-4">
                                @Html.TextBoxFor(m => m.Name, new { id = "txtName", tabindex = "2", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Name"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-4 text-right">
                                @Helper.GetResourceString("lbl_ActiveInactive")
                            </div>
                            <div class="col-md-4">
                                @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "3" })
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        @if (Helper.CheckClaims(Claims.ManageSpecialityFat))
                        {
                            <button id="btnSave"  tabindex = "4" type="button" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Save")</button>
                        }
                        <button id="btnDirtyCancel" tabindex = "5" type="button" onclick="popupClose();" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Cancel")</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        // kendo grid filter contains
        FilterContains();

        //Modal popup show
        $("#btnAddVertical").click(function () {
            clear();
            $(".validation-error-label").remove();
            $("#addVerticalPopoup").modal('show');
        });

        //Save function
        $("#btnSave").click(function () {
            var isValidForm = $("#frmOilType").valid();

            if (isValidForm) {
                var data = {
                    Id: $("#txtId").val(),
                    VerticalId: $("#ddlVertical").data("kendoDropDownList").value(),
                    Name: $("#txtName").val(),
                    IsActive: $("#cbActiveInactive").is(":checked")
                };
                $.ajax({
                    type: "Post",
                    url: '@Url.Action("AddOrUpdateIngredient", "Lookup")',
                    data: { inputDto: data },
                    success: function (responce) {
                        if ((responce) && (responce.PostStatus)) {
                            ShowSuccessMessage(responce.PostMessage);
                            refreshGrid();
                        } else {
                            ShowErrorMessage(responce.PostMessage);
                        }
                    }
                })
            } else { return false; }
        });
    });

    //Grid edit event
    function editOil(arg) {
        $(".validation-error-label").remove();
        var dataItem = $("#IngredientGrid").getKendoGrid().dataItem($(arg).closest("tr"));

        //Set the values to control
        $("#txtId").val(dataItem.Id);
        $("#txtName").val(dataItem.Name);
        $("#cbActiveInactive").prop("checked", dataItem.IsActive);
        $("#addVerticalPopoup").modal('show');
    }

    //clear all form data
    function clear() {
        $("#txtId").val('');
        $("#txtName").val('');
        $("#cbActiveInactive").prop("checked", false);
    }

    //Refresh the grid
    function refreshGrid() {
        var orderGrid = $("#IngredientGrid").data("kendoGrid");
        orderGrid.dataSource.read();
    }

    //Method to data bound event for owner
    function onVerticleDataBound(e) {
        SetEmptyRow(e);
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();

    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>







