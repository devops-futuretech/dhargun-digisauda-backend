@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model MaterialTypeDto
@{
    ViewBag.Title = "masterMaterialType";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="masterMaterialType" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Material Type</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li><a href="MaterialTypeList">Material Type List</a><span class="icon-right"></span></li>
        <li class="active">Material Type<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;" id="divLoader">
            <div class="row" id="dvMaterialType">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddorUpdateMaterialType", "Lookup", FormMethod.Post, new { id = "frmMaterialType", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(s => s.Id, new { id = "id" })


                        <div class="row form-group">

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">@Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span></label>
                                    @(Html.Kendo().DropDownListFor(m => m.SalesOrganizationId)
                                    .Name("ddlSalesOrganization")
                                    .OptionLabel(@Helper.GetResourceString("plho-SelectSales"))
                                    .DataTextField("SalesOrganizationName")
                                    .Events(e => e.Change("onSaleChange"))
                                    .DataValueField("Id")
                                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                                    ).HtmlAttributes(new { tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                                    )
                                </div>
                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">@Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span></label>

                                    @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
                                    .Name("ddlDistributionChannel")
                                    .OptionLabel(@Helper.GetResourceString("plho-SelectDistChannel"))
                                    .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                                    .DataTextField("DistributionChannelName")
                                    .DataValueField("Id")
                                    .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                                    .ServerFiltering(true))
                                    .HtmlAttributes(new { @class = "", tabindex = "2", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                                </div>

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">  @Helper.GetResourceString("lbl_Vertical") <span class="text-danger">*</span> </label>
                                    @(Html.Kendo().DropDownListFor(m => m.VerticalId)
                           .Name("ddlVertical")
                          .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                          .DataTextField("Name")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_VerticleType"), @style = "width:100%" }))
                                </div>

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">@Helper.GetResourceString("lbl_MaterialType") <span class="text-danger">*</span> </label>
                                @Html.TextBoxFor(m => m.MaterialType, new { id = "txtMaterialType", tabindex = "2", @class = "form-control ", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Vertical"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                            </div>

                        </div>

                        <div class="row form-group">

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">Status</label>
                                <div class="custom_checkbox_main">
                                    <label class="custom_checkbox">
                                        @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActive", tabindex = "3", })                                        <span class="checkmark check_tick"></span>
                                        <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-12 text-right buttons-align">

                                <button type="button" tabindex="7" id="btnCancel" onclick="location.href = '@Url.Action("MaterialTypeList", "Lookup")'" class="k-button k-cancel custom-btns" >@Helper.GetResourceString("btn_Cancel")</button>
                                <button type="button" tabindex="6" id="btnsave" class="k-primary k-button custom-btns">
                                    @if (Model.Id > 0)
                                    {@Helper.GetResourceString("btn_Update")}
                                else
                                { @Helper.GetResourceString("lbl_Save") }
                                </button>


</div>

</div>
                    }

                </div>
            </div>


        </div>
    </div>
</div>


<script>

    $(document).ready(function () {


        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        if (('@Model.Id' > 0)) {
            $("#ddlVertical").data("kendoDropDownList").readonly();
        }

        $("#btnsave").click(function () {
            addMaterialtoDatabase();
            //$('#frmMaterialType').submit();
            console.log("Hi");
        });
    });

    //function formSubmit() {
    //    $('#frmMaterialType').submit();
    //}


    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();

    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }
    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

    function addMaterialtoDatabase() {
        //$('#frmMaterialType')
        var isValidForm = $("#frmMaterialType").valid();
        if (isValidForm) {
            window.kendo.ui.progress($("#frmMaterialType"), true);
            var inputdata = {
                VerticalId: $("#ddlVertical").val(),
                SalesOrganizationId: $("#ddlSalesOrganization").val(),
                DistributionChannelId: $("#ddlDistributionChannel").val(),
                MaterialType: $("#txtMaterialType").val(),
                IsActive: $("#cbActive").val(),
            };
            console.log(inputdata);
            $.ajax(
                    {
                    url: "/Lookup/AddorUpdateMaterialType",
                        type: 'POST',
                    data: {
                        Id: $("#id").val(),
                        VerticalId: $("#ddlVertical").val(),
                        SalesOrganizationId: $("#ddlSalesOrganization").val(),
                        DistributionChannelId: $("#ddlDistributionChannel").val(),
                        MaterialType: $("#txtMaterialType").val(),
                        IsActive: $("#cbActive").val(),
                    },
                        success: function (data) {
                            if (data.PostStatus) {
                                    var url = '@Url.Action("MaterialTypeList", "Lookup")';
					                window.location.href = url;
                                ShowSuccessMessage('@Helper.GetResourceString("msg_SaveSuccess")');
                            }
                            else {
                                if (data.Message != "")
                                    ShowErrorMessage(data.PostMessage);
                                else
                                    ShowErrorMessage('@Helper.GetResourceString("msg_SaveError")');
                            }
                            window.kendo.ui.progress($("#frmMaterialType"), false);
                        }
                    });
        }
    }
</script>



