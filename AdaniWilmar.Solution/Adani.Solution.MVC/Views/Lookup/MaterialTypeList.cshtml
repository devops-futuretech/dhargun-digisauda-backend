@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@{
    ViewBag.Title = "MaterialTypeList";
}


<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="masterMaterialType" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Material Type List</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li class="active">Material Type List<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">
            <a href="@Url.Action("MaterialTypeEditRedirect","Lookup")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;Add New Material Type</a>
        </div>
    </div>*@
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        @*<div class="panel-heading">
        </div>*@
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvDealers">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick='excelExport()' type="button">Excel</span>
                            </div>
                        </div>

                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))

                        <div class="period-wrapper">
                            <a href="@Url.Action("MaterialTypeEditRedirect","Lookup")" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;Add New Material Type</a>
                        </div>

                    </div>

                    @(Html.Kendo().Grid<MaterialTypesGridDataDto>().Name("ViewMaterialTypeList")
                              .Columns(columns =>
                              {
                                  columns.Bound(c => c.MaterialType).ClientTemplate(@"<div> <a style='text-decoration: underline;' href='" + Url.Action("MaterialTypeEditRedirect", "Lookup", new { materialTypeId = "#=Id#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=MaterialType#</a> </div>").Title(@Helper.GetResourceString("lbl_MaterialType")).Width(Settings.GridColumnMaxWidth);
                                  columns.Bound(c => c.Id).Visible(false);
                                  columns.Bound(c => c.SalesOrganizationName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_SalesOrganization")).Width(Settings.GridColumnMaxWidth);
                                  columns.Bound(c => c.DistributionChannelName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_DistributionChannel")).Width(Settings.GridColumnMaxWidth);
                                  columns.Bound(c => c.VerticalName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Vertical")).Width(Settings.GridColumnMaxWidth);
                                  
                                  columns.Bound(c => c.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'>#if(IsActive){#<i class='icon-checkbox-checked2 faicon-green'></i>#}else{#<i class='icon-cancel-square2 faicon-red'></i>#}#</div>").Width(Settings.GridColumnMaxWidth);
                              })
            .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
        .Filterable(filter => filter.Mode(GridFilterMode.Row))
        .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
        .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
        .Resizable(resize => resize.Columns(true))
        .Selectable(selectable => selectable
            .Mode(GridSelectionMode.Multiple)
        .Type(GridSelectionType.Row))
        .Scrollable(s => s.Enabled(true).Height("auto"))

        .Reorderable(reorder => reorder.Columns(true))
        .DataSource(dataSource => dataSource
        .Ajax()
        .Read(read => read.Action("GetMaterialTypeList", "Lookup"))

        .ServerOperation(false)))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();

         if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
		}
    });

    function excelExport() {
        window.kendo.ui.progress($("#div_Progress"), true);
        var data = { IsToReturnInactiveData: true };
        $.ajax({
            type: 'Post',
            url: '@Url.Action("ExportMaterialType", "Lookup")',
            data: { inputDto: data },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

</script>



