<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <p class="content-group-lg"></p>
            @using (Html.BeginForm("Notification", "Lookup", FormMethod.Post, new { id = "frmNotification", @class = "form-validate-jquery" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.EncryptedId, new { id = "hdntpNotificationId" })
                @Html.HiddenFor(m => m.LoginUserId, new { id = "hdnLoginUserId" })
                <input type="hidden" name="NotificationDetailDtoList" value="" id="NotificationDetailDtoList" />
                <fieldset class="content-group">

                    <div class="row form-group">
                        <div class="col-lg-3 col-sm-6 mb-3">
