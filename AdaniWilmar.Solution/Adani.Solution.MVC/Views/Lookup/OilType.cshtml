@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Common
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO

@{
    ViewBag.Title = "OilType";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="masterOilType" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_OilType")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_OilType")<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
            <div class="period-wrapper">
                @if (Helper.CheckClaims(Claims.ManageMaster) && !ConfigHelper.IsSapDataUpdate)
                {
                    <a id="btnAddOilType" href="#" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("lbl_AddOilType")</a>
                }
            </div>
        </div>*@
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        @*<div class="panel-heading">
        </div>*@
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvDealers">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">

                                <span class="export-link" onclick='excelExport()' type="button">Excel</span>
                            </div>
                        </div>

                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("GridOilType")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>*@&ensp;
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))

                    <div class="period-wrapper">
                        @if (Helper.CheckClaims(Claims.ManageMaster) && !ConfigHelper.IsSapDataUpdate)
                        {
                            @*<a id="btnAddOilType" href="#" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;@Helper.GetResourceString("lbl_AddOilType")</a>*@
                            <a href="@Url.Action("OTERedirect","Lookup")" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;Add New Oil Type</a>
                        }
                    </div>

                    </div>

                    @(Html.Kendo().Grid<OilTypeDto>()
                          .Name("GridOilType")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.VerticalId).Visible(false);
                              columns.Bound(c => c.Name).ClientTemplate(@"<div> <a style='text-decoration: underline;' href='" + Url.Action("OTERedirect", "Lookup", new { EncryptedId = "#=EncryptedId#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=Name#</a> </div>").Title(@Helper.GetResourceString("lbl_Name")).Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.Id).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Id").Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.Name).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Name")).Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.Code).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("OilType Code").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.SalesOrganizationName).HtmlAttributes(new { @title = "#=SalesOrganizationName#" }).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Sales Organisation").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.DistributionChannelName).HtmlAttributes(new { @title = "#=DistributionChannelName#" }).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Distribution Channel").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.VerticalName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Division Name").Width(Settings.GridColumnMaxWidth);
                             // columns.Bound(c => c.LitreConversion).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_LitreConversion")).Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.IsRasoi).HeaderTemplate("").Title("Is Rasoi").ClientTemplate(@"<div style='text-align: center;'>#if(IsRasoi){#<i class='icon-checkbox-checked2 faicon-green'></i>#}else{#<i class='icon-cancel-square2 faicon-red'></i>#}#</div>").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'>#if(IsActive){#<i class='icon-green_ckbox_tick faicon-green'><span class='path1'></span><span class='path2'></span></i>#}else{#<i class='icon-red_ckbox_tick faicon-red'><span class='path1'></span><span class='path2'></span></i>#}#</div>").Width(Settings.GridColumnMaxWidth);
                              //columns.Template(t => t.Name).Title(@Helper.GetResourceString("lbl_Edit")).ClientTemplate(@"<div style='text-align: center;'>
                              //                                  <i onclick='editOil(this)' class='icon-edit pointer' ></i></div>").Title(@Helper.GetResourceString("lbl_Edit")).Width(Settings.GridButtonColumnWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Resizable(resize => resize.Columns(true))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Excel(excel => excel.AllPages(true).FileName(@Helper.GetResourceString("lbl_OilType") + " " + DateTime.Now + ".xlsx").Filterable(true))
                          .Events(events => events.DataBound("onOiltypeDataBound"))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Sort(sort => sort.Add("Id").Ascending())
                          .Model(model => { model.Id(p => p.Id); })
                          .ServerOperation(true)
                          .Read(read => read.Action("GetOilTypeListAsync", "Lookup"))))
                </div>
            </div>
        </div>
    </div>
    
</div>


<script>

    $(document).ready(function () {

        sapDataReadOnly();             //Sap data readonly

        // kendo grid filter contains
        FilterContains();
        // clears invisible value

    });

    //Dropdown change event
    function typeChange() {
        refreshGrid();
    }

   

    //Refresh the grid
    function refreshGrid() {
        var orderGrid = $("#GridOilType").data("kendoGrid");
        orderGrid.dataSource.read();
    }

    //Method to data bound event for owner
    function onOiltypeDataBound(e) {
        SetEmptyRow(e);
    }

    function sapDataReadOnly() {
        if ('@ConfigHelper.IsSapDataUpdate' == "True") {
            $("#ddVerticalType").data("kendoDropDownList").readonly();
            $("#txtName").prop('readonly', true);
        }
    }

    function excelExport() {
        window.kendo.ui.progress($("#div_Progress"), true);
        var data = { IsToReturnInactiveData: true };
        $.ajax({
            type: 'Post',
            url: '@Url.Action("ExportOilType", "Lookup")',
            data: { inputDto: data },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }


</script>





