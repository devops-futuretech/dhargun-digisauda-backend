                            <label class="custom_label"> @Helper.GetResourceString("lbl_Pincode")  </label>
                            @Html.TextBoxFor(m => m.PinCode, new { id = "txtPinCode", tabindex = "9", @class = "form-control",  @onkeypress = "return isNumber(event);", data_msg_required = Helper.GetMsgRequired("lbl_Pincode"), @minlength = (int)InputMaxLength.Pincode, @maxlength = (int)InputMaxLength.Pincode })
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_Address")  </label>
                            @Html.TextAreaFor(m => m.Location, new { id = "txtPlantLocation", tabindex = "10", @class = "form-control",  data_msg_required = Helper.GetMsgRequired("lbl_Location"), @maxlength = (int)InputMaxLength.TextAreaString })
                        </div>

                        @*<div class="col-lg-3 col-sm-6 mb-3">
            <label class="custom_label"> @Helper.GetResourceString("lbl_Usage") </label>
            @Html.TextBoxFor(m => m.Usage, new { id = "txtUsage", tabindex = "11", @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>*@

                        <div class="col-lg-3 col-sm-6 mb-3">

                            <label class="custom_label">Status</label>
                            <div class="custom_checkbox_main">
                                <label class="custom_checkbox">
                                    @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "12", })
                                    <span class="checkmark check_tick"></span>
                                    <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                </label>
                            </div>

                        </div>

                    </div>


                        <div class="row form-group">
                            <div class="col-md-12 text-right buttons-align">
                                <button type="button" id="btnCancel" tabindex="13" onclick="location.href = '@Url.Action("PlantMasterList", "Lookup")'" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.ManageMaster))
                                {
                                    <button type="button" tabindex="30" id="btnSave" class="k-primary k-button custom-btns">@( Model.Id == 0 ? "Save" : "Update")</button>
                                }
                            </div>
                        </div>
                    }
                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        if ('@Model.Id' > 0)
        {
            $('#txtPlantCode').attr('readonly', 'true');
        }

        $("#btnSave").click(function () {
            var isValidForm = $("#frmPlantMaster").valid();
         
            if (isValidForm) {
                window.kendo.ui.progress($("#PlantMasterLoader"), true);
                $("#frmPlantMaster").submit();
                window.kendo.ui.progress($("#PlantMasterLoader"), false);
            }
        });

    });

    function ClearAddressFields() {
        $("#txtCity").val('');
        $("#hdnCityId").val('');
        $("#txtDistrict").val('');
        $("#hdnDistrictId").val('');
        $("#txtState").val('');
        $("#hdnStateId").val('');
    }

    //State
    function onStateChange(e) {
        $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
    }

    function OnStateDataBound(e) {
        var stateId = $("#ddlState").data("kendoDropDownList").value();
        if (stateId > 0) {
            $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
        }
    }

    //Territory
    function territoryAdditionalInfo() {
        return {
            stateId: Number($("#ddlState").val())
        }
    }

    function territoryChange() {
        $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
    }

    function OnTerritoryDataBound() {
        var territoryId = Number($("#ddlTerritory").val());
        if (territoryId > 0) {
            $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
        }
    }

    //District
    function onDistrictChange(e) {
        $("#ddlCity").data("kendoDropDownList").dataSource.read();
    }

    function OnDistrictDataBound(e) {
        var districtId = $("#ddlDistrict").data("kendoDropDownList").value();
        if (districtId > 0) {
            $("#ddlCity").data("kendoDropDownList").dataSource.read();
        }
    }

    function additionalDistrictByStateInfo() {
        return {
            territoryId: Number($("#ddlState").val())
        };
    }

    //City
    function additionalCityByDistrictInfo() {
        var districtId = $("#ddlDistrict").data("kendoDropDownList").value();
        return {
            districtId: districtId
        };
    }

    //Zone
    function onZoneChange() {
        $("#ddlState").data("kendoDropDownList").dataSource.read();
    }

    function stateLoadParam() {
        var zoneId = $("#ddlZone").data("kendoDropDownList").value();
        return {
            zoneId: zoneId
        };
    }

</script>
