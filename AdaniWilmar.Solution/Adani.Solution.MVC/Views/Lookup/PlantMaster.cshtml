@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@model Adani.Solution.DTO.DepotDto

@{
    ViewBag.Title = "PlantMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="masterPlantMaster" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_AddOrUpdatePlantMaster")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li><a href="PlantMasterList"> Plant Details </a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_AddOrUpdatePlantMaster")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="PlantMasterLoader">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddOrUpdatePlant", "Lookup", FormMethod.Post, new { id = "frmPlantMaster", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.EncryptedId, new { id = "Id" })

                    <div class="row form-group">

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_PlantCode") <span class="text-danger">*</span> </label>
                            @Html.TextBoxFor(m => m.Code, new { @id = "txtPlantCode", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_PlantCode"), @maxlength = (int)InputMaxLength.String })
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_PlantName") <span class="text-danger">*</span> </label>
                            @Html.TextBoxFor(m => m.Name, new { id = "txtPlantName", tabindex = "2", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_PlantName"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_EmailId") </label>
                            @Html.TextBoxFor(m => m.Email, new { id = "txtEmail", tabindex = "3",/* data_msg_required = Helper.GetMsgRequired("lbl_Email"), */ @class = "form-control", @maxlength = (int)InputMaxLength.String })
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">  @Helper.GetResourceString("lbl_MobileNumber") </label>
                            @Html.TextBoxFor(m => m.MobileNumber, new { id = "txtMobileNumber", tabindex = "3", @class = "form-control", @onkeypress = "return isNumber(event);", data_msg_required = Helper.GetMsgRequired("lbl_MobileNumber"), @maxlength = (int)InputMaxLength.MobileNumber })
                        </div>

                        

                    </div>

                    @*<div class="row form-group">*@
                        @*<div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_Zone") <span class="text-danger">*</span> </label>
