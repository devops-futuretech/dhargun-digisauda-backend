                        </div>*@

                        @*<div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_Territory") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().DropDownListFor(m => m.TerritoryId)
