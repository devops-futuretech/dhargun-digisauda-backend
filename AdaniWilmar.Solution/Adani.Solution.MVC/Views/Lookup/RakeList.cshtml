@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Common
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO

@{
    ViewBag.Title = "RakeList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="masterRake" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_RakeList")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_RakeList")<span class="icon-right"></span></li>
    </ol>

    @*<div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">
            @if (Helper.CheckClaims(Claims.ManageMaster))
            {
                <a href="@Url.Action("RakeEditRedirect", "Lookup")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateRake")</a>
            }
        </div>
    </div>*@
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        @*<div class="panel-heading">
        </div>*@
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvDealers">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick='excelExport()' type="button">Excel</span>
                            </div>
                        </div>

                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("RakeList")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>*@&ensp;

                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))

                        <div class="period-wrapper">
                            @if (Helper.CheckClaims(Claims.ManageMaster))
                            {
                                <a href="@Url.Action("RakeEditRedirect", "Lookup")" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateRake")</a>
                            }
                        </div>

                    </div>
                    @(Html.Kendo().Grid<RakeDto>()
                       .Name("RakeList")
                       .Columns(columns =>
                       {
                           columns.Bound(c => c.Id).Visible(false);
                           columns.Bound(c => c.Code).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_RakeCode")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.Name).ClientTemplate(@"<div> <a style='text-decoration: underline;' href='" + Url.Action("RakeEditRedirect", "Lookup", new { rakeId = "#=Id#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=Name#</a> </div>").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_RakeName")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.Location).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Address")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.ZoneName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(Helper.GetResourceString("lbl_Zone")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.State).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(Helper.GetResourceString("lbl_State")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.TerritoryName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(Helper.GetResourceString("lbl_Territory")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.District).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(Helper.GetResourceString("lbl_District")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.City).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(Helper.GetResourceString("lbl_City")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.Email).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Email")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.PinCode).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Pincode")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.DepotName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Depot")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.AssociatedPlantCodes).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_AssociatedPlant")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.AssociatedStates).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_AssociatedState")).Width(Settings.GridColumnMaxWidth);
                           columns.Bound(c => c.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'>#if(IsActive){#<i class='icon-green_ckbox_tick faicon-green'><span class='path1'></span><span class='path2'></span></i>#}else{#<i class='icon-red_ckbox_tick faicon-red'><span class='path1'></span><span class='path2'></span></i>#}#</div>").Width(Settings.GridColumnMaxWidth);
                       })
                       .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                       .Filterable(filter => filter.Mode(GridFilterMode.Row))
                       .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                       .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                       .Scrollable(s => s.Enabled(true).Height("auto"))
                       .Resizable(resize => resize.Columns(true))
                       .Reorderable(reorder => reorder.Columns(true))
                       .Excel(excel => excel.AllPages(true).FileName(@Helper.GetResourceString("lbl_RakeDetails") + " " + DateTime.Now + ".xlsx").Filterable(true))
                       .Events(events => events.DataBound("onRakeListDataBound"))
                       .DataSource(dataSource => dataSource
                       .Ajax()
                       //.Sort(sort => sort.Add("Id").Ascending())
                       .Model(model => { model.Id(p => p.Id); })
                       .ServerOperation(true)
                       .Read(read => read.Action("GetRakeListAsync", "Lookup", new { IsToReturnInactiveData = true }))))
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        // kendo grid filter contains
        FilterContains();

        if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
        }

    });

    //Method to data bound event for owner
    function onRakeListDataBound(e) {
        SetEmptyRow(e);
    }

    function excelExport() {
        window.kendo.ui.progress($("#div_Progress"), true);       
        var data = { IsToReturnInactiveData: true };
        $.ajax({
            type: 'Post',
            url: '@Url.Action("ExportRake", "Lookup")',
            data: { inputDto: data },
            success: function (responce) {               
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });        
    }

</script>


