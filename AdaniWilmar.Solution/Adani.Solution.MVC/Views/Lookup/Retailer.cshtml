<script>
    $(document).ready(function ()
    {
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        if ('@Model.Id' > 0)
        {
            $('#txtCode').attr('readonly', 'true');
        }

        $('input[type="text"]').keypress(function (e) {
            var code = e.keyCode || e.which;
            if (code === 13) {
                e.preventDefault();
            }
        });

        $('#btnSave').on('click', function (e)
        {
            var isValid = $('#frmRetailer').valid();
            if (isValid)
            {
                window.kendo.ui.progress($("#dvRetailer"), true);
                $('#frmRetailer').submit();
                window.kendo.ui.progress($("#dvRetailer"), false);
            }
        });
    });

    function ImportPincodeOnFocusOut(event) {
        var error = $("#txtPincode-error").text();
        var pincodeValue = $("#" + event.currentTarget.id).val();
        if (pincodeValue!=="" && error === "") {

            var pincodeFlag = PincodeValidation(pincodeValue, '@Helper.GetResourceString("msg_PincodeError")');

            if (pincodeFlag) {
                GetAddressByPincode(pincodeValue);
            }
        }
    }

    function GetAddressByPincode(pincode)
    {
        window.kendo.ui.progress($("#dvRetailer"), true);
        if (pincode !== "") {
            moduleCommon.Common.AjaxCall({
                type: 'Post',
                url: "@Url.Action("GetAddressByPincode", "Lookup")",
                data: {
                    pincode: pincode
                },
                success: function (result) {
                    if (result !== null && result.PostStatus) {
                        $("#txtDistrict").val(result.DistrictName);
                        $("#hdnDistrictId").val(result.DistrictId);
                        $("#txtState").val(result.StateName);
                        window.kendo.ui.progress($("#dvRetailer"), false);
                    }
                    else {
                        if (result.PostStatusMessage !== "")
                            ShowErrorMessage(result.PostStatusMessage);
                        else
                            ShowErrorMessage('@Helper.GetResourceString("msg_PincodeError")');

                        ClearAddressFields();
                        $(window).scrollTop(0);
                        window.kendo.ui.progress($("#dvRetailer"), false);
                    }
                },
                error: function (result) {
                    ShowErrorMessage('@Helper.GetResourceString("msg_PincodeError")');
                    ClearAddressFields();
                    $(window).scrollTop(0);
                    window.kendo.ui.progress($("#dvRetailer"), false);
                }
            });
        }
        window.kendo.ui.progress($("#dvRetailer"), false);
    }

    function ClearAddressFields() {
        $("#txtCity").val("");
        $("#hdnCityId").val("");
        $("#txtDistrict").val("");
        $("#hdnDistrictId").val("");
    }

    //State
    function onStateChange(e) {
        $("#ddlTerritory").data("kendoDropDownList").dataSource.read();
        $("#ddlFreightZone").data("kendoDropDownList").dataSource.read();
    }

    function OnStateDataBound(e) {
        var stateId = $("#ddlState").data("kendoDropDownList").value();
        if (stateId > 0) {
            $("#ddlTerritory").data("kendoDropDownList").dataSource.read();
            $("#ddlFreightZone").data("kendoDropDownList").dataSource.read();
        }
    }

    //Territory
    function territoryAdditionalInfo() {
        return {
            stateId: Number($("#ddlState").val())
        }
    }

    function territoryChange() {
        $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
    }

    function OnTerritoryDataBound() {
        var territoryId = Number($("#ddlTerritory").val());
        if (territoryId > 0) {
            $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
        }
    }

    //District
    function onDistrictChange(e) {
        $("#ddlCity").data("kendoDropDownList").dataSource.read();
    }

    function OnDistrictDataBound(e) {
        var districtId = $("#ddlDistrict").data("kendoDropDownList").value();
        if (districtId > 0) {
            $("#ddlCity").data("kendoDropDownList").dataSource.read();
        }
    }

    function additionalDistrictByStateInfo() {
        return {
            territoryId: Number($("#ddlTerritory").val())
        };
    }

    //City
    function additionalCityByDistrictInfo() {
        var districtId = $("#ddlDistrict").data("kendoDropDownList").value();
        return {
            districtId: districtId
        };
    }


    //Freight
    function onFreightZoneChange() {
        $("#ddlFreightRoute").data("kendoDropDownList").dataSource.read();
        $("#ddlDealer").data("kendoDropDownList").dataSource.read();
    }

    function onFreightRouteChange() {
         $("#ddlDealer").data("kendoDropDownList").dataSource.read();
    }

    function freightZoneAdditionalInfo() {
        var ddlZone = $("#ddlZone").data("kendoDropDownList").value();
        var ddlState = $("#ddlState").data("kendoDropDownList").value();
        return {
            zoneId: Number(ddlZone),
            stateId: Number(ddlState)
        };
    }

    function freightRouteAdditionalInfo() {
        var ddlFreightZone = $("#ddlFreightZone").data("kendoDropDownList").value();
        return {
            zoneId: Number(ddlFreightZone)
        };
    }


    function DealerAdditionalInfo()
    {
        var ddlFreightZone = $("#ddlFreightZone").data("kendoDropDownList").value();
        var ddlFreightRoute = $("#ddlFreightRoute").data("kendoDropDownList").value();
        return {
            freightzoneId: Number(ddlFreightZone),
            freightrouteId: Number(ddlFreightRoute)
        };
    }

    //Zone
    function onZoneChange() {
        $("#ddlState").data("kendoDropDownList").dataSource.read();
    }

    //State load param
    function stateLoadParam() {
        var zoneId = $("#ddlZone").data("kendoDropDownList").value();
        return {
            zoneId: zoneId
        }
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddVerticalType").data("kendoDropDownList").dataSource.read();

    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddVerticalType").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>



