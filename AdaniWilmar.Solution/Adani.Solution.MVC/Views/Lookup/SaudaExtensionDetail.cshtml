@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model RoleIdDto
@{
    ViewBag.Title = "Sauda Extension Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="transactionSaudaExtension" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title"> @Helper.GetResourceString("lbl_SaudaExtensionDetail")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Transaction</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_SaudaExtensionDetail")<span class="icon-right"></span></li>
    </ol>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="FilterOption">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_FromDate") </label>
                        @(Html.Kendo().DatePicker().Name("FromDate")
                          .Format(Settings.DateFormat)
                          .Events(e => e.Change("fromChange"))
                          .HtmlAttributes(new { id = "dpFromDate", onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_ToDate") </label>
                        @(Html.Kendo().DatePicker().Name("ToDate")
                          .Format(Settings.DateFormat)
                          .HtmlAttributes(new { id = "dpToDate", onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_Status") </label>
                        @(Html.Kendo().DropDownList()
                                  .Name("Status")
                                  .OptionLabel(@Helper.GetResourceString("plho_SelectStatus"))
                                  .DataTextField("Name")
                                  .DataValueField("Id")
                                  .Events(e => e.Change("statusChanged"))
                                  .DataSource(source => source.Read(resd => resd.Action("GetPendingApprovedStatusddl", "Lookup"))
                                  .ServerFiltering(false))
                                  .HtmlAttributes(new { id = "ddlStatus", @class = "form-control", tabindex = "3", @style = "width:100%" }))
                        <label id="lblStatus" class="field-validation-error" style="display: none;">@Helper.GetSelectMsgRequired("lbl_Status")</label>
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                    </div>
                </div>

                <div class="row form-group">

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                        @if (Model.RoleId == (long)Role.Admin || Model.RoleId == (long)Role.SubAdmin)
                        {
                            // <div class="col-md-3">
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                            // </div>
                        }
                        else
                        {
                            //<div class="col-md-3">
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .Value(Model.VerticalId.ToString())
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%", @readonly = "readonly" }))
                            // </div>
                        }
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-12 text-right">
                        <button type="button" tabindex="4" onclick="SaudaConvertionSearch()" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Search")</button>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="text-right right-buttons">
                            <div class="export_as">
                                <span>Export as</span>
                                <div class="export-btns">
                                    <span class="export-link" onclick='excelExport()' type="button">Excel</span>
                                </div>
                            </div>
                            @*<button class="k-button k-button-icontext k-grid-excel" onclick='excelExport()' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                            @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        </div>
                        @(Html.Kendo().Grid<Adani.Solution.DTO.SaudaBookedSaudaWithExtensionDetailsExportDto>()
                          .Name("ViewSaudaExtensionDetail")
                          .Columns(columns =>
                          {
                          //columns.Bound(c => c.SaudaOrderId).Visible(false);
                          //columns.Bound(c => c.PendingContractId).Visible(false);
                          columns.Bound(c => c.IsApproval).Visible(false);
                          columns.Bound(c => c.SaudaExtensionUpdateFromSap).Visible(false);
                          columns.Bound(c => c.Id).Visible(false);
                          columns.Template(@<text></text>).ClientTemplate(
                                        "# if((SaudaExtensionUpdateFromSap && !IsApproval) || (!SaudaExtensionUpdateFromSap && SAPRemarks != null && SAPRemarks != '') )" +
                                        "{#" +
                                        "<input type='checkbox' class='chkbxAllPaymentReceived'  value=#=Id# onclick=\"findCheckedItemsSaveItToHidden(this,'#=Id#','hdSelectedIds','masterCBAllPaymentReceived','chkbxAllPaymentReceived','lblPaymentReceivedSelectedCount');\"/>" +
                                        "#}#"
                                        )
                                    .HeaderTemplate("<div class='text-center'><input type='checkbox' id='masterCBAllPaymentReceived' onclick=\"masterfindCheckedItemsSaveItToHidden(this,'hdSelectedIds','chkbxAllPaymentReceived','lblPaymentReceivedSelectedCount')\"/></div>").Width(Settings.GridFilterColumnWidth);
                              columns.Bound(c => c.ZonalTrader).Title(@Helper.GetResourceString("lbl_ZonalHead")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.StateTrader).Title(@Helper.GetResourceString("lbl_BDOName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Dealer).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_DealerName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.SaudaNumber).Title(@Helper.GetResourceString("lbl_SaudaNumber")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ValidFrom).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_ValidFrom")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ValidTo).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_ValidTo")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.BookedSku).Title(@Helper.GetResourceString("lbl_BookedSku")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.SaudaQuantityMT).Format("{0:0.000}").Title(@Helper.GetResourceString("lbl_SaudaQuantityMT")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.SaudaQuantityCase).Format("{0:0.00}").Title(@Helper.GetResourceString("lbl_SaudaQuantityCase")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.PendingQuantityMT).Format("{0:0.000}").Title(@Helper.GetResourceString("lbl_PendingQuantityMT")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.PendingQuantityCase).Format("{0:0.00}").Title(@Helper.GetResourceString("lbl_PendingQuantityCase")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ExtendedDays).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_ExtensionDays")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ExtendedDate).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_ExtendedToDate")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.BaseRate).Title(@Helper.GetResourceString("lbl_BaseRate")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Remarks).Title(@Helper.GetResourceString("lbl_Remarks")).HeaderHtmlAttributes(new { style = "text-align:center" }).HtmlAttributes(new { title = "#= Remarks #" }).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.SAPRemarks).Title(@Helper.GetResourceString("lbl_SapRemarks")).HeaderHtmlAttributes(new { style = "text-align:center" }).HtmlAttributes(new { title = "#= SAPRemarks #" }).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Selectable(selectable => selectable
                          .Mode(GridSelectionMode.Multiple)
                          .Type(GridSelectionType.Row))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          //.Events(events => events.DataBound("onBrokerListDataBound"))
                          .Reorderable(reorder => reorder.Columns(true))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          //.Model(model => model.Id(m => m.SaudaOrderId))
                          .ServerOperation(true)
                          .Read(read => read.Action("GetSaudaExtensionDetailList", "Lookup").Data("additionalInfo"))))
                    </div>
                </div>
            </div>
        </div>
        <div class="row form-group">
            <div class="col-lg-12">
                <div class="text-right">
                    <button type="button" tabindex="12" id="btnReprocessed" class='k-primary k-button custom-btns'>Reprocessed</button>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("hdSelectedIds")
<script>
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();

        StartDateRange();

         $("#btnReprocessed").click(function (e) {

            var selectedOrders = [];

             var gridData = $("#ViewSaudaExtensionDetail").data("kendoGrid").dataSource.data();

            if (gridData.length === 0) {
                ShowErrorMessage("Please select any record");
                return false;
            }

            if ($("#hdSelectedIds").val()) {
                selectedOrders = $("#hdSelectedIds").val().split(",");
            }

            if (!(selectedOrders.length > 0)) {
                ShowErrorMessage("Please select any record");
                return false;
            }

            var model = {
               SaudaExtensionIds: selectedOrders
            };

            window.kendo.ui.progress($("#pageLoader"), true);
             moduleCommon.Common.AjaxCall({
                 url: '@Url.Action("ReprocessSaudaExtension", "ReverseAuction")',
                 type: 'POST',
                 data: { saudaExtensionUpdateDto: model },
                 success: function(result) {
                     if (result.PostStatus) {
                         ShowSuccessMessage(result.PostMessage);
                         setTimeout(function () { window.location.href = '@Url.Action("SaudaExtensionDetail", "Lookup")'; }, 1500);
                     } else {
                         ShowErrorMessage(result.PostMessage);
                     }
                     window.kendo.ui.progress($("#pageLoader"), false);
                 }
            });
        });

    });

    function SaudaConvertionSearch() {
        var StatusId = 0;
        if ($("#ddlStatus").val() != "") {
            StatusId = $("#ddlStatus").val();
        }
        else {
            ShowErrorMessage("@Helper.GetResourceString("plho_SelectStatus")");
            return false;
        }
        $("#ViewSaudaExtensionDetail").data("kendoGrid").dataSource.read();

    }
    function additionalInfo() {

        var statusId = Number($("#ddlStatus").val());
        var verticalId = 0;
        if ($("#ddlVertical").val() != "") {
            verticalId = $("#ddlVertical").val();
        }
        return {
            ValidFrom: $("#dpFromDate").val(),
            ValidTo: $("#dpToDate").val(),
            statusId: statusId,
            verticalId: verticalId
        };
    }
    function fromChange() {

        var endPicker = $("#dpToDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#dpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }
    }
    function StartDateRange() {

        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#dpFromDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
        $("#dpToDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        var endPicker = $("#dpToDate").data("kendoDatePicker");
        endPicker.min(dates);

    }
    function statusChanged() {
        var statusId = Number($("#ddlStatus").val());
    }

     function excelExport() {
         window.kendo.ui.progress($("#div_Progress"), true);
         var verticalId = 0;
         if ($("#ddlVertical").val() != "") {
             verticalId = $("#ddlVertical").val();
         }
         var data = {
             ValidFrom: $("#dpFromDate").val(), // $("#dpFromDate").data("kendoDatePicker").value().toDateString(),
             ValidTo: $("#dpToDate").val(), // $("#dpToDate").data("kendoDatePicker").value().toDateString(),
             statusId: Number($("#ddlStatus").val()),
             verticalId: verticalId
         };
        $.ajax({
            type: 'Post',
            url: '@Url.Action("ExportSaudaExtension", "Lookup")',
            data: { inputDto: data },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>
