@Html.Hidden("hdSelectedIds")

<script>

    var arrSaudaData = {};

    $(document).ready(function () {
    $('[data-toggle="tooltip"]').tooltip();

    if ('@TempData["SuccessMessage"]'.length) {
		ShowSuccessMessage('@TempData["SuccessMessage"]');
    }
    if ('@TempData["ErrorMessage"]'.length) {
        ShowErrorMessage('@TempData["ErrorMessage"]');
    }
    setFromToDateRange("dpFromDate", "dpToDate", emamiGlobal.constant.IndentDateRange);

    $("#btnApproved").val(emamiGlobal.Status.Approved);
    $("#btnRejected").val(emamiGlobal.Status.Rejected);
    $("#btnPending").val(emamiGlobal.Status.Pending);

    $("#btnApproved,#btnRejected,#btnPending").attr("disabled", true);

    $("#btnApproved,#btnRejected,#btnPending").click(function (e) {

        var selectedOrders = [];
        var form = $('#frmSaudaModificationDetails');
        var token = $('input[name="__RequestVerificationToken"]', form).val();
        var gridData = $("#ViewSaudaModificationList").data("kendoGrid").dataSource.data();
        var statusId = parseInt($(this).val());

        if (gridData.length === 0) {
            ShowErrorMessage("Please select any record");
            return false;
        }

        if ($("#hdSelectedIds").val()) {
            selectedOrders = $("#hdSelectedIds").val().split(",");
        }

        if (!(selectedOrders.length > 0)) {
            ShowErrorMessage("Please select any record");
            return false;
        }

        if ((statusId == emamiGlobal.Status.Rejected || statusId == emamiGlobal.Status.Hold) && !$("#txtRemarks").val()) {
            ShowErrorMessage("Please enter the reason");
            return false;
        }

        var model = {
            StatusId: statusId,
            Remarks: $("#txtRemarks").val(),
