function selectAllHideShow() {
    var statusId = $("#ddlStatus").data("kendoDropDownList").value();
    $("#hdSelectedIds").val('');
    $("#masterCBAllPaymentReceived").prop("checked", false);
    $("#btnPending").prop("disabled", true);
    var bookingType = $("input[name='BookingType']:checked").val();
    if (Number(statusId) === emamiGlobal.Status.Pending || Number(statusId) === 0 || Number(statusId) === -1) {
        $("#btnApproved,#btnRejected").prop("disabled", false);
        $("#btnPending").prop("disabled", true);
        $("#masterCBAllPaymentReceived").show();
    } else if (bookingType == emamiGlobal.SaudaBookingType.ReverseAuction && Number(statusId) === emamiGlobal.Status.Rejected) {
        $("#btnApproved,#btnRejected").prop("disabled", true);
        $("#btnPending").prop("disabled", false);
        $("#masterCBAllPaymentReceived").show();
    }
    else {
        $("#btnApproved,#btnRejected,#btnHold").prop("disabled", true);
        $("#masterCBAllPaymentReceived").hide();
    }
}



function saudaRejectConfirm(saudaId, statusId) {

    arrSaudaData = { SaudaId: saudaId, StatusId: statusId };
    $("#txtRejectRemarks").val('');
    $("#myReasonModal").modal("show");
}

function saudaReject() {

     var form = $('#frmSaudaModificationDetails');
     var token = $('input[name="__RequestVerificationToken"]', form).val();

     if (!(arrSaudaData.StatusId == emamiGlobal.Status.Rejected)) {
         ShowErrorMessage("Accepted sauda only reject");
         return false;
     }
     var model = {
         StatusId: arrSaudaData.StatusId,
         Remarks: $("#txtRejectRemarks").val(),
         SaudaOrderIds: [arrSaudaData.SaudaId]
     };
     window.kendo.ui.progress($("#pageLoader"), true);
      moduleCommon.Common.AjaxCall({
          url: '@Url.Action("UpdateSaudhaModificationStatus", "Lookup")',
          type: 'POST',
          data: { __RequestVerificationToken: token, saudaUpdateDto: model },
          success: function(result) {
              if (result.PostStatus) {
                  ShowSuccessMessage(result.PostMessage);
                  setTimeout(function () { window.location.href = '@Url.Action("SaudaModificationList", "Lookup")'; }, 1500);
              } else {
                  ShowErrorMessage(result.PostMessage);
              }
              arrSaudaData = {};
              window.kendo.ui.progress($("#pageLoader"), false);
          }
     });
}

