@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.SaudaValidityAndSaudaReportMailConfigurationDto
@{
    ViewBag.Title = "SaudaValidityAndSaudaReportMailConfiguration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="configurationSaudaValidityAndSaudaReportMail" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_SaudaValidityAndSaudaReportMailConfiguration")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Configurations</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_SaudaValidityAndSaudaReportMailConfiguration")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="dvconfigurationForMailsAndVerticals">
                <div class="col-md-12">
                    <div class="row form-group">
                        @using (Html.BeginForm("AddorUpdateSaudaValidityAndSaudaReportMailConfiguration", "Lookup", FormMethod.Post, new { id = "frmconfigurationForMailsAndVerticals", @class = "form-validate-jquery" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="row form-group">
                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">
                                        @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                                    </label>
                                    @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                                </div>

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">
                                        @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                                    </label>
                                    @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                                </div>


                                @if (Model.RoleId == (long)Role.Admin)
                                {
                                    <div class="col-lg-3 col-sm-6 mb-3">
                                        <label class="custom_label">  @Helper.GetResourceString("lbl_Vertical") <span class="text-danger">*</span> </label>
                                        @(Html.Kendo().DropDownListFor(m => m.VerticalId)
                                      .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .Events(e => e.Change("onVerticalTypeChange"))
                                      .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                      .ServerFiltering(false))
                                      .HtmlAttributes(new { id = "ddlVertical", @class = "", tabindex = "1", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), @style = "width:100%" }))
                                    </div>

                                }
                                else
                                {
                                    //<div class="row form-group">
                                    <div class="col-lg-3 col-sm-6 mb-3">
                                        <label class="custom_label">
                                            @Helper.GetResourceString("lbl_Vertical") <span class="text-danger">*</span>
                                        </label>

                                        @(Html.Kendo().DropDownListFor(m => m.VerticalId)
                                      .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .Events(e => e.Change("onVerticalTypeChange"))
                                      .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                      .ServerFiltering(false))
                                      .HtmlAttributes(new { id = "ddlVertical", @class = "", tabindex = "1", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), @style = "width:100%" }))
                                    </div>

                                }

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label"> @Helper.GetResourceString("lbl_EmailsForSaudaReportBasedOnVerticals") <span class="text-danger">*</span> </label>
                                    @Html.TextBoxFor(m => m.EmailIds, new { type = "text", id = "txtEmailId", @class = "form-control", tabindex = "2", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_EmailsForSaudaReportBasedOnVerticals") })
                                </div>

                            </div>

                            <div class="row form-group">

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">  @Helper.GetResourceString("lbl_VerticalsBasedOnSaudaValidity") </label>
                                    @(Html.Kendo().MultiSelectFor(m => m.VerticalsBasedOnSaudaValidity)
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVerticalBasedOnSaudaValidity", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_VerticalsBasedOnSaudaValidity"), @style = "width:100%" }))
                                </div>
                            </div>

                        }
                    </div>
                    <div class="row form-group">
                        <div class="col-md-12 text-right">
                            <button type="button" tabindex="7" id="btnSave" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                        </div>
                    </div>
                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

         if ('@Model.VerticalId' > 0) {
            $("#ddlVertical").data("kendoDropDownList").readonly(true);
        }

        $('input[type="text"]').keypress(function (e) {
            var code = e.keyCode || e.which;
            if (code === 13) {
                e.preventDefault();
            }
        });

        $('#btnSave').on('click', function (e) {
            var isValid = $('#frmconfigurationForMailsAndVerticals').valid();
            if (isValid) {
                window.kendo.ui.progress($("#dvconfigurationForMailsAndVerticals"), true);
                $('#frmconfigurationForMailsAndVerticals').submit();
                window.kendo.ui.progress($("#dvconfigurationForMailsAndVerticals"), false);
            }
        });
     });

    function onVerticalTypeChange() {
        $.ajax({
            type: 'Post',
            url: '@Url.Action("SaudaValidityAndSaudaReportMailConfiguration", "Lookup")',
            data: { verticalId: Number($('#ddlVertical').data("kendoDropDownList").value()) },
            success: function (responce) {
               $("#txtEmailId").val(responce.EmailIds);
            },
            error: function (responce) {


            }
        });
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        if (distId > 0) {

            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
            $("#ddlVerticalBasedOnSaudaValidity").data("kendoMultiSelect").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>











