    function loadShipToPartyGrid(isRemoveShipToPartyId) {
        debugger;
        //var verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        var verticalId = "";
        var grid = $("#ViewDivisionTable").data("kendoGrid");
        var datasource = grid.dataSource;
        for (var i = 0; i < datasource.data().length; i += 1) {
            var id = datasource.data()[i].DivisionId;
            verticalId = verticalId.concat(id + ",");

        }
        var ddlState = $("#ddlState").data("kendoDropDownList").value();
        var stateId = Number(ddlState);
        if (verticalId != 0 && stateId != 0) {
            window.kendo.ui.progress($("#dvUser"), true);
            moduleCommon.Common.AjaxCall({
                url: '@Url.Action("ShipToPartyBasedOnStateGridPartial", "Lookup")',
                type: 'Get',
                data: { IsRemoveSelectedDealerIdsFromSession: isRemoveShipToPartyId, verticalId: verticalId, stateId: stateId },
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    $("#dvShipToPartyPopup").html(result);
                    window.kendo.ui.progress($("#dvUser"), false);
                }
            });
        }
    }
