        var total = datasource.data().length;
        var SalesOrganizationId = $("#ddlSalesOrganization").val();
        var SalesOrganizationName = $("#ddlSalesOrganization").data("kendoDropDownList").text();
        var DistrinutionChannelId = $("#ddlDistributionChannel").val();
        var DistributionChannelName = $("#ddlDistributionChannel").data("kendoDropDownList").text();
        var DivisionId = $("#ddlVertical").val();
        var DivisionName = $("#ddlVertical").data("kendoDropDownList").text();
            //Insertion
            var isDuplicate = false;
            for (var i = 0; i < datasource.data().length; i += 1) {
                if (datasource.data()[i].SalesOrganizationId == SalesOrganizationId && datasource.data()[i].DistributionChannelId == DistrinutionChannelId && datasource.data()[i].DivisionId == DivisionId) {
                    isDuplicate = true;
                    break;
                }
            }
            if (!isDuplicate) {
                datasource.insert(total, {
                    SalesOrganizationId: SalesOrganizationId,
                    DistributionChannelId: DistrinutionChannelId,
                    DivisionId: DivisionId,
                    Division: DivisionName,
                    DistributionChannel: DistributionChannelName,
                    SalesOrganization: SalesOrganizationName,
                });
                total = datasource.data().length;
                $("#ddlSalesOrganization").data("kendoDropDownList").value(-1);
                $("#ddlDistributionChannel").data("kendoDropDownList").value(-1);
                $("#ddlVertical").data("kendoDropDownList").value(-1);
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_division_exists")');
            }
        window.kendo.ui.progress($("#ViewDivisionTable"), false);
    }


</script>



