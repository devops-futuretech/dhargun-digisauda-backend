                             .HtmlAttributes(new { id = "ddlLine", @class = "", tabindex = "3",  data_msg_required = Helper.GetSelectMsgRequired("lbl_Line"), @style = "width:100%" }))
                            </div>
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">Status</label>
                                <div class="custom_checkbox_main">
                                    <label class="custom_checkbox">
                                        @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "20" })
                                        <span class="checkmark check_tick"></span>
                                        <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                    </label>
                                </div>

                            </div>
                        </div>

                        @*<div class="row form-group">*@

                        @*<div class="col-lg-3 col-sm-6 mb-3">
                                            <label class="custom_label">  Sales Document Type <span class="text-danger">*</span> </label>
                                            @(Html.Kendo().DropDownListFor(m => m.SalesDocumentTypeId)
                                                .OptionLabel("Select Sales Document Type")
                                                .DataTextField("Name")
                                                .DataValueField("Id")
                                                .DataSource(source => source.Read(read => read.Action("GetSalesDocumentTypeddl", "Lookup"))
                                                ).HtmlAttributes(new { id= "ddlSalesDocumentType", tabindex = "1", @class = "form-control", required = "required", data_msg_required = "Sales Document type", @style = "width:100%" })
                            )
                                        </div>*@
                        @*</div>*@

                        @*<div class="row form-group">

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    @Helper.GetResourceString("lbl_StorageLocation")
                                </div>
                                <div class="col-md-3">
                                    @Html.TextBoxFor(m => m.StorageLocation, new { id = "txtStorageLocation", tabindex = "12", @placeholder = Helper.GetResourceString("lbl_StorageLocation"), @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_StorageLocation"), @maxlength = (int)InputMaxLength.String })
                                </div>
                            </div>*@

                        <div class="row form-group">
                            <div class="col-md-12 text-right buttons-align">
                                <button type="button" id="btnCancel" tabindex="23" onclick="location.href = '@Url.Action("SkuList", "Lookup")'" class="k-button k-cancel custom-btns">Cancel</button>
                                @if (Helper.CheckClaims(Claims.ManageMaster))
                                {
                                    <button type="button" id="btnSave" tabindex="24" class="k-primary k-button custom-btns">@(Model != null && Model.Id == 0 ? @Helper.GetResourceString("btn_SaveSku") : @Helper.GetResourceString("btn_UpdateSku")) </button>
                                }
                            </div>
                        </div>
                    }
                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        sapDataReadOnly();  //Sap data readonly

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        if ('@Model.VerticalId' > 0) {

            //$("#ddlVertical").data("kendoDropDownList").readonly();
        }

        if (!('@Model.Id' > 0)) {
            $('#txtQuantity').val('');
            $('#txtProcessCost').val('');
        }
        else {
            // $('#txtSkuName').attr('readonly', 'true');
            $('#txtSkuCode').attr('readonly', 'true');
        }

        if ('@Model.ConversionFactor1' === "0") {
            $('#txtConversionFactor1').val('');
        }

        if ('@Model.ConversionFactor2' === "0") {
            $('#txtConversionFactor2').val('');
        }

        if ('@Model.ConversionFactor3' === "0") {
            $('#txtConversionFactor3').val('');
        }
        if ('@Model.GrossWeight' === "0") {
            $("#txtGrossWeight").val('');
        }
        if ('@Model.QuantityTypeUom' === "0") {
            $("#txtQuantityType").val('');
        }

        if ('@Model.VerticalId' === "1") {
            ProcessCostNotRequired();
        } else {
            ProcessCostRequired();
        }

        $('input[type="text"]').keypress(function (e) {
            var code = e.keyCode || e.which;
            if (code === 13) {
                e.preventDefault();
            }
        });

        $('#btnSave').on('click', function (e) {

            //if ($("#ddlVertical").val() == "1") {
            //    $("#txtProcessCost").prop("required", false);
            //    $("#txtProcessCost").val('');
            //    //$("#txtProcessCost").prop('disabled', true);
            //}


            var isValid = $('#frmSku').valid();
            if (isValid) {
                window.kendo.ui.progress($("#dvSku"), true);
                $('#frmSku').submit();
                window.kendo.ui.progress($("#dvSku"), false);
            }
        });
    });

    //Verticle Change Events
    function onVerticalTypeChange() {

        if ($("#ddlVertical").val() == "1") {
            ProcessCostNotRequired();
        } else {
            ProcessCostRequired();
        }

        $("#ddlOilType").data("kendoDropDownList").dataSource.read();
    }

    function oilTypeAdditionalInfo() {
        var verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        return {
            verticalId: Number(verticalId)
        };
    }

    //Verticle data onBound events
    function verticleDataBound() {
        if ('@Model.VerticalId' > 0) {
            $("#ddlOilType").data("kendoDropDownList").dataSource.read();
        }
    }

    function ProcessCostNotRequired() {
        //$("#txtProcessCost").val('');
        //$("#txtProcessCost").prop('disabled', true);
        $("#txtProcessCost").prop("required", false);
        $("#ProcessCostRequired").html("");
    }

    function ProcessCostRequired() {
        //$("#txtProcessCost").prop('disabled', false);
        $("#txtProcessCost").prop("required", true);
        $("#ProcessCostRequired").html("*");
    }

    function sapDataReadOnly() {
        if ('@ConfigHelper.IsSapDataUpdate' == "True") {
            $("#ddlVertical").data("kendoDropDownList").readonly();
            $("#ddlOilType").data("kendoDropDownList").readonly();
            $("#txtSkuName").prop('readonly', true);
            $("#txtSkuCode").prop('readonly', true);
        }
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();

    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();

        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>




