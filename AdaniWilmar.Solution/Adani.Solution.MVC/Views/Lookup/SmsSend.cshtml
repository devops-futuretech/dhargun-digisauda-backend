@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.SmsInputDto
@{
    ViewBag.Title = "SmsSend";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="masterSendSMS" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Send Notification</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li class="active">Send Notification<span class="icon-right"></span></li>
    </ol>
    <div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">

            @*<button id="btnCreateSendSMS" type="button" tabindex="6" class="k-primary k-button">@Helper.GetResourceString("lbl_CreateSendSms")</button>*@

        </div>
    </div>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">

            @using (Html.BeginForm("SendSms", "Lookup", FormMethod.Post, new { id = "frmSmsSend", @class = "form-validate-jquery" }))
            {
                <div class="col-md-12" style="padding-bottom: 20px;display:none" id="successAlert">
                    <div class="alert alert-success no-border">
                        <button type="button" class="close" data-dismiss="alert"><span>&times;</span><span class="sr-only">Close</span></button>
                        <span class="text-semibold" id="successContent"></span>
                    </div>
                </div>

                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span></label>
                        @(Html.Kendo().DropDownListFor(m => m.SalesOrganizationId)
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">@Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span></label>
                        @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "5", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownListFor(m => m.VerticalId)
                                                      .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                                                      .DataTextField("Name")
                                                      .DataValueField("Id")
                                                      .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                                      //.DataSource(source => source.Read(read => read.Action("GetVerticalListAsync", "Lookup", new { isToReturnInactiveData = false }))
                                                      .ServerFiltering(false))
                                                      .HtmlAttributes(new { id = "ddlVertical", @class = "", tabindex = "1", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), @style = "width:100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Role")<span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownListFor(a => a.RoleId)
                                                      .DataTextField("Name")
                                                      .DataValueField("Id")
                                                      .OptionLabel(@Helper.GetResourceString("plho_SelectRole"))
                                                      .DataSource(source => source.Read(read => read.Action("GetRoleListForSendSMS", "Lookup"))
                                                      .ServerFiltering(true))
                                                      .HtmlAttributes(new { id = "ddlRole", @class = "form-control", tabindex = "1", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Role"), @style = "width:100%" }))

                    </div>

                </div>

                <div class="row form-group">

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_NotificationType")<span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownListFor(a => a.NotificationType)
                                                      .DataTextField("Name")
                                                      .DataValueField("Id")
                                                      .Events(e => e.Change("onNotificationChange"))
                                                      .OptionLabel("Select Notification Type")
                                                      .DataSource(source => source.Read(read => read.Action("GetAllNotificationTypes", "Lookup"))
                                                      .ServerFiltering(true))
                                                      .HtmlAttributes(new { id = "ddlNotificationType", @class = "form-control", tabindex = "1", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_NotificationType"), @style = "width:100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> Type <span class="text-danger">*</span></label>
                        @(Html.Kendo().DropDownListFor(a => a.LiveOrTesting)
                                                      .DataTextField("Name")
                                                      .DataValueField("Id")
                                                      .Events(e => e.Change("onLiveOrTesting"))
                                                      .DataSource(source => source.Read(read => read.Action("GetNotificationTypes", "Lookup"))
                                                      .ServerFiltering(true))
                                                      .HtmlAttributes(new { id = "ddlLiveOrTesting", @class = "form-control", tabindex = "1", required = "required", @style = "width:100%" }))
                    </div>
                </div>
                <div class="row form-group" id="testpushNotificationId" style="display:none">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">@Helper.GetResourceString("lbl_MobileNumber") <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.TestMobileNumber, new { id = "txtTestMobileNumber", tabindex = "10", @class = "form-control", data_msg_required = Helper.GetMsgRequired("lbl_MobileNumber"), @maxlength = (int)InputMaxLength.String })
                    </div>
                </div>
                <div class="row form-group" id="testMobileNumber" style="display:none">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">@Helper.GetResourceString("lbl_MobileNumber") <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.TestMobileNumber, new { id = "txtTestMobileNumber", tabindex = "10", @class = "form-control", data_msg_required = Helper.GetMsgRequired("lbl_MobileNumber"), @maxlength = (int)InputMaxLength.String })
                    </div>
                </div>

                <div class="row form-group" id="testEmail" style="display:none">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">@Helper.GetResourceString("lbl_Email") <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.TestEmail, new { id = "txtTestEmail", tabindex = "3", @class = "form-control", data_msg_required = Helper.GetMsgRequired("lbl_Email"), @maxlength = (int)InputMaxLength.TextAreaString })
                    </div>
                    <div id="subject" style="display:none">
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_Subject") <span class="text-danger">*</span> </label>
                            @Html.TextBoxFor(m => m.Subject, new { id = "txtSubject", tabindex = "3", @class = "form-control", data_msg_required = Helper.GetMsgRequired("lbl_Subject"), @maxlength = (int)InputMaxLength.AnnouncementTitle })
                        </div>
                    </div>
                </div>
                <div class="row form-group">

                    <div class="col-lg-12 col-sm-12 mb-3">
                        <label class="custom_label">@Helper.GetResourceString("lbl_Content")</label>

                        @Html.TextAreaFor(a => a.SmsContent, new { id = "txtSmsContent", tabindex = "5", required = "required", @class = "k-textarea", data_msg_required = Helper.GetMsgRequired("lbl_Content") })
                        @*@(Html.Kendo().EditorFor(e => e.SmsContent)
                            //.Name("editor")
                            .HtmlAttributes(new { style = "height:440px", aria_label = "editor" })
                            .Resizable(resizable => resizable.Content(true).Toolbar(true))
                            //.ImageBrowser(imageBrowser => imageBrowser
                            //.Image("~/Content/UserFiles/Images/{0}")
                            //.Read("Read", "ImageBrowser")
                            //.Create("Create", "ImageBrowser")
                            //.Destroy("Destroy", "ImageBrowser")
                            //.Upload("Upload", "ImageBrowser")
                            //.Thumbnail("Thumbnail", "ImageBrowser"))
                    )*@

                    </div>
                </div>

                <div class="col-md-12 text-center">
                    @*<button id="btnClose" type="button" tabindex="6" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Close")</button>*@
                    <button id="btnSaveSms" type="button" tabindex="6" class="k-primary k-button custom-btns">Send</button>
                </div>
            }
        </div>
    </div>

</div>

<script>
    $(document).ready(function () {

        if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
        }

        $('#btnSaveSms').on('click', function (e) {
            var isValid = $('#frmSmsSend').valid();

            if (isValid) {
                window.kendo.ui.progress($("#div_Progress"), true);
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SendSms", "Lookup")',
                    data: $("#frmSmsSend").serialize(),
                    success: function (res) {
                        if (res.Status) {
                            ShowSuccessMessage(res.Message);
                            $("#successContent").text(res.Message);
                            $("#successAlert").css("display", "block");
                            clearData();
                        } else {
                            ShowErrorMessage(res.Message);
                            $("#successAlert").css("display", "none");
                        }
                    },
                    error: function () {
                        ShowErrorMessage("Some error occured");
                    },
                    complete: function () {
                        window.kendo.ui.progress($("#div_Progress"), false);
                    }
                });
            }
        });
    });

    function onNotificationChange() {
        @*if (this.value() == @((int)Adani.Solution.DTO.Enums.AppNotificationType.Email)) {
            $("#subject").css("display", "block");
            $("#txtSubject").prop('required', true);
        } else {
            $("#subject").css("display", "none");
            $("#txtSubject").prop('required', false);
            //$("#txtSubject").val('');
        }*@
        hideShow();
    }

    function onLiveOrTesting() {
        hideShow();
    }

    function hideShow() {
        var notificationType = $("#ddlNotificationType").val();
        var liveOrTesting = $("#ddlLiveOrTesting").val();

        if (liveOrTesting == @((int)Adani.Solution.DTO.Enums.LiveOrTesting.Testing)
                && notificationType == @((int)Adani.Solution.DTO.Enums.AppNotificationType.Email)) {

            $("#testEmail").css("display", "block");
            $("#txtTestEmail").prop('required', true);
            $("#subject").css("display", "block");
            $("#txtSubject").prop('required', true);
            $("#testMobileNumber").css("display", "none");
            $("#txtTestMobileNumber").prop('required', false);
            $("#testpushNotificationId").css("display", "none");
            $("#testpushNotificationId").prop('required', false);

        } else if (liveOrTesting == @((int)Adani.Solution.DTO.Enums.LiveOrTesting.Testing)
                && notificationType == @((int)Adani.Solution.DTO.Enums.AppNotificationType.SMS)) {

            $("#testEmail").css("display", "none");
            $("#txtTestEmail").prop('required', false);
            $("#subject").css("display", "none");
            $("#txtSubject").prop('required', false);
            $("#testMobileNumber").css("display", "block");
            $("#txtTestMobileNumber").prop('required', true);
            $("#testpushNotificationId").css("display", "none");
            $("#testpushNotificationId").prop('required', false);

        }else if (liveOrTesting == @((int)Adani.Solution.DTO.Enums.LiveOrTesting.Testing)
                && notificationType == @((int)Adani.Solution.DTO.Enums.AppNotificationType.Pushnotification)) {

            $("#testEmail").css("display", "none");
            $("#txtTestEmail").prop('required', false);
            $("#subject").css("display", "none");
            $("#txtSubject").prop('required', false);
            $("#testpushNotificationId").css("display", "block");
            $("#testpushNotificationId").prop('required', true);

        }
        else {
            $("#testEmail").css("display", "none");
            $("#txtTestEmail").prop('required', false);
            $("#testMobileNumber").css("display", "none");
            $("#txtTestMobileNumber").prop('required', false);
        }
    }

    function clearData() {
        $("#txtSubject").val('');
        $("#txtSmsContent").val('');
        $("#txtTestMobileNumber").val('');
        $("#txtTestEmail").val('');
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();

    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }
</script>