@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@using Adani.Solution.DTO.Enums;
@using Adani.Solution.MVC.Models;
@using Adani.Solution.DTO;
@{
    ViewBag.Title = Helper.GetResourceString("lbl_SurpriseDiscount");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="discountSurprise" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">@Helper.GetResourceString("lbl_SurpriseDiscount")</h2>
    <div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">
            <a href="@Url.Action("SurpriseDiscountEditRedirect", "Lookup")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("msg_CreateSurpriseDiscount")</a>
        </div>
    </div>
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">

        </div>
        <div class="panel-body" style="display: block;">
            <div class="row">
                <div class="col-md-12">
                    <div class="text-right">
                        <button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("ViewSurpriseDiscount")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                    </div>
                    @(Html.Kendo().Grid<SurpriseDiscountDto>()
                          .Name("ViewSurpriseDiscount")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.OilTypeId).Visible(false);
                              columns.Bound(c => c.OilType).ClientTemplate(@"<div><a style='text-decoration: underline;' href='" + Url.Action("SurpriseDiscountEditRedirect", "Lookup", new { SurpriseDiscountId = "#=Id#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=OilType#</a>  </div>").Title(@Helper.GetResourceString("lbl_OilType")).Width(Settings.GridOtherColumnWidth);
                              //columns.Bound(c => c.OilType).Title(@Helper.GetResourceString("lbl_OilType")).Width(Settings.GridOtherColumnWidth);
                              columns.Bound(c => c.OilPackingTypeId).Visible(false);
                              columns.Bound(c => c.OilPackingType).Title(@Helper.GetResourceString("lbl_OilPackingType")).Width(Settings.GridOtherColumnWidth);
                              columns.Bound(c => c.SkuId).Visible(false);
                              columns.Bound(c => c.Sku).Title(@Helper.GetResourceString("lbl_Sku")).Width(Settings.GridOtherColumnWidth);
                              columns.Bound(c => c.ValidFrom).Title(@Helper.GetResourceString("lbl_FromDate")).Format(Settings.GridDateFormat).Width(Settings.GridOtherColumnWidth);
                              columns.Bound(c => c.ValidTo).Title(@Helper.GetResourceString("lbl_ToDate")).Format(Settings.GridDateFormat).Width(Settings.GridOtherColumnWidth);
                              columns.Bound(c => c.Discount).Title(@Helper.GetResourceString("lbl_Discount")).Width(Settings.GridOtherColumnWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Resizable(resize => resize.Columns(true))
                          .Excel(excel => excel.FileName(@Helper.GetResourceString("lbl_SurpriseDiscount") + " " + DateTime.Now + ".xlsx").AllPages(true))
                          .Reorderable(reorder => reorder.Columns(true))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(model => model.Id(m => m.Id))
                          .ServerOperation(true)
                          .Read(read => read.Action("GetAllSurpriseDiscountListAsync", "Lookup"))))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
		$(document).ready(function () {
			 @*if ('@Model.PostMessage' !== ""){
			   if ('@Model.PostStatus' === '@true') {
					ShowSuccessMessage('@Model.PostMessage');
				} else {
				   ShowErrorMessage('@Model.PostMessage');
				}
		}*@
            // kendo grid filter contains
			 FilterContains();


        });



        //Method to data bound event for owner
        function OnCategoryListDataBound(e) {
			SetEmptyRow(e);
        }

</script>


