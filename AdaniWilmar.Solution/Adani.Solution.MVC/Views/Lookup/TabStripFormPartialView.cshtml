    <div class="row form-group">
        <div class="col-md-4 text-right control-label">
            @Helper.GetResourceString("lbl_Remarks")
        </div>

        <div class="col-md-4">
            @Html.TextAreaFor(m => m.Remarks, new { id = "txtRemarks", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.MaxTextLength })
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-4 text-right control-label">
            @Helper.GetResourceString("lbl_Comments")
        </div>
        <div class="col-md-4" style="padding-top: 07px;">
            @if (Model != null && Model.Comments != null && Model.Comments.Any())
            {

                for (int i = 0; i < Model.Comments.Count(); i++)
                {
                    <table>
                        <tbody>
                            <tr>
                                <td style="width:1000px">
                                    <pre>@Model.Comments[i].Description
Commented by: @Model.Comments[i].CreatedBy
Created DateTime: @Model.Comments[i].CreatedOn</pre>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }

            }
            else
            {
                <i> There are no comments yet on this issue. </i>
            }
        </div>
    </div>
</fieldset>

@*<div id="myModal">

    </div>*@
<script>


    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();
        $('#myModal').modal('hide');
    });
    function dataBound(e) {
        SetEmptyRow(e);
        this.expandRow(this.tbody.find("tr.k-master-row").first());   //expand first row
    }

	function AttachmentModel(questionId) {
		$('#myModal').modal('show');
		$.ajax({
            type: "POST",
            url: '@Url.Action("GetAttachments", "Lookup")',
            data: { QuestionId: questionId },
			success: function (result) {
				$("#myModal").html(result);
                $("#popupAttachmentDetails").modal('show');
            }
        });
    }
</script>

