@using Kendo.Mvc.UI
@using Adani.Solution.DTO
@using Adani.Solution.DTO.Enums
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@using Adani.Solution.MVC.Models;
@model  Adani.Solution.DTO.SubmittedFormViewDto

<p class="content-group-lg"></p>
<fieldset class="content-group">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.SubmittedFormId, new { id = "hdnSubmittedFormId" })

    <div class="row form-group">
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_FormName")
        </div>
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.FormName, new { id = "txtFormName", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>

        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_DependentFormName")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.ParentFormName, new { id = "txtParentFormName", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_RaisedBy")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.RaisedBy, new { id = "txtRaisedBy", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>

        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_CreatedDate")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.CreatedDate, new { id = "txtCreatedDate", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_CustomerName")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.RaisedFor, new { id = "txtRaisedFor", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>

        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_Plant")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.PlantName, new { id = "txtPlantName", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_Sku")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.SkuName, new { id = "txtSkuName", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>

        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_City")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.CityName, new { id = "txtCityName", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_State")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.StateName, new { id = "txtStateName", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>

        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_Status")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.FormStatusName, new { id = "txtFormStatusName", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>

    </div>

    <div class="row form-group">
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_Demonstrator")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.DemonstratedBy, new { id = "txtDemonstratedBy", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_DemoIncharge")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.DemoIncharge, new { id = "txtDemoincharge", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_DealerName")
        </div>

        <div class="col-md-4">
            @Html.TextBoxFor(m => m.DealerName, new { id = "txtDealerName", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>
        <div class="col-md-2 text-right control-label">
            @Helper.GetResourceString("lbl_EALUsers")
        </div>

        <div class="col-md-4">
            @Html.TextAreaFor(m => m.EALUserName, new { id = "txtEALUser", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })
        </div>
    </div>
    <div class="row form-group">
        <div class="row text-right control-label">
            <div class="col-md-2">
                @Helper.GetResourceString("lbl_Questions")
            </div>
        </div>
        <div class="row">
            <div class="col-md-10 col-md-offset-1">
                @(Html.Kendo().Grid<SectionDto>()
									.Name("ViewSetions"+ Model.SubmittedFormId)
									.Columns(columns =>
									{
										columns.Bound(c => c.SectionId).Visible(false);
										columns.Bound(c => c.SectionName).Title(@Helper.GetResourceString("lbl_Section"));
									})
									.BindTo(Model.Sections)
									.ClientDetailTemplateId("template")
									.NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
									.Filterable(filter => filter.Mode(GridFilterMode.Row))
									.Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
									.Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
									.Scrollable(s => s.Enabled(true).Height("auto"))
									.Events(events => events.DataBound("dataBound"))
									.Reorderable(reorder => reorder.Columns(true))
									.Resizable(resize => resize.Columns(true))
									.DataSource(dataSource => dataSource
										.Ajax()
										.PageSize(Settings.DefaultPageSize)
										.Model(model => model.Id(m => m.SectionId))
										.ServerOperation(true)
						))
            </div>
            <script id="template" type="text/kendo-tmpl">

                @(Html.Kendo().Grid<SubmittedFormQuestionViewDto>()
						  .Name("grid_#=GuidValue#")      //template expression, to be evaluated in the master context
						  .Columns(columns =>
						  {
							  columns.Bound(c => c.QuestionId).Visible(false);
							  columns.Bound(c => c.QuestionTypeId).Visible(false);
							  columns.Bound(c => c.Question).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Query")).Width(Settings.GridColumnMaxWidth);
							  columns.Bound(c => c.QuestionTypeName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_QuestionType")).Width(Settings.GridColumnMaxWidth);
							  columns.Bound(c => c.Answer).HeaderHtmlAttributes(new { style = "text-align:center" }).HtmlAttributes(new { title = "\\#= Answer \\#" }).ClientTemplate("\\# if (QuestionTypeId == "+ (int)QuestionType.Attachments +") { \\#" + "\\<a onclick=AttachmentModel('\\#=QuestionId\\#') title='view attachments'><i class='icon-attachment' ></i></a>\\" +  "\\# } else { \\#" + "\\<p>\\#=Answer\\#</p>\\" +    "#\\ } \\#").Title(@Helper.GetResourceString("lbl_Answer")).Width(Settings.GridColumnMaxWidth);
						  })
						  .DataSource(dataSource => dataSource
							  .Ajax()
							  .PageSize(10)
							  .Read(read => read.Action("GetQuestionSectionDetail", "Lookup", new { id = "#=SectionId#" }))
						  )
						  .Pageable()
						  .Sortable()
						  .Scrollable(s => s.Enabled(true).Height("auto"))
						  .Reorderable(reorder => reorder.Columns(true))
						  .Resizable(resize => resize.Columns(true))
						  .ToClientTemplate()
							)
            </script>
        </div>
    </div>
