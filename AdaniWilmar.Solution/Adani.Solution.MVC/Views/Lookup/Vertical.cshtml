@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Common
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.VerticalDto

@{
    ViewBag.Title = "Division";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="masterVertical" />
<div id="main-section-header" class="row">
    @*@Helper.GetResourceString("lbl_OilType")*@
    <h2 id="team-efficiency" class="main-title">Division</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li class="active">Division<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
            <div class="period-wrapper">
                @if (Helper.CheckClaims(Claims.ManageMaster) && !ConfigHelper.IsSapDataUpdate)
                {
                    <a id="btnAddVertical" href="#" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;@Helper.GetResourceString("lbl_AddDivision")</a>
                }
            </div>
        </div>*@
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        @*<div class="panel-heading">
                <h3 class="inner-title">Division List</h3>
            </div>*@
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvDealers">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                @*<span class="export-link" onclick='excelExport()' type="button">CSV</span>*@
                                <span class="export-link" onclick='excelExport()' type="button">Excel</span>
                            </div>
                        </div>
                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='excelExport()' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("GridVertical")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                    <div class="period-wrapper">
                        @if (Helper.CheckClaims(Claims.ManageMaster) && !ConfigHelper.IsSapDataUpdate)
                        {
                            <a href="@Url.Action("VERedirect","Lookup")" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;Add New Division</a>
                        }
                    </div>
                    </div>
                    @(Html.Kendo().Grid<VerticalDto>()
                          .Name("GridVertical")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.SalesOrganizationId).Visible(false);
                              columns.Bound(c => c.DistributionChannelId).Visible(false);
                              columns.Bound(c => c.SalesOrganizationName).HtmlAttributes(new { @title = "#=SalesOrganizationName#" }).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Sales Organization").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.DistributionChannelName).HtmlAttributes(new { @title = "#=DistributionChannelName#" }).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_DistributionChannel")).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Name).ClientTemplate(@"<div> <a style='text-decoration: underline;' href='" + Url.Action("VERedirect", "Lookup", new { EncryptedId = "#=EncryptedId#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=Name#</a> </div>").Title("Division").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Code).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Code").Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.Name).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Name")).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.SalesDocumentType).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_SalesDocumentType")).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.SalesOrderDocumentType).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("SalesOrder DocumentType").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'>#if(IsActive){#<i class='icon-green_ckbox_tick faicon-green'><span class='path1'></span><span class='path2'></span></i>#}else{#<i class='icon-red_ckbox_tick faicon-red'><span class='path1'></span><span class='path2'></span></i>#}#</div>").Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.ZPR4).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Zpr4")).ClientTemplate(@"<div style='text-align: center;'>#if(ZPR4){#<i class='icon-green_ckbox_tick faicon-green'><span class='path1'></span><span class='path2'></span></i>#}else{#<i class='icon-red_ckbox_tick faicon-red'><span class='path1'></span><span class='path2'></span></i>#}#</div>").Width(Settings.GridColumnMaxWidth);
                              //columns.Template(t => t.Name).Title(@Helper.GetResourceString("lbl_Edit")).ClientTemplate(@"<div style='text-align: center;'>
                              //                                          <i onclick='editOil(this)' class='icon-edit pointer' ></i></div>").Title(@Helper.GetResourceString("lbl_Edit")).Width(Settings.GridButtonColumnWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Resizable(resize => resize.Columns(true))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Excel(excel => excel.AllPages(true).FileName(@Helper.GetResourceString("lbl_Division") + " " + DateTime.Now + ".xlsx").Filterable(true))
                          .Events(events => events.DataBound("onVerticleDataBound"))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Sort(sort => sort.Add("Id").Ascending())
                          .Model(model => { model.Id(p => p.Id); })
                          .ServerOperation(true)
                          .Read(read => read.Action("GetVerticalListForGridAsync", "Lookup"))
                          ))
                </div>
            </div>
        </div>
    </div>
    
</div>

<script>

    $(document).ready(function () {

        // kendo grid filter contains
        FilterContains();

        //Modal popup show


        //Save function

    });
   

    //Refresh the grid
    function refreshGrid() {
        var orderGrid = $("#GridVertical").data("kendoGrid");
        orderGrid.dataSource.read();
    }

    //Method to data bound event for owner
    function onVerticleDataBound(e) {
        SetEmptyRow(e);
    }

    function excelExport() {
        window.kendo.ui.progress($("#div_Progress"), true);
        var data = { IsToReturnInactiveData: true };
        $.ajax({
            type: 'Post',
            url: '@Url.Action("ExportVertical", "Lookup")',
            data: { inputDto: data },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }


    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>







