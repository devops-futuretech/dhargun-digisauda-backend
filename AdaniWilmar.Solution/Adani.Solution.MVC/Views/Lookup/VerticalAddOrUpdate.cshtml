@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model Adani.Solution.DTO.VerticalDto
@{
    ViewBag.Title = "VerticalAddOrUpdate";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="masterVertical" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Division</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li><a href="Vertical">Division List</a><span class="icon-right"></span></li>
        <li class="active">Add Or Update Division<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;" id="divLoader">
            <div class="row" id="dvMaterialType">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddOrUpdateVerticalDetails", "Lookup", FormMethod.Post, new { id = "frmDivision", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(s => s.EncryptedId, new { id = "txtId" })

                    <div class="row form-group">
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">@Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span></label>
                            @(Html.Kendo().DropDownListFor(m => m.SalesOrganizationId)
                    .Name("ddlSalesOrganization")
                    .OptionLabel(@Helper.GetResourceString("plho-SelectSales"))
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Select("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">@Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span></label>

                            @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
                           .Name("ddlDistributionChannel")
                          .OptionLabel(@Helper.GetResourceString("plho-SelectDistChannel"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "2", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                        </div>


                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_Name") <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Name, new { id = "txtName", tabindex = "4", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Name"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_SalesDocumentType") <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.SalesDocumentType, new { id = "txtSalesDocumentType", tabindex = "4", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_SalesDocumentType"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_SalesOrderDocumentType") <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.SalesOrderDocumentType, new { id = "txtSalesOrderDocumentType", tabindex = "4", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_SalesOrderDocumentType"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">@*@Helper.GetResourceString("lbl_Name")*@Code <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Code, new { id = "txtCode", tabindex = "2", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Name"), @maxlength = (int)InputMaxLength.String })
                        </div>
                        @*<div class="col-lg-3 col-sm-6 mb-3">
            <label class="custom_label">@Helper.GetResourceString("lbl_CCArea") <span class="text-danger">*</span></label>
            @Html.TextBoxFor(m => m.CCArea, new { id = "txtCCArea", tabindex = "3", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_CCArea"), @maxlength = (int)InputMaxLength.TextAreaString })
        </div>*@
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">Status</label>
                            <div class="custom_checkbox_main">
                                <label class="custom_checkbox">
                                    @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "4" })
                                    <span class="checkmark check_tick"></span>
                                    <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                </label>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">ZPR4</label>
                            <div class="custom_checkbox_main">
                                <label class="custom_checkbox">
                                    @Html.CheckBoxFor(m => m.ZPR4, new { id = "cbzpr4", tabindex = "4" })
                                    <span class="checkmark check_tick"></span>
                                    <span class="label-title">@Helper.GetResourceString("lbl_Zpr4")</span>
                                </label>
                            </div>
                        </div>

                    </div>
                        <div class="row form-group">
                            <div class="col-md-12 text-right buttons-align">

                                <button type="button" tabindex="7" id="btnCancel" onclick="location.href = '@Url.Action("Vertical", "Lookup")'" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.ManageMaster))
                                {
                                    <button type="button" tabindex="6" id="btnsave" class="k-primary k-button custom-btns">
                                        @if (Model.Id > 0)
                                        {@Helper.GetResourceString("btn_Update")}
                                    else
                                    { @Helper.GetResourceString("lbl_Save")}
                                    </button>
                                }

                                </div>

                        </div>

                    }

                    
                </div>
            </div>
        </div>

    </div>
</div>
<script>
            $(document).ready(function () {


        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
                }
                 if ('@Model.EncryptedId'!=null && '@Model.EncryptedId'!='')
        {
                     $('#txtCode').attr('readonly', 'true');
        }

                $("#btnsave").click(function () {
            addVerticaltoDatabase();
        });
    });

            function onSaleChange() {
                $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
            }


            function distParam() {
                var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
                return {
                    saleId: Number(saleId)
                };
            }
    function addVerticaltoDatabase() {
        debugger;
        var isValidForm = $("#frmDivision").valid();

        if (isValidForm) {
            window.kendo.ui.progress($("#frmDivision"), true);
             var token = '@Html.AntiForgeryToken()';
                token = $(token).val();
            var data = {

                    EncryptedId: $("#txtId").val(),
                    Name: $("#txtName").val(),
                    SalesDocumentType: $("#txtSalesDocumentType").val(),
                    SalesOrderDocumentType: $("#txtSalesOrderDocumentType").val(),
                    Code: $("#txtCode").val(),
                    //CCArea: $("#txtCCArea").val(),
                    IsActive: $("#cbActiveInactive").is(":checked"),
                    ZPR4: $("#cbzpr4").is(":checked"),
                    DistributionChannelId: $("#ddlDistributionChannel").val(),
                    SalesOrganizationId: $("#ddlSalesOrganization").val()
            };
            console.log(data);

                $.ajax({
                    type: "Post",
                    url: '@Url.Action("AddOrUpdateVerticalDetails", "Lookup")',
                    data: { __RequestVerificationToken: token, verticalDto: data },
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=utf-8',
                    success: function (responce) {
                        if ((responce) && (responce.PostStatus)) {
                             var url = '@Url.Action("Vertical", "Lookup")';
					                window.location.href = url;
                            ShowSuccessMessage(responce.PostMessage);
                        } else {
                            ShowErrorMessage(responce.PostMessage);
                        }
                        window.kendo.ui.progress($("#frmDivision"), false);
                    }
                })
                } else { return false; }
            }


</script>
