@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.AddorUpdateZoneDto
@{
    ViewBag.Title = "Zone";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    label {
        font-weight: normal !important;
        margin-bottom: 5px !important;
        position: relative;
        bottom: 2px;
    }
</style>

<input type="hidden" class="currentMenu" value="masterZone" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_AddOrUpdateZone")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li><a href="ZoneList">@Helper.GetResourceString("lbl_Zone")</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_AddOrUpdateZone")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="dvUser">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddOrUpdateZone", "Lookup", FormMethod.Post, new { id = "frmZone", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.EncryptedId)
     
                            <div class="row form-group">

                                <div class="col-lg-4 col-sm-6 mb-3">
                                    <label class="custom_label"> Name<span class="text-danger">*</span> </label>
                                    @Html.TextBoxFor(m => m.Name, new { id = "txtName", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Name"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                                </div>
                                <div class="col-lg-4 col-sm-6 mb-3">
                                    <label class="custom_label">Status</label>
                                    <div class="custom_checkbox_main">
                                        <label class="custom_checkbox">
                                            @Html.CheckBoxFor(m => m.isActive, new { id = "isActive", tabindex = "2", data_msg_required = Helper.GetMsgRequired("lbl_DirectPartyName"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                                            <span class="checkmark check_tick"></span>
                                            <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                        </label>
                                    </div>
                                </div>

                            </div>

                            <div class="row form-group">
                                <div class="col-lg-4 col-sm-6 mb-3">
                                    States
                                </div>
                                <div class="col-md-10">
                                    @foreach (var item in Model.States.Select((value, i) => (i)))
                                    {
                                        <div>
                                            @*@Model.States[item].Name*@

                                            <span class="custom_checkbox_main" style="padding-right: 15px;">
                                                <label class="custom_checkbox">
                                                    @Html.CheckBoxFor(it => it.States[item].Checked, new { Style = "vertical-align:3px}", tabindex = "2" })
                                                    <span class="checkmark check_tick"></span>
                                                </label>
                                            </span>
                                            @Html.HiddenFor(it => it.States[item].Id)
                                            @Html.HiddenFor(it => it.States[item].Name)
                                            <label>@Model.States[item].Name</label>
                                            @*@Html.Label(Model.States[item].Name, htmlAttributes: new { @for = "States_" + item + "__Checked" })*@
                                        </div>
                                    }
                                    @*@for (var i = 0; i < Model.States.Count(); i++)
                                    {
                                        <div>

                                            <span class="custom_checkbox_main" style="padding-right: 15px;">
                                                <label class="custom_checkbox">
                                                    @Html.CheckBoxFor(it => it.States[i].Checked, new { Style = "vertical-align:3px}", tabindex = "2" })
                                                    <span class="checkmark check_tick"></span>
                                                </label>
                                            </span>
                                            @Html.HiddenFor(it => it.States[i].Id)
                                            @Html.HiddenFor(it => it.States[i].Name)
                                            @Html.Label(Model.States[i].Name, htmlAttributes: new { @for = "States_" + i + "__Checked" })
                                        </div>

                                    }*@
                                </div>

                            </div>
                      
                        <div class="row form-group">
                            @{
                                var btn_text = string.Empty;
                                if (Model.Id == 0)
                                {
                                    btn_text = "Save Zone";
                                }
                                else
                                {
                                    btn_text = "Update Zone";
                                }
                            }
                            <div class="col-md-12 text-right buttons-align">
                                <button type="button" tabindex = "4" id="btnCancel" onclick="location.href = '@Url.Action("ZoneList", "Lookup")'" class="k-button k-cancel custom-btns">Cancel</button>
                                @if (Helper.CheckClaims(Claims.ManageMaster))
                                {
                                    <button type="submit" tabindex = "3" id="btnSave" class="k-primary k-button custom-btns">
                                        @btn_text
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function ()
    {
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        $('input[type="text"]').keypress(function (e) {
            var code = e.keyCode || e.which;
            if (code === 13) {
                e.preventDefault();
            }
        });

        $('#btnSave').on('click', function (e)
        {
            var isValid = $('#frmZone').valid();
            if (isValid)
            {
                window.kendo.ui.progress($("#dvUser"), true);
                $('#frmZone').submit();
                window.kendo.ui.progress($("#dvUser"), false);
            }
        });
    });

</script>

