                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        if ('@Model.DivisionId' > 0) {
            $("#ddVerticalType").data("kendoDropDownList").readonly(true);
        }

        if ('@Model.Id' === '0') {
            setDefaultDate();
        }

        claimBasedDisable();
        processedSetReadOnly();
        @*if ('@roleId' == emamiGlobal.role.Admin || '@roleId' == emamiGlobal.role.BusinessFinanceAdmin || '@roleId' == emamiGlobal.role.NationalTrader) {
            if ('@Model.Id' > 0) {
                formFieldReadOnly();
            } else {
                $("#txtDiscount").val('');
            }
        } else {
            formFieldReadOnly();
        }*@

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        //Save the form data
        $("#btnSave").click(function () {
            
            var isValidForm = $("#frmDiscountUser").valid();
            if (isValidForm) {
                var token = $('input[name="__RequestVerificationToken"]', $('#frmDiscountUser')).val();
                var data = {
                    EncryptedId: $("#hdnId").val(),
                    DivisionId: $("#ddVerticalType").val(),
                    SalesOrganizationId: $("#ddlSalesOrganization").val(),
                    DistributionChannelId: $("#ddlDistributionChannel").val(),
                    OilTypeId: $("#ddlOilType").val(),
                    SkuIds: $("#ddlSku").val(),
                    CustomerId: $("#ddlUser").val(),
                    ValidFrom: $("#dpFromDate").val(),
                    ValidTo: $("#dpToDate").val(),
                    ActualDiscount: $("#txtDiscount").val(),
                    DiscountReason: $("#txtDiscountReason").val(),
                    StateIds: $("#ddlState").val()
                    
                };

                 window.kendo.ui.progress($("#divLoader"), true);
                 moduleCommon.Common.AjaxCall({
                    type: 'Post',
                    url: '@Url.Action("AddOrUpdateDiscountUser", "Pricing")',
                    data: { __RequestVerificationToken: token, model : data },
                    success: function (result) {
                        if (result.PostStatus == true) {
                            ShowSuccessMessage(result.PostMessage);
                            setTimeout(function () {
                                window.kendo.ui.progress($("#divLoader"), false);
                                window.location.href = '@Url.Action("DiscountUserList", "Pricing")';
                            }, 1500);
                        } else {
                            ShowErrorMessage(result.PostMessage);
                            window.kendo.ui.progress($("#divLoader"), false);
                        }
                    }
                });
            }
        });

        $("#skuSelectAll").click(function () {
            MultiSelectSelectAll("ddlSku", "skuSelectAll");
            //$("#ddlSku").data("kendoMultiSelect").dataSource.read();
        });
        $("#stateSelectAll").click(function () {
            MultiSelectSelectAll("ddlState", "stateSelectAll");
        });

        $("#employeeSelectAll").click(function () {
            MultiSelectSelectAll("ddlUser", "employeeSelectAll");
            //$("#ddlSku").data("kendoMultiSelect").dataSource.read();
        });

    });

    function claimBasedDisable() {
        if ('@Helper.CheckClaims(Claims.ManageDiscounts)' == "True") {
            if ('@Model.Id' > 0) {
                //formFieldReadOnly();
            } else {
                $("#txtDiscount").val('');
            }
        } else {
            setDateRange();
            formFieldReadOnly();
            //alert('View claim');
            //setDateRange();
        }
    }

    //Readonly fields
    function formFieldReadOnly() {
        var dropdown = $("#ddVerticalType").data("kendoDropDownList");
        dropdown.readonly();
        dropdown = $("#ddlOilType").data("kendoDropDownList");
        dropdown.readonly();
        dropdown = $("#ddlSku").data("kendoMultiSelect");
        dropdown.readonly();
    }

    function processedSetReadOnly() {
        if ($("#hdnIsProcessed").val() == "True") {
            var discount = $("#txtDiscount");
            discount.attr('readonly', 'readonly');
            var datePicker = $("#dpFromDate").data("kendoDateTimePicker");
            datePicker.readonly();
            datePicker = $("#dpToDate").data("kendoDateTimePicker");
            datePicker.readonly();
        }
    }
    function userAssignedData() {
              var verticalId = 0;
               var distributionChannelId = 0;
        var salesOrganizationId = 0;
        var StateId = 0;
             if ($("#ddlSalesOrganization").data("kendoDropDownList").value() != "") {
                       salesOrganizationId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
                }
               if ($("#ddlDistributionChannel").data("kendoDropDownList").value() != "") {
                       distributionChannelId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
                 }
                if ($("#ddVerticalType").data("kendoDropDownList").value() != "") {
                       verticalId = $("#ddVerticalType").data("kendoDropDownList").value();
                   }
               return {
                       verticalId: verticalId,
                       SalesOrganizationId: salesOrganizationId,
                   DistributionChannelId: distributionChannelId,
                        StateId: StateId
                            }
        }
    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddVerticalType").data("kendoDropDownList").dataSource.read();

    }
    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddVerticalType").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }



