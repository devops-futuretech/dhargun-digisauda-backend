                                @if (Helper.CheckClaims(Claims.ManageDiscounts) || Helper.CheckClaims(Claims.AssignDiscount))
                                {
                                    <button type="button" id="btnSave" tabindex="9" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                                }
                            </div>
                        </div>
                    }
