                            <div class="row form-group">
                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label"> @Helper.GetResourceString("lbl_DiscountReason") <span class="text-danger">*</span> </label>
                                    @Html.TextBoxFor(m => m.DiscountReason, new { id = "txtDiscountReason", tabindex = "19", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_DiscountReason"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                                </div>

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label"> @Helper.GetResourceString("lbl_ValidFrom") <span class="text-danger">*</span> </label>
