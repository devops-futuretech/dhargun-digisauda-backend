                            </div>

                            <div class="row form-group">

                                @*<div class="col-lg-3 col-sm-6 mb-3">
            <label class="custom_label"> @Helper.GetResourceString("lbl_PackGroup") <span class="text-danger"></span> </label>
            @(Html.Kendo().DropDownListFor(m => m.OilPackingTypeId)
                                                          .OptionLabel(@Helper.GetResourceString("plho_SelectOilPackingType"))
                                                          .DataTextField("Name")
                                                          .DataValueField("Id")
                                                          .Events(e => e.Change("onPackGroupChange").DataBound("onPackGroupDataBound"))
                                                          .DataSource(source => source.Read(read => read.Action("GetOilPackingTypeListAsync", "Lookup", new { isToReturnInactiveData = true }))
                                                          .ServerFiltering(true))
                                                          .HtmlAttributes(new { id = "ddlOilPackingType", @class = "", tabindex = "3", @style = "width:100%" }))
        </div>*@




                                <div class="col-lg-8 col-sm-6 mb-3">
                                    <label class="custom_label">
                                        @Helper.GetResourceString("lbl_Sku") <span class="text-danger">*</span>
                                    </label>
                                    @(Html.Kendo().MultiSelectFor(m => m.SkuIds)
