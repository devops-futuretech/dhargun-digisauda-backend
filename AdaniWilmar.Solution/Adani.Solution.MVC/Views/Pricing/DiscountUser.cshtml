        }
    }



    function fromChange() {
        var endPicker = $("#dpToDate").data("kendoDateTimePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#dpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateTimeFormat));
            endPicker.min(startDate);
        }
    }

    function StartDateRange() {
        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#dpFromDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateTimeFormat));
        $("#dpToDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateTimeFormat));

        var endPicker = $("#dpToDate").data("kendoDateTimePicker");
        endPicker.min(dates);
    }

    function setDefaultDate() {
        var dates = new Date();
        dates.setDate(dates.getDate());
        $("#dpToDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateTimeFormat));
        $("#dpFromDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateTimeFormat));
        StartDateRange();
    }

    function setDateRange() {
        if ($('#hdnParentValidFrom').val() != "" && $('#hdnParentValidTo').val() != "") {
            var fromDate = new Date();
            var toDate = new Date();
            fromDate = $('#hdnParentValidFrom').val();
            toDate = $('#hdnParentValidTo').val();

            //$("#dpFromDate").val(fromDate);
            //$("#dpToDate").val(toDate);

            var fromPicker = $("#dpFromDate").data("kendoDateTimePicker");
            fromPicker.min(fromDate);
            fromPicker.max(toDate);

            var toPicker = $("#dpToDate").data("kendoDateTimePicker");
            toPicker.min(fromDate);
            toPicker.max(toDate);
        }
    }


