@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.MVC.Common
@using System.Security.Claims
@model Adani.Solution.DTO.DiscountUserDto

@{
    ViewBag.Title = "DiscountUser";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var roleId = 0;
    var labelName = "";

    if (HttpContext.Current.User != null)
    {
        var identity = (ClaimsIdentity)HttpContext.Current.User.Identity;
        roleId = Convert.ToInt32(identity.FindFirst("RoleId")?.Value);

        if (roleId == (int)Adani.Solution.DTO.Enums.Role.StateTrader || roleId == (int)Adani.Solution.DTO.Enums.Role.KAM)
        {
            labelName = "Customers";
        }
        else
        {
            labelName = "Employees";
        }
    }
}

<input type="hidden" class="currentMenu" value="tpdiscountUser" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_Discount")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Discounts </a><span class="icon-right"></span></li>
        <li><a href="DiscountUserList">User Discount</a><span class="icon-right"></span></li>
        <li class="active"> Add @Helper.GetResourceString("lbl_Discount")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddOrUpdateDiscountUser", "Pricing", FormMethod.Post, new { id = "frmDiscountUser", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.EncryptedId, new { id = "hdnId" })
                        @Html.HiddenFor(m => m.ParentValidFrom, new { id = "hdnParentValidFrom" })
                        @Html.HiddenFor(m => m.ParentValidTo, new { id = "hdnParentValidTo" })
                        @Html.HiddenFor(m => m.IsProcessed, new { id = "hdnIsProcessed" })
                        <div class="row form-group">
                            <div class="row form-group">

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">
                                        @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                                    </label>
                                    @(Html.Kendo().DropDownListFor(m => m.SalesOrganizationId)
                                        .Name("ddlSalesOrganization")
                                        .OptionLabel(@Helper.GetResourceString("plho-SelectSales"))
                                        .DataTextField("SalesOrganizationName")
                                        .Events(e => e.Change("onSaleChange"))
                                        .DataValueField("Id")
                                        .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                                        ).HtmlAttributes(new { tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                                    )
                                </div>
                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">
                                        @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                                    </label>
                                    @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
                                               .Name("ddlDistributionChannel")
                                              .OptionLabel(@Helper.GetResourceString("plho-SelectDistChannel"))
                                              .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                                              .DataTextField("DistributionChannelName")
                                              .DataValueField("Id")
                                              .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                                              .ServerFiltering(true))
                                              .HtmlAttributes(new { @class = "", tabindex = "5", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                                </div>

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">
                                        @Helper.GetResourceString("lbl_VerticleType") <span class="text-danger">*</span>
                                    </label>
                                    @(Html.Kendo().DropDownListFor(m => m.DivisionId)
                                       .Name("ddVerticalType")
                                      .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .Events(e => e.Change("onVerticalChange"))
                                      .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                      .ServerFiltering(true))
                                      .HtmlAttributes(new { @class = "", tabindex = "5", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_VerticleType"), @style = "width:100%" }))
                                </div>

                                <div class="col-lg-3 col-sm-6 mb-3">
                                    <label class="custom_label">
                                        @Helper.GetResourceString("lbl_Discount") <span></span> <span class="text-danger">*</span>
                                    </label>
                                    @Html.TextBoxFor(m => m.ActualDiscount, new { id = "txtDiscount", @class = "form-control decimalValue", tabindex = "5", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Discount"), @maxlength = (int)InputMaxLength.Price })
                                   

                                </div>

                                @*<div class="col-lg-3 col-sm-6 mb-3">
            <label class="custom_label">  @Helper.GetResourceString("lbl_OilType") <span class="text-danger">*</span> </label>
            @Html.HiddenFor(m => m.OilTypeName, new { id = "hdnOilTypeId" })
            @(Html.Kendo().DropDownListFor(m => m.OilTypeId)
