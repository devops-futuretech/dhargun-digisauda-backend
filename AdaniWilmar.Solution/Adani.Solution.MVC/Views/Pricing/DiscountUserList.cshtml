@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Common
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using System.Security.Claims
@model LoginUserIdDto
@{
    ViewBag.Title = "DiscountUserList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var userid = string.Empty;
    var roleId = 0;
    if (HttpContext.Current.User != null)
    {
        var identity = (ClaimsIdentity)HttpContext.Current.User.Identity;
        userid = identity.FindFirst("UserId")?.Value;
        roleId = Convert.ToInt32(identity.FindFirst("RoleId")?.Value);
    }
}

<input type="hidden" class="currentMenu" value="tpdiscountUser" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title"> User @Helper.GetResourceString("lbl_Discount")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Discounts</a><span class="icon-right"></span></li>
        <li class="active">User @Helper.GetResourceString("lbl_Discount")<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">
            @if (Helper.CheckClaims(Claims.ManageDiscounts))
            {
                <a href="@Url.Action("DiscountUserEditRedirect", "Pricing")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateDiscount")</a>
            }
        </div>
    </div>*@
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        @*<div class="panel-heading">
        </div>*@
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSecondaryFreights">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3 mt-3">
                        <label class="custom_label">
                            Date
                        </label>
                        @(Html.Kendo().DatePickerFor(m => m.Date)
                                          .Value(DateTime.Now)
                                          .Format(Settings.DateFormat)
                                          //.Events(e => e.Change("fromChange"))
                                          .HtmlAttributes(new { id = "StartDate", onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>
                </div>
                <div class="row form-group">
                    @*<div class="col-md-5">
                </div>*@
                    <div class="col-md-12 text-right">
                        <button type="button" tabindex="4" id="btnDiscount" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Search") </button>
                    </div>
                </div>


            </div>
            <div class="row" id="dvDealers">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick='downloadUserDiscount()' type="button">Excel</span>
                                @*<span class="export-link" onclick='ExportToExcel("GridCustomerDiscount")' type="button">Excel</span>*@
                            </div>
                        </div>
                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("ViewDepots")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        <div class="period-wrapper">
                            @if (Helper.CheckClaims(Claims.ManageDiscounts))
                            {
                                <a href="@Url.Action("DiUERedirect", "Pricing")" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateDiscount")</a>
                            }
                        </div>
                    </div>
                    @(Html.Kendo().Grid<SkuDepotDiscountDto>()
                          .Name("GridCustomerDiscount")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.DiscountType).Visible(false);
                              columns.Bound(c => c.SalesOrganization).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Sales Organisation").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.DistributionChannel).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Distribution Channel").Width(Settings.GridColumnMaxWidth);
                             // columns.Bound(c => c.Division).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Division Name").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Division).ClientTemplate(@"<div> <a style='text-decoration: underline;' href='" + Url.Action("DiUERedirect", "Pricing", new { EncryptedId = "#=EncryptedId#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=Division#</a> </div>").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Division").Width(Settings.GridColumnMaxWidth);
                              //columns.Bound(c => c.OilTypeCode).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("OilType Code").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ValidFrom).Format(Settings.GridDateTimeFormat).Title(@Helper.GetResourceString("lbl_ValidFrom")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                              columns.Bound(c => c.ValidTo).Format(Settings.GridDateTimeFormat).Title(@Helper.GetResourceString("lbl_ValidTo")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              // columns.Bound(c => c.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("msg_Status")).ClientTemplate(@"<div style='text-align: center;'> #if(IsActive == false) { #"
                              //   + " <a  title='" + @Helper.GetResourceString("msg_Inactive") + "'><i class='icon-cancel-square2 faicon-red' ></i></a>   #}else{#<a title='" + @Helper.GetResourceString("msg_Active") + "'><i  class='icon-checkbox-checked2 faicon-green' ></i></a> #}# </div>").Width(Settings.GridColumnMaxWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Resizable(resize => resize.Columns(true))
                          .Events(events => events.DataBound("onCustomerDiscountDataBound"))
                          .ClientDetailTemplateId("usertemplate")
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Sort(sort => sort.Add("Id").Descending())
                          .Model(model => { model.Id(p => p.Id); })
                          .ServerOperation(true)
                          .Read(read => read.Action("GetDiscountUserListAsync", "Pricing").Data("additionalParam"))))
                </div>
            </div>
        </div>
    </div>
</div>

<script id="usertemplate" type="text/kendo-tmpl">

    @(Html.Kendo().Grid<Adani.Solution.DTO.DiscountUserQuantityOutput>()
          .Name("grid_#=Id#")       //template expression, to be evaluated in the master context
          .Columns(columns =>
          {
              columns.Bound(c => c.SkuName).Title(@Helper.GetResourceString("lbl_SkuName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
              columns.Bound(c => c.SkuCode).Title(@Helper.GetResourceString("lbl_SkuCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
              columns.Bound(c => c.Discount).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Discount")).Width(Settings.GridColumnMaxWidth);
              columns.Bound(c => c.StateName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_State")).Width(Settings.GridColumnMaxWidth);
              columns.Bound(c => c.EmployeeName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_EmployeeName")).Width(Settings.GridColumnMaxWidth);
              columns.Bound(c => c.Email).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_Email")).Width(Settings.GridColumnMaxWidth);
              columns.Bound(c => c.MobileNumber).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title(@Helper.GetResourceString("lbl_MobileNumber")).Width(Settings.GridColumnMaxWidth);
              //columns.Bound(c => c.Status).HeaderTemplate("").Title(@Helper.GetResourceString("msg_Status")).ClientTemplate(@"\\#=checkstatus(Status)\\#").Width(Settings.GridColumnMaxWidth);
          })
          .DataSource(dataSource => dataSource
              .Ajax()
              .PageSize(10)
              .Read(read => read.Action("GetDiscountUserDetailListAsync", "Pricing", new { discountId = "#=Id#" }))
          )
          .Pageable()
          .Sortable()
          .Scrollable(s => s.Enabled(true).Height("auto"))
          .Reorderable(reorder => reorder.Columns(true))
          .Resizable(resize => resize.Columns(true))
          .ToClientTemplate())
</script>

<script>

    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();
        $("#btnDiscount").click(function () {
            //$("#TodayPricing").data("kendoGrid").dataSource.read();
            GetDiscount()
        });
        if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
        }
    });

    function GetDiscount() {
        $("#GridCustomerDiscount").data("kendoGrid").dataSource.read();
    }

        //Grid data load param
    function additionalParam() {
        return {
            Date: ($("#StartDate").val() === "" ? "" : $("#StartDate").val()),
            isToReturnInactiveData:true
        };
    }

    //function checkstatus(status) {
    //    if (status) {
    //        return "<center><i  class='icon-checkbox-checked2 faicon-green' ></i></center>";
    //    }
    //    else {
    //        return "<center><i class='icon-cancel-square2 faicon-red' ></i></center>";
    //    }
    //}

    //Method to data bound event for owner
    function onCustomerDiscountDataBound(e) {
        SetEmptyRow(e);
        //this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
    function downloadUserDiscount() {

        $.ajax({
            type: "POST",
            url: '@Url.Action("DiscountUserListExport", "Pricing")',
            data: {
                Id: Number(0),
                Date: ($("#StartDate").val() === "" ? "" : $("#StartDate").val()),
            },
            success: function (responce) {

                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Report")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");

                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }
    function onDiscountTypeChange() {
        $("#GridCustomerDiscount").data("kendoGrid").dataSource.read();
    }

    function additionalInfo() {
        var seletedType = $("#ddlDiscounyType").data("kendoDropDownList").value();
        return {
            isToReturnInactiveData: true,
            discountType: Number(seletedType)
        }
    }
</script>


