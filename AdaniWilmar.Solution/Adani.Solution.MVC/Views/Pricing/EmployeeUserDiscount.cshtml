        MultiSelectIndividualSelect("ddlSku", "skuSelectAll");
    }

    function onSkuDataBound() {
        MultiSelectIndividualSelect("ddlSku", "skuSelectAll");
    }


    function userAssignedData() {
                var verticalId = 0;
                var distributionChannelId = 0;
        var salesOrganizationId = 0;
        var stateId = 0;

        if ($("#hdnSalesOrganizationId").val() != "") {
            salesOrganizationId = $("#hdnSalesOrganizationId").val();
        }

        if ($("#hdnDistributionChannelId").val() != "") {
            distributionChannelId = $("#hdnDistributionChannelId").val();
        }

        if ($("#hdnVerticleId").val() != "") {
            verticalId = $("#hdnVerticleId").val();
        }
        if ($("#hdnStateId").val() != "") {
            stateId = $("#hdnStateId").val();
        }

        return {
            verticalId: verticalId,
            SalesOrganizationId: salesOrganizationId,
            DistributionChannelId: distributionChannelId,
            StateId: stateId
           }
        }

    function fromChange() {
        var endPicker = $("#dpEmpToDate").data("kendoDateTimePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#dpEmpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateTimeFormat));
            endPicker.min(startDate);
        }
    }

    function empFromChange() {
        var endPicker = $("#dpEmpToDate").data("kendoDateTimePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#dpEmpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateTimeFormat));
            endPicker.min(startDate);
        }
    }

    function StartDateRange() {
        var endPicker = $("#dpEmpToDate").data("kendoDateTimePicker"),
            startDate = $("#dpEmpToDate").val();

        if (startDate) {
            startDate = new Date(startDate);
            $("#dpEmpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateTimeFormat));
            endPicker.min(startDate);
        }
    }

    function setDefaultDate() {
        var dates = new Date();
        dates.setDate(dates.getDate());
        $("#dpEmpToDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateTimeFormat));
        $("#dpEmpFromDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateTimeFormat));
        StartDateRange();
    }

    function setEmployeeDefaultDate() {
        debugger;
        var fromDate = $("#dpFromDate").data("kendoDateTimePicker").value();
        var toDate = $("#dpToDate").data("kendoDateTimePicker").value();

        //Set default date
        $("#dpEmpFromDate").val(kendo.toString(kendo.parseDate(fromDate), emamiGlobal.constant.DateTimeFormat));
        $("#dpEmpToDate").val(kendo.toString(kendo.parseDate(fromDate), emamiGlobal.constant.DateTimeFormat));

        //Set min and max date
        var empFromPicker = $("#dpEmpFromDate").data("kendoDateTimePicker");
        empFromPicker.min(fromDate);
        empFromPicker.max(toDate);

        var empToPicker = $("#dpEmpToDate").data("kendoDateTimePicker");
        empToPicker.min(fromDate);
        empToPicker.max(toDate);
    }

    //Employee dropdown
    function onEmployeeChange() {
        MultiSelectIndividualSelect("ddlUser", "employeeSelectAll");
    }

    function onEmployeeDataBound() {
        MultiSelectIndividualSelect("ddlUser", "employeeSelectAll");
    }

</script>