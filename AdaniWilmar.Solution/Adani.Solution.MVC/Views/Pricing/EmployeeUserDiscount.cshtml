                                {
                                    <button type="submit" id="btnSave" tabindex="12" class="k-primary k-button">@Helper.GetResourceString("btn_Save")<i class="icon-arrow-right14 position-right"></i></button>
                                }
                            </div>
                        </div>
                    }
                    <!---end of form input-->
                </div>
            </div>
        </div>
    </div>
</div>



<script>

    $(document).ready(function () {

        setDefaultDate();
        setEmployeeDefaultDate();
        //var dropdown = $("#ddVerticalType").data("kendoDropDownList");
        //dropdown.readonly();
        //dropdown = $("#ddlOilType").data("kendoDropDownList");
        //dropdown.readonly();
        dropdown = $("#ddlSkuName").data("kendoMultiSelect");
        dropdown.readonly();
        $("#txtDiscount").prop("readonly", true);
        $("#txtState").prop("readonly", true);
        var datePicker = $("#dpFromDate").data("kendoDateTimePicker");
        datePicker.readonly();
        datePicker = $("#dpToDate").data("kendoDateTimePicker");
        datePicker.readonly();
        $("#txtEmpActualDiscount").val('');



        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        //Save the form data
        $("#btnSave").click(function () {

            var isValidForm = $("#frmEmployeeUserDiscount").valid();

            var selectedPlant = $("#ddlPlantId").data("kendoMultiSelect");
            if (selectedPlant) {
                var data = selectedPlant.value();
            }

            if (isValidForm) {
                window.kendo.ui.progress($("#pageLoader"), true);
                $("#frmEmployeeUserDiscount").submit();
                //window.kendo.ui.progress($("#pageLoader"), false);
            }
        });

        //Clear all form fields
        $("#btnCancel").click(function () {
            var dataSource = $("#ddlUser").data("kendoMultiSelect");
            dataSource.value("0");
            dataSource = $("#ddlSkuName").data("kendoMultiSelect");
            dataSource.value("0");
            //dataSource = $("#ddlOilType").data("kendoDropDownList");
            //dataSource.value("0");
            $("#txtDiscount").val('');
            $("#cbActiveInactive").prop("checked", false);
        });

        $("#employeeSelectAll").click(function () {
            MultiSelectSelectAll("ddlUser", "employeeSelectAll");
        });
    });

