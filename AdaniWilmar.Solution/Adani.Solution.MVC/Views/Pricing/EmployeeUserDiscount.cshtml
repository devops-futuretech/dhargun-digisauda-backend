                                     .HtmlAttributes(new { id = "ddlUser", @class = "", tabindex = "7", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_CustomerName"), @style = "width:100%" }))
            </div>
        }

        <div class="col-md-2 text-right">
            @Helper.GetResourceString("lbl_Discount") <span></span> <span class="text-danger">*</span>
        </div>
        <div class="col-md-3">
            @Html.TextBoxFor(m => m.EmpActualDiscount, new { id = "txtEmpActualDiscount", @class = "form-control decimalValue", tabindex = "8", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Discount"), @maxlength = (int)InputMaxLength.Discount })
        </div>
