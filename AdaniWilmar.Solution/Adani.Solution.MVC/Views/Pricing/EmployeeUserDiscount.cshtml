@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.MVC.Common
@using System.Security.Claims
@model Adani.Solution.DTO.EmployeeUserDiscountDto

@{
    ViewBag.Title = "EmployeeUserDiscount";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var roleId = 0;
    var labelName = "";

    if (HttpContext.Current.User != null)
    {
        var identity = (ClaimsIdentity)HttpContext.Current.User.Identity;
        roleId = Convert.ToInt32(identity.FindFirst("RoleId")?.Value);

        if (roleId == (int)Adani.Solution.DTO.Enums.Role.StateTrader || roleId == (int)Adani.Solution.DTO.Enums.Role.KAM)
        {
            labelName = "Customers";
        }
        else
        {
            labelName = "Employees";
        }
    }
}

<input type="hidden" class="currentMenu" value="tpdiscountEmployee" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">@Helper.GetResourceString("lbl_Discount")</h2>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="pageLoader">
