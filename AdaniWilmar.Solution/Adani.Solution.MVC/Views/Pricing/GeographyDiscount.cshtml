                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label" for="txtDiscountReason">
                                    @Helper.GetResourceString("lbl_DiscountReason") <span class="text-danger">*</span>
                                </label>
                                @Html.TextBoxFor(m => m.DiscountReason, new { id = "txtDiscountReason", tabindex = "9", @class = "form-control input-width", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_DiscountReason"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                            </div>

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label" for="dpFromDate">
                                    @Helper.GetResourceString("lbl_ValidFrom") <span class="text-danger">*</span>
                                </label>
                                @(Html.Kendo().DateTimePickerFor(m => m.ValidFrom)
                                  .Name("dpFromDate")
                                  .Format(Settings.DateTimeFormat)
                                  .Interval(1)
                                  .Events(e => e.Change("fromChange"))
                                  .HtmlAttributes(new { tabindex = "10", @class = "input-width", onkeydown = "return isFocus(event);" }))
                            </div>

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label" for="dpToDate">
                                    @Helper.GetResourceString("lbl_ValidTo") <span class="text-danger">*</span>
                                </label>
                                @(Html.Kendo().DateTimePickerFor(m => m.ValidTo)
                                  .Name("dpToDate")
                                  .Format(Settings.DateTimeFormat)
                                  .Interval(1)
                                  .Events(e => e.Change("toChange"))
                                  .HtmlAttributes(new { tabindex = "11", @class ="input-width", onkeydown = "return isFocus(event);" }))
                            </div>

                            <div class="col-lg-2 col-sm-4 mb-2" style="margin-left: 0px">
                                <label class="custom_label">Status</label>
                                <div class="custom_checkbox_main">
                                    <label class="custom_checkbox">
                                        @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "12" })
                                        <span class="checkmark check_tick"></span>
                                        <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="row form-group">                            
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label" for="cbMapCities">
                                    @Helper.GetResourceString("lbl_AppliesTo") <span class="text-danger">*</span>
                                </label>
                                <div>@(Html.Kendo().CheckBox().Name("MapCities").HtmlAttributes(new { id = "cbMapCities", tabindex = "13" }))</div>
                                <br />
                                <a href="#" onclick="showMapCitiesPopup()"><span id="selectedCityCount">0</span> <span>cities selected</span></a>
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-12 text-right">
                                <button type="button" tabindex="12" id="btnCancel" onclick="location.href = '@Url.Action("GeographyDiscountList", "Pricing")'" class="k-button  k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.ManageGeographyDiscount))
                                {
                                    <button type="button" id="btnSave" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

