                                              .Name("ZoneId")
                                              .DataTextField("Name")
                                              .DataValueField("Id")
                                              .Events(e => e.Change("onZoneChange").DataBound("onZoneDatabound"))
                                              .DataSource(source => source.Read(read => read.Action("GetZoneListddl", "Lookup", new { isToReturnInactiveData = true }))
                                              .ServerFiltering(false))
                                              .HtmlAttributes(new { id = "ddlZone", tabindex = "10", required = "required", @class = "form-control input-width", data_msg_required = Helper.GetSelectMsgRequired("lbl_Zone") }))
