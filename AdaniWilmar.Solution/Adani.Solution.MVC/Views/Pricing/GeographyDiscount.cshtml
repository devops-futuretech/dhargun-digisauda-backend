@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.MVC.Common
@model Adani.Solution.DTO.DiscountInputDto

@{
    ViewBag.Title = "GeographyDiscount";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{ 
    bool isEdit = Model.EncryptedId != null ? true : false;
    var currentDate = DateTime.Now;
}

<style>
    .k-grid {
        width: 50%;
    }

    .text-box single-line {
        width: 90% !important;
    }

    .k-grid {
        width: 100% !important;
    }
</style>

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="tpdiscountGeography" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_AddOrUpdateGeographyDiscount")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#"> Discounts </a><span class="icon-right"></span></li>
        <li><a href="GeographyDiscountList">@Helper.GetResourceString("lbl_GeographyDiscounts")</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_AddOrUpdateGeographyDiscount")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="divLoader">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddOrUpdateGeographyDiscount", "Pricing", FormMethod.Post, new { id = "frmGeographyDiscount", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.EncryptedId, new { id = "hdnId" })

                        <div class="row form-group">
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label" for="ddlSalesOrganization">
                                    @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                                </label>
                                @(Html.Kendo().DropDownListFor(m => m.SalesOrganizationId)
                                  .Name("ddlSalesOrganization")
                                  .OptionLabel(@Helper.GetResourceString("plho-SelectSales"))
                                  .DataTextField("SalesOrganizationName")
                                  .DataValueField("Id")
                                  .Events(e => e.Change("onSaleChange"))
                                  .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup")))
                                      .HtmlAttributes(new { tabindex = "1", @class = "form-control input-width", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization") }))
                            </div>

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label" for="ddlDistributionChannel">
                                    @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                                </label>
                                @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
                                  .Name("ddlDistributionChannel")
                                  .OptionLabel(@Helper.GetResourceString("plho-SelectDistChannel"))
                                  .DataTextField("DistributionChannelName")
                                  .DataValueField("Id")
                                  .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                                  .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam")).ServerFiltering(true))
                                  .HtmlAttributes(new { tabindex = "2", required = "required", @class = "form-control input-width", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel") }))
                            </div>

                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label" for="ddVerticalType">
