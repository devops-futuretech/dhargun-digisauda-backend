<div id="cityPopupgfdh" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close model-header-color" data-dismiss="modal">&times;</button>
                <h6 class="panel-title model-header-color"><span class="text-semibold">Add Details</span></h6>
            </div>

            <div class="modal-footer">
                <button id="btnSave" type="button" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Save")</button>
                <button id="btnDirtyCancel" type="button" onclick="popupClose();" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Cancel")</button>
            </div>
        </div>
    </div>
</div>


<script>

    //var selectedCityArr = [];
    var selectedCityArr = [];
    var selectedCityRow = [];

    $(document).ready(function () {
        if ('@Model.DivisionId' > 0) {
          //  $("#ddVerticalType").data("kendoDropDownList").readonly(true);
        }

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        if ('@Model.Id' === '0') {
            StartDateRange();
            $("#txtActualDiscount").val('');
        }
        else {
            //$("#ddlOiltypes").data("kendoDropDownList").readonly(true);
            //$("#ddlSku").data("kendoMultiSelect").readonly(true);

            if (@Model.RoleId != 12)
            {
                var startDate = $("#dpFromDate").data("kendoDateTimePicker").value();
                var endDate = $("#dpToDate").data("kendoDateTimePicker").value();
                var currentDate = new Date('@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")');

                if (startDate < currentDate) {
                    $("#dpFromDate").data("kendoDateTimePicker").readonly();
                }

                if (endDate < currentDate) {
                    $("#dpToDate").data("kendoDateTimePicker").readonly();
                }
            }


            @if (@Model.CityId != null)
            {
                foreach (var id in Model.CityId)
                {
                    @:selectedCityArr.push(Number("@id"));
                }
            }

            @if(@Model.Cities != null)
            {
                foreach (var data in Model.Cities)
                {
                    @:selectedCityPush(@data.ZoneId, @data.StateId, @data.TerritoryId, @data.DistrictId, @data.CityId);
                }
            }
        }

        $("#btnSave").click(function () {

            var isValidForm = $("#frmGeographyDiscount").valid();
            if (isValidForm) {
                var token = $('input[name="__RequestVerificationToken"]', $('#frmGeographyDiscount')).val();
                var data = {
                    EncryptedId: $("#hdnId").val(),
                    DivisionId: $("#ddVerticalType").val(),
                    SalesOrganizationId: $("#ddlSalesOrganization").val(),
                    DistributionChannelId: $("#ddlDistributionChannel").val(),
                    SkuIds: $("#ddlSku").val(),
                    ValidFrom: $("#dpFromDate").val(),
                    ValidTo: $("#dpToDate").val(),
                    ActualDiscount: $("#txtActualDiscount").val(),
                    DiscountReason: $("#txtDiscountReason").val(),
                    OilTypeId: $("#ddlOilType").data("kendoDropDownList").value(),
                    PackGroupId: $("#ddlOilPackingType").data("kendoDropDownList").value(),
                    PackTypeId: $("#ddlPackType").data("kendoDropDownList").value(),
                    IsActive: $("#cbActiveInactive").prop("checked"),
                    Cities: JSON.parse(JSON.stringify(selectedCityRow))
                };

                 window.kendo.ui.progress($("#divLoader"), true);
                 moduleCommon.Common.AjaxCall({
                    type: 'Post',
                    url: '@Url.Action("AddOrUpdateGeographyDiscount", "Pricing")',
                    data: { __RequestVerificationToken: token, model : data },
                    success: function (result) {
                        if (result.PostStatus == true) {
                            ShowSuccessMessage(result.PostMessage);
                            setTimeout(function () {
                                window.kendo.ui.progress($("#divLoader"), false);
                                window.location.href = '@Url.Action("GeographyDiscountList", "Pricing")';
                            }, 1500);
                        } else {
                            ShowErrorMessage(result.PostMessage);
                            window.kendo.ui.progress($("#divLoader"), false);
                        }
                    }
                });
            }
        });

        $("#cbMapCities").click(function () {
            if($(this).is(":checked")){
                $("#cityPopup").modal("show");
            }
        });

        $("#skuSelectAll").click(function () {
            MultiSelectSelectAll("ddlSku", "skuSelectAll");
        });


        if ('@isEdit' !== 'True')
        {
            var now = new Date();
            now.setHours(23);
            now.setMinutes(59);
            now.setSeconds(0);
            $("#dpToDate").data("kendoDateTimePicker").value(now);
        }
    });

    $(document).on("change", "input[type='checkbox'].rowCheckbox", function () {
        var row = $(this).closest("tr");
        var dataItem = $("#GridCityDetails").data("kendoGrid").dataItem(row);

        if (this.checked) {
            selectedCityArr[dataItem.Id] = dataItem;
        }
        else {
            delete selectedCityArr[dataItem.Id];
        }
    });

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddVerticalType").data("kendoDropDownList").dataSource.read();

    }
    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddVerticalType").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
