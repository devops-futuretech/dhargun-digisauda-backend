    //Multiselect checkbox Check and UnCheck based on event
    function MultiSelectCheckUnCheck(DropDownName, CheckBoxName) {
        var dropdown = $("#" + DropDownName + "").data("kendoMultiSelect");
        if (dropdown) {
            var allIds = dropdown.dataSource.data().map(function (dataItem) { return dataItem.Id; });            //Select all ids from dropdown
            if ($("#" + CheckBoxName + "").is(":checked")) {
                dropdown.value(allIds);
            } else {
                dropdown.value([]);
            }
        }
    }




    function selectIndividualPrice(arg) {
        gridIndividualDataSelect(arg, "ViewFinalPriceList", "selectAllPrice");
    }

    function MultiSelectEvents(DropDownName, CheckBoxName) {
        var dropdown = $("#" + DropDownName + "").data("kendoMultiSelect");
        if (dropdown) {
            var selectedValueCount = dropdown.value().length;              //Selected value length
            var totalValueCount = dropdown.dataSource.data().length;       //Dropdown total value count
            if (selectedValueCount > 0 && totalValueCount > 0 && selectedValueCount === totalValueCount) {
                $("#" + CheckBoxName + "").prop("checked", true);
            } else {
                $("#" + CheckBoxName + "").prop("checked", false);
            }
        }
    }

    function selectAllPrices(arg) {    //Multiselect Select all checkbox Check and UnCheck based on data count
        gridSelectAllData(arg, "ViewFinalPriceList", "individualPriceSelect")
    }

    function onFinalPricingtDataBound(e) {
        //Get gride object
        gridDataBound(e, "ViewFinalPriceList");
    }


    function gridDataBound(e, gridName) {
        //Get gride object
        
        var gridObject = $("#" + gridName + "").data("kendoGrid");
        var gridItems = gridObject.items();
        var recordsOnCurrentView = gridObject.dataSource.view().length;                        //records on current view / page      

        if (gridItems) {
            gridItems.each(function (index) {
                var rowItem = gridObject.dataItem(this);
                if (rowItem) {
                    if (selectedIds) {
                        var isValid = selectedIds.indexOf(rowItem.Id) !== -1;
                        if (isValid) {
                            rowItem.set("IsChecked", true);
                        } else {
                            rowItem.set("IsChecked", false);
                        }
                    }
                }
            });
        }

        var selectedRowData = $("input:checked", gridObject.tbody).closest("tr");              // Get selected rows
        checkBoxChanges(selectedRowData, recordsOnCurrentView, "selectAllPrice");
    }

    /*
        Grid checkbox check and uncheck based on events
        Checked data get and push to global array
        UnChecked data remove from array
        Display selected data total count for display purpose
        */
    function gridIndividualDataSelect(arg, gridName, headerCheckboxName) {
        
        var gridObject = $("#" + gridName + "").data("kendoGrid");                            // Get grid object
        var selectedRow = gridObject.dataItem($(arg).closest("tr"));
        var recordsOnCurrentView = gridObject.dataSource.view().length;                       //records on current view / page
        var selectedRowData = $("input:checked", gridObject.tbody).closest("tr");             // Get selected rows
        var rowItem = gridObject.dataItem(this);

        checkBoxChanges(selectedRowData, recordsOnCurrentView, headerCheckboxName);

        if (selectedRow) {
            //Event is checked
            if ($(arg).is(':checked')) {

                selectedIds.push(selectedRow.Id);
                selectedRows.push(selectedRow);

                //selectedRow.set("IsChecked", true);

            } else {   //Event is unchecked

                //$(arg).prop("checked", false);
                //selectedRow.set("IsChecked", false);

                if (selectedIds) {
                    var index1 = selectedIds.indexOf(selectedRow.Id);
                    if (index1 !== -1) {
                        selectedIds.splice(index1, 1);
                    }
                }
                if (selectedRows) {
                    var index2 = selectedRows.findIndex(function (data) { return data.Id === selectedRow.Id });
                    if (index2 !== -1) {
                        selectedRows.splice(index2, 1);
                    }
                }
            }
        }
    }


    /*
        Grid checkbox check and uncheck based on events
        Checked data get and push to global array
        UnChecked data remove from array
        Display selected data total count for display purpose
        */
    function gridSelectAllData(arg, gridName, clientCheckboxName) {
        
        //Get Grid object
        var gridObject = $("#" + gridName + "").data("kendoGrid");
        var gridData = gridObject.dataSource.data();
        var gridData1 = gridObject.dataSource.page();

        if ($(arg).is(':checked')) {
            //Checkbox check
            $("." + clientCheckboxName + "").prop("checked", true);

            if (gridData) {

                gridData.forEach(function (rowData, index) {
                    if (rowData) {
                        if (selectedIds) {
                            var index1 = selectedIds.indexOf(rowData.Id);
                            if (index1 === -1) {
                                selectedIds.push(rowData.Id);
                            }
                        }
                        if (selectedRows) {
                            var index2 = selectedRows.findIndex(function (data) { return data.Id === rowData.Id });
                            if (index2 === -1) {
                                selectedRows.push(rowData);
                            }
                        }
                    }
                });
            }
        } else {
            //Checkbox uncheck
            $("." + clientCheckboxName + "").prop("checked", false);

            if (gridData) {

                gridData.forEach(function (rowData, index) {
                    if (rowData) {
                        if (selectedIds) {
                            var index1 = selectedIds.indexOf(rowData.Id);
                            if (index1 !== -1) {
                                selectedIds.splice(index1, 1);
                            }
                        }
                        if (selectedRows) {
                            var index2 = selectedRows.findIndex(function (data) { return data.Id === rowData.Id });
                            if (index2 !== -1) {
                                selectedRows.splice(index2, 1);
                            }
                        }
                    }
                });
            }
        }
    }

    //HeaderTemplate checkbox check or uncheck
    function checkBoxChanges(selectedRows, allRowCount, checkboxName) {

        if (selectedRows.length > 0 && allRowCount > 0 && selectedRows.length == allRowCount) {
            $("." + checkboxName + "").prop("checked", true);
        } else {
            $("." + checkboxName + "").prop("checked", false);
        }
    }

    function SaveRAPrice(e) {

        var isValidSearchParam = $("#finalPriceSaveForm").valid();

        var ddlBiddingWindow = $("#ddlBiddingWindow").data("kendoDropDownList").value();
        if (ddlBiddingWindow > 0) {
            isValidSearchParam = isValidSearchParam;
        }
        else {
            ShowErrorMessage("Please select a Bidding Window");
            isValidSearchParam = false;
        }
        if (isValidSearchParam) {

            if (selectedRows.length == 0) {
                ShowErrorMessage("Please select the Sku to Proceed and Already Mapped Sku not able change");
                return false;
            }

            var messageText = ((selectedRows && selectedRows.length > 1) ? 'items' : 'item');
            var confirmText = "<span style='font-size:large'><strong>" + selectedRows.length + " " + messageText + " selected</strong></span>" + "</br></br>Are you sure you want to publish this " + messageText + "?";

            kendo.confirm(confirmText).then(function () {
                SaveFinalPrice(e);
            }, function () {
                window.kendo.ui.progress($("#div_Progress"), false);
            });
        }        
    }

</script>

