            if (e.action === "itemchange" && e.field === "XMarginCost") {

                // here you can access model items using e.items[0].modelName;
                var calculatedPrice = e.items[0].XMarginCost + e.items[0].BaseRate;
                e.items[0].FinalPrice = calculatedPrice;
