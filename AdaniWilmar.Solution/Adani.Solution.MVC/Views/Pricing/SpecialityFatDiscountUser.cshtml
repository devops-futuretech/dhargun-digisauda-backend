<script>

    $(document).ready(function () {



        if ('@Model.Id' === '0') {
            StartDateRange();
        }

        if ('@Model.Id' === '0') {
            if ('@Model.Id' > 0) {
                //formFieldReadOnly();
            } else {
                $("#txtDiscount").val('');
            }
        } else {
            formFieldReadOnly();
        }

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        //Save the form data
        $("#btnSave").click(function () {
            var isValidForm = $("#frmSpecialityFatDiscountUser").valid();

            if (isValidForm) {
                window.kendo.ui.progress($("#div_Progress"), true);
                $("#frmSpecialityFatDiscountUser").submit();
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });


        //$("#skuSelectAll").click(function () {
        //    MultiSelectSelectAll("ddlSkuName", "skuSelectAll");
        //});

        $("#empSelectAll").click(function () {
            MultiSelectSelectAll("ddlCustomerName", "empSelectAll");
        });

        var now = new Date();
        now.setHours(23);
        now.setMinutes(59);
        now.setSeconds(0);
        $("#dpToDate").data("kendoDateTimePicker").value(now);
    });

    //Readonly fields
    function formFieldReadOnly() {
         $("#ddVerticalType").data("kendoDropDownList").readonly(true);
        $("#ddlSalesOrganization").data("kendoDropDownList").readonly(true);
        $("#ddlDistributionChannel").data("kendoDropDownList").readonly(true);
        var dropdown = $("#ddVerticalType").data("kendoDropDownList");
        dropdown.readonly();
        dropdown = $("#ddlOilType").data("kendoDropDownList");
        dropdown.readonly();
        //dropdown = $("#ddlSkuName").data("kendoMultiSelect");
        //dropdown.readonly();

        var datePicker = $("#dpFromDate").data("kendoDateTimePicker");
        datePicker.readonly();
        datePicker = $("#dpToDate").data("kendoDateTimePicker");
        datePicker.readonly();
    }

    //Verticle Type Change Events
    function onVerticalTypeChange() {
        //clear
        //$("#ddlSkuName").data("kendoMultiSelect").dataSource.data([]);
        $("#ddlOilType").data("kendoDropDownList").dataSource.data([]);
        $("#ddlOilType").data("kendoDropDownList").dataSource.read();
        $("#ddlCustomerName").data("kendoMultiSelect").dataSource.read();
    }

    //Oiltype Change Events
    function onOilTypeChange() {
        //$("#ddlSkuName").data("kendoMultiSelect").dataSource.read();
    }

    //OilType loading additional parameters
    function oilTypeAdditionalInfo() {
        var verticleId = $("#ddVerticalType").data("kendoDropDownList").value();
        if (!verticleId) {
             if ('@Model.Id' != 0) {
                verticalId = '@Model.VerticleId';
            }
        }
        return {
            verticalId: Number(verticleId)
        }
    }

    //SkuName loading additional parameters
    function skuAdditionalInfo() {
        @*var oilTypeId = $("#ddlOilType").data("kendoDropDownList").value();
        if (!oilTypeId) {
            if ('@Model.Id' != 0) {
                oilTypeId = '@Model.OilTypeId';
            }
        }
        return {
            oiltypeId: Number(oilTypeId)
        }*@

        var oilType = $('#ddlOilType').data("kendoDropDownList").value();
        var subCategory = $('#ddlSubCategory').data("kendoDropDownList").value();

        return {
            oilTypeId: Number(oilType),
            subCategoryId: Number(subCategory),
        };
    }



    function fromChange() {
        var endPicker = $("#dpToDate").data("kendoDateTimePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#dpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateTimeFormat));
            endPicker.min(startDate);
        }
    }

    function StartDateRange() {
        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#dpFromDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateTimeFormat));
        $("#dpToDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateTimeFormat));

        var endPicker = $("#dpToDate").data("kendoDateTimePicker");
        endPicker.min(dates);
    }

    function StartDateRange() {
        var startDate = new Date();
        startDate.setDate(startDate.getDate());

        $("#dpFromDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateTimeFormat));   //Set default date
        var startPicker = $("#dpFromDate").data("kendoDateTimePicker");
        startPicker.min(startDate);

        var endPicker = $("#dpToDate").data("kendoDateTimePicker");                                             //Set min date
        $("#dpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateTimeFormat));
        endPicker.min(startDate);
    }

    //Sub category
    function subCategoryChange() {
        //$("#ddlSkuName").data("kendoMultiSelect").dataSource.read();
