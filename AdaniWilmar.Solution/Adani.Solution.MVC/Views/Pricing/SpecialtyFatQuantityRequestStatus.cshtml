@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO

@{
    ViewBag.Title = "SpecialtyFatQuantityRequestStatus";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="tpsfquantitylimitRequestStatus" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Quantity Request Details</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#"> Qty Limit </a><span class="icon-right"></span></li>
        <li class="active">Quantity Request Details<span class="icon-right"></span></li>
    </ol>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSFQuantityRequest">
                <div class="row form-group">
                    <div class="col-md-12">
                        <div class="text-right right-buttons">
                            @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        </div>
                        @(Html.Kendo().Grid<SpecialtyFatQuantityRequestDto>()
                                      .Name("ViewSFQuantityRequest")
                                      .Columns(columns =>
                                      {
                                          columns.Bound(c => c.CreatedBy).Title(@Helper.GetResourceString("lbl_CreatedBy")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                          columns.Bound(c => c.OilTypeName).Title(@Helper.GetResourceString("lbl_OilType")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                          //columns.Bound(c => c.OilTypeCode).Title("OilType Code").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                          //columns.Bound(c => c.SkuName).Title(@Helper.GetResourceString("lbl_SkuName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                                          //columns.Bound(c => c.SkuCode).Title(@Helper.GetResourceString("lbl_SkuCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                                          columns.Bound(c => c.Quantity).Title(@Helper.GetResourceString("lbl_RequestQuantityLimit")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                          columns.Bound(c => c.Status).Title(@Helper.GetResourceString("lbl_Status")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                      })
                                      .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                      .Filterable(filter => filter.Mode(GridFilterMode.Row))
                                      .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                                      .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                                      .Selectable(selectable => selectable
                                      .Mode(GridSelectionMode.Multiple)
                                      .Type(GridSelectionType.Row))
                                      .Scrollable(s => s.Enabled(true).Height("auto"))
                                      .Reorderable(reorder => reorder.Columns(true))
                                      .DataSource(dataSource => dataSource
                                      .Ajax()
                                      .Model(model => model.Id(m => m.Id))
                                      .ServerOperation(true)
                                      .Read(read => read.Action("GetSpecialtyFatQuantityRequestStatusAsync", "Pricing"))))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        // kendo grid filter contains
        FilterContains();

    });

</script>

