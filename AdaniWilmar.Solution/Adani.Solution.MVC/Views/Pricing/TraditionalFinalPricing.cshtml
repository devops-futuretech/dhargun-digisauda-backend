                                  columns.Bound(c => c.ExRakePrice).Format(Settings.PriceNumberFormat).Title("Ex Rake Price").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                                  columns.Bound(c => c.ForRakePrice).Format(Settings.PriceNumberFormat).Title("For Rake Price").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              })
                              .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                              .Filterable(filter => filter.Mode(GridFilterMode.Row))
                              //.Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                              .Excel(excel => excel.FileName("TraditionalProcessFinalPricing" + " " + DateTime.Now + ".xlsx").AllPages(true))
                              .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                              .Selectable(selectable => selectable
                              .Mode(GridSelectionMode.Multiple)
                              .Type(GridSelectionType.Row))
                              .Scrollable(s => s.Enabled(true).Height("auto"))
                              .Reorderable(reorder => reorder.Columns(true))
                              .Resizable(resize => resize.Columns(true))
                              .Events(events => events.DataBound("onFinalPricingtDataBound"))
                              .DataSource(dataSource => dataSource
                              .Ajax().ServerOperation(false)
                              .Model(model => model.Id(m => m.SkuId))
                              ))
                    </div>
                    <form id="finalPriceSaveForm">
                        <div class="row form-group" style="margin-top:15px;">
                            <div class="col-md-offset-4 col-md-4 text-right">
                                @Html.Label("Pricing Date ")
                                @(Html.Kendo().DatePicker().Name("PrincingDate")
                                      .Value(DateTime.Now)
                                      .Min(DateTime.Now.Date)
                                      .Enable(false)
                                      .HtmlAttributes(new { @id = "biddingDate", tabindex = "15", @class = "from-control", @required = "required" }))
