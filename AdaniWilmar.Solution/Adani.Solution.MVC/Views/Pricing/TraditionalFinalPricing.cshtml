                        1. Need to create or import the Pricing data (Material Cost,Packing Cost,Primary Freight,Secondary Freight,Depot Cost,Detention Cost,
                        Honeycomb Cost,Profit Margin,Cushion Margin,Scheme Cost).
                    </p>
                    <p>2. Price calculation will be done based on SKU Per Case.</p>
                    <p>3. Published price only showing in the sauda creation.</p>
                    <p>4. Discount and Premium are not applied to final price</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>      

    var selectedIds = [];
    var selectedRows = [];

    jQuery.fn.extend({
        serializeForm: function (element) {
            var config = {};
            $(this).serializeArray().map(function (item) {
                if (config[item.name]) {
                    if (typeof (config[item.name]) === "string") {
                        config[item.name] = [config[item.name]];
                    }
                    config[item.name].push(item.value);
                } else {
                    config[item.name] = item.value;
                }
            });
            return config;
        }
    });


    var searchParams = {};
    $(document).ready(function () {

        FilterContains(); //Grid Column Filter hide

        //$('#myModal').modal({
        //    show: 'true'
        //});

        $("#ddlSaudaBookingType").data("kendoDropDownList").value("1");
        $("#dvAlert").css("display", "none");

        if ('@Model.VerticalId' > 0) {
            $("#ddlVertical").data("kendoDropDownList").readonly(true);
        }

        $("#tmSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlTransportMode", "tmSelectAll");
        });

        $("#stateSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlState", "stateSelectAll");
            $("#ddlTerritory").data("kendoMultiSelect").dataSource.read();
            
        });

        $("#territorySelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlTerritory", "territorySelectAll");
            $("#ddlDistrict").data("kendoMultiSelect").dataSource.read();
        });

        $("#districtSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlDistrict", "districtSelectAll");
            $("#ddlCity").data("kendoMultiSelect").dataSource.read();
        });      

        $("#citySelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlCity", "citySelectAll");
        });
        
        $("#freightZoneSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlFreightZone", "freightZoneSelectAll");
            $("#ddlFreightRoute").data("kendoMultiSelect").dataSource.read();
        });

        $("#freightRouteSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlFreightRoute", "freightRouteSelectAll");
