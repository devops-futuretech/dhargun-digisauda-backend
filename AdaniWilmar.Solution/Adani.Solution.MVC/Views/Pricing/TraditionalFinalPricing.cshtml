    });

    //function onFinalPricingtDataBound(e) {
    //    SetEmptyRow(e);
    //}
    function SearchFinalPrice() {

        window.kendo.ui.progress($("#dvFinalPricing"), true);
        var isValidSearchParam = $("#frmSearchPricing").valid();
        if (isValidSearchParam) {
            searchParams = $("#frmSearchPricing").serializeForm();
            moduleCommon.Common.AjaxCall({
                type: 'Post',
                url: '@Url.Action("SearchFinalPrice", "Pricing")',
                data: $("#frmSearchPricing").serializeForm(),
                success: function (result) { 
                    if (result.PostStatus) {
                        selectedIds = [];
                        selectedRows = [];
                        var ds = new kendo.data.DataSource({
                            pageSize: emamiGlobal.constant.PageSize,
                            data: result.SkuFinalpriceList
                        });
                        $("#ViewFinalPriceList").data("kendoGrid").setDataSource(ds);
                        
                        if (result.ErrorMessage) {
                            ShowErrorMessageLeftAlign(result.ErrorMessage.join(", "));
                        }
                    } else {
                        ShowErrorMessage(result.PostMessage);
                    } 
                    window.kendo.ui.progress($("#dvFinalPricing"), false);
                },
                failure: function () {
                    ShowErrorMessage("Failure");
                    window.kendo.ui.progress($("#dvFinalPricing"), false);
                }
            });
        }
        else {
            window.kendo.ui.progress($("#dvFinalPricing"), false);
            return false;
        }
    }

    function SaveFinalPrice(event) {

        var isValidSearchParam = $("#finalPriceSaveForm").valid();
        if (isValidSearchParam) {

            if (selectedRows.length == 0) {
                ShowErrorMessage("Please select the Sku to Proceed and Already Mapped Sku not able change");
                return false;
            }
            
            window.kendo.ui.progress($("#dvFinalPricing"), true);
            moduleCommon.Common.AjaxCall({
                type: 'Post',
                url: '@Url.Action("SaveTraditionalFinalPricing", "Pricing")',
                data: { inputdto: searchParams, outputDto: JSON.parse(JSON.stringify(selectedRows)), BiddingDate: $("#biddingDate").data("kendoDatePicker").value().toISOString() },
                success: function (result) {                    
                    if (result.PostStatus) {  
                        selectedIds = [];
                        selectedRows = [];
                        $("#ViewFinalPriceList").data("kendoGrid").dataSource.data([]);                       
                        ShowSuccessMessage(result.PostMessage);
                        window.kendo.ui.progress($("#dvFinalPricing"), false);
                         //$('#ViewFinalPriceList input:checked:not(:disabled)').each(function (i,ele) { $(ele).prop("disabled", "true"); });
                    }
                    else {
                        ShowErrorMessage(result.PostMessage);
                        window.kendo.ui.progress($("#dvFinalPricing"), false);
                    }
                },
                failure: function () {
                    ShowErrorMessage("Failure");
                    window.kendo.ui.progress($("#dvFinalPricing"), false);
                }
            });
        } else {
            window.kendo.ui.progress($("#dvFinalPricing"), false);
            return false;
        }
    }

    function BookingTypeChange(e) {
        // 1 Reverse Auction
        // 2 Traditional Process
        if ($("#ddlSaudaBookingType").data("kendoDropDownList").value() == "1") {
            $('.bookingTypeTraditional').css("display", "block");
            $("#txtCounterBid").removeAttr("disabled");
            $("#txtBPCPJumb").removeAttr("disabled");
        }
        else {
            $('.bookingTypeTraditional').css("display", "none");
            $("#txtCounterBid").attr("disabled", "disabled");
            $("#txtBPCPJumb").attr("disabled", "disabled");
        }
    }

