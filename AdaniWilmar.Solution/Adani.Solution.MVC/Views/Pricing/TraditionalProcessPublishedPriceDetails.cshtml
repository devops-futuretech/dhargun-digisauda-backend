@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model  PricePublistInputDataDto
@{
    ViewBag.Title = "Traditional Process Published Price New";
}

<style>

    .k-confirm .k-window-titlebar::before {
        content: 'Confirmation';
    }

    .k-confirm .k-window-titlebar .k-dialog-title {
        visibility: collapse;
    }
</style>

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="tpfinalpriceTraditionalProcessGeneratePriceDetails" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Traditional Process Price</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#"> Final Price </a><span class="icon-right"></span></li>
        <li class="active">Traditional Process Price <span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
            <div class="period-wrapper">
                <b><i class="icon-plus-circle2"></i></b>
            </div>
        </div>*@
    <div style="clear:both;"></div>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSecondaryFreights">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_FromDate")
                        </label>
                        @(Html.Kendo().DatePickerFor(m => m.StartDate)
                                          .Value(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                                          .Format(Settings.DateFormat)
                                          .Events(e => e.Change("fromChange"))
                                          .HtmlAttributes(new { id = "StartDate", onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_ToDate") </label>
                        @(Html.Kendo().DatePickerFor(m => m.EndDate)
                                          //.Name("EndDate")
                                          .Value(DateTime.Now)
                                          .Format(Settings.DateFormat)
                                          .HtmlAttributes(new { id = "EndDate", onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_Plant") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownListFor(m => m.PlantId)
                                 .OptionLabel(@Helper.GetResourceString("plho_SelectPlant"))
                                 .DataTextField("Name")
                                 .DataValueField("Id")
                                 .DataSource(source => source.Read(read => read.Action("GetPlantListddlAsync", "Lookup"))
                                 .ServerFiltering(false))
                                 .HtmlAttributes(new { id = "ddlPlant", @class = "", tabindex = "2", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Plant"), @style = "width:100%" }))
                    </div>

                </div>
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                        @if (Model.RoleId == (long)Role.Admin || Model.RoleId == (long)Role.SubAdmin)
                        {
                            //<div class="col-md-3">
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .Events(e => e.Change("onVerticalTypeChange"))
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                            // </div>
                        }
                        else
                        {
                            //<div class="col-md-3">
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .Events(e => e.Change("onVerticalTypeChange"))
                              .Value(Model.DivisionId.ToString())
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%", @readonly = "readonly" }))
                            // </div>
                        }
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_OilType") 

                        @(Html.Kendo().DropDownListFor(m => m.OilTypeId)
                                                              .OptionLabel(@Helper.GetResourceString("plho_SelectOilType"))
                                                              .DataTextField("Name")
                                                              .DataValueField("Id")
                                                              //.Events(e => e.Change("onOilTypeChange").DataBound("onOilTypeDataBound"))
                                                              .DataSource(source => source.Read(read => read.Action("GetOilTypesBasedOnVerticalId", "Lookup", new { isToReturnInactiveData = false }).Data("oilTypeAdditionalInfo"))
                                                              .ServerFiltering(true))
                                                              .HtmlAttributes(new { id = "ddlOilType", @class = "", tabindex = "2", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_OilType"), @style = "width:100%" }))
                    </div>

                </div>
                    <div class="row form-group">
                        <div class="col-md-5">
                        </div>
                        <div class="col-md-12 text-right">
                            <button type="button" tabindex="4" id="btnGenerateLiftingList" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Search") </button>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="row form-group">
                            <div class="col-md-12">
                                <div class="text-right right-buttons">
                                    @*<button type="button" onclick="downloadZoneSuccessDataForAllRecords()" class="k-primary k-button">Download</button>*@

                                    @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                                </div>

                                @(Html.Kendo().Grid<FinalPriceGenerateListDto>()
                                     .Name("TPFinalPriceGenerate")
                                     .Columns(columns =>
                                     {
                                         //columns.Bound(c => c.Id).Visible(false);
                                         //columns.Bound(c => c.SAPPricingCode).Format(Settings.GridDateTimeFormat).Title("Pricing Date").Width(170);
                                         columns.Bound(c => c.SAPPricingCode).Title(@Helper.GetResourceString("lbl_SAP_PricingCode")).Width(170).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.SkuName).Title(@Helper.GetResourceString("lbl_SkuName")).Width(170).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.SkuCode).Title(@Helper.GetResourceString("lbl_SkuCode")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.OilTypeCode).Title(@Helper.GetResourceString("lbl_OilTypeCode")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.OilTypeName).Title(@Helper.GetResourceString("lbl_OilTypeName")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.OilPackingType).Title(@Helper.GetResourceString("lbl_OilPackingType")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.PlantCode).Title(@Helper.GetResourceString("lbl_PlantCode")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.PlantName).Title(@Helper.GetResourceString("lbl_PlantName")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.Price).Title(@Helper.GetResourceString("lbl_Price")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.SalesOrganizationName).Title(@Helper.GetResourceString("lbl_SalesOrganization")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.DistributionChannelName).Title(@Helper.GetResourceString("lbl_DistributorName")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.DivisionName).Title(@Helper.GetResourceString("lbl_Division")).Width(Settings.GridColumnMaxWidth);
                                         columns.Bound(c => c.ValidFrom).Format(Settings.GridDateTimeFormat).Title(@Helper.GetResourceString("lbl_ValidFrom")).Width(170);
                                         columns.Bound(c => c.ValidTo).Format(Settings.GridDateTimeFormat).Title(@Helper.GetResourceString("lbl_ValidTo")).Width(170);
                                         //columns.Bound(c => c.TotalState).Title("Total State").Width(Settings.GridColumnMaxWidth);
                                         //columns.Template(c => c.IsPublish).Title("Download")
                                         //.ClientTemplate(@"<div style='text-align: center;'><i onclick='downloadZoneSuccessData(#=Id#)' style='cursor: pointer;' class='icon-download4'></i></div>").Width(Settings.GridOtherColumnWidth);
                                         // columns.Template(c => c.IsPublish).Title("Publish")
                                         // .ClientTemplate(@"
                                         //<div style='text-align: center;'>
                                         //#if(PublishButtonStatus == emamiGlobal.PublishButtonStatus.PriceGenerating){#<div style='cursor: no-drop;'><button type='button' class='k-primary k-button' disabled>Price Generating</button></div>#}
                                         //else if(PublishButtonStatus == emamiGlobal.PublishButtonStatus.Publish){#<button style='width: 80px;' type='button' onclick='tpFinalPriceBulkPublish(#=Id#)' class='k-primary k-button'>Publish</button>#}
                                         //else if(PublishButtonStatus == emamiGlobal.PublishButtonStatus.Published){#<div style='cursor: no-drop;'><button type='button' class='k-primary k-button' disabled>Published</button></div>#}
                                         //else if(PublishButtonStatus == emamiGlobal.PublishButtonStatus.PriceGenerateFailed){#<div style='cursor: no-drop;'><button type='button' class='k-primary k-button' disabled>PriceGenerateFailed</button></div>#}#</div>").Width(Settings.GridOtherColumnWidth);
                                     })
                                     .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                     .Filterable(filter => filter.Mode(GridFilterMode.Row))
                                     .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                                     .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                                     .Selectable(selectable => selectable
                                     .Mode(GridSelectionMode.Multiple)
                                     .Type(GridSelectionType.Row))
                                     .Scrollable(s => s.Enabled(true).Height("auto"))
                                     .Reorderable(reorder => reorder.Columns(true))
                                     .Resizable(resize => resize.Columns(true))
                                     .DataSource(dataSource => dataSource
                                     .Ajax()
                                     .Sort(s => s.Add("Id").Descending())
                                     .Read(read => read.Action("GetGeneratedPriceList", "Pricing").Data("additionalParam"))
                                     .Model(model => model.Id(m => m.DivisionId))
                                     .ServerOperation(true)))
                            </div>
                        </div>
                    </div>

                    

                </div>
            </div>
    </div>
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header" style="font-size:16px;color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" style="font-size: 26px;color:#fff;">&times;</button>
                    <h4 class="modal-title">Notes:</h4>
                </div>
                <div class="modal-body" style="font-size: 14px;line-break: normal;line-height: 2.5;">
                    <p> 1. Trade ticket is mandatory for Sauda(HBC) creation in SAP.</p>
                    <p> 2. Total proportion value should be hundred(100).</p>
                    <p> 3. After creation of trade ticket in the DS portal, Trade ticket number will come from SAP.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    $(document).ready(function () {

        setFromToDateRange("StartDate", "EndDate", emamiGlobal.constant.IndentDateRange);

        // kendo grid filter contains
        FilterContains();

        $("#btnGenerateLiftingList").click(function () {
            //$("#TPFinalPriceGenerate").data("kendoGrid").dataSource.read();
            getTPGeneratedPrice()

            console.log("Checkkd")
        });

        //Set default date
        //setDefaultDate();

    });


    function getStatus(id) {
        alert(id);
    }
    function oilTypeAdditionalInfo() {
        var DivisionId = $("#ddlVertical").data("kendoDropDownList").value();
        return {
            verticalId: Number(DivisionId)
        };
    }

    //Set default date
    function setDefaultDate() {
        var dates = new Date();
        dates.setDate(dates.getDate());
        $("#StartDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
    }

    //Grid data load param
    function additionalParam() {
        
        var data = {
            StartDate: ($("#StartDate").val() === "" ? "" : $("#StartDate").val()),
            EndDate: ($("#EndDate").val() === "" ? "" : $("#EndDate").val()),
            bookingTypeId: '@((Int64)Adani.Solution.DTO.Enums.SaudaBookingTypes.TraditionalProcess)',
            DivisionId: $("#ddlVertical").data("kendoDropDownList").value(),
            SalesOrganizationId: $("#ddlVertical").data("kendoDropDownList").value(),
            DistributionChannelId: $("#ddlVertical").data("kendoDropDownList").value(),
            oilTypeId: $("#ddlOilType").data("kendoDropDownList").value(),
            PlantId: $("#ddlPlant").data("kendoDropDownList").value(),
            RoleId:"1"
        };
        console.log(data);
        return {
            inputDto:data,
        };
    }

    function AdditionalInfoForHierarchialGrid(Id) {
        debugger;
        return {
            searchDate: ($("#StartDate").val() === "" ? new Date().toDateString() : $("#StartDate").val()),
            pricingId: Id
        }
    }

    function getTPGeneratedPrice() {
        $("#TPFinalPriceGenerate").data("kendoGrid").dataSource.read();
    }

    //(function () {
    //    setInterval(function () { getTPGeneratedPrice(); }, 60000);
    //})();

    function tpFinalPricePublish(Id, FinalPriceRecordCount) {
        var confirmText = "Traditional Process Total Final Price Count : <strong>" + FinalPriceRecordCount + ".</strong><br><br> Are you sure you want to <strong>Publish</strong> this price?";
        kendo.confirm(confirmText).then(function () {
            TraditionalProcessFinalPricePublish(Id);
         }, function () {
         });
    }

    function TraditionalProcessFinalPricePublish(Id) {
        var inputParam = {
            PublishId: Id,
            BookingTypeId:'@((Int64)Adani.Solution.DTO.Enums.SaudaBookingTypes.TraditionalProcess)',
            BiddingDate: $("#SearchDate").val()
        };

        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("StateBasePublishFinalPrice", "Pricing")',
            data: { inputDto: inputParam },
            success: function (responce) {
                if (responce.PostStatus) {
                    ShowSuccessMessage(responce.PostMessage);
                    $("#TPFinalPriceGenerate").data("kendoGrid").dataSource.read();
                } else {
                    ShowErrorMessage("Traditional Process Final price publish error");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("Traditional Process Final price publish error");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function downloadSuccessData(Id, finalPriceRecordCount) {
        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPublishedFinalPriceListNew", "Pricing")',
            data: { publishId: Id, FinalPriceRecordCount: finalPriceRecordCount, SearchDate: ($("#SearchDate").val() === "" ? new Date().toDateString() : $("#SearchDate").val()),},
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }
    function onVerticalTypeChange() {
        $("#ddlOilType").data("kendoDropDownList").dataSource.read();
    }
    function downloadErrorData(Id) {
        //var grid = $("#TPFinalPriceGenerate").data("kendoGrid");
        //var selectedRow = grid.dataItem($(e).closest("tr"));

        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetStateBasePriceGenerateErrorList", "Pricing")',
            data: { priceId: Id, saudaBookingTypeId: '@((Int64)Adani.Solution.DTO.Enums.SaudaBookingTypes.TraditionalProcess)' },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function tpFinalPriceBulkPublish(Id) {
        var confirmText = "Are you sure you want to <strong>Publish</strong> this price?";
        kendo.confirm(confirmText).then(function () {
            TraditionalProcessFinalPriceBulkPublish(Id);
         }, function () {
         });
    }

    function TraditionalProcessFinalPriceBulkPublish(Id) {
        var inputParam = {
            PublishId: Id,
            BookingTypeId:'@((Int64)Adani.Solution.DTO.Enums.SaudaBookingTypes.TraditionalProcess)',
            BiddingDate: $("#SearchDate").val()
        };

        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("StateBasePublishFinalPrice", "Pricing")',
            data: { inputDto: inputParam },
            success: function (responce) {
                if (responce.PostStatus) {
                    ShowSuccessMessage(responce.PostMessage);
                    $("#TPFinalPriceGenerate").data("kendoGrid").dataSource.read();
                } else {
                    ShowErrorMessage("Traditional Process Final price publish error");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("Traditional Process Final price publish error");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function downloadZoneSuccessData(Id) {
        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("ZoneBasedFinalPriceDownload", "Pricing")',
            data: { priceId: Id, SearchDate: ($("#SearchDate").val() === "" ? new Date().toDateString() : $("#SearchDate").val()),},
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
            },
            complete: function (res) {
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
        }


    function downloadZoneSuccessDataForAllRecords() {
        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "GET",
            url: '@Url.Action("ZoneBasedFinalPriceDownloadForAllRecords", "Pricing")',

            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
            },
            complete: function (res) {
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function fromDateChange() {
        //setToDateRange("StartDate", "EndDate", emamiGlobal.constant.IndentDateRange);
    }

    function StartDateRange() {
        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#StartDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
        $("#EndDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        var endPicker = $("#EndDate").data("kendoDatePicker");
        endPicker.min(dates);
    }

    function fromChange() {
        debugger;
        var endPicker = $("#EndDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#EndDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }
</script>

