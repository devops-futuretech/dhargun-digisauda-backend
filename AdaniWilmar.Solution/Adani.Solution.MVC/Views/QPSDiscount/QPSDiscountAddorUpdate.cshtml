                            SkuIds: $("#ddlSku").val(),
                            ZoneId: $("#ddlZone").val(),
                            IsActive: $("#cbActiveInactive").prop("checked")


                    };
                    console.log(data);

                        $.ajax({
                            type: "Post",
                            url: '@Url.Action("QpsAddOrUpdate", "QPSDiscount")',
                            data: { __RequestVerificationToken: token, qPSSchemeDiscountDto: data, QPSSlabDetails: jsonstring },
                            dataType: 'json',
                            contentType: 'application/x-www-form-urlencoded; charset=utf-8',
                            success: function (response) {
