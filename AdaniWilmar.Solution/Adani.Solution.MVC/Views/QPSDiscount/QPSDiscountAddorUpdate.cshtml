@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model Adani.Solution.DTO.QPSSchemeDiscountDto
@{
    ViewBag.Title = "QPSDiscount";

}
<style>
    .col-md-2 {
        width: 10.666667%;
        padding: 32px;
    }

    #multiselectDescription_ul {
        font-family: Arial, sans-serif;
        font-size: 14px;
        line-height: 1.5;
        color: #333;
        padding: 10px;
    }
</style>
@*<div id="dvAlert" class="alert-margin-left-right"></div>*@
<input type="hidden" class="currentMenu" value="tpdiscountQPSScheme" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">QPSDiscount</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Discounts</a><span class="icon-right"></span></li>
        <li><a href="QPSDiscountList">QPSDiscount</a><span class="icon-right"></span></li>
        <li class="active">Add or Update QPS Discount<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;" id="divLoader">
            <div class="row" id="dvMaterialType">
                <div class="col-md-12">
                    @using (Html.BeginForm("QpsAddOrUpdate", "QPSDiscount", FormMethod.Post, new { id = "frmDivision", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(s => s.Id, new { id = "txtId" })

                    <div class="row form-group">
                        @if (Model.Id > 0)
                        {
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">  @Helper.GetResourceString("QPSId") </label>
                                @Html.TextBox("QPSId", Model.Id, new { id = "qpsId", tabindex = "8", @class = "form-control", @maxlength = (int)InputMaxLength.Price, autocomplete = "off" })
                            </div>
                        }
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_StartDate") <span class="text-danger">*</span></label>
                            @(Html.Kendo().DatePickerFor(m => m.StartDate)
      .Format(Settings.DateFormat)
      .Events(e => e.Change("fromChange"))
      .HtmlAttributes(new { id = "dpFromDate", onkeydown = "return isFocus(event);", tabindex = "5", style = "width: 100%" }))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_EndDate") <span class="text-danger">*</span></label>
                            @(Html.Kendo().DatePickerFor(m => m.EndDate)
      .Format(Settings.DateFormat)
      .HtmlAttributes(new { id = "dpToDate", onkeydown = "return isFocus(event);", tabindex = "6", style = "width: 100%" }))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">
                                @Helper.GetResourceString("lbl_SalesOrganization")<span class="text-danger">*</span>
                            </label>
                            @(Html.Kendo().DropDownListFor(m => m.SalesOrgId)
//.Name("ddlSalesOrganization")
.OptionLabel("Select Sales Organization")
.DataTextField("SalesOrganizationName")
.Events(e => e.Change("onSaleChange"))
.DataValueField("Id")
.DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
).HtmlAttributes(new { id = "ddlSalesOrganization", tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                            )
                        </div>
                        @if (Model.Id == 0)
                        {
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">
                                    @Helper.GetResourceString("lbl_DistributionChannel")<span class="text-danger">*</span>
                                </label>
                                @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
//.Name("ddlDistributionChannel")
.OptionLabel("Select Distribution")
.Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
.DataTextField("DistributionChannelName")
.DataValueField("Id")
.DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
.ServerFiltering(true))
.HtmlAttributes(new { id = "ddlDistributionChannel", @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                            </div>
                        }
                    </div>

                    <div class="row form-group">
                        @if (Model.Id > 0)
                        {
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">
                                    @Helper.GetResourceString("lbl_DistributionChannel")<span class="text-danger">*</span>
                                </label>
                                @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
//.Name("ddlDistributionChannel")
.OptionLabel("Select Distribution")
.Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
.DataTextField("DistributionChannelName")
.DataValueField("Id")
.DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
.ServerFiltering(true))
.HtmlAttributes(new { id = "ddlDistributionChannel", @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                            </div>
                        }

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical")  <span class="text-danger">*</span></label>
                            @(Html.Kendo().DropDownListFor(m => m.DivisionId)
  .OptionLabel(@Helper.GetResourceString("plho_Division"))
  .DataTextField("Name")
  .DataValueField("Id")
   .Events(events => events.Change("onVerticalChange").DataBound("onVerticleDataBound"))
    .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
    .ServerFiltering(false))
    .HtmlAttributes(new { id = "ddlVertical", tabindex = "7", @class = "", @style = "width:100%", required = "required", data_msg_required = Helper.GetSelectMsgRequired("msg_Division"), }))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3" id="oiltypeContainer">
                            <label class="custom_label">  @Helper.GetResourceString("lbl_OilType") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().MultiSelectFor(m => m.OilTypeId)
               //.OptionLabel(@Helper.GetResourceString("plho_SelectOilType"))
               .DataTextField("Name")
               .DataValueField("Id")
               .AutoClose(false)
               .TagMode(TagMode.Single)
               .Placeholder(@Helper.GetResourceString("plho_SelectOilType"))
               .Events(e => e.Change("onOiltypeChange").DataBound("onOilTypeDataBound"))
               .DataSource(source => source.Read(read => read.Action("GetOilTypesBasedOnVerticalId", "Lookup").Data("oilTypeAdditionalInfo"))
               .ServerFiltering(true))
               .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='oilTypeSelectAll'> Select All</label>")
               .HtmlAttributes(new { id = "ddlOilType", @class = "", tabindex = "5", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_OilType"), @style = "width:100%" }))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3" id="skuContainer">
                            <label class="custom_label">  @Helper.GetResourceString("lbl_Sku") </label>
                            @(Html.Kendo().MultiSelectFor(m => m.SkuIds)
              .DataTextField("Name")
              .DataValueField("Id")
              .AutoClose(false)
              .TagMode(TagMode.Single)
              .Placeholder(@Helper.GetResourceString("plho_SelectSku"))
              .Events(e => e.Change("onSkuChange").DataBound("onSkuDataBound"))
              .DataSource(source => source.Read(read => read.Action("GetSkuListByOilTypeIdsPackGroupIdsForDropdown", "Lookup").Data("skuAdditionalInfo"))
              /*.ServerFiltering(true)*/)
              .ItemTemplate("<span class=\" k-state-default\">#: data.Code #</span>" + "<span class=\"pullLeft k-state-default\"><h3>#: data.Name #</h3></span>")
              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='skuSelectAll'> Select All</label>")
              .HtmlAttributes(new { id = "ddlSku", @class = "", tabindex = "7", data_msg_required = Helper.GetSelectMsgRequired("lbl_Sku"), @style = "width:100%" }))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3 " id="zoneContainer">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_Zone") <span class="text-danger">*</span></label>
                            @(Html.Kendo().MultiSelect().Name("ZoneId")
        .Events(events => events.Change("onZoneChange").DataBound("onZoneDataBound"))
        //.OptionLabel(@Helper.GetResourceString("plho_SelectZone"))
        .Placeholder("Select Zone")
        .DataTextField("Name")
        .DataValueField("Id")
        .AutoClose(false)
        .TagMode(TagMode.Single)
        //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
        .DataSource(source => source.Read(read => read.Action("GetZoneListddl", "Lookup", new { isToReturnInactiveData = false }))
        .ServerFiltering(false))
        .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zoneSelectAll'> Select All</label>")
        .HtmlAttributes(new { id = "ddlZone", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Zone"), @style = "width:100%" }))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3 " id="stateContainer">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_State") <span class="text-danger">*</span></label>
                            @(Html.Kendo().MultiSelectFor(m => m.StateId)
        //@(Html.Kendo().MultiSelect().Name("StateId")
        //.OptionLabel(@Helper.GetResourceString("plho_SelectState"))
        .Events(events => events.Change("onStateChange").DataBound("onStateDataBound"))
        .Placeholder("Select State")
        .DataTextField("Name")
        .DataValueField("Id")
        .AutoClose(false)
        .TagMode(TagMode.Single)
        .DataSource(source => source.Read(read => read.Action("GetStatesBasedOnZoneIds", "Lookup").Data("StateAdditionalInfo"))
        .ServerFiltering(false))
        .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='stateSelectAll'> Select All</label>")
        .HtmlAttributes(new { id = "ddlState", @class = "", tabindex = "2", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                        </div>
                        <div class="row form-group">
                            <div class="col-lg-3 col-sm-6 mb-3" style="margin-left: 0px">
                                <label class="custom_label">Status</label>
                                <div class="custom_checkbox_main">
                                    <label class="custom_checkbox">
                                        @Html.CheckBoxFor(m => m.IsActive, new { id = "cbActiveInactive", tabindex = "20" })
                                        <span class="checkmark check_tick"></span>
                                        <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                        <div class="row form-group">
                            <input type="hidden" name="QPSSlabDetails" value="" id="QPSSlabDetails" />
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">  @Helper.GetResourceString("lbl_SlabFromRange") <span class="text-danger">*</span>  </label>
                                @Html.TextBox("SaudaLimit1", "", new { id = "txtSlabFromRange", tabindex = "6", @class = "form-control", @onkeypress = "return isNumber(event);", data_msg_required = Helper.GetMsgRequired("msg_Slabframrange"), @placeholder = Helper.GetResourceString("lbl_SlabFromRange"), @maxlength = (int)InputMaxLength.Price, autocomplete = "off" })
                            </div>
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">  @Helper.GetResourceString("lbl_SlabToRange") <span class="text-danger">*</span>  </label>
                                @Html.TextBox("SaudaLimit1", "", new { id = "txtSlabToRange", tabindex = "6", @class = "form-control", @onkeypress = "return isNumber(event);", data_msg_required = Helper.GetMsgRequired("msg_Slabtorange"), @placeholder = Helper.GetResourceString("lbl_SlabToRange"), @maxlength = (int)InputMaxLength.Price, autocomplete = "off" })
                            </div>
                            <div class="col-lg-3 col-sm-6 mb-3">
                                <label class="custom_label">  @Helper.GetResourceString("lbl_SlabDiscount") <span class="text-danger">*</span>  </label>
                                @Html.TextBox("SaudaLimit1", "", new { id = "txtDiscount", tabindex = "6", @class = "form-control decimalValue", data_msg_required = Helper.GetMsgRequired("msg_Slabdiscount"), @placeholder = Helper.GetResourceString("lbl_SlabDiscount"), @maxlength = (int)InputMaxLength.Price, autocomplete = "off" })
                            </div>
                            <div class="col-lg-3 col-sm-6 mb-3" style="bottom: -15px">
                                <button type="button" id="btnSlabAdd" tabindex="10" class="k-primary k-button">
                                    @if (Model.Id > 0)
                                    {@Helper.GetResourceString("Btn_UpdSlab")}
                                else
                                {@Helper.GetResourceString("Btn_AddSlab")}
                                </button>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div>
                                @(Html.Kendo().Grid<QPSSlabDetailsDto>()
                                      .Name("ViewQPSDetails")
                                      .Columns(columns =>
                                      {
                                          columns.Bound(c => c.SlabId).Visible(false);
                                          columns.Bound(c => c.FromRange).Visible(true).Width(Settings.GridOtherColumnWidth);
                                          columns.Bound(c => c.ToRange).Visible(true).Width(Settings.GridOtherColumnWidth);
                                          columns.Bound(c => c.Discount).Visible(true).Width(Settings.GridOtherColumnWidth);
                                          columns.Command(command => command.Custom("Delete").Click("deleteRow_QPSDiscount")).Width(Settings.GridOtherColumnWidth);
                                      })

                                        .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                        .BindTo(Model.QPSSlabDetails).Editable(edit => edit.Mode(GridEditMode.InCell))
                                        //.BindTo((IEnumerable<QPSSlabDetailsDto>)Model.QPSSlabDetails)
                                        //.BindTo((IEnumerable<QPSSlabDetailsDto>)Model.QPSSlabDetails).Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                                        .HtmlAttributes(new { data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), required = "required" })
                                        .Selectable(selectable => selectable
                                        .Mode(GridSelectionMode.Multiple)
                                        .Type(GridSelectionType.Row))
                                        .Scrollable(s => s.Enabled(true).Height("auto"))
                                        //.Events(events => events.DataBound("onListChangeDataBound"))
                                        .Reorderable(reorder => reorder.Columns(true))
                                        .Editable(edit => edit.Mode(GridEditMode.InCell))
                                        .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .PageSize(Settings.DefaultPageSize)
                                        .Model(model =>
                                        {
                                            model.Id(m => m.SlabId);
                                            model.Field(m => m.FromRange).Editable(false);
                                            model.Field(m => m.ToRange).Editable(false);
                                            model.Field(m => m.Discount).Editable(false);
                                        })
                                        //.Destroy(update => update.Action())
                                        ))
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-12 text-right buttons-align">

                                <button type="button" tabindex="7" id="btnCancel" onclick="location.href = '@Url.Action("QPSDiscountList", "QPSDiscount")'" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.QPSDiscount))
                                {
                                    <button type="button" tabindex="6" id="btnQPSSave" class="k-primary k-button custom-btns">
                                        @if (Model.Id > 0)
                                        {@Helper.GetResourceString("btn_Update")}
                                    else
                                    { @Helper.GetResourceString("lbl_Save")}
                                    </button>
                                }

                            </div>

                        </div>

                    }


                </div>
            </div>
        </div>

    </div>
</div>
<div id="multiselectDescription" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close closeQpsDet" data-dismiss="modal">&times;</button>
                <h6 class="panel-title"><span class="text-semibold" id="multiselectDescription_head"></span></h6>
            </div>

            <div class="modal-body">
                <div id="dvQPSDiscountPopup">
                    <div class="content main-section-content row">
                        <div class="panel panel-flat">
                            <div class="panel-body" style="display: block;">
                                <div style="max-height: 250px; overflow-y: auto;">
                                    <ul id="multiselectDescription_ul" class="list-group"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="popupClose();" class="k-button closeQpsDet" data-dismiss="modal">@Helper.GetResourceString("btn_Close")</button>
            </div>
        </div>
    </div>
</div>
<script>

    var listOfObjects = [];
    var fromRange = '';

    $(document).ready(function () {
        if ('@Model.Id' != 0) {
            $('#oiltypeContainer').click(function () {
                $("#multiselectDescription").modal("show");
                $("#multiselectDescription_head").text("Selected OilTypes");
                var selectedItems = $("#ddlOilType").data('kendoMultiSelect').dataItems();
                var listContainer = $("#multiselectDescription_ul");
                listContainer.empty();

                selectedItems.forEach(function (item) {
                    var listItem = $("<li>").text(item.Name);
                    listContainer.append(listItem);
                });
            });

            $('#skuContainer').click(function () {
                $("#multiselectDescription_head").text("Selected Materials");
                $("#multiselectDescription").modal("show");
                var selectedItems = $("#ddlSku").data('kendoMultiSelect').dataItems();
                var listContainer = $("#multiselectDescription_ul");
                listContainer.empty();

                selectedItems.forEach(function (item) {
                    var listItem = $("<li>").text(item.Name);
                    listContainer.append(listItem);
                });
            });

            $('#zoneContainer').click(function () {
                $("#multiselectDescription_head").text("Selected Zones");
                $("#multiselectDescription").modal("show");
                var selectedItems = $("#ddlZone").data('kendoMultiSelect').dataItems();
                var listContainer = $("#multiselectDescription_ul");
                listContainer.empty();

                selectedItems.forEach(function (item) {
                    var listItem = $("<li>").text(item.Name);
                    listContainer.append(listItem);
                });
            });

            $('#stateContainer').click(function () {
                $("#multiselectDescription_head").text("Selected States");
                $("#multiselectDescription").modal("show");
                var selectedItems = $("#ddlState").data('kendoMultiSelect').dataItems();
                var listContainer = $("#multiselectDescription_ul");
                listContainer.empty();

                selectedItems.forEach(function (item) {
                    var listItem = $("<li>").text(item.Name);
                    listContainer.append(listItem);
                });
            });
        }

        if ('@Model.Id' != 0) {
            var currentDate = new Date();
            currentDate.setHours(0, 0, 0, 0);
            var endDate = $("#dpToDate").data("kendoDatePicker").value();
            endDate.setHours(0, 0, 0, 0);

            if (endDate < currentDate) {
                $("#cbActiveInactive").prop("disabled", true);
            } else {
                $("#cbActiveInactive").prop("disabled", false);
            }
        }

                        if ('@Model.PostMessage' !== "") {
                            if ('@Model.PostStatus' === '@true') {
                                ShowSuccessMessage('@Model.PostMessage');
                            } else {
                                ShowErrorMessage('@Model.PostMessage');
                            }
                        }

                        if ('@Model.Id' === '0') {
                            setDefaultDate();
                        }
                if ('@Model.Id' > 0) {
                    var dpFromDatePicker = $("#dpFromDate").data("kendoDatePicker");
                    if (dpFromDatePicker) {dpFromDatePicker.enable(false);}
                    var dpToDatePicker = $("#dpToDate").data("kendoDatePicker");
                    if (dpToDatePicker) { dpToDatePicker.enable(false);}
                    var salesOrgDropDown = $("#ddlSalesOrganization").data("kendoDropDownList");
                    if (salesOrgDropDown) { salesOrgDropDown.enable(false); }
                    var disbutCahDropDown = $("#ddlDistributionChannel").data("kendoDropDownList");
                    if (disbutCahDropDown) { disbutCahDropDown.enable(false); }
                    var ddlVerticalDropDown = $("#ddlVertical").data("kendoDropDownList");
                    if (ddlVerticalDropDown) { ddlVerticalDropDown.enable(false); }
                    var ddOilTypeDropDown = $("#ddlOilType").data("kendoMultiSelect");
                    if (ddOilTypeDropDown) { ddOilTypeDropDown.enable(false); }
                    var ddlSkuMultiSelect = $("#ddlSku").data("kendoMultiSelect");
                    if (ddlSkuMultiSelect) { ddlSkuMultiSelect.enable(false); }
                    var ddlZoneDropDown = $("#ddlZone").data("kendoMultiSelect");
                    if (ddlZoneDropDown) { ddlZoneDropDown.enable(false); }
                    var ddlStateDropDown = $("#ddlState").data("kendoMultiSelect");
                    if (ddlStateDropDown) { ddlStateDropDown.enable(false); }
                    document.getElementById("qpsId").disabled = true;
                }
                //$("#btnsave").click(function () {
                //addVerticaltoDatabase();
                //});
                $("#zoneSelectAll").click(function () {
                            MultiSelectCheckUnCheck("ddlZone", "zoneSelectAll");
                    $("#ddlState").data("kendoMultiSelect").dataSource.read();
                });

                $("#stateSelectAll").click(function () {
                            MultiSelectSelectAll("ddlState", "stateSelectAll");
                });
                $("#oilTypeSelectAll").click(function () {
                    MultiSelectCheckUnCheck("ddlOilType", "oilTypeSelectAll");
                    $("#ddlSku").data("kendoMultiSelect").dataSource.read();
                });
                $("#skuSelectAll").click(function () {
                            MultiSelectSelectAll("ddlSku", "skuSelectAll");
                });

                $("#btnSlabAdd").click(function () {
                    if ($("#txtSlabFromRange").val() == "" || $("#txtSlabFromRange").val() == "0") {
                        ShowErrorMessage('@Helper.GetResourceString("msg_Slabframrange")');
                    } else if ($("#txtSlabToRange").val() == "" || $("#txtSlabToRange").val() == "0") {
                        ShowErrorMessage('@Helper.GetResourceString("msg_Slabtorange")');
                    } else if ($("#txtDiscount").val() == "" || $("#txtDiscount").val() == "0") {
                        ShowErrorMessage('@Helper.GetResourceString("msg_Slabdiscount")');
                    }
                    else {
                        AddSlabToList();
                    }

                });

                $('#btnQPSSave').on('click', function (e) {
                    var isValid = $('#frmDivision').valid();
                    if (isValid) {
                        //$("#ddlSaudaBookingType").data("kendoDropDownList").readonly(false);
                        //$("#ddlSaudaBookingType").data("kendoDropDownList").enable(true);

                        if ($("#ViewQPSDetails").data("kendoGrid").dataSource.data().length > 0)
                        {
                            window.kendo.ui.progress($("#dvMaterialType"), true);
                        $("#QPSSlabDetails").val(JSON.stringify($("#ViewQPSDetails").data("kendoGrid").dataSource.data()));
                                var frm = $("#frmDivision").serialize();
                        //$('#frmDivision').submit();
                            window.kendo.ui.progress($("#dvMaterialType"), false);
                        } else {
                            ShowErrorMessage('@Helper.GetResourceString("msg_SlabReq")');
                            return;
                        }
                        addVerticaltoDatabase();
                    }

                });
            });

            function deleteRow_QPSDiscount(e) {
                e.preventDefault();
                if (confirm("Are you sure you want to delete this record?")) {
                    var grid = $("#ViewQPSDetails").data("kendoGrid");
                    var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
                    grid.dataSource.remove(dataItem);
                    grid.dataSource.sync();
                }
            }

            function onVerticleDataBound() {
                if ('@Model.Id' > 0 || $("#ddlVertical").data("kendoDropDownList").value() > 0) {
                    $("#ddlOilType").data("kendoMultiSelect").dataSource.read();
                    //    $("#ddlCustomer").data("kendoMultiSelect").dataSource.read();
                }
            }

            //function stateLoadParam() {
            //    return {
            //        SelectedIds: $("#ddlZone").val()
            //    }
            //}

            function StateAdditionalInfo() {
                return {
                SelectedIds: $("#ddlZone").data("kendoMultiSelect").value().join()
                };
            }
