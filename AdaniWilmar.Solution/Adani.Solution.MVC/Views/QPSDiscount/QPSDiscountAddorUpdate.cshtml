                    //console.log(jsonstring);

                    //var view = $('#ViewQPSDetails').dataSource.data();
                    var view = $("#ViewQPSDetails").data("kendoGrid").dataSource.data();

                    for (var i = 0; i < view.length; i++) {
                        var slabs = {
                            "FromRange": view[i].FromRange,
                            "ToRange": view[i].ToRange,
                            "Discount": view[i].Discount
                        }
                        slablist.push(slabs);
                    }

                    var jsonstring = JSON.stringify(slablist);
                    console.log(jsonstring);

