            function AddSlabToList()
            {
                window.kendo.ui.progress($("#ViewQPSDetails"), true);
                var grid = $("#ViewQPSDetails").data("kendoGrid");

                    var datasource = grid.dataSource;
                    var total = datasource.data().length;
                var FromRange = parseInt($("#txtSlabFromRange").val());
                var ToRange = parseInt($("#txtSlabToRange").val());
                var Discount = parseFloat($("#txtDiscount").val());
                    //Insertion
                var isDuplicate = false;
                var isRangeViolation = false;
                var isValidDiscount = true;

                // Check for equal from and to range
                if (FromRange === ToRange) {
                    isRangeViolation = true;
                }
                // Check for FromRange greater than ToRange
                if (FromRange > ToRange) {
                    isRangeViolation = true;
                }
                // Check if Discount is zero
                if (Discount === 0) {
                    isValidDiscount = false;
                }

                // Validate against existing slabs
                for (var i = 0; i < datasource.data().length; i++) {
                    var existingFromRange = parseInt(datasource.data()[i].FromRange);
                    var existingToRange = parseInt(datasource.data()[i].ToRange);
                    var existingDiscount = parseFloat(datasource.data()[i].Discount);

                    // Check if new slab overlaps with existing slabs
                    if ((FromRange >= existingFromRange && FromRange <= existingToRange) ||
                        (ToRange >= existingFromRange && ToRange <= existingToRange) ||
                        (FromRange < existingFromRange && ToRange > existingToRange)) {
                        isRangeViolation = true;
                    }

                    // Check if discount is the same as any existing discount
                    if (!isRangeViolation && Discount === existingDiscount) {
                        isValidDiscount = false;
                    }
                }

                var innerRow = -1;
                // Ensure the new slab is either at the end or fits in between existing slabs
                if (total > 0 && !isRangeViolation) {
                    var canInsert = false;
                    for (var i = 0; i < total; i++) {
                        var initialFronRange = parseInt(datasource.data()[0].FromRange);
                        var initialToRange = parseInt(datasource.data()[0].ToRange);
                        var initialDiscount = parseFloat(datasource.data()[0].Discount);
                        var currentFromRange = parseInt(datasource.data()[i].FromRange);
                        var currentToRange = parseInt(datasource.data()[i].ToRange);
                        var currentDiscount = parseFloat(datasource.data()[i].Discount);

                        if (i < total - 1) {
                            var nextFromRange = parseInt(datasource.data()[i + 1].FromRange);
                            var nextDiscount = parseFloat(datasource.data()[i + 1].Discount);

                            if ((FromRange === currentToRange + 1 || ToRange === nextFromRange - 1) &&
                                Discount > currentDiscount && Discount < nextDiscount) {
                                canInsert = true;
                                innerRow = i + 1;
                                break;
                            }
                            else if (ToRange < initialFronRange && FromRange < ToRange && Discount < initialDiscount) {
                                canInsert = true;
                                innerRow = 0;
                                break;
                            }
                            if ((FromRange === currentToRange + 1 || ToRange === nextFromRange - 1) && Discount < currentDiscount) {
                                isValidDiscount = false;
                            }
                        } else {
                            if (FromRange >= currentToRange + 1) {
                                if (Discount > currentDiscount) {
                                    canInsert = true;
                                    break;
                                }
                                else {
                                    isValidDiscount = false;
                                }
                            }
                            else if (ToRange < currentFromRange && FromRange < ToRange && Discount > currentDiscount) {
                                isValidDiscount = false;
                            }
                            else if (ToRange < initialFronRange && FromRange < ToRange && Discount < initialDiscount) {
                                canInsert = true;
                                innerRow = 0;
                            }
                        }
                    }
                    if (!canInsert) {
                        isRangeViolation = true;
                    }
                }

                if (!isRangeViolation && isValidDiscount) {
                    datasource.insert(innerRow !== -1 ? innerRow : total, {
                        FromRange: FromRange,
                        ToRange: ToRange,
                        Discount: Discount,
                    });
                    total = datasource.data().length;

                    $("#txtSlabFromRange").val('');
                    $("#txtSlabToRange").val('');
                    $("#txtDiscount").val('');
                }
                else {
                    if (isRangeViolation) {
                        if (!isValidDiscount) {
                            ShowErrorMessage('@Helper.GetResourceString("msg_Slabdiscount")');
                        }
                        else {
                            ShowErrorMessage('@Helper.GetResourceString("msg_Slab_exists")');
                        }
                    }
                    else if (!isValidDiscount) {
                        ShowErrorMessage('@Helper.GetResourceString("msg_Slabdiscount")');
                    }
                }
                window.kendo.ui.progress($("#ViewQPSDetails"), false);
            }

            function AllowNumericBetween1And2000(event) {
                if (event.shiftKey || event.ctrlKey || event.altKey) {
                    event.preventDefault();
                } else {
                    var keyCode = event.keyCode;
                    if (!((keyCode >= 48 && keyCode <= 57) || (keyCode >= 96 && keyCode <= 105) || keyCode == 8 || keyCode == 9 || keyCode == 37 || keyCode == 39 || keyCode == 46 || keyCode == 116)) {
                        event.preventDefault();
                    } else {
                        var currentTextbox = event.target;
                        var currentValue = parseFloat(currentTextbox.value + String.fromCharCode(keyCode));

                        // Check if the new value is numeric and within the specified range
                        if (isNaN(currentValue) || currentValue <= 0 || currentValue > 2000) {
                            event.preventDefault();
                        }
                    }
                }
            }

