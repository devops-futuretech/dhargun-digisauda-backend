                                              columns.Bound(c => c.CustomerGroupId).Visible(false);
                                              columns.Template(@<text></text>).ClientTemplate("<div class='text-center'><input type='checkbox' class='chkbxAllCustomer' value=#=CustomerId# onclick=\"findCheckedItemsSaveItToHidden(this,'#=CustomerId#','hdSelectedCustomerIds','masterCBAllCustomer','chkbxAllCustomer','lblDealerSelectedCount','');\" /></div>")
                                               .HeaderTemplate("<div class='text-center'> Select Customer to Remove <input type='checkbox' id='masterCBAllCustomer' onclick=\"masterfindCheckedItemsSaveItToHidden(this,'hdSelectedCustomerIds','chkbxAllCustomer','lblDealerSelectedCount','')\" /></div>").Width(Settings.GridColumnMaxWidth);
                                columns.Bound(c => c.CustomerName).Title(@Helper.GetResourceString("lbl_CustomerName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
