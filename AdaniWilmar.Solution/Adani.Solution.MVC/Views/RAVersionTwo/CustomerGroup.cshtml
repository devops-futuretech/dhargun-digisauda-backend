@using Kendo.Mvc.UI;
@using Adani.Solution.DTO.Enums;
@using Adani.Solution.DTO;
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@model Adani.Solution.DTO.CustomerGroupDto
@{
    ViewBag.Title = "CustomerGroup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .k-grid-header .k-header > .k-link {
        padding: 19px 12px !important;
    }

    .k-grid th {
        white-space: pre-wrap !important;
    }
</style>

<input type="hidden" class="currentMenu" value="ra2CustomerGroupList" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">@Helper.GetResourceString("lbl_CustomerGroup")</h2>
    <div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">
        </div>
    </div>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat" id="dvSalesTarget">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <p class="content-group-lg"></p>
            @using (Html.BeginForm("AddOrUpdateCustomerGroup", "RAVersionTwo", FormMethod.Post, new { id = "frmCustomerGroup", @class = "form-validate-jquery" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.LoginUserId, new { id = "hdnLoginUserId" })
                <input type="hidden" name="CustomerGroupDetailDtoList" value="" id="CustomerGroupDetailDtoList" />
                <fieldset class="content-group">
                    <div class="row form-group">
                        <div class="col-md-4 text-right">
                            @Helper.GetResourceString("lbl_CustomerGroupName") <span class="text-danger">*</span>
                        </div>
                        <div class="col-md-4">
                            @Html.TextBoxFor(m => m.Name, new { id = "txtCustomerGroupName", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_CustomerGroupName"), @onkeydown = "return AllowOnlyAlphaNumeric(event);", @maxlength = (int)InputMaxLength.String })
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-md-4 text-right">
                            @Helper.GetResourceString("lbl_Vertical") <span class="text-danger">*</span>
                        </div>
                        <div class="col-md-4">
