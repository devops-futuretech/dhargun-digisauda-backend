                                          .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .DataSource(source => source.Read(read => read.Action("GetVerticalListAsync", "Lookup", new { isToReturnInactiveData = true }))
                                          .ServerFiltering(false))
                                          .HtmlAttributes(new { id = "ddlVertical", @class = "", tabindex = "7", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), @style = "width:100%" }))
                        </div>
