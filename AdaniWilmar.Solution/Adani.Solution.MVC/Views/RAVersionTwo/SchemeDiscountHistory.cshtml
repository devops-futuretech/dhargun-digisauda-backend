@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Common
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO

@{
    ViewBag.Title = "SchemeDiscountHistory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="tpra2SchemeHistory" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_AuditLog")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#"> Scheme Discount</a><span class="icon-right"></span></li>
        <li class="active"> @Helper.GetResourceString("lbl_AuditLog") <span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_FromDate") </label>
                        @(Html.Kendo().DatePicker()
                              .Name("StartDate")
                              .Format(Settings.DateFormat)
                              .Events(e => e.Change("fromDateChange"))
                              .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_ToDate") </label>
                        @(Html.Kendo().DatePicker()
                              .Name("EndDate")
                              .Format(Settings.DateFormat)
                              .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                    </div>
                @*</div>
            </div>*@
            @*<div class="row form-group">
                <div class="col-md-12 text-center">*@
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_DiscountType") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownList().Name("ActionType")
                                          .OptionLabel(@Helper.GetResourceString("plho_SelectDiscountType"))
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .Events(e=>e.Change("statusChange").DataBound("dataDiscountBound"))
                                          .DataSource(source => source.Read(resd => resd.Action("GetDiscountTypeListForDropdown", "RAVersionTwo"))
                                          .ServerFiltering(false))
                                          .HtmlAttributes(new { id = "ddlDiscountType", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DiscountType"), @style = "width:100%" }))
                    </div>
                </div>
            </div>
