                               .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                               .DataTextField("Name")
                               .DataValueField("Id")
                               .DataSource(source => source.Read(read => read.Action("GetVerticalListAsync", "Lookup", new { isToReturnInactiveData = true }))
                               .ServerFiltering(false))
                               .HtmlAttributes(new { id = "ddlVertical", @class = "", tabindex = "7", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), @style = "width:100%" }))
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 text-right">
                        @Helper.GetResourceString("lbl_IsBaseGroup")
                    </div>
                    <div class="col-md-4">
                        @(Html.Kendo().CheckBoxFor(m => m.IsBaseGroup).HtmlAttributes(new { id = "cbIsBaseGroup" }))
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-4 text-right">
                        @Helper.GetResourceString("lbl_IsActive")
                    </div>
                    <div class="col-md-4">
                        @(Html.Kendo().CheckBoxFor(m => m.IsActive).HtmlAttributes(new { id = "cbActiveInactive" }))
                    </div>
                </div>
            </fieldset>
            <div class="row form-group">
                @Html.HiddenFor(m => m.SelecteDealerIdsString, new { id = "hdSelectedDealerIds" })
