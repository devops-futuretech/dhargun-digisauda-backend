        });
    }

    function AddDataToGrid() {
        var grid = $("#ViewCustomers").data("kendoGrid");
        var mappedGrid = $("#ViewMappedCustomers").data("kendoGrid");

        var ddlVerticalValue = $("#ddlVertical").data("kendoDropDownList").value(),
            viewVertical = grid.dataSource.view();

        var selectedItems = $("input:checked", grid.tbody).closest("tr");
        var items = [];
        var alreadyAddedCustomers=[];
        var gridDataItems = [];

        $.each(selectedItems, function (idx, row) {
            var gridItem = grid.dataItem(row);
            items.push(gridItem);
            var gridDataItem = mappedGrid.dataSource.data().filter(function (item) {
                return item.CustomerId === gridItem.CustomerId && item.VerticalId === ddlVerticalValue;
            });
            if (gridDataItem.length > 0) {
                gridDataItems.push(gridDataItem);
                alreadyAddedCustomers.push(gridItem.CustomerName);
            }
            else {
                var ddlVertical = $("#ddlVertical").data("kendoDropDownList").text();
                var ddlVerticalId = $("#ddlVertical").data("kendoDropDownList").value();
                var datasource = mappedGrid.dataSource;
                var total = datasource.data().length;

                datasource.insert(total, {
                    CustomerId: gridItem.CustomerId,
                    VerticalId: ddlVerticalId,
                    Vertical: ddlVertical,
                    CustomerName: gridItem.CustomerName,
                    Code: gridItem.Code,
                    MobileNumber: gridItem.MobileNumber,
                    Email: gridItem.Email,
                    Zone: gridItem.Zone,
                    State: gridItem.State,
                    District: gridItem.District,
                    Territory: gridItem.Territory,
                    City: gridItem.City,
                    CustomerGroupDetailId: gridItem.CustomerGroupDetailId,
                    SaudaBookingType: gridItem.SaudaBookingType
                });
            }
        });

        if ($("#ViewMappedCustomers").data("kendoGrid").dataSource.data().length > 0) {
            ResetFields();
        }

        if (gridDataItems.length > 0) {
            ShowErrorMessage('@Helper.GetResourceString("msg_CustomerAlreadyAddedInCustomerGroup")' + ": " + alreadyAddedCustomers.join(','));
        }
    }

