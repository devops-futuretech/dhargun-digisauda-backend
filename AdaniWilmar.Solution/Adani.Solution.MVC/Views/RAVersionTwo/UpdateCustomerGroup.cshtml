    function DeleteCustomer() {
        var selectedIds = [];
        var selectedCustomerIds = [];
        var selectedCustomerDetailIds = [];

        if ($("#hdSelectedCustomerIds").val()) {
            selectedIds = $("#hdSelectedCustomerIds").val().split(",");
        }

        if (!(selectedIds.length > 0)) {
            ShowErrorMessage("Please select any customer");
            return false;
        }

        var grid = $("#ViewMappedCustomers").data("kendoGrid");
        var selectedItems = $("input:checked", grid.tbody).closest("tr");
        var gridDataItems = [];

        $.each(selectedItems, function (idx, row) {
            var gridItem = grid.dataItem(row);
            if (gridItem.CustomerGroupDetailId !== undefined && gridItem.CustomerGroupDetailId > 0) {
                selectedCustomerIds.push(gridItem.CustomerId);
                selectedCustomerDetailIds.push(gridItem.CustomerGroupDetailId);
                gridDataItems.push(gridItem);
            }
        });

        if (gridDataItems.length > 0) {
            var model = {
                CustomerGroupId: $("#hdnCustomerGroupId").val(),
                CustomerIds: selectedCustomerIds,
                CustomerGroupDetailIds: selectedCustomerDetailIds
            };


            window.kendo.ui.progress($("#div_Progress"), true);
            moduleCommon.Common.AjaxCall({
                url: '@Url.Action("RemoveCustomersFromCustomerGroup", "RAVersionTwo")',
                type: 'POST',
                data: { inputDto: model },
                success: function (result) {
                    if (result.PostStatus) {
                        ShowSuccessMessage(result.PostMessage);
                    } else {
                        ShowErrorMessage(result.PostMessage);
                    }
                }
            });
            window.kendo.ui.progress($("#div_Progress"), false);
        }
        RemoveSelectedItemsFromGrid();
        var hiddenId = 'hdSelectedCustomerIds';
        UnCheckeRemovedItemsSaveItToHidden(selectedIds, hiddenId);
    }

