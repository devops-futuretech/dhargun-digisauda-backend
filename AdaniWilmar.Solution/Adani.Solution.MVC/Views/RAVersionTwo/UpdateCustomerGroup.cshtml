<div id="kWindow">
    <h2>@Helper.GetResourceString("msg_CustomerDeleteConfirmation")</h2>
    <div class="col-md-12 text-center">
        <button id="yes" class="k-primary k-button">Yes</button>
        <button id="no" class="k-primary k-button">No</button>
    </div>
</div>

<script type="text/javascript">
    var selectedDealerIds = [];
    var selectedCustomerIds = [];
    var windowDelete;
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();

        windowDelete = $("#kWindow").kendoWindow({
            title: "Delete confirmation",
            modal: true,
            visible: false,
            resizable: false,
            width: 300
        }).data("kendoWindow");

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        $('#btnAddCustomer').on('click', function (e) {
            var isValid = $('#frmCustomerGroup').valid();
            $("#ddlZone").data("kendoMultiSelect").dataSource.data([]);

            if (isValid) {
                $('#dvBindPartial').modal('show');
                //loadDealerGrid(true);
                $("#ViewCustomers").data("kendoGrid").dataSource.read();
                $("#hdSelectedDealerIds").val("");

                $("#ddlZone").data("kendoMultiSelect").dataSource.read();
                $("#ddlState").data("kendoMultiSelect").dataSource.data([]);
                $("#ddlTerritory").data("kendoMultiSelect").dataSource.data([]);
                $("#ddlDistrict").data("kendoMultiSelect").dataSource.data([]);
                $("#ddlCity").data("kendoMultiSelect").dataSource.data([]);
            }
        });

        $("#btnAddCustomersToGrid").click(function (e) {
            var hdSelectedDealerIds = $("#hdSelectedDealerIds").val();
            if (hdSelectedDealerIds) {
                selectedDealerIds = $("#hdSelectedDealerIds").val().split(",");
                $('#hdSelectedIds').val(selectedDealerIds);
            }
            if (selectedDealerIds.length>0) {
                window.kendo.ui.progress($("#div_Progress"), true);
                AddDataToGrid();
                window.kendo.ui.progress($("#div_Progress"), false);
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_PleaseSelectCustomer")');
            }
        });

        $("#btnRemoveCustomers").click(function (e) {
            var hdSelectedCustomerIds = $("#hdSelectedCustomerIds").val();
            if (hdSelectedCustomerIds) {
                selectedCustomerIds = $("#hdSelectedCustomerIds").val().split(",");
                $('#hdSelectedIdsToRemove').val(selectedCustomerIds);
            }
            var addedCustomerCount = $("#ViewMappedCustomers").data("kendoGrid").dataSource.data().length;

           // if (addedCustomerCount > 1) {
                if (selectedCustomerIds.length > 0) {

                    window.kendo.ui.progress($("#div_Progress"), true);
                    RemoveDataFromGrid();
                    window.kendo.ui.progress($("#div_Progress"), false);
                }
                else {
                    ShowErrorMessage('@Helper.GetResourceString("msg_PleaseSelectCustomer")');
                }
            //}
        });

        $('#btnSaveCustomerGroup').on('click', function (e) {
            var isValid = $('#frmCustomerGroup').valid();
            if (isValid) {
                if ($("#ViewMappedCustomers").data("kendoGrid").dataSource.data().length > 0) {
                    window.kendo.ui.progress($("#div_Progress"), true);
                    $("#CustomerGroupDetailDtoList").val(JSON.stringify($("#ViewMappedCustomers").data("kendoGrid").dataSource.data()));
                    var frm = $("frmCustomerGroup").serialize();
                    $('#frmCustomerGroup').submit();
                    window.kendo.ui.progress($("#div_Progress"), false);
                }
                else {
                    ShowErrorMessage('@Helper.GetResourceString("msg_CustomerNotAdded")');
                }
            }
        });

        if ('@Model.VerticalId' > 0) {
            $("#ddlVertical").data("kendoDropDownList").readonly(true);
        }

        //Popup Events Start

        $('#chkKendoFilterShowHide').change(function () {
            filterShowHide();
        });

