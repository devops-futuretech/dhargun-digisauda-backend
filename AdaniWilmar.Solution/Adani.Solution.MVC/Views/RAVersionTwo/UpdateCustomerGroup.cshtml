            if (dataItem !== undefined && !dataItem.HasChildren) {
                row.find(".k-hierarchy-cell").html("");
            }
        });

        if ($("#hdSelectedDealerIds").val()) {
            selectedDealerIds = $("#hdSelectedDealerIds").val().split(",");
        }

        $("#masterCBAllDealer").prop('checked', false);
        $('input:checkbox.' + 'chkbxAllDealer').each(function () {
            if ($.inArray(this.value, selectedDealerIds) > -1) {
