                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .AutoClose(false)
                                          .TagMode(TagMode.Single)
                                          .Placeholder(@Helper.GetResourceString("plho_SelectDistrict"))
                                          .Events(e => e.Change("onDistrictChange").DataBound("OnDistrictDataBound"))
                                          .DataSource(source => source.Read(resd => resd.Action("GerDistrictBasedOnTerritory", "Lookup").Data("additionalDistrictByTerritoryInfo"))
                                          .ServerFiltering(true))
                                          .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='districtSelectAll'> Select All</label>")
                                          .HtmlAttributes(new { id = "ddlDistrict", @class = "", tabindex = "14", @style = "width:100%" }))
                                </div>
                            </div>

                            <div class="row form-group">
                                <div class="col-md-4 text-right">
                                    @Helper.GetResourceString("lbl_City") 
                                </div>
                                <div class="col-md-4">
                                    @(Html.Kendo().MultiSelectFor(f => f.CityIds)
                                          .Placeholder(@Helper.GetResourceString("plho_SelectCity"))
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .AutoClose(false)
                                          .TagMode(TagMode.Single)
                                          .Events(e => e.Change("onCityChange").DataBound("onCityDataBound"))
                                          .DataSource(source => source.Read(resd => resd.Action("GetCityListBasedOnDistrict", "Lookup").Data("additionalCityByDistrictInfo"))
                                          /*.ServerFiltering(false))*/)
                                          .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='citySelectAll'> Select All</label>")
                                          .HtmlAttributes(new { id = "ddlCity", tabindex = "1", @class = "form-control", @style = "width:100%" }))
                                </div>
                            </div>

                            <div class="row form-group">
                                <div class="col-md-4 text-right">
                                    @Helper.GetResourceString("lbl_CustomerGroup") 
                                </div>
                                <div class="col-md-4">
                                    @(Html.Kendo().MultiSelectFor(m => m.CustomerGroupIds)
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .AutoClose(false)
                                          .TagMode(TagMode.Single)
                                          .Placeholder(@Helper.GetResourceString("plho_SelectCustomerGroup"))
                                          .Events(e => e.Change("onCustomerGroupChange").DataBound("onCustomerGroupDataBound"))
                                          .DataSource(source => source.Read(read => read.Action("GetCustomerGroupListByVerticalddl", "RAVersionTwo").Data("CustomerGroupAdditionalInfo"))
                                          .ServerFiltering(true))
                                          .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='customerGroupSelectAll'> Select All</label>")
                                          .HtmlAttributes(new { id = "ddlCustomerGroup", @class = "", tabindex = "1", @style = "width:100%" }))
                                </div>
                            </div>

                            <div class="row form-group">
                                <div class="col-md-4 text-right">
                                    @Helper.GetResourceString("lbl_Customer") 
                                </div>
                                <div class="col-md-4">
                                    @(Html.Kendo().MultiSelectFor(f => f.CustomerIds)
                                          .Placeholder(@Helper.GetResourceString("plho_SelectCustomer"))
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .AutoClose(false)
                                          .TagMode(TagMode.Single)
                                          .Events(e => e.Change("onCustomerChange").DataBound("onCustomerDataBound"))
                                          .DataSource(source => source.Read(resd => resd.Action("GetCustomerListByCustomerGroupIdsCityIdsForDropdown", "RAVersionTwo").Data("CustomerAdditionalInfo"))
                                          /*.ServerFiltering(false)*/)
                                          .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='customerSelectAll'> Select All</label>")
                                          .HtmlAttributes(new { id = "ddlCustomer", tabindex = "1", @class = "form-control", @style = "width:100%" }))
                                </div>
                            </div>

                            <div class="row form-group">
                                <div class="col-md-4 text-right">
                                    @Helper.GetResourceString("lbl_ValidFrom") <span class="text-danger">*</span>
                                </div>
                                <div class="col-md-4">
                                    @(Html.Kendo().DatePickerFor(m => m.ValidFrom)
                                          .Format(Settings.DateFormat)
                                          .Events(e => e.Change("fromChange"))
                                          .HtmlAttributes(new { id = "dpFromDate", onkeydown = "return isFocus(event);", tabindex = "5", style = "width: 100%" }))
                                </div>
                            </div>
                            <div class="row form-group">
                                <div class="col-md-4 text-right">
                                    @Helper.GetResourceString("lbl_ValidTo") <span class="text-danger">*</span>
                                </div>
                                <div class="col-md-4">
                                    @(Html.Kendo().DatePickerFor(m => m.ValidTo)
                                          .Format(Settings.DateFormat)
                                          .HtmlAttributes(new { id = "dpToDate", onkeydown = "return isFocus(event);", tabindex = "6", style = "width: 100%" }))
                                </div>
                            </div>
                            <div class="row form-group">
                                <div class="col-md-2 text-right">
                                    @Helper.GetResourceString("lbl_VolumeSlabInMT") <span class="text-danger">*</span>
                                </div>
                                <div class="col-md-2">
                                    @Html.TextBoxFor(m => m.StartVolumeSlabInMT, new { id = "txtStartVolumeSlabInMT", @class = "form-control", @placeholder = Helper.GetResourceString("lbl_StartVolumeSlabInMT"), @maxlength = (int)InputMaxLength.Price })
                                </div>
                                <div class="col-md-2">
                                    @Html.TextBoxFor(m => m.EndVolumeSlabInMT, new { id = "txtEndVolumeSlabInMT", @class = "form-control", @placeholder = Helper.GetResourceString("lbl_EndVolumeSlabInMT"), @maxlength = (int)InputMaxLength.Price })
                                </div>
                                <div class="col-md-2">
                                    @Html.TextBoxFor(m => m.Discount, new { id = "txtDiscount", tabindex = "4", @class = "form-control decimalValue", @placeholder = Helper.GetResourceString("lbl_Discount"), @maxlength = (int)InputMaxLength.Price })
                                </div>
                                <div class="col-md-2">
                                    <button type="button" tabindex="5" id="btnAddVolumeSlabs" class="k-primary k-button">@Helper.GetResourceString("Btn_AddVolumeSlab")</button>
                                </div>
                            </div>
                            <div class="row" align="center" style="margin-bottom:15px;">
                                <div class="col-md-12">
                                    <div class="text-right">
                                    </div>
                                    @(Html.Kendo().Grid<Adani.Solution.DTO.VolumeDiscountSlabDto>()
                                          .Name("ViewVolumeSlabs")
                                          .Columns(columns =>
                                          {
                                              columns.Bound(p => p.VolumeDiscountSlabId).Visible(false);
                                              columns.Bound(p => p.StartSlabInMT).Title(Helper.GetResourceString("lbl_StartVolumeSlabInMT")).Width(Settings.GridColumnMaxWidth);
                                              columns.Bound(p => p.EndSlabInMT).Title(Helper.GetResourceString("lbl_EndVolumeSlabInMT")).Width(Settings.GridColumnMaxWidth);
                                              columns.Bound(p => p.DiscountForSlab).Title(Helper.GetResourceString("lbl_Discount")).Width(Settings.GridColumnMaxWidth);
                                              columns.Template(c => c.VolumeDiscountSlabId).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Action"))
                                                  .ClientTemplate("<div style='text-align: center;'><a style='padding-left: 4px;' class='icon-cross cursor-pointer' onclick='RemoveDataFromGrid(this)'></a></div>").Width(Settings.GridOtherColumnWidth);
                                          })
                                          //.ToolBar(toolBar => { toolBar.Template("<a class='k-button k-button-icontext' onclick='AddTradeTicket()' href='#'></span>Add New Trade Details</a>"); })
                                          .BindTo(Model.VolumeSlabsList)
                                          .DataSource(dataSource => dataSource
                                          .Ajax()
                                          .ServerOperation(false)
                                          .Model(model => { model.Id(p => p.VolumeDiscountSlabId); })
                                          .Create(create => create.Action("", ""))))
                                </div>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-12 text-center">
                                <button type="button" tabindex="8" id="btnCancel" onclick="location.href = '@Url.Action("VolumeDiscountGeographyList", "RAVersionTwo")'" class="k-button">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.ManageRADiscounts))
                                {
                                    <button type="button" tabindex="9" id="btnSave" class="k-primary k-button">@Helper.GetResourceString("btn_Save")<i class="icon-arrow-right14 position-right"></i></button>
                                }
