</div>
<div id="kWindow">
    <h2>@Helper.GetResourceString("msg_VolumeSlabDeleteConfirmation")</h2>
    <div class="col-md-12 text-center">
        <button id="yes" class="k-primary k-button">Yes</button>
        <button id="no" class="k-primary k-button">No</button>
    </div>
</div>
<script>
    var windowDelete;
    $(document).ready(function () {

        windowDelete = $("#kWindow").kendoWindow({
            title: "Delete confirmation",
            modal: true,
            visible: false,
            resizable: false,
            width: 300
        }).data("kendoWindow");

        if ('@Model.VerticalId' > 0) {
            $("#ddlVertical").data("kendoDropDownList").readonly(true);
        }

        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        if ('@Model.StartVolumeSlabInMT' === "0") {
            $('#txtStartVolumeSlabInMT').val('');
        }

        if ('@Model.EndVolumeSlabInMT' === "0") {
            $('#txtEndVolumeSlabInMT').val('');
        }

        if ('@Model.Discount' === "0") {
            $('#txtDiscount').val('');
        }

        if ('@Model.Id' === '0') {
            $("#ddlVertical").data("kendoDropDownList").value('@Convert.ToInt32(Vertical.Hbc)');            
            $("#txtActualDiscount").val('');
            StartDateRange();
        } else {
            //$("#ddlOiltypes").data("kendoDropDownList").readonly(true);
            //$("#ddlSku").data("kendoMultiSelect").readonly(true);
            $("#dpFromDate").data("kendoDatePicker").readonly();
            $("#dpToDate").data("kendoDatePicker").readonly();
        }

        $("#btnAddVolumeSlabs").click(function (e) {
            AddDataToGrid();
        });

         $('#btnSave').on('click', function (e) {
             var isValid = $('#frmVolumeDiscount').valid();
            if (isValid) {
                if ($("#ViewVolumeSlabs").data("kendoGrid").dataSource.data().length > 0) {
                    window.kendo.ui.progress($("#div_Progress"), true);
                    $("#VolumeSlabsList").val(JSON.stringify($("#ViewVolumeSlabs").data("kendoGrid").dataSource.data()));
                    var frm = $("frmVolumeDiscount").serialize();
                    $('#frmVolumeDiscount').submit();
                    window.kendo.ui.progress($("#div_Progress"), false);
                }
                else {
                    ShowErrorMessage('@Helper.GetResourceString("msg_VolumeSlabsNotAdded")');
                }
            }
        });

        $("#skuSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlSku", "skuSelectAll");
        });

        $("#oilTypeSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlOilType", "oilTypeSelectAll");
            $("#ddlSku").data("kendoMultiSelect").dataSource.read();
        });

        $("#oilPackingTypeSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlOilPackingType", "oilPackingTypeSelectAll");
            $("#ddlSku").data("kendoMultiSelect").dataSource.read();
        });

        $("#customerGroupSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlCustomerGroup", "customerGroupSelectAll");
            $("#ddlCustomer").data("kendoMultiSelect").dataSource.read();
            $("#ddlZonalHead").data("kendoMultiSelect").dataSource.read();
        });

        $("#skuSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlSku", "skuSelectAll");
        });

        $("#citySelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlCity", "citySelectAll");
            $("#ddlCustomer").data("kendoMultiSelect").dataSource.read();
        });
        $("#customerSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlCustomer", "customerSelectAll");
        });

        $("#zoneSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlZone", "zoneSelectAll");
            $("#ddlState").data("kendoMultiSelect").dataSource.read();
        });

        $("#stateSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlState", "stateSelectAll");
            $("#ddlTerritory").data("kendoMultiSelect").dataSource.read();
        });

        $("#territorySelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlTerritory", "territorySelectAll");
            $("#ddlDistrict").data("kendoMultiSelect").dataSource.read();
        });

        $("#districtSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlDistrict", "districtSelectAll");
            $("#ddlCity").data("kendoMultiSelect").dataSource.read();
        });

    });

    function RemoveDataFromGrid(e) {
        var grid = $("#ViewVolumeSlabs").data("kendoGrid");
        var row = $(e).closest("tr");
        var dataItem = grid.dataItem($(e).closest("tr"));
        windowDelete.center().open();
        $("#yes").click(function () {
            grid.removeRow(row);
            windowDelete.close();
        });

        $("#no").click(function () {
            windowDelete.close();
        });
    }

    function AddDataToGrid() {
        var mappedGrid = $("#ViewVolumeSlabs").data("kendoGrid");
        var txtStartVolumeSlabInMT = $('#txtStartVolumeSlabInMT').val();
        var txtEndVolumeSlabInMT = $('#txtEndVolumeSlabInMT').val();
        var txtDiscount = $('#txtDiscount').val();
        var gridDataItems = [];
        var gridDataItems2 = [];

        if (txtStartVolumeSlabInMT !== ""
            && txtEndVolumeSlabInMT !== "" && Number(txtEndVolumeSlabInMT) > 0
            && txtDiscount !== "" && Number(txtDiscount) > 0) {

            //if (500 < size && size < 600) {
            //}
            if (Number(txtEndVolumeSlabInMT) < Number(txtStartVolumeSlabInMT)) {
                ShowErrorMessage('@Helper.GetResourceString("msg_InvalidVolumeSlab")');
            }
            else {
                var data = mappedGrid.dataSource.data();
                $.each(data, function (i, item) {
                    if (Number(item.StartSlabInMT) === Number(txtStartVolumeSlabInMT) && Number(item.EndSlabInMT) === Number(txtEndVolumeSlabInMT)) {
                        gridDataItems.push(item);
                    }
                    if (Number(item.StartSlabInMT) <= Number(txtStartVolumeSlabInMT) && Number(txtStartVolumeSlabInMT) < Number(item.EndSlabInMT)) {
                        gridDataItems2.push(item);
                    }
                });
                if (gridDataItems.length > 0 || gridDataItems2.length > 0) {
                    ShowErrorMessage('@Helper.GetResourceString("msg_VolumeSlabAlreadyAddedInThisRange")');
                }
                else {
                    var datasource = mappedGrid.dataSource;
                    var total = datasource.data().length;

                    datasource.insert(total, {
                        StartSlabInMT: txtStartVolumeSlabInMT,
                        EndSlabInMT: txtEndVolumeSlabInMT,
                        DiscountForSlab: txtDiscount
                    });
                    ClearVolumeSlabs();
                }
            }
        }
        else {
            ShowErrorMessage('@Helper.GetResourceString("msg_PleaseGiveVolumeSlabDetailsToProceed")');
        }
    }

    function ClearVolumeSlabs() {
        $('#txtStartVolumeSlabInMT').val('');
        $('#txtEndVolumeSlabInMT').val('');
        $('#txtDiscount').val('');
    }

     function onVerticalChange() {
        $("#ddlOilType").data("kendoMultiSelect").dataSource.read();
        $("#ddlZone").data("kendoMultiSelect").dataSource.read();
        $("#ddlCustomerGroup").data("kendoMultiSelect").dataSource.read();
    }

