@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model Adani.Solution.DTO.VolumeDiscountGeographyDto

@{
    ViewBag.Title = "GeographyBasedVolumeDiscount";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="ra2VolumeDiscountGeographyBased" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">@Helper.GetResourceString("lbl_AddOrUpdateGeographyBasedVolumeDiscount")</h2>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading"></div>
        <div class="panel-body">
            <div class="row" id="divLoader">
                <div class="col-md-12">
                    @using (Html.BeginForm("AddOrUpdateGeographyBasedVolumeDiscount", "RAVersionTwo", FormMethod.Post, new { id = "frmVolumeDiscount", @class = "form-validate-jquery" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="VolumeSlabsList" value="" id="VolumeSlabsList" />
                        @Html.HiddenFor(m => m.Id, new { id = "hdnId" })
                        <div class="row form-group">
                            <div class="row form-group">
                                <div class="col-md-4 text-right">
