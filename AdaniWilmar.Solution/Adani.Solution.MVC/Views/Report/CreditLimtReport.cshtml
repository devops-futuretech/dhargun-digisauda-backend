<script>

    $(document).ready(function () {
        FilterContains();
        $("#btnGenerateReport").click(function () {
            //downloadCreditLimitReport();
            $("#ViewCreditLimit").data("kendoGrid").dataSource.read();
        });

        $("#zonalheadSelectAll").click(function () {
            MultiSelectSelectAll("ddlZonalHead", "zonalheadSelectAll");
            if (@Model.RoleId != 7) {
                $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
            }
        });

        $("#BDOSelectAll").click(function () {
            MultiSelectSelectAll("ddlBDO", "BDOSelectAll");
        });


        $("#stateSelectAll").click(function () {
            MultiSelectSelectAll("ddlState", "stateSelectAll");
            if (@Model.RoleId != 7) {
            $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
            }
        });
    });
    function nationalheadLoadParam() {
        return {
            SelectedIds: (@Model.LoginUserId ? @Model.LoginUserId : "")
        }
    }
    function additionalInfo() {

        var verticalId = 0;
        var SalesOrganizationId = 0;
        var DistributionChannelId = 0;
        if ($("#ddlVertical").val() != "") {
            verticalId = $("#ddlVertical").val();
        }
        if ($("#ddlSalesOrganization").val() != "") {
            SalesOrganizationId = $("#ddlSalesOrganization").val();
        }
        if ($("#ddlDistributionChannel").val() != "") {
            DistributionChannelId = $("#ddlDistributionChannel").val();
        }
        var ZHId = zonalheadLoadParam();
        var BdoId = BDOLoadParam();
        var data = {
            stateIds: $("#ddlState").data("kendoMultiSelect").value(),
            verticalIds: verticalId,
            SalesOrganizationId: SalesOrganizationId,
            DistributionChannelId: DistributionChannelId,
            dealerCode: $("#txtCode").val(),
            zhId: ZHId.SelectedIds,
            bdoId: BdoId.SelectedIds
        };
        return data;
    }

    function BDOLoadParam() {
         var SelectedId = "";
        if (@Model.RoleId== @((int)Role.StateTrader)) {
            SelectedId = @Model.LoginUserId;
        } else {
            SelectedId = ($("#ddlBDO").val() ? $("#ddlBDO").val().join() : "")
        }
        return {
            SelectedIds: SelectedId
        }
    }
    function downloadCreditLimitReport() {

        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("CreditLimitExportAsync", "Report")',
            data: additionalInfo(),
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Report")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }



    //------------------ State ---------------------


    function onStateChange(e) {
        MultiSelectIndividualSelect("ddlState", "stateSelectAll");
        if (@Model.RoleId != 7) {
            $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        }
    }

    function onStateDataBound(e) {
        MultiSelectIndividualSelect("ddlState", "stateSelectAll");
        if (@Model.RoleId != 7) {
            $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        }
    }

    //Zone
    function onZonalChange() {
        MultiSelectIndividualSelect("ddlZonalHead", "zonalheadSelectAll");
        if (@Model.RoleId != 7) {
            $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        }
    }

    function onZonalheadDataBound(e) {
        MultiSelectIndividualSelect("ddlZonalHead", "zonalheadSelectAll");
        if (@Model.RoleId != 7) {
            $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        }
    }

    function onBDOChange(e) {
        MultiSelectIndividualSelect("ddlBDO", "BDOSelectAll");
    }

    function onBDODataBound(e) {
        MultiSelectIndividualSelect("ddlBDO", "BDOSelectAll");
    }

    function zonalheadLoadParam() {
        var SelectedId = "";
        if (@Model.RoleId== @((int)Role.ZonalTrader)) {
            SelectedId = @Model.LoginUserId;
        } else {
            SelectedId = ($("#ddlZonalHead").val() ? $("#ddlZonalHead").val().join() : "")
        }
        return {
            SelectedIds: SelectedId
        }
    }

    function MultiSelectCheckUnCheck(DropDownName, CheckBoxName) {
        var dropdown = $("#" + DropDownName + "").data("kendoMultiSelect");
        if (dropdown) {
            var allIds = dropdown.dataSource.data().map(function (dataItem) { return dataItem.StateId; });            //Select all ids from dropdown
            if ($("#" + CheckBoxName + "").is(":checked")) {
                dropdown.value(allIds);
            } else {
                dropdown.value([]);
            }
        }
    }

    function MultiSelectEvents(DropDownName, CheckBoxName) {
        var dropdown = $("#" + DropDownName + "").data("kendoMultiSelect");
        if (dropdown) {
            var selectedValueCount = dropdown.value().length;                                   //Selected value length
            var totalValueCount = dropdown.dataSource.data().length;                            //Dropdown total value count
            if (selectedValueCount > 0 && totalValueCount > 0 && selectedValueCount === totalValueCount) {
                $("#" + CheckBoxName + "").prop("checked", true);
            } else {
                $("#" + CheckBoxName + "").prop("checked", false);
            }
        }
    }


    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>



