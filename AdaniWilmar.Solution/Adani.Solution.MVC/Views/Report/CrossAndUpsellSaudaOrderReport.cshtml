@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO
@using Adani.Solution.DTO.Enums
@model RoleIdDto
@{
    ViewBag.Title = "SaudaOrderReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="reportCrossAndUpsellSaudaOrderDetails" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Cross-Selling & Upselling Report</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Report</a><span class="icon-right"></span></li>
        <li class="active">Cross-Selling & Upselling Report<span class="icon-right"></span></li>
    </ol>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSpecialRate">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label for="StartDate" class="custom_label">
                            @Helper.GetResourceString("lbl_FromDate")
                        </label>
                        @(Html.Kendo().DatePicker()
                              .Name("StartDate")
                              .Format(Settings.DateFormat)
                              .Events(e => e.Change("fromDateChange"))
                              .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label for="EndDate" class="custom_label"> @Helper.GetResourceString("lbl_ToDate") </label>
                        @(Html.Kendo().DatePicker()
                              .Name("EndDate")
                              .Format(Settings.DateFormat)
                              .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label for="ddlZone" class="custom_label">  @Helper.GetResourceString("lbl_Zone") </label>
                        @(Html.Kendo().MultiSelect().Name("ZoneId")
                              .Events(events => events.Change("onZoneChange").DataBound("onZoneDataBound"))
                              .Placeholder(@Helper.GetResourceString("plho_SelectZone"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              .DataSource(source => source.Read(read => read.Action("GetZoneListddl", "Lookup", new { isToReturnInactiveData = false }))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zoneSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlZone", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Zone"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label for="ddlState" class="custom_label"> @Helper.GetResourceString("lbl_State") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().MultiSelect().Name("StateId")
                              .Events(events => events.Change("onStateChange").DataBound("onStateDataBound"))
                              .Placeholder(@Helper.GetResourceString("plho_SelectState"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetStatesBasedOnZoneIds", "Lookup").Data("stateLoadParam"))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='stateSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlState", @class = "", tabindex = "4", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                    </div>
                </div>

                <div class="row form-group">


                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label for="ddlSalesOrganization" class="custom_label">
                            @Helper.GetResourceString("lbl_SalesOrganization")
                        </label>
                        @(Html.Kendo().DropDownList()
                        .Name("ddlSalesOrganization")
                        .OptionLabel(@Helper.GetResourceString("plho-SelectSales"))
                        .DataTextField("SalesOrganizationName")
                        .Events(e => e.Change("onSaleChange"))
                        .DataValueField("Id")
                        .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                        ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                    )

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label for="ddlDistributionChannel" class="custom_label">
                            @Helper.GetResourceString("lbl_DistributionChannel")
                        </label>
                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel(@Helper.GetResourceString("plho-SelectDistChannel"))
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                    </div>


                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label for="ddlVertical" class="custom_label">@Helper.GetResourceString("lbl_Vertical") </label>
                        @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_Division"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "7", @class = "", @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label for="ddlStatus" class="custom_label"> @Helper.GetResourceString("lbl_Status") </label>
                        @(Html.Kendo().MultiSelect().Name("Id")
                             .Events(events => events.Change("onStatusChange").DataBound("onStatusDataBound"))
                             .Placeholder(@Helper.GetResourceString("plho-SelectStatus"))
                             .DataTextField("Name")
                             .DataValueField("Id")
                             .AutoClose(false)
                             .TagMode(TagMode.Single)
                             .DataSource(source => source.Read(read => read.Action("GetSaudaListStatusWithAllOption", "Lookup"))
                             .ServerFiltering(false))
                             .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='statusSelectAll'> Select All</label>")
                             .HtmlAttributes(new { id = "ddlStatus", @class = "", tabindex = "9", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Status"), @style = "width:100%" }))
                        <label for="ddlStatus" id="lblStatus" class="field-validation-error" style="display: none;">@Helper.GetSelectMsgRequired("lbl_Status")</label>
                    </div>
                </div>

                <div class="row form-group">
                    <div class="col-md-12 text-right">
                        <button type="button" id="btnGenerateReport" class="k-primary k-button custom-btns">Generate Report </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        setFromToDateRange("StartDate", "EndDate", emamiGlobal.constant.ReportDateRange);

        $("#btnGenerateReport").click(function () {
            downloadCrossAndUpsellSaudaReport();
        });

        $("#zoneSelectAll").click(function () {
            MultiSelectSelectAll("ddlZone", "zoneSelectAll");
            $("#ddlState").data("kendoMultiSelect").dataSource.read();
        });

        $("#stateSelectAll").click(function () {
            MultiSelectSelectAll("ddlState", "stateSelectAll");
        });

        $("#statusSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlStatus", "statusSelectAll");
        });

    });

    function fromDateChange() {
        var endPicker = $("#EndDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#EndDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }

        setToDateRangeBasedOnFromDate(startDate, "EndDate", emamiGlobal.constant.IndentDateRange);
    }

    function StartDateRange() {
        var startDate = new Date();
        startDate.setDate(startDate.getDate());
        $("#StartDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
        var endPicker = $("#EndDate").data("kendoDatePicker");
        $("#EndDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
    }

    function downloadCrossAndUpsellSaudaReport(Id) {
        if (!$("#ddlState").val()) {
            ShowErrorMessage("Please select state");
            return false;
        }
        window.kendo.ui.progress($("#div_Progress"), true);
        var verticalId = 0;
        var salesorganizationId = 0;
        var distributionChannelId = 0;
        var stateIds = "";
        if ($("#ddlVertical").val() != "") {
            verticalId = $("#ddlVertical").val();
        }
        if ($("#ddlSalesOrganization").val() != "") {
            salesorganizationId = $("#ddlSalesOrganization").val();
        }
        if ($("#ddlDistributionChannel").val() != "") {
            distributionChannelId = $("#ddlDistributionChannel").val();
        }
        if ($("#ddlState").val() != "") {
            stateIds = $("#ddlState").data("kendoMultiSelect").value();
        }
        var statusId = $("#ddlStatus").val() ? $("#ddlStatus").val().join() : "";

        var fromdate = $("#StartDate").data("kendoDatePicker").value();
        var todate = $("#EndDate").data("kendoDatePicker").value();
        if (todate == null) {
            todate = fromdate;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetCrossAndUpsellSaudaOrderReport", "Report")',
            data: {
                fromDate: $("#StartDate").val(),
                toDate: $("#EndDate").val(),
                stateIds: stateIds,
                verticalId: verticalId,
                salesorganizationId: salesorganizationId,
                distributionChannelId: distributionChannelId,
                statusIds: $("#ddlStatus").data("kendoMultiSelect").value(),
                LoginUserId: '@Model.LoginUserId',
                RoleId : '@Model.RoleId'
            },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function onStatusChange() {
        MultiSelectEvents("ddlStatus", "statusSelectAll");
    }

    function onStatusDataBound(e) {
        MultiSelectEvents("ddlStatus", "statusSelectAll");
    }

    //Zone
    function onZoneChange() {
        $("#ddlState").data("kendoMultiSelect").dataSource.read();
        MultiSelectIndividualSelect("ddlZone", "zoneSelectAll");
    }

    function onZoneDataBound(e) {
        MultiSelectIndividualSelect("ddlZone", "zoneSelectAll");
    }

    function onStateChange(e) {
        MultiSelectIndividualSelect("ddlState", "stateSelectAll");
    }

    function onStateDataBound(e) {
        MultiSelectIndividualSelect("ddlState", "stateSelectAll");
    }

    function stateLoadParam() {
        return {
            SelectedIds: ($("#ddlZone").val() ? $("#ddlZone").val().join() : "")
        }
        }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>
