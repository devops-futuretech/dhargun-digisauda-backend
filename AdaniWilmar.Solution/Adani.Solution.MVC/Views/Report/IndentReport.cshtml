@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model IndentReportInputDto
@{
    ViewBag.Title = @Helper.GetResourceString("lbl_IndentReport");
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="reportIndentReport" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_IndentReport")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Report</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_IndentReport")<span class="icon-right"></span></li>
    </ol>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSpecialRate">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_FromDate") </label>
                        @(Html.Kendo().DatePicker()
                                                            .Name("StartDate")
                                                            .Value(DateTime.Now)
                                                            .Format(Settings.DateFormat)
                                                            .Events(e => e.Change("fromDateChange"))
                                                            .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_ToDate") </label>
                        @(Html.Kendo().DatePicker()
                                                            .Name("EndDate")
                                                            .Value(DateTime.Now)
                                                            .Format(Settings.DateFormat)
                                                            .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_State") </label>
                        @(Html.Kendo().MultiSelectFor(m => m.StateIds)
                                      .Placeholder(@Helper.GetResourceString("plho_SelectState"))
                                      .Events(events => events.Change("onStateChange").DataBound("onStateDataBound"))
                                      .DataTextField("StateName")
                                      .DataValueField("StateId")
                                      .AutoClose(false)
                                      .TagMode(TagMode.Single)
                                      .DataSource(source => source.Read(read => read.Action("GetStateListAsync", "Lookup"))
                                      .ServerFiltering(false))
                                      .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='stateSelectAll'> Select All</label>")
                                      .HtmlAttributes(new { id = "ddlState", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_Status") </label>
                        @(Html.Kendo().DropDownListFor(m => m.StatusId)
                                      .Name("Status")
                                      .OptionLabel("Select status")
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .DataSource(source => source.Read(resd => resd.Action("GetPendingApprovedStatusWithAllOption", "Lookup"))
                                      .ServerFiltering(false))
                                      .HtmlAttributes(new { id = "ddlStatus", @class = "form-control", tabindex = "4", @style = "width:100%" }))
                    </div>
                </div>
               
                <div class="row form-group">

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger"></span>
                        </label>
                        @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger"></span>
                        </label>
                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                        @(Html.Kendo().DropDownList().Name("VerticalId")
                                                                  .OptionLabel(@Helper.GetResourceString("plho_All"))
                                                                  .DataTextField("Name")
                                                                  .DataValueField("Id")
                                                                  .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                                                  .ServerFiltering(false))
                                                                  .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                    </div>

                    <!--<div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_IsAfterCreationDeliveryOrderNo") </label>-->
                        @*@Html.CheckBoxFor(m => m.IsAfterDeliverOrderNumber, new { id = "cbIsAfterDeliverOrderNumber", tabindex = "5" })*@
                        <!--@Html.Kendo().CheckBoxFor(m => m.IsAfterDeliverOrderNumber).Name("IsAfterDeliverOrderNumber").HtmlAttributes(new { id = "cbIsAfterDeliverOrderNumber", tabindex = "5" })
                    </div>-->
                </div>
                <div class="row form-group">
                    <div class="col-md-12 text-right">
                        <button type="button" tabindex="4" id="btnGenerateReport" class="k-primary k-button custom-btns">Generate Report </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {

        setFromToDateRange("StartDate", "EndDate", emamiGlobal.constant.IndentDateRange);

        $("#btnGenerateReport").click(function () {
            var verticalId = 0;
            var salesOrganizationId = $("#ddlSalesOrganization").val();
            var distributionChannelId = $("#ddlDistributionChannel").val();
            if ($("#ddlVertical").val() != "") {
                verticalId = $("#ddlVertical").val();
            }
            window.kendo.ui.progress($("#div_Progress"), true);
            $.ajax({
                type: "POST",
                url: '@Url.Action("IndentReportExportAsync", "Report")',
                data: {
                    StartDate: $("#StartDate").val(),
                    EndDate: $("#EndDate").val(),
                    StateIds : $("#ddlState").data("kendoMultiSelect").value(),
                    StatusId: $("#ddlStatus").data("kendoDropDownList").value(),
                   // IsAfterDeliverOrderNumber: $("#cbIsAfterDeliverOrderNumber").is(":checked"),
                    verticalIds: verticalId,
                    SalesOrganizationId: salesOrganizationId,
                    DistributionChannelId: distributionChannelId
                },
                success: function (responce) {
                    if (responce.FileGuid) {
                        window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                    } else {
                        ShowErrorMessage("No records found");
                    }
                    window.kendo.ui.progress($("#div_Progress"), false);
                },
                error: function (responce) {
                    ShowErrorMessage("File download failed");
                    window.kendo.ui.progress($("#div_Progress"), false);
                }
            });
        });

        $("#stateSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlState", "stateSelectAll");
        });

    });

    function fromDateChange() {
        var endPicker = $("#EndDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#EndDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }
        setToDateRangeBasedOnFromDate(startDate, "EndDate", emamiGlobal.constant.IndentDateRange);
        //setToDateRange("StartDate", "EndDate", 90);
    }

    function onStateChange(e) {
        MultiSelectEvents("ddlState", "stateSelectAll");
    }

    function onStateDataBound(e) {
        MultiSelectEvents("ddlState", "stateSelectAll");
    }

    function MultiSelectCheckUnCheck(DropDownName, CheckBoxName) {
        var dropdown = $("#" + DropDownName + "").data("kendoMultiSelect");
        if (dropdown) {
            var allIds = dropdown.dataSource.data().map(function (dataItem) { return dataItem.StateId; });            //Select all ids from dropdown
            if ($("#" + CheckBoxName + "").is(":checked")) {
                dropdown.value(allIds);
            } else {
                dropdown.value([]);
            }
        }
    }

    function MultiSelectEvents(DropDownName, CheckBoxName) {
        var dropdown = $("#" + DropDownName + "").data("kendoMultiSelect");
        if (dropdown) {
            var selectedValueCount = dropdown.value().length;                                   //Selected value length
            var totalValueCount = dropdown.dataSource.data().length;                            //Dropdown total value count
            if (selectedValueCount > 0 && totalValueCount > 0 && selectedValueCount === totalValueCount) {
                $("#" + CheckBoxName + "").prop("checked", true);
            } else {
                $("#" + CheckBoxName + "").prop("checked", false);
            }
        }
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>

