@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@model Adani.Solution.DTO.ExcelReportFilterDto
@{
    ViewBag.Title = "MTPVsDSRReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="reportDeviationDSRReport" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">MTP Vs DSR Deviation Report</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Report</a><span class="icon-right"></span></li>
        <li class="active">MTP Vs DSR Deviation Report<span class="icon-right"></span></li>
    </ol>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSpecialRate">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_FromDate") </label>
                        @(Html.Kendo().DatePicker()
                                                                            .Name("StartDate")
                                                                            .Value(DateTime.Now)
                                                                            .Format(Settings.DateFormat)
                                                                            .Events(e => e.Change("fromDateChange"))
                                                                            .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_ToDate") </label>
                        @(Html.Kendo().DatePicker()
                                                                            .Name("EndDate")
                                                                            .Value(DateTime.Now)
                                                                            .Format(Settings.DateFormat)
                                                                            .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_Zone") </label>
                        @(Html.Kendo().MultiSelect().Name("ZoneId")
                                                                                       .Events(events => events.Change("onZoneChange").DataBound("onZoneDataBound"))
                                                                                       .Placeholder("Select Zone")
                                                                                       .DataTextField("Name")
                                                                                       .DataValueField("Id")
                                                                                       .AutoClose(false)
                                                                                       .TagMode(TagMode.Single)
                                                                                       //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                                                                                       .DataSource(source => source.Read(read => read.Action("GetZoneListddl", "Lookup", new { isToReturnInactiveData = false }))
                                                                                       .ServerFiltering(false))
                                                                                       .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zoneSelectAll'> Select All</label>")
                                                                                       .HtmlAttributes(new { id = "ddlZone", @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Zone"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_State") </label>
                        @(Html.Kendo().MultiSelectFor(m => m.StateIds)
                                                                                          .Events(events => events.Change("onStateChange").DataBound("onStateDataBound"))
                                                                                          .Placeholder("Select State")
                                                                                          .DataTextField("Name")
                                                                                          .DataValueField("Id")
                                                                                          .AutoClose(false)
                                                                                          .TagMode(TagMode.Single)
                                                                                          .DataSource(source => source.Read(read => read.Action("GetStatesBasedOnZoneIds", "Lookup").Data("stateLoadParam"))
                                                                                          .ServerFiltering(false))
                                                                                          .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='stateSelectAll'> Select All</label>")
                                                                                          .HtmlAttributes(new { id = "ddlState", @class = "", tabindex = "7", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_State"), @style = "width:100%" }))
                    </div>
                </div>
                <div class="row form-group">
                    @if (Model.RoleId == (long)Role.NationalTrader)
                    {
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_ZonalHead") </label>
                            @(Html.Kendo().MultiSelect().Name("ZonalHeadId")
                              .Events(events => events.Change("onZonalChange").DataBound("onZonalheadDataBound"))
                              .Placeholder("Select Zonal Head")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetZonalHeadBasedNH", "Lookup").Data("nationalheadLoadParam"))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zonalheadSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlZonalHead", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_ZonalHead"), @style = "width:100%"}))
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_BDO") </label>
                            @(Html.Kendo().MultiSelect().Name("BDOId")
                              .Events(events => events.Change("onBDOChange").DataBound("onBDODataBound"))
                              .Placeholder("Select StateTrader")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetBDOBasedOnZonalheadIds", "Lookup").Data("zonalheadLoadParam"))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='BDOSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlBDO", @class = "", tabindex = "4", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_BDO"), @style = "width:100%" }))
                        </div>
                    }
                    else if (Model.RoleId == (long)Role.ZonalTrader)
                    {
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_ZonalHead") </label>
                            @(Html.Kendo().MultiSelect().Name("ZonalHeadId")
                              .Events(events => events.Change("onZonalChange").DataBound("onZonalheadDataBound"))
                              .Placeholder("Select Zonal Head")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .Value(Model.LoginUserId.ToString())
                              .TagMode(TagMode.Multiple)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetZonalHeadList", "Lookup", new { isToReturnInactiveData = false }))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zonalheadSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlZonalHead", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_ZonalHead"), @style = "width:100%" , @readonly = "readonly" }))
                        </div>
                        
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_BDO") </label>
                            @(Html.Kendo().MultiSelect().Name("BDOId")
                              .Events(events => events.Change("onBDOChange").DataBound("onBDODataBound"))
                              .Placeholder("Select StateTrader")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetBDOBasedOnZonalheadIds", "Lookup").Data("zonalheadLoadParam"))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='BDOSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlBDO", @class = "", tabindex = "4", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_BDO"), @style = "width:100%" }))
                        </div>

                    }
                    else if (Model.RoleId == (long)Role.StateTrader)
                    {
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_ZonalHead") </label>
                            @(Html.Kendo().MultiSelect().Name("ZonalHeadId")
                              .Events(events => events.Change("onZonalChange").DataBound("onZonalheadDataBound"))
                              .Placeholder("Select Zonal Head")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .Value(Model.OrganizationReportingToId.ToString())
                              .TagMode(TagMode.Multiple)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetZonalHeadList", "Lookup", new { isToReturnInactiveData = false }))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zonalheadSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlZonalHead", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_ZonalHead"), @style = "width:100%" , @readonly = "readonly" }))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">  @Helper.GetResourceString("lbl_BDO") </label>
                            @(Html.Kendo().MultiSelect().Name("BDOId")
                              .Events(events => events.Change("onBDOChange").DataBound("onBDODataBound"))
                              .Placeholder("Select StateTrader")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .Value(Model.LoginUserId.ToString())
                              .AutoClose(false)
                              .TagMode(TagMode.Multiple)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetBDOBasedOnZonalheadIds", "Lookup",new { SelectedIds = Model.OrganizationReportingToId.ToString() }))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='BDOSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlBDO", @class = "", tabindex = "4", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_BDO"), @style = "width:100%" , @readonly = "readonly" }))
                        </div>


                    }
                    else
                    {
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_ZonalHead") </label>
                            @(Html.Kendo().MultiSelect().Name("ZonalHeadId")
                              .Events(events => events.Change("onZonalChange").DataBound("onZonalheadDataBound"))
                              .Placeholder("Select Zonal Head")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetZonalHeadList", "Lookup", new { isToReturnInactiveData = false }))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zonalheadSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlZonalHead", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_ZonalHead"), @style = "width:100%"}))
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_BDO") </label>
                            @(Html.Kendo().MultiSelect().Name("BDOId")
                              .Events(events => events.Change("onBDOChange").DataBound("onBDODataBound"))
                              .Placeholder("Select StateTrader")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              //.MaxSelectedItems(ConfigHelper.MaxSelectedOneItemForMultiselect)
                              .DataSource(source => source.Read(read => read.Action("GetBDOBasedOnZonalheadIds", "Lookup").Data("zonalheadLoadParam"))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='BDOSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlBDO", @class = "", tabindex = "4", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_BDO"), @style = "width:100%" }))
                        </div>
                    }

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                        @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                    </div>

                </div>
                    <div class="row form-group">
                        <div class="col-md-12 text-right">
                            <button type="button" tabindex="4" id="btnGenerateReport" class="k-primary k-button custom-btns">Generate Report</button>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        setFromToDateRange("StartDate", "EndDate", emamiGlobal.constant.ReportDateRange);
        $("#btnGenerateReport").click(function () {
            downloadSaudaReport();
        });

         $("#zonalheadSelectAll").click(function () {
            MultiSelectSelectAll("ddlZonalHead", "zonalheadSelectAll");
            if (@Model.RoleId != 7) {
                $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
            }
        });
        $("#zoneSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlZone", "zoneSelectAll");
            $("#ddlState").data("kendoMultiSelect").dataSource.read();
        });

        $("#stateSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlState", "stateSelectAll");
        });

        $("#BDOSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlBDO", "BDOSelectAll");
        });
    });

    function fromDateChange() {
        setToDateRange("StartDate", "EndDate", 90);
    }
     function zonalheadLoadParam() {
        return {
            SelectedIds: ($("#ddlZonalHead").val() ? $("#ddlZonalHead").val().join() : "")
        }
    }

    function nationalheadLoadParam() {
        return {
            SelectedIds: (@Model.LoginUserId ? @Model.LoginUserId : "")
        }
    }
    function onZonalChange() {
        MultiSelectIndividualSelect("ddlZonalHead", "zonalheadSelectAll");
        if (@Model.RoleId != 7) {
            $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        }
    }

    function onZonalheadDataBound(e) {
        MultiSelectIndividualSelect("ddlZonalHead", "zonalheadSelectAll");
        if (@Model.RoleId != 7) {
            $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        }
    }
    function downloadSaudaReport(Id) {
        window.kendo.ui.progress($("#div_Progress"), true);
        var stateIds = $("#ddlState").val() ? $("#ddlState").val().join() : "";
        var BDOIds = $("#ddlBDO").val() ? $("#ddlBDO").val().join() : "";
        var verticalId = 0;
        var SalesOrganizationId = 0;
        var DistributionChannelId = 0;

        if ($("#ddlVertical").val() != "") {
            verticalId = $("#ddlVertical").val();
        }
        if ($("#ddlSalesOrganization").val() != "") {
            SalesOrganizationId = $("#ddlSalesOrganization").val();
        }
        if ($("#ddlDistributionChannel").val() != "") {
            DistributionChannelId = $("#ddlDistributionChannel").val();
        }
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetMTPVsDSRDeviationReport", "Report")',
            data: {
                fromDate: $("#StartDate").data("kendoDatePicker").value().toDateString(),
                toDate: $("#EndDate").data("kendoDatePicker").value().toDateString(),
                stateIds: stateIds,
                BDOIds: BDOIds,
                verticalId: verticalId,
                SalesOrganizationId: SalesOrganizationId,
                DistributionChannelId: DistributionChannelId
            },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }
    function onZoneChange() {
        $("#ddlState").data("kendoMultiSelect").dataSource.read();
        MultiSelectEvents("ddlZone", "zoneSelectAll");
    }

    function onZoneDataBound(e) {
        MultiSelectEvents("ddlZone", "zoneSelectAll");
    }
    function onStateChange(e) {
        MultiSelectEvents("ddlState", "stateSelectAll");
    }

    function onStateDataBound(e) {
        MultiSelectEvents("ddlState", "stateSelectAll");
    }

    function stateLoadParam() {
        return {
            SelectedIds: ($("#ddlZone").val() ? $("#ddlZone").val().join() : "")
        }
    }
    function onBDOChange() {
        MultiSelectEvents("ddlBDO", "BDOSelectAll");
    }

    function onBDODataBound(e) {
        MultiSelectEvents("ddlBDO", "BDOSelectAll");
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>