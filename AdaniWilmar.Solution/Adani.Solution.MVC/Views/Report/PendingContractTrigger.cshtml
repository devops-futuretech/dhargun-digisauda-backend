    function AdditionalInfo() {
        var verticalId = 0;
        if ($("#ddlVertical").data("kendoDropDownList").value()) {
            verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        }
        return {
            verticalId: Number(verticalId),
        };
    }*@
    function nationalheadLoadParam() {
        var verticalId = 0;
        var distId = 0;
        var salesId = 0;
        if ($("#ddlVertical").data("kendoDropDownList").value() != "") {
            verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        }
        if ($("#ddlDistributionChannel").data("kendoDropDownList").value() != "") {
            distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        }
        if ($("#ddlSalesOrganization").data("kendoDropDownList").value() != "") {
            salesId=$("#ddlSalesOrganization").data("kendoDropDownList").value();
        }
        return {
            SelectedIds: (@Model.LoginUserId ? @Model.LoginUserId : ""),
            SalesOrganizationId: salesId,
            DistributionChannelId:distId,
            DivisionId:verticalId
        }
    }

    function nationalheadLoadParamforAdmin() {
        var verticalId = 0;
        var distId = 0;
        var salesId = 0;
        
        return {
            SelectedIds: 0,
            SalesOrganizationId: salesId,
            DistributionChannelId:distId,
            DivisionId:verticalId
        }
    }
    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }

    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function onVerticalChange(e) {
        $("#ddlZonalHead").data("kendoMultiSelect").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function OnVerticalDataBound(e) {
        var verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        //if (verticalId > 0) {
        //    $("#ddlZonalHead").data("kendoDropDownList").dataSource.read();
        //}

    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function DivisionParam() {
        var verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        var salesId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            verticalId: Number(verticalId),
            SalesOrganizationId: Number(salesId),
            DistributionChannelId: Number(distId)

        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

    function onZonalChange() {
        $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        MultiSelectIndividualSelect("ddlZonalHead", "zonalheadSelectAll");
    }

    function onZonalheadDataBound(e) {
        MultiSelectIndividualSelect("ddlZonalHead", "zonalheadSelectAll");
    }

    function onBDOChange(e) {
        $("#ddlDealer").data("kendoMultiSelect").dataSource.read();
        MultiSelectIndividualSelect("ddlBDO", "BDOSelectAll");
    }

    function onBDODataBound(e) {
        MultiSelectIndividualSelect("ddlBDO", "BDOSelectAll");
    }

    function zonalheadLoadParam() {
        var SelectedId = "";
        if (@Model.RoleId== @((int)Role.ZonalTrader)) {
            SelectedId = @Model.LoginUserId;
        } else {
            SelectedId = ($("#ddlZonalHead").val() ? $("#ddlZonalHead").val().join() : "")
        }
        return {
            SelectedIds: SelectedId
        }
    }

    function BDOLoadParam() {
         var SelectedId = "";
        if (@Model.RoleId== @((int)Role.StateTrader)) {
            SelectedId = @Model.LoginUserId;
        } else {
            SelectedId = ($("#ddlBDO").val() ? $("#ddlBDO").val().join() : "")
        }
        return {
            SelectedIds: SelectedId
        }
    }

    function downloadMonthlyTourPlanReport() {
        @*if (!$("#ddlBDO").val()) {
            ShowErrorMessage("Please select StateTrader");
            return false;
        }*@
        window.kendo.ui.progress($("#div_Progress"), true);
        var verticalId = $("#ddlVertical").val();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPendingContractTrigger", "Report")',
            data: {

                DivisionId: verticalId,
                DealerIds: $("#ddlDealer").val().join(),
                SalesOrgId: $("#ddlSalesOrganization").val(),
                DistChnlId: $("#ddlDistributionChannel").val()
            },
            success: function (responce) {

                    ShowSuccessMessage("Submitted Successfully");

                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("Submit failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

</script>











