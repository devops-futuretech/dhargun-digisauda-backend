<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="transactionPendingContractTrigger" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_PendingContractTrigger")</h2>
    <ol class="breadcrumb custom_breadcrumb">
