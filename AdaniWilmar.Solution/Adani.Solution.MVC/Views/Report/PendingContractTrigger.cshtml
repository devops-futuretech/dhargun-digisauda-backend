                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='DealerSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlDealer", @class = "", tabindex = "4",  required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Dealer"), @style = "width:100%" }))
