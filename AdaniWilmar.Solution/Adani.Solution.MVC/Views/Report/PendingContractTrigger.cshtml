</div>
<script>
    $(document).ready(function () {
        // kendo grid filter contains
        @*FilterContains();*@
         if (@Model.RoleId== @((int)Role.ZonalTrader)) {
             $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        }
        $("#btnGenerateReport").click(function () {
            downloadMonthlyTourPlanReport();
        });

        $("#zonalheadSelectAll").click(function () {
            MultiSelectSelectAll("ddlZonalHead", "zonalheadSelectAll");
            $("#ddlBDO").data("kendoMultiSelect").dataSource.read();
        });

        $("#BDOSelectAll").click(function () {
            MultiSelectSelectAll("ddlBDO", "BDOSelectAll");
            $("#ddlDealer").data("kendoMultiSelect").dataSource.read();

        });
        $("#DealerSelectAll").click(function () {
            var dropdown = $("#ddlDealer").data("kendoMultiSelect");
            if (dropdown) {
                var allIds = dropdown.dataSource.data().map(function (dataItem) { return dataItem.Code; });            //Select all ids from dropdown
                if ($("#DealerSelectAll").is(":checked")) {
                    dropdown.value(allIds);
                } else {
                    dropdown.value([]);
                }
            }
            //MultiSelectSelectAll("ddlDealer", "DealerSelectAll");
        });

    });

