@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model RoleIdDto
@{
    ViewBag.Title = "PendingContracts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="transactionSAPPendingContracts" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_PendingContractReport")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Transaction</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_PendingContractReport")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        @*<div class="panel-body" style="display: block;">*@

            <div class="panel-body" style="display: block;" id="pageLoader">
                <div class=" col-md-12">
                    <div class="panel-group filter-accordion" id="accordion">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse" class="accord" data-parent="#accordion" href="#collapseOne">Filters</a>
                                </h4>
                            </div>
                            <div id="collapseOne" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <div class="row">
                                        <div class="panel-body">
                                            <div class="row" id="dvFreightRoutes">

                                                <div class="row form-group">
                                                    <div class="row">
                                                        <div class="col-lg-3 col-sm-6 mb-3">
                                                            <label class="custom_label">
                                                                @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                                                            </label>
                                                            @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                                                        </div>

                                                        <div class="col-lg-3 col-sm-6 mb-3">
                                                            <label class="custom_label">
                                                                @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                                                            </label>
                                                            @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new {  @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                                                        </div>
                                                        <div class="col-lg-3 col-sm-6 mb-3">
                                                            <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                                                            @(Html.Kendo().DropDownList().Name("VerticalId")
                                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                                              .DataTextField("Name")
                                              .DataValueField("Id")
                                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                              .ServerFiltering(false))
                                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                                                        </div>

                                                    </div>
                                                    <div class="row form-group">
                                                        <div class="col-md-12 text-left">
                                                            <button type="button" tabindex="4" id="btnGenerateReport" class="k-primary k-button custom-btns">Generate Report</button>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="row form-group"></div>
                
                <div class="row form-group">

                    <div class="col-md-12">
                        <div class="text-right right-buttons">
                            <div class="export_as">
                                <span>Export as</span>
                                <div class="export-btns">
                                    <span class="export-link" onclick='downloadPendingContracts()' type="button">Excel</span>
                                </div>
                            </div>
                            @*<button class="k-button k-button-icontext k-grid-excel" onclick='downloadPendingContracts()' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                            @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        </div>
                        @(Html.Kendo().Grid<PendingContractstDto>()
                      .Name("SAPPendingContracts")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.Id).Visible(false);
                          columns.Bound(c => c.SaudaNumber).Title("Contract Number").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.CustomerName).Title("Distributor Name").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.CustomerCode).Title("Distributor Code").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.MaterialCode).Title("Material Code").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.SalesOrganization).Title("SalesOrganization").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.DistributionChannel).Title("DistributionChannel").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.Division).Title("Division").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.PendingQuantityInCase).Title("PendingQuantityInCase").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.PendingQuantityInMT).Title("PendingQuantityInMT)").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.BasicRate).Title("Basic Price").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.TotalPrice).Title("Total Value").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.OpenSalesOrderQuantity).Title("OpenSalesOrderQuantity").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.ContractValidTo).Format(Settings.GridDateFormat).Title("ContractValidTo").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                          columns.Bound(c => c.CreatedDate).Format(Settings.GridDateTimeFormat).Title("CreatedDate").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                      })
                      .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                      .Filterable(filter => filter.Mode(GridFilterMode.Row))
                      .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                      .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                      .Selectable(selectable => selectable
                      .Mode(GridSelectionMode.Multiple)
                      .Type(GridSelectionType.Row))
                      .Scrollable(s => s.Enabled(true).Height("auto"))
                      .Reorderable(reorder => reorder.Columns(true))
                      .Resizable(resize => resize.Columns(true))
                      .Excel(excel => excel.AllPages(true).FileName("PendingContracts" + " " + DateTime.Now + ".xlsx").Filterable(true))
                      .DataSource(dataSource => dataSource
                      .Ajax()
                      .ServerOperation(true)
                      .Read(read => read.Action("GetPendingContracts", "Report").Data("AdditionalInfo"))))
                    </div>
                </div>
            </div>
        </div>
</div>
<script>
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();

        $("#btnGenerateReport").click(function () {
            $("#SAPPendingContracts").data("kendoGrid").dataSource.read();
        });

    });
     function downloadPendingContracts() {
         var verticalId = 0;
         var SalesOrganizationId = 0;
         var DistributionChannelId = 0;
         if ($("#ddlSalesOrganization").data("kendoDropDownList").value()) {
             SalesOrganizationId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
         }
         if ($("#ddlDistributionChannel").data("kendoDropDownList").value()) {
             DistributionChannelId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
         }
         if ($("#ddlVertical").data("kendoDropDownList").value()) {
             verticalId = $("#ddlVertical").data("kendoDropDownList").value();
         }
         
        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("PendingContractsExportAsync", "Report")',
            data: {
                verticalId: Number(verticalId),
                SalesOrganizationId: SalesOrganizationId,
                DistributionChannelId: DistributionChannelId,
             },
            success: function (responce) {

                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Report")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function AdditionalInfo() {
        debugger;
        var verticalId = 0;
        if ($("#ddlVertical").data("kendoDropDownList").value()) {
            verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        }
        var SalesOrganizationId = 0;
        if ($("#ddlSalesOrganization").data("kendoDropDownList").value()) {
            SalesOrganizationId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        }
        var DistributionChannelId = 0;
        if ($("#ddlDistributionChannel").data("kendoDropDownList").value()) {
            DistributionChannelId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        }
        return {
            verticalId: Number(verticalId),
            SalesOrganizationId: SalesOrganizationId,
            DistributionChannelId: DistributionChannelId,
        };
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>











