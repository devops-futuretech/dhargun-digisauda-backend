<script>
    $(document).ready(function () {

        // kendo grid filter contains
        FilterContains();

        //Fill default date
        fillDefaultDate();

        $("#btnGenerateReport").click(function () {
            $("#ViewSalesRegister").data("kendoGrid").dataSource.read();
        });

     });

    function fillDefaultDate() {
        var dates = new Date();
        dates.setDate(dates.getDate());
        $("#dpToDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
        $("#dpFromDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        StartDateRange();
    }

    function fromChange() {
        var endPicker = $("#dpToDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#dpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }
        setToDateRangeBasedOnFromDate(startDate, "dpToDate", emamiGlobal.constant.IndentDateRange);
    }

    function StartDateRange() {
        //var endPicker = $("#dpToDate").data("kendoDatePicker"),
        //    startDate = $("#dpToDate").val();
        //if (startDate) {
        //    startDate = new Date(startDate);
        //    $("#dpToDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
        //    endPicker.min(startDate);
        //}

        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#dpFromDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
        $("#dpToDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        var endPicker = $("#dpToDate").data("kendoDatePicker");
        endPicker.min(dates);
    }


    function AdditionalParam() {
        debugger;
        var verticalId = 0;
        if ($("#ddlVertical").data("kendoDropDownList").value() != "") {
            verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        }
        var SalesOrganizationId = 0;
        if ($("#ddlSalesOrganization").data("kendoDropDownList").value()) {
            SalesOrganizationId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        }
        var DistributionChannelId = 0;
        if ($("#ddlDistributionChannel").data("kendoDropDownList").value()) {
            DistributionChannelId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        }
        return {
            monthStartdate: $("#dpFromDate").val(),
            monthEnddate: $("#dpToDate").val(),
            verticalId: verticalId,
            SalesOrganizationId: SalesOrganizationId,
            DistributionChannelId: DistributionChannelId
        };
    }


    function downloadSalesRegister() {
        var monthStartdate = $("#dpFromDate").val();
        var monthEnddate = $("#dpToDate").val();

        window.kendo.ui.progress($("#div_Progress"), true);
        var verticalId = 0;
        var SalesOrganizationId = 0;
        if ($("#ddlSalesOrganization").data("kendoDropDownList").value()) {
            SalesOrganizationId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        }
        var DistributionChannelId = 0;
        if ($("#ddlDistributionChannel").data("kendoDropDownList").value()) {
            DistributionChannelId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        }

        if ($("#ddlVertical").val() != "") {
            verticalId = $("#ddlVertical").val();
        }
        $.ajax({
            type: "POST",
            url: '@Url.Action("SalesRegisterExportAsync", "Report")',
            data: {
                monthStartdate: monthStartdate,
                monthEnddate: monthEnddate,
                verticalId: verticalId,
                SalesOrganizationId: SalesOrganizationId,
                DistributionChannelId: DistributionChannelId
             },
            success: function (responce) {

                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Report")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");

                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>











