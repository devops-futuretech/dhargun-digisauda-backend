@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model RoleIdDto
@{
    ViewBag.Title = "SalesRegisterComparison";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="reportSalesRegisterComparison" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Sales Register Comparison</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Report</a><span class="icon-right"></span></li>
        <li class="active">Sales Register Comparison<span class="icon-right"></span></li>
    </ol>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSpecialRate">
                <div class="row form-group">
                    <div class="row form-group">
                        <div class="col-lg-3 col-sm-6 mb-3 ">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_FromDate") </label>
                            @(Html.Kendo().DatePicker()
                                                         .Name("StartDate")
                                                         .Value(DateTime.Now)
                                                         .Format(Settings.DateFormat)
                                                         .Events(e => e.Change("fromDateChange"))
                                                         .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_ToDate") </label>
                            @(Html.Kendo().DatePicker()
                                                       .Name("EndDate")
                                                       .Value(DateTime.Now)
                                                       .Format(Settings.DateFormat)
                                                       .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "5", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                        </div>

                    </div>

                    <div class="row form-group">
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                                                  .OptionLabel(@Helper.GetResourceString("plho_All"))
                                                  .DataTextField("Name")
                                                  .DataValueField("Id")
                                                  .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                                  .ServerFiltering(false))
                                                  .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                        </div>


                        <div class="col-md-12 text-right">
                            <button type="button" tabindex="4" id="btnGenerateReport" class="k-primary k-button custom-btns">Generate Report </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick=' downloadSalesRegisterComparison()' type="button">Excel</span>
                            </div>
                        </div>
                        @*<button class="k-button k-button-icontext k-grid-excel" onclick=' downloadSalesRegisterComparison()' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                    </div>
                    @(Html.Kendo().Grid<SalesRegisterOutputDto>
                    ()
                    .Name("SalesRegisterComparison")
                    .Columns(columns =>
                    {
                        columns.Group(group => group
                        .Title("Report for SAP Data")
                        .Columns(info =>
                        {
                            info.Bound(c => c.BillingType).Title("Billing Type").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.Contractnumber).Title("Contract Number").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.DoNumber).Title("Do Number").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.BillNumber).Title("Bill Number").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.BillingDate).Title("Billing Date").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.QuantityCase).Title("Quantity In Case").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.QuantityMT).Title("Quantity ").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.OilTypeDesc).Title("Oil Type Desc").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.BillToParty).Title("Bill To Party").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.BillToPartyDescription).Title("Bill To Party Description").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.StateofShipparty).Title("State of Shipparty").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                        })

                    );
                        columns.Group(group => group
                        .Title("Report for Portal Data")
                        .Columns(info =>
                        {
                            info.Bound(c => c.InvBillNumber).Title("Bill Number").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                            info.Bound(c => c.InvQuantityInCase).Title("Quantity In Case").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                        })

                    );
                        columns.Bound(c => c.Status).Title("Status").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                        columns.Bound(c => c.ActionToTaken).Title("ActionToTaken").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                    })
                    .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                    .Filterable(filter => filter.Mode(GridFilterMode.Row))
                    .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                    .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                    .Selectable(selectable => selectable
                    .Mode(GridSelectionMode.Multiple)
                    .Type(GridSelectionType.Row))
                    .Scrollable(s => s.Enabled(true).Height("auto"))
                    .Reorderable(reorder => reorder.Columns(true))
                    .Resizable(resize => resize.Columns(true))
                    .Excel(excel => excel.AllPages(true).FileName("SalesRegisterComparison" + " " + DateTime.Now + ".xlsx").Filterable(true))
                    .DataSource(dataSource => dataSource
                    .Ajax()
                    .ServerOperation(true)
                    .Read(read => read.Action("GetSalesRegisterComparison", "Report").Data("AdditionalInfo"))))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        FilterContains();
        $("#btnGenerateReport").click(function () {
            $("#SalesRegisterComparison").data("kendoGrid").dataSource.read();
        });
    });


   function AdditionalInfo() {
       var verticalId = 0;
       if ($("#ddlVertical").data("kendoDropDownList").value() != "") {
           verticalId = $("#ddlVertical").data("kendoDropDownList").value();
       }
       var SalesOrganizationId = 0;
       if ($("#ddlSalesOrganization").data("kendoDropDownList").value()) {
           SalesOrganizationId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
       }
       var DistributionChannelId = 0;
       if ($("#ddlDistributionChannel").data("kendoDropDownList").value()) {
           DistributionChannelId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
       }
       return {
             fromDate: $("#StartDate").val(),
             toDate: $("#EndDate").val(),
           verticalId: verticalId,
           SalesOrganizationId: SalesOrganizationId,
           DistributionChannelId: DistributionChannelId
         };
        }

    function downloadSalesRegisterComparison() {
        var verticalId = 0;
        var SalesOrganizationId = $("#ddlSalesOrganization").val();
        var DistributionChannelId = $("#ddlDistributionChannel").val();
        if ($("#ddlVertical").data("kendoDropDownList").value() != "") {
            verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        }
        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("SalesRegisterComparisonExportAsync", "Report")',
            data: {
                VerticalId: verticalId,
                fromDate: $("#StartDate").val(),
                toDate: $("#EndDate").val(),
                SalesOrganizationId: SalesOrganizationId,
                DistributionChannelId: DistributionChannelId
            },
            success: function (responce) {

                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Report")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }


    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>


