@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@model Adani.Solution.DTO.SaudaAgingReportDto

@{
    ViewBag.Title = "SaudaAgingReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="reportSaudaReport" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_SaudaAgingReport")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Report</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_SaudaAgingReport")<span class="icon-right"></span></li>
    </ol>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSpecialRate">

                <div class="row form-group">

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_SaudaAging") <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.SaudaAging, new { @id = "txtSaudaAging", tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_SaudaAging") })
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Depot") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownListFor(m => m.DepotId)
        .OptionLabel("Select Depot")
        .DataTextField("Name")
        .DataValueField("Id")
        .DataSource(source => source.Read(read => read.Action("GetAllDepotList", "Lookup"))
        .ServerFiltering(false))
        .HtmlAttributes(new { id = "ddlDepot", tabindex = "2", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Depot"), @style = "width:100%" }))

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Party") <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.Party, new { @id = "txtParty", tabindex = "3", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Party") })
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_PartyName") <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.PartyName, new { @id = "txtPartyName", tabindex = "4", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_PartyName") })
                    </div>

                </div>

                <div class="row form-group">

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_City") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownListFor(m => m.CityId)
    .OptionLabel(@Helper.GetResourceString("plho_SelectCity"))
    .DataTextField("CityName")
    .DataValueField("CityId")
    .DataSource(source => source.Read(read => read.Action("GetCityListAsync", "Lookup"))
    .ServerFiltering(false))
    .HtmlAttributes(new { id = "ddlCity", @class = "", required = "required", tabindex = "5", data_msg_required = Helper.GetSelectMsgRequired("lbl_City"), @style = "width:100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_MaterialDescription") <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.MaterialDescription, new { @id = "txtMaterialDescription", tabindex = "4", @class = "form-control", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_MaterialDescription") })
                    </div>

                </div>

                <div class="row form-group">
                    <div class="col-md-12 text-right">
                        <button type="button" tabindex="4" id="btnGenerateReport" class="k-primary k-button custom-btns">Generate Report</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        $("#btnGenerateReport").click(function () {
            downloadSaudaReport();
        });

    });

 
    function downloadSaudaReport(Id) {

        var inputputDto = {
            SaudaAging: $("#txtSaudaAging").val(),
            DepotId: $("#ddlDepot").val(),
            Party: $("#txtParty").val(),
            PartyName: $("#txtPartyName").val(),
            CityId: $("#ddlCity").val(),
            MaterialDescription: $("#txtMaterialDescription").val()
        };

        window.kendo.ui.progress($("#div_Progress"), true);

        $.ajax({
            type: "POST",
            url: '@Url.Action("SaudaAgingExportAsync", "Report")',
            data: inputputDto,
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Report")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }
</script>