@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@model Adani.Solution.DTO.RoleIdDto
@{
    ViewBag.Title = "TruckPlacementTrackerReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="reportTruckPlacementTrackerReport" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Truck Placement Tracker Report</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Report</a><span class="icon-right"></span></li>
        <li class="active">Truck Placement Tracker Report<span class="icon-right"></span></li>
    </ol>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSpecialRate">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_FromDate") </label>
                        @(Html.Kendo().DatePicker()
                                      .Name("StartDate")
                                      .Value(DateTime.Now)
                                      .Format(Settings.DateFormat)
                                      .Events(e => e.Change("fromDateChange"))
                                      .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_ToDate") </label>
                        @(Html.Kendo().DatePicker()
                                      .Name("EndDate")
                                      .Value(DateTime.Now)
                                      .Format(Settings.DateFormat)
                                      .HtmlAttributes(new { onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "1", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "5", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                    </div>

                </div>

                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                        @if (Model.RoleId == (long)Role.Admin || Model.RoleId == (long)Role.SubAdmin)
                        {
                            //  <div class="col-md-3">
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                                  .OptionLabel(@Helper.GetResourceString("plho_All"))
                                  .DataTextField("Name")
                                  .DataValueField("Id")
                                  .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                  .ServerFiltering(false))
                                  .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                            //  </div>
                        }
                        else
                        {
                            // <div class="col-md-3">
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                                  .OptionLabel(@Helper.GetResourceString("plho_All"))
                                  .DataTextField("Name")
                                  .DataValueField("Id")
                                  .Value(Model.VerticalId.ToString())
                                  .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                  .ServerFiltering(false))
                                  .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%", @readonly = "readonly" }))
                            //
                            //</div>
                        }
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_NationalHead") </label>
                        @(Html.Kendo().MultiSelect().Name("NationalHeadId")
                              .Events(events => events.Change("onNationalHeadChange").DataBound("onNationalHeadDataBound"))
                              .Placeholder("Select NationalTrader")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              .DataSource(source => source.Read(read => read.Action("GetNationalHeadList", "Lookup", new { isToReturnInactiveData = false }))
                              .ServerFiltering(false))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='nationalHeadSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlNationalHead", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_NationalHead"), @style = "width:100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">@Helper.GetResourceString("lbl_ZonalHead") </label>
                        @(Html.Kendo().MultiSelect().Name("ZonalHeadId")
                                      .Events(events => events.Change("onZonalHeadChange").DataBound("onZonalHeadDataBound"))
                                      .Placeholder("Select ZonalTrader")
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .AutoClose(false)
                                      .TagMode(TagMode.Single)
                                      .DataSource(source => source.Read(read => read.Action("GetZonalHeadListByNH", "Lookup").Data("nationalheadLoadParam"))
                                      .ServerFiltering(false))
                                      .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='zonalHeadSelectAll'> Select All</label>")
                                      .HtmlAttributes(new { id = "ddlZonalHead", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_ZonalHead"), @style = "width:100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_BDO") </label>
                        @(Html.Kendo().MultiSelect().Name("BDOId")
                                      .Events(events => events.Change("onBDOChange").DataBound("onBDODataBound"))
                                      .Placeholder("Select StateTrader")
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .AutoClose(false)
                                      .TagMode(TagMode.Single)
                                      .DataSource(source => source.Read(read => read.Action("GetBDOBasedOnZonalheadIds", "Lookup").Data("zonalheadLoadParam"))
                                      .ServerFiltering(false))
                                      .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='bdoSelectAll'> Select All</label>")
                                      .HtmlAttributes(new { id = "ddlBdo", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_BDO"), @style = "width:100%" }))
                    </div>

                </div>
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_Customer") </label>
                        @(Html.Kendo().MultiSelect()
                              .Name("CustomerId")
                              .Placeholder(@Helper.GetResourceString("plho_SelectUser"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .AutoClose(false)
                              .TagMode(TagMode.Single)
                              .Events(e => e.Change("onEmployeeChange").DataBound("onEmployeeDataBound"))
                              .DataSource(source => source.Read(read => read.Action("GetDealerBasedOnBDOIds", "Lookup").Data("bdoLoadParam"))
                              .ServerFiltering(true))
                              .HeaderTemplate("<label style='padding:10px 10px 5px 10px;color:white'><input type='checkbox' id='employeeSelectAll'> Select All</label>")
                              .HtmlAttributes(new { id = "ddlUser", @class = "", tabindex = "4", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_CustomerName"), @style = "width:100%" }))
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-12 text-center">
                        <button type="button" tabindex="4" id="btnGenerateReport" class="k-primary k-button">Generate Report<i class="icon-arrow-right14 position-right"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        setFromToDateRange("StartDate", "EndDate", emamiGlobal.constant.ReportDateRange);
        $("#btnGenerateReport").click(function () {
            downloadReport();
        });

        $("#bdoSelectAll").click(function () {
            MultiSelectSelectAll("ddlBdo", "bdoSelectAll");
            $("#ddlUser").data("kendoMultiSelect").dataSource.read();
        });

        $("#zonalHeadSelectAll").click(function () {
            MultiSelectSelectAll("ddlZonalHead", "zonalHeadSelectAll");
            $("#ddlBdo").data("kendoMultiSelect").dataSource.read();
        });

        $("#nationalHeadSelectAll").click(function () {
            MultiSelectSelectAll("ddlNationalHead", "nationalHeadSelectAll");
            $("#ddlZonalHead").data("kendoMultiSelect").dataSource.read();
        });

        $("#employeeSelectAll").click(function () {
            MultiSelectSelectAll("ddlUser", "employeeSelectAll");
            //$("#ddlSku").data("kendoMultiSelect").dataSource.read();
        });
    });

    function fromDateChange() {
        setToDateRange("StartDate", "EndDate", emamiGlobal.constant.ReportDateRange);
    }

    function onEmployeeChange() {
        MultiSelectIndividualSelect("ddlUser", "employeeSelectAll");
    }


    function onEmployeeDataBound() {
        MultiSelectIndividualSelect("ddlUser", "employeeSelectAll");
    }

    function onBDOChange() {
        MultiSelectIndividualSelect("ddlBdo", "bdoSelectAll");
        $("#ddlUser").data("kendoMultiSelect").dataSource.read();
    }

    function onBDODataBound(e) {
        MultiSelectIndividualSelect("ddlBdo", "bdoSelectAll");
    }

    function onZonalHeadChange() {
        MultiSelectIndividualSelect("ddlZonalHead", "zonalHeadSelectAll");
        $("#ddlBdo").data("kendoMultiSelect").dataSource.read();
    }

    function onZonalHeadDataBound(e) {
        MultiSelectIndividualSelect("ddlNationalHead", "nationalHeadSelectAll");
    }

    function onNationalHeadChange() {
        MultiSelectIndividualSelect("ddlNationalHead", "nationalHeadSelectAll");
        $("#ddlZonalHead").data("kendoMultiSelect").dataSource.read();
    }

    function onNationalHeadDataBound(e) {
        MultiSelectIndividualSelect("ddlZonalHead", "zonalHeadSelectAll");
    }

    function nationalheadLoadParam() {

        return {
            SelectedIds: ($("#ddlNationalHead").val() ? $("#ddlNationalHead").val().join() : "")
        };
    }

    function zonalheadLoadParam() {

        return {
            SelectedIds: ($("#ddlZonalHead").val() ? $("#ddlZonalHead").val().join() : "")
        };
    }

    function bdoLoadParam() {

        return {
            SelectedIds: ($("#ddlBdo").val() ? $("#ddlBdo").val().join() : "")
        };
    }


    function AdditionalParam() {
        var VerticalId = $("#ddlVertical").data("kendoDropDownList").value();
        var NationalHeadIds = $("#ddlNationalHead").data("kendoMultiSelect").value();
        var ZonalHeadIds = $("#ddlZonalHead").data("kendoMultiSelect").value();
        var BdoIds = $("#ddlBdo").data("kendoMultiSelect").value();
        var DealerIds = $("#ddlUser").data("kendoMultiSelect").value();
        return {
            FromDate: $("#StartDate").val(),
            ToDate: $("#EndDate").val(),
            ZonalHeadIds: ZonalHeadIds,
            NationalHeadIds: NationalHeadIds,
            BdoIds: BdoIds,
            DealerIds: DealerIds
        };
    }


    function downloadReport(Id) {
        var verticalId = 0;
        if ($("#ddlVertical").val() != "") {
            verticalId = $("#ddlVertical").val();
        }
        var ZonalHeadIds = $("#ddlZonalHead").val();
        var NationalHeadIds = $("#ddlNationalHead").val();
        var BdoIds = $("#ddlBdo").val();
        var DealerIds = $("#ddlUser").val();
        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetTruckPlacementTrackerReport", "Report")',
            data: {
                fromDate: $("#StartDate").data("kendoDatePicker").value().toDateString(),
                toDate: $("#EndDate").data("kendoDatePicker").value().toDateString(),
                verticalId: verticalId,
                NationalHeadIds: $("#ddlNationalHead").data("kendoMultiSelect").value(),
                ZonalHeadIds: $("#ddlZonalHead").data("kendoMultiSelect").value(),
                BdoIds: $("#ddlBdo").data("kendoMultiSelect").value(),
                DealerIds: $("#ddlUser").data("kendoMultiSelect").value()
            },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>