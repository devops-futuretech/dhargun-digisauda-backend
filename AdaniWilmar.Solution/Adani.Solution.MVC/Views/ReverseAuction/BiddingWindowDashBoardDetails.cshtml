<script type="text/javascript">
    $(document).ready(function () {
        var grid = $("#BiddingWindowVolumeList");
        $('#ChartBasedOnOilType').hide();
        var biddingWindowId = $("#hdnId").val()
        //var BiddingWindowStatusCount = $("#BiddingWindowStatusCount").data("kendoChart");
        //BiddingWindowStatusCount.dataSource.read({ BiddingWindowId: biddingWindowId });
        $("#refreshDashboard").click(function () {
            window.location.reload();
        });
    });
    function additionalParam() {
        return {
            BiddingWindowId: $("#hdnId").val()
        }
    }
    function ShowOilTypeWiseChart() {
        $('#ChartBasedOnOilType').show();
    }
    function Refresh() {
        window.location.reload();
    }

    function getNumberFormat() {
        return emamiGlobal.constant.BiddingWindowDashboardFormat;
    }

</script>
