@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.BiddingWindowTimingDto
@{

    ViewBag.Title = "Bidding Window Timing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="configurationBitWindow" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Bidding Window</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Configurations</a><span class="icon-right"></span></li>
        <li><a href="BiddingWindow">@Helper.GetResourceString("lbl_BiddingWindow")</a><span class="icon-right"></span></li>
        <li class="active">Bidding Window<span class="icon-right"></span></li>
    </ol>
    <div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">
        </div>
    </div>
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvDealers">
                <div class="col-md-12">
                    <div class="text-left">
                        @using (Html.BeginForm("BiddingWindowTiming", "ReverseAuction", FormMethod.Post, new { id = "frmBiddingWindowTiming", @class = "form-validate-jquery" }))
                        {
                            <div class="demo-section k-content">
                                @Html.HiddenFor(model => model.Id)
                                <div class="row form-group">
                                    <div class="col-lg-3 col-sm-6 mb-3">
                                        <label class="custom_label">  @Html.Label("Date") </label>
                                        @(Html.Kendo().DatePickerFor(s => s.Date)
                                              .Min(DateTime.Now)
                                              .Format(Settings.DateFormat)
                                              .HtmlAttributes(new { id = "dpDate", tabindex = "1", style = "width: 100%", onkeydown = "return isFocus(event);" }))
                                    </div>

                                    <div class="col-lg-5 col-sm-6 mb-3">
                                        <label class="custom_label" style="display:block"> @Html.Label("From & To Time") </label>
                                        <div class="row">
                                            <div class="col-xs-6 col-sm-6 p-0 pb-2 custom-time-slct">
                                                @(Html.Kendo().TimePickerFor(s => s.From)
                                              .Name("From")
                                              .Min("6:00 AM")
                                              .Max("11:30 PM")
                                              .Interval(1)
                                              .Format("HH:mm")
                                              .Events(e => e.Change("startChange")).HtmlAttributes(new { style = "width: 100%", tabindex = "2", onkeydown = "return isFocus(event);" }))
                                            </div>
                                            <div class="col-xs-6 col-sm-6 p-0 pb-2 custom-time-slct">
                                                @(Html.Kendo().TimePickerFor(s => s.To)
                                              .Name("To")
                                              .Min("6:00 AM")
                                              .Max("11:30 PM")
                                              .Interval(1)
                                              .Format("HH:mm")
                                              .HtmlAttributes(new { style = "width: 100%", tabindex = "3", onkeydown = "return isFocus(event);" }))
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                                    <div class="row form-group">
                                        <div class="col-lg-3 col-sm-6 mb-3">
                                            <label class="custom_label">  @Html.Label("Is Last Window") </label>
                                            <div class="custom_checkbox_main">
                                                @(Html.Kendo().CheckBoxFor(m => m.IsLastWindowPerDay).Name("IsLastWindowPerDay").HtmlAttributes(new { id = "cbIsLastWindow", tabindex = "4" }))

                                            </div>
                                        </div>


                                        <div class="col-lg-3 col-sm-6 mb-3">
                                            <label class="custom_label">Status</label>
                                            <div class="custom_checkbox_main">
                                                @(Html.Kendo().CheckBoxFor(m => m.IsActive).Name("IsActive").HtmlAttributes(new { id = "cbIsActive", tabindex = "5" }))
                                                <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <div class="col-md-12 text-right">
                                <button type="button" tabindex="7" id="btnCancel" onclick="location.href = '@Url.Action("BiddingWindow", "ReverseAuction")'" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                                @if (Helper.CheckClaims(Claims.ManageBiddingWindow))
                                {
                                    <button type="button" tabindex="6" id="btnSave" class="k-primary k-button custom-btns">Save</button>
                                }
                            </div>

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
       if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        if ('@Model.Id' === '0') {
            var dates = new Date();
            dates.setDate(dates.getDate());
            $("#dpDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        }

        //$("#From").kendoTimePicker({
        //    interval: 1
        //});

        //$("#To").kendoTimePicker({
        //    interval: 1
        //});

        $("#btnSave").on('click', function () {
            var date = $("#dpDate").data("kendoDatePicker").value();
            //if (date) {
                if ($("#From").data("kendoTimePicker").value()) {
                    if ($("#To").data("kendoTimePicker").value()) {
                        var isValid = $("#frmBiddingWindowTiming").valid();
                        if (isValid) {
                            // Animate loader
                            window.kendo.ui.progress($("#div_Progress"), true);
                            $("#frmBiddingWindowTiming").submit();
                        }
                    }
                    else {
                        ShowErrorMessage("Invalid End Time");
                        return false;
                    }
                }
                else {
                    ShowErrorMessage("Invalid Start Time");
                    return false;
                }
            //}

            //else {
            //    ShowErrorMessage("Invalid Date");
            //    return false;
            //}
         });
    });
    function startChange() {
        var startTime = this.value(),
            endPicker = $("#To").data("kendoTimePicker");

        if (startTime) {
            startTime = new Date(startTime);
            //endPicker.max(startTime);
            startTime.setMinutes(startTime.getMinutes() + this.options.interval);
            endPicker.min(startTime);
            endPicker.value(startTime);
        }
    }
</script>
