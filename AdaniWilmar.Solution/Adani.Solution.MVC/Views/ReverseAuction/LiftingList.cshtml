@Html.Hidden("hdSelectedIds")
<script>
    $(document).ready(function () {

        setFromToDateRange("StartDate", "EndDate", emamiGlobal.constant.IndentDateRange);

        //StartDateRange();
        //$("#btnApproved").prop("disabled", true);
        //$("#btnRejected").prop("disabled", true);
        $("#masterCBAllPaymentReceived").hide();

        $("#btnApproved").val(emamiGlobal.Status.Approved);
        $("#btnRejected").val(emamiGlobal.Status.Rejected);

        $("#btnGenerateLiftingList").on('click', function () {
            //window.kendo.ui.progress($("#div_Progress"), true);
            onDateChange();
           // window.kendo.ui.progress($("#div_Progress"), false);
        });

        // Lifting request Approve & Reject
        $("#btnApproved,#btnRejected").click(function (e) {
            var form = $('#frmLiftingList');
            var token = $('input[name="__RequestVerificationToken"]', form).val();
            var gridData = $("#ViewLiftingList").data("kendoGrid").dataSource.data();
            var selectedOrders = [];

            if (gridData.length === 0) {
                ShowErrorMessage("Please select any record");
                return false;
            }

            selectedOrders = $("#hdSelectedIds").val().split(",");
            if (selectedOrders == '') {
                ShowErrorMessage("Please select any record");
                return false;
            }

            var statusId = parseInt($(this).val());
            if ((statusId == emamiGlobal.Status.Rejected || statusId == emamiGlobal.Status.Hold) && !$("#txtRemarks").val()) {
                ShowErrorMessage("Please enter the reason");
                return false;
            }

            var model = {
                EncryptedIds: selectedOrders,
                StatusId: statusId,
                Remarks: $("#txtRemarks").val()
            };

            var IsApproved = false;
            for (var i = 0; i < gridData.length; i++) {
                if (gridData[i].StatusID == emamiGlobal.Status.Pending) {
                    IsApproved = true;
                }
            }
            if (!IsApproved) {
                ShowErrorMessage('@Helper.GetResourceString("msg_AlreadyApproved")');
            }
            else {
                window.kendo.ui.progress($("#div_Progress"), true);
                moduleCommon.Common.AjaxCall({
                url: '@Url.Action("LiftingRequestStatusChanges", "ReverseAuction")',
                type: 'POST',
                data: { __RequestVerificationToken: token, liftingRequestStatusChange: model },
                success: function (result) {
                    if (result.PostStatus) {
                        ShowSuccessMessage(result.PostMessage);
                        setTimeout(function () { window.location.href = '@Url.Action("LiftingList", "ReverseAuction")'; }, 1300);
                    } else {
                        ShowErrorMessage(result.PostMessage);
                    }
                    window.kendo.ui.progress($("#div_Progress"), false);
                }
            });
            }

        });

        // Lifting request reprocess
        $("#btnReprocess").click(function (e) {
            var form = $('#frmLiftingList');
            var token = $('input[name="__RequestVerificationToken"]', form).val();
            var gridData = $("#ViewLiftingList").data("kendoGrid").dataSource.data();
            var selectedOrders = [];

            if (gridData.length === 0) {
                ShowErrorMessage("Please select any record");
                return false;
            }

            selectedOrders = $("#hdSelectedIds").val().split(",");
            if (selectedOrders == '') {
                ShowErrorMessage("Please select any record");
                return false;
            }

            var model = {
                EncryptedIds: selectedOrders
            };

             window.kendo.ui.progress($("#pageLoader"), true);
            moduleCommon.Common.AjaxCall({
            url: '@Url.Action("ReprocessLiftingRequest", "ReverseAuction")',
            type: 'POST',
            data: { inputDto : model},
                    success: function(result) {
                        if (result.PostStatus) {
                            ShowSuccessMessage(result.PostMessage);
                            setTimeout(function () { window.location.href = '@Url.Action("LiftingList", "ReverseAuction")'; }, 1500);
                        } else {
                            ShowErrorMessage(result.PostMessage);
                        }
                        window.kendo.ui.progress($("#pageLoader"), false);
            }
            });

        });


        // kendo grid filter contains
        FilterContains();


        $("#stateSelectAll").click(function () {
            MultiSelectCheckUnCheck("ddlState", "stateSelectAll");
        });


        $("#liftingExcelDownload").click(function () {
            window.kendo.ui.progress($("#div_Progress"), true);
            var verticalId = 0;
            if ($("#ddlVertical").val() != "") {
                verticalId = $("#ddlVertical").val();
            }
            var model = {
                FromDate: $('#StartDate').val(),
                ToDate: $('#EndDate').val(),
                StatusId: $('#ddlStatus').val(),
                StateIds: $('#ddlState').val(),
                verticalId: verticalId
            };

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetSaudaOrderLiftingRequestExcelExport", "ReverseAuction")',
                data: { inputDto: model },
                success: function (responce) {
                    if (responce.FileGuid) {
                        window.location.href = '@Url.Action("ExcelDownload", "Base")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                    } else {
                        ShowErrorMessage("No records found");
                    }
                    window.kendo.ui.progress($("#div_Progress"), false);
                },
                error: function (responce) {
                    ShowErrorMessage("File download failed");
                    window.kendo.ui.progress($("#div_Progress"), false);
                }
            });
        });
    });


    var detailExportPromises = [];

    function employees_excelExport(e) {

        var grid = $("#ViewLiftingList").data("kendoGrid");
        $(".k-master-row").each(function (index) {
            grid.expandRow(this);
        });

        // prevent saving the file because we will update the workbook
        e.preventDefault();
        var workbook = e.workbook;
        // Export all detail grids
        $("[data-role=grid]", this.element).each(function () {
            $(this).data("kendoGrid").saveAsExcel();
        });
        // wait for all detail grids to finish exporting
        $.when.apply(null, detailExportPromises)
            .then(function () {
                // get the export results
                var detailExports = $.makeArray(arguments);
                // sort by masterRowIndex
                detailExports.sort(function (a, b) {
                    return a.masterRowIndex - b.masterRowIndex;
                });
                // add an empty column
                workbook.sheets[0].columns.unshift({ width: 30 });
                // prepend an empty cell to each row
                for (var i = 0; i < workbook.sheets[0].rows.length; i++) {
                    workbook.sheets[0].rows[i].cells.unshift({});
                }
                // merge the detail export sheet rows with the master sheet rows
                // loop backwards so the masterRowIndex doesn't need to be updated
                for (var i = detailExports.length - 1; i >= 0; i--) {
                    var masterRowIndex = detailExports[i].masterRowIndex + 1;
                    var sheet = detailExports[i].sheet;
                    // prepend an empty cell to each row
                    for (var ci = 0; ci < sheet.rows.length; ci++) {
                        if (sheet.rows[ci].cells[0].value) {
                            sheet.rows[ci].cells.unshift({});
                        }
                    }
                    // insert the detail sheet rows after the master row
                    [].splice.apply(workbook.sheets[0].rows, [masterRowIndex + 1, 0].concat(sheet.rows));
                }
                // save the workbook
                kendo.saveAs({
                    dataURI: new kendo.ooxml.Workbook(workbook).toDataURL(),
                    fileName: '@Helper.GetResourceString("lbl_IndentList")' + '_' + '@DateTime.Now' + ".xlsx"
                });
            });
    }


    function detailInit(e) {
        var deferred = $.Deferred();
        // get the index of the master row
        var masterRowIndex = e.masterRow.index(".k-master-row");
        // add the deferred to the list of promises
        detailExportPromises.push(deferred);
        var detailGrid = e.detailRow.find("[data-role=grid]").data("kendoGrid");
        detailGrid.bind("excelExport", function (e) {
            // prevent saving the file
            e.preventDefault();
            // resolve the deferred
            deferred.resolve({
                masterRowIndex: masterRowIndex,
                sheet: e.workbook.sheets[0]
            });
        });
    }

