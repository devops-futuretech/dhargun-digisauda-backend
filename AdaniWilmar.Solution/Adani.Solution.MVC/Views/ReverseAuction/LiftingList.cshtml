@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model LiftingRequestOutputDto
@{
    ViewBag.Title = @Helper.GetResourceString("lbl_IndentList");
}

<style>
    button:disabled {
        cursor: not-allowed !important;
        pointer-events: all !important;
    }
</style>

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="transactionLiftingList" />

<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_IndentList")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Transaction</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_IndentList")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>
@using (Html.BeginForm("SaudhaDetails", "ReverseAuction", FormMethod.Post, new { id = "frmLiftingList", @class = "form-validate-jquery" }))
