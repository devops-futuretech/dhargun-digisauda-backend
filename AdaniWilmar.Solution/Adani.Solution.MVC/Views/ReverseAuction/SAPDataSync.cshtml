@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@{
    ViewBag.Title = "SAPDataSync";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="configurationSyncData" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_SAPDataSync")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Configurations</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_SAPDataSync")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSapSync">
                <div class="row form-group">
                    @*<div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_SyncType") </label>
                        @(Html.Kendo().DropDownList()
                                      .Name("SyncTypeId")
                                      .OptionLabel("Select Option to Sync Type")
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .DataSource(source => source.Read(resd => resd.Action("GetSyncTypeForDropdown", "ReverseAuction"))
                                      .ServerFiltering(false))
                                      .Events(e => e.Change("SyncTypeChanges"))
                                      .HtmlAttributes(new { id = "ddlSyncTypeSync", @class = "form-control", tabindex = "4", @style = "width:100%" }))
                        <label id="lblTypeSync" class="field-validation-error" style="display: none;">@Helper.GetSelectMsgRequired("lbl_SyncType")</label>
                    </div>*@

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_SalesOrganization") @*<span class="text-danger">*</span>*@ </label>
                        @(Html.Kendo().DropDownList()
                                    .Name("ddlSalesOrganization")
                                    .OptionLabel(@Helper.GetResourceString("plho-SelectSales"))
                                    .DataTextField("SalesOrganizationName")
                                    .Events(e => e.Change("onSaleChange"))
                                    .DataValueField("Id")
                                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                                    ).HtmlAttributes(new { tabindex = "1", @class = "form-control", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                               )
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_DistributionChannel") @*<span class="text-danger">*</span>*@ </label>
                        @(Html.Kendo().DropDownList()
                                  .Name("ddlDistributionChannel")
                                  .OptionLabel(@Helper.GetResourceString("plho-SelectDistChannel"))
                                  .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                                  .DataTextField("DistributionChannelName")
                                  .DataValueField("Id")
                                  .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                                  .ServerFiltering(true))
                                  .HtmlAttributes(new { @class = "", tabindex = "5", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">  @Helper.GetResourceString("lbl_Vertical") <span class="text-danger">*</span> </label>
                        @(Html.Kendo().DropDownList()
                                      .Name("ddlDivision")
                                      .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .DataSource(source => source.Read(read => read.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                      .ServerFiltering(false))
                                      .HtmlAttributes(new { id = "ddlVertical", @class = "", tabindex = "3", data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), @style = "width:100%" }))
                    </div>

                    @*<div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_SAPDataSync") </label>
                        @(Html.Kendo().DropDownList()
                                      .Name("SyncDataId")
                                      .OptionLabel("Select Option to Sync Data")
                                      .DataTextField("Name")
                                      .DataValueField("Id")
                                      .DataSource(source => source.Read(resd => resd.Action("GetSAPDataSyncListForDropdown", "ReverseAuction"))
                                      .ServerFiltering(false))
                                      .HtmlAttributes(new { id = "ddlSAPDataSync", @class = "form-control", tabindex = "4", @style = "width:100%" }))
                        <label id="lblDataSync" class="field-validation-error" style="display: none;">@Helper.GetSelectMsgRequired("lbl_SAPDataSync")</label>
                    </div>*@
                </div>
                <div class="row form-group">
                    <div class="col-md-12 text-right">
                        <button type="button" tabindex="7" onclick="SAPDataSync()" class="k-primary k-button custom-btns">Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
		}
    });

    var SapSyncHit = true;
    function SAPDataSync() {
     //   var ddlSAPDataSync = "".concat($("#ddlSalesOrganization").data("kendoDropDownList").text(), " ", $("#ddlDistributionChannel").data("kendoDropDownList").text(), " ", $("#ddlDivision").data("kendoDropDownList").text());
        //if (ddlSAPDataSync) {
            var model = {
                DivisionId: $("#ddlDivision").data("kendoDropDownList").value()

            };
            if (SapSyncHit) {
                SapSyncHit = false;
                window.kendo.ui.progress($("#dvSapSync"), true);
                moduleCommon.Common.AjaxCall({
                    url: '@Url.Action("SAPSyncData", "ReverseAuction")',
                    type: 'POST',
                    data: { inputDto: model },
                    success: function (result) {
                        if (result.PostStatus) {
                            var counter = 60;
                            setInterval(function () {
                                counter--;
                                if (counter >= 0) {
                                    window.kendo.ui.progress($("#dvSapSync"), true);
                                    SapSyncHit = true;
                                }
                                if (counter === 0) {
                                    window.kendo.ui.progress($("#dvSapSync"), false);
                                    SapSyncHit = true;
                                    ShowSuccessMessage(result.PostMessage);
                                    clearInterval(counter);
                                }
                            }, 1000);

                        }
                        else {
                            window.kendo.ui.progress($("#dvSapSync"), false);
                            SapSyncHit = true;
                            ShowErrorMessage(result.PostMessage);
                        }
                    }
                });
            }
            else {
                SapSyncHit = true;
            }

        //} else {
        //    ShowErrorMessage("Please select any option to Sync data");
        //    window.kendo.ui.progress($("#dvSapSync"), false);
        //    return false;
        //}
    }

    //function SyncTypeChanges() {
    //    $("#ddlSAPDataSync").data("kendoDropDownList").dataSource.read();
    //}

    //function AddinalInfo() {
    //    return {
    //        SyncTypeId: $("#ddlSyncTypeSync").data("kendoDropDownList").value(),
    //    };
    //}

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();

    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>
