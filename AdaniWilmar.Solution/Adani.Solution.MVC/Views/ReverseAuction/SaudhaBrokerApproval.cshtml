@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@using Adani.Solution.MVC.Common;
@model SaudaDetailOutputDto
@{
    ViewBag.Title = "SaudhaBrokerApproval";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="reverseauctionSaudhaDetails" />

<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">Sauda Details</h2>
    <div style="clear:both;"></div>
</div>

@using (Html.BeginForm("SaudhaDetails", "ReverseAuction", FormMethod.Post, new { id = "frmSaudhaDetails", @class = "form-validate-jquery" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.SaudaId, new { id = "hdnSaudaId" })
    <div class="content main-section-content row">
        <div class="panel panel-flat">
            <div class="panel-heading">
            </div>
            <div class="panel-body" style="display: block;">
                <div class="row" id="div_Progress">
                    <div class="col-md-12">

                        <div class="row form-group">
                            <div class="col-md-2">
                                @Helper.GetResourceString("lbl_SaudaNumber")
                            </div>
                            <div class="col-md-3">
                                @Model.SaudaNumber
                            </div>

                            <div class="col-md-2">
                                @Helper.GetResourceString("lbl_SaudaDate")
                            </div>
                            <div class="col-md-3">
                                @Model.SaudaDate
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-2">
                                @Helper.GetResourceString("lbl_DealerName")
                            </div>
                            <div class="col-md-3">
                                @Model.DealerName
                            </div>

                            <div class="col-md-2">
                                @Helper.GetResourceString("lbl_DealerLocation")
                            </div>
                            <div class="col-md-3">
                                @Model.DealerLoaction
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-2">
                                @Helper.GetResourceString("lbl_TotalBidQuantity")
                            </div>
                            <div class="col-md-3">
                                @Model.TotalQuantity
                            </div>

                            <div class="col-md-2">
                                @Helper.GetResourceString("lbl_TotalBidPrice")
                            </div>
                            <div class="col-md-3">
                                @Model.TotalAmount
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-2">
                                @Helper.GetResourceString("lbl_IncoTerm")
                            </div>
                            <div class="col-md-3">
                                @Model.Incoterm
                            </div>
                            <div class="col-md-2">
                                @Helper.GetResourceString("lbl_PlantDepot")
                            </div>
                            <div class="col-md-3">
                                @Model.PlantOrDepot
                            </div>
                        </div>

                        <div class="row form-group">
                            <div>
                                <div class="text-right">
                                </div>

                                @(Html.Kendo().Grid<SaudaOrderDetails>().Name("SkuFinalpriceList")
                                                                            .Columns(columns =>
                                                                            {
                                                                                columns.Bound(c => c.SkuId).Visible(false);
                                                                                columns.Bound(c => c.SkuName).Title(@Helper.GetResourceString("lbl_SkuName")).Width(Settings.GridColumnMaxWidth);
                                                                                columns.Bound(c => c.BidQuantity).Title(@Helper.GetResourceString("lbl_BidQuantity")).Width(Settings.GridColumnMaxWidth);
                                                                                columns.Bound(c => c.BidPrice).Title(@Helper.GetResourceString("lbl_BidPrice")).Width(Settings.GridColumnMaxWidth);
                                                                            })
                                                                            .BindTo(Model.SaudaOrders)
                                                                            .EnableCustomBinding(true)
                                                                                .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                                                            .Filterable(filter => filter.Mode(GridFilterMode.Row))
                                                                            .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                                                                            .Scrollable(s => s.Enabled(true).Height("auto"))
                                                                            .Events(events => events.DataBound("onDataBound"))
                                                                            .Reorderable(reorder => reorder.Columns(true))
                                                                            .DataSource(dataSource => dataSource
                                                                            .Ajax()
                                                                            .Model(model => model.Id(m => m.SkuId))
                                                                            ))

                            </div>
                        </div>
                        <div class="row form-group" id="divSave">
                            <div class="col-lg-12" id="divRemarks">
                                <label class="control-label col-lg-1">@Helper.GetResourceString("lbl_Remarks")</label>
                                <div class="col-lg-11">
                                    @Html.TextAreaFor(m => m.ApproverRemarks, new { id = "txtRemarks", @class = "k-textarea", @maxlength = (int)InputMaxLength.TextAreaString })
                                </div>
                            </div>
                        </div>

                        <div class="row form-group" id="divSave">
                            <div class="text-right">
                                <button type="button" id="btnApproved" value="1" class="k-primary k-button">@Helper.GetResourceString("btn_Approve")</button>
                                <button type="button" id="btnRejected" value="3" class="k-button">@Helper.GetResourceString("btn_Reject")</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>

    $(document).ready(function () {

        // kendo grid filter contains
        FilterContains();

        $("#btnApproved,#btnRejected").click(function (e) {
            window.kendo.ui.progress($("#div_Progress"), true);
            
            var form = $('#frmSaudhaDetails')
            var token = $('input[name="__RequestVerificationToken"]', form).val();

            var model = {
                SaudaId: $("#hdnSaudaId").val(),
                StatusId: $(this).val(),
                Remarks: $("#txtRemarks").val()
            };

            moduleCommon.Common.AjaxCall({
                url: '@Url.Action("UpdateSaudhaStatus", "ReverseAuction")',
				type: 'POST',
                data: { __RequestVerificationToken: token, saudaUpdateDto: model },
				success: function (result) {
                    if (result.PostStatus) {
                        ShowSuccessMessage(result.PostMessage);
                        setTimeout(function () { window.location.href = '@Url.Action("SaudaList", "ReverseAuction")'; }, 1300);
					} else {
						ShowErrorMessage(result.PostMessage);
						window.kendo.ui.progress($("#div_Progress"), false);
						return false;
					}
				}
			});

        });
    });

    function onDataBound(e) {
        SetEmptyRow(e);
    }
</script>
