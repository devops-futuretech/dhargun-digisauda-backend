        $("#btnApproved,#btnRejected,#btnHold").click(function (e) {

            var form = $('#frmSaudhaDetails')
            var token = $('input[name="__RequestVerificationToken"]', form).val();
            var statusId = parseInt($(this).val());
            var selectedOrders = [];

            if ((statusId == emamiGlobal.Status.Rejected || statusId == emamiGlobal.Status.Hold) && !$("#txtReason").val()) {
                ShowErrorMessage("Please enter the reason");
                return false;
            }

            selectedOrders.push(Number($("#hdnSaudaOrderId").val()));

            var model = {
                StatusId: statusId,
                Remarks: $("#txtReason").val(),
                SaudaOrderIds: selectedOrders
            };

            window.kendo.ui.progress($("#div_Progress"), true);
            moduleCommon.Common.AjaxCall({
                url: '@Url.Action("UpdateSaudhaStatus", "ReverseAuction")',
				type: 'POST',
                data: { __RequestVerificationToken: token, saudaUpdateDto: model },
                success: function (result) {
                    if (result.PostStatus) {
                        ShowSuccessMessage(result.PostMessage);
                        setTimeout(function () { window.location.href = '@Url.Action("SaudaList", "ReverseAuction")'; }, 1300);
					} else {
						ShowErrorMessage(result.PostMessage);
                    }
                    window.kendo.ui.progress($("#div_Progress"), false);
				}
			});
        });

        //$("#dateValidFrom").data("kendoDatePicker").readonly(true);
        //$("#dateValidTo").data("kendoDatePicker").readonly(true);
        setMinDate();

    });

     function downloadAudioFile(SaudaId) {
        $('#myModal').modal('show');
        window.kendo.ui.progress($("#div_Progress"), true);
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetCallRecordedBasedOnSauda", "Report")',
            data: { saudaId : SaudaId },
            success: function (responce) {
                debugger;
                    $("#myModal").html(responce);
                    $("#popupCallRecordingAttachmentDetails").modal('show');
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
            },
            complete: function (res) {
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }
   function onGridEdit(e) {
    debugger;
    if (e.model.StatusId !== 1) {
        // not Pending — don't allow editing
        var grid = $("#ViewSaudaList").data("kendoGrid");
        grid.closeCell();
        return;
    }
    // Pending — allow editing
    e.model.IsEdited = true;
}
