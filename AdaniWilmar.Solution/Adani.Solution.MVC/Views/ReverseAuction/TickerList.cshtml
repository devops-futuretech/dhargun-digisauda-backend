@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@{
    ViewBag.Title = "Ticker";
}


<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="configurationTickerList" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Ticker</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Configurations</a><span class="icon-right"></span></li>
        <li class="active">Ticker<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
            <div class="period-wrapper">
                <a href="@Url.Action("AddOrUpdateTicker", "ReverseAuction")" class="k-primary k-button custom-btns"><b><i class="icon-plus-"></i></b>&ensp;Add New Ticker</a>
            </div>
        </div>*@
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat"> 
        @*<div class="panel-heading">
        </div>*@
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvDealers">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))

                        <div class="period-wrapper">
                            <a href="@Url.Action("TEdit", "ReverseAuction")" class="k-primary k-button custom-btns"><b><i class="icon-plus"></i></b>&ensp;Add New Ticker</a>
                        </div>
                    </div>
                    @(Html.Kendo().Grid<TickerDto>()
                          .Name("ViewTickerList")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.Id).Title("Edit").HeaderTemplate("").Title("Action").ClientTemplate("<div style='text-align: center;'><a   title='" + @Helper.GetResourceString("msg_Edit") + "' class='icon-pencil cursor-pointer' href='" + Url.Action("TEdit", "ReverseAuction", new { EncryptedId = "#=EncryptedId#" }) + "' ></a></div>").Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.TickerDate).Format(Settings.GridDateFormat).Title("Date");
                              columns.Bound(c => c.FromHoursString).Title("From Hour");
                              columns.Bound(c => c.ToHoursString).Title("To Hour");
                              columns.Bound(c => c.Content).Format(Settings.GridDateFormat).Title("Content");
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Selectable(selectable => selectable
                          .Mode(GridSelectionMode.Multiple)
                          .Type(GridSelectionType.Row))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Events(events => events.DataBound("onDealerListDataBound"))
                          .Resizable(resize => resize.Columns(true))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Resizable(resize => resize.Columns(true))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(model => { model.Id(p => p.Id); })
                          .ServerOperation(true)
                          .Read(read => read.Action("TickerListDataAsync", "ReverseAuction", new { isToReturnInactiveData = true }))))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();

         if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
		}
    });

    //Method to data bound event for dealer List
    function onDealerListDataBound(e) {
        SetEmptyRow(e);
    }

</script>





