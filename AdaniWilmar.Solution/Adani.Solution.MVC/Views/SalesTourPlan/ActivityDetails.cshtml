<script id="competitorSkuTemplate" type="text/kendo-tmpl">

    @(Html.Kendo().Grid<Adani.Solution.DTO.BdoCompetitorSkusDto>()
                                .Name("grid_#=Id#")       //template expression, to be evaluated in the master context
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.SkuName).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("SkuName").Width(Settings.GridColumnMaxWidth);
                                    columns.Bound(c => c.QuanityPerMt).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Quanity in cases/Nos").Width(Settings.GridColumnMaxWidth);
                                    columns.Bound(c => c.Price).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Title("Price").Width(Settings.GridColumnMaxWidth);
                                })
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .PageSize(10)
                                    .Read(read => read.Action("GetCompetitorSkuList", "SalesTourPlan", new { competitorsId = "#=Id#" }))
                                )
                                .Pageable()
                                .Sortable()
                                .ToClientTemplate()
    )
</script>

