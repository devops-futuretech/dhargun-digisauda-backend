<div id="dvProductCont" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width:50%;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close closeProduct model-header-color" data-dismiss="modal">&times;</button>
                <h6 class="panel-title"><span class="text-semibold model-header-color">Attachments</span></h6>
            </div>
            <div class="modal-body">
                <div id="dv_Remarks">

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="popupClose('hdSelectedProductIds','DiscountProductType_2');" class="k-button closeProduct" data-dismiss="modal">@Helper.GetResourceString("btn_Close")</button>
            </div>
        </div>

    </div>
</div>
<script>
    $(document).ready(function () {

        jQuery('.tabs .tab-links a').on('click', function (e) {
            var currentAttrValue = jQuery(this).attr('href');
            // Show/Hide Tabs
            jQuery('.tabs ' + currentAttrValue).show().siblings().hide();
            // Change/remove current tab to active
            jQuery(this).parent('li').addClass('tabactive').siblings().removeClass('tabactive');
            e.preventDefault();
        });

        // kendo grid filter contains
        FilterContains();

    });
    function getCompetitorAttachments(Id) {
        $('#dvProductCont').modal('show');
        $.ajax({
            url: "/SalesTourPlan/CompetitorAttachments",
            type: 'POST',
            data: { Id: Id },
            success: function (result) {
                if (result !== null) {
                    $("#dv_Remarks").html(result);
                }
            }
        });

        return false;
    }

    function getProspectiveDealerAttachments(Id) {
        $('#dvProductCont').modal('show');
        $.ajax({
            url: "/SalesTourPlan/ProspectiveDealerAttachments",
            type: 'POST',
            data: { Id: Id },
            success: function (result) {
                if (result !== null) {
                    $("#dv_Remarks").html(result);
                }
            }
        });

        return false;
    }
</script>