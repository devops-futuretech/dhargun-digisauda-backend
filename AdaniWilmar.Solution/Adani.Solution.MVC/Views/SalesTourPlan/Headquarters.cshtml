@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@using Adani.Solution.DTO.Enums;
@using Adani.Solution.MVC.Models;
@model Adani.Solution.MVC.Models.HeadQuartersViewModel
@{
    ViewBag.Title = Helper.GetResourceString("msg_Headquarters");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="masterHeadquarters" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("msg_Headquarters")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Masters</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("msg_Headquarters")<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
            <div class="period-wrapper">
                @if (Helper.CheckClaims(Claims.ManageMaster))
                {
                    <a href="@Url.Action("HeadquarterEditRedirect", "SalesTourPlan")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("msg_CreateHeadquarters")</a>
                }
            </div>
        </div>*@
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        @*<div class="panel-heading">

        </div>*@
        <div class="panel-body" style="display: block;">
            <div class="row">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick='excelExport()' type="button">Excel</span>
                            </div>
                        </div>

                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("ViewHeadquarters")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>*@&ensp;

                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))

                        <div class="period-wrapper">
                            @if (Helper.CheckClaims(Claims.ManageMaster))
                            {
                                <a href="@Url.Action("HeadquarterEditRedirect", "SalesTourPlan")" class="k-primary k-button"><b><i class="icon-plus"></i> </b>&ensp;@Helper.GetResourceString("msg_CreateHeadquarters")</a>
                            }
                        </div>

                    </div>

                    @(Html.Kendo().Grid<HeadQuartersViewModel>()
                       .Name("ViewHeadquarters")
                       .Columns(columns =>
                       {
                           columns.Bound(c => c.Id).Visible(false);
                           columns.Bound(c => c.Name).ClientTemplate(@"<div><a style='text-decoration: underline;' href='" + Url.Action("HeadquarterEditRedirect", "SalesTourPlan", new { headquarterId = "#=Id#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=Name#</a>  </div>").Title(@Helper.GetResourceString("lbl_Name")).Width(Settings.GridOtherColumnWidth);
                           columns.Bound(c => c.Address).Title(@Helper.GetResourceString("lbl_Address")).Width(Settings.GridOtherColumnWidth);
                           columns.Bound(c => c.Zone).Title(@Helper.GetResourceString("lbl_Zone")).Width(Settings.GridOtherColumnWidth);
                           columns.Bound(c => c.State).Title(@Helper.GetResourceString("lbl_State")).Width(Settings.GridOtherColumnWidth);
                           columns.Bound(c => c.Territory).Title(@Helper.GetResourceString("lbl_Territory")).Width(Settings.GridOtherColumnWidth);
                           columns.Bound(c => c.District).Title(@Helper.GetResourceString("lbl_District")).Width(Settings.GridOtherColumnWidth);
                           columns.Bound(c => c.City).Title(@Helper.GetResourceString("lbl_City")).Width(Settings.GridOtherColumnWidth);
                           columns.Bound(t => t.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'>#if(IsActive){#<i class='icon-green_ckbox_tick faicon-green'><span class='path1'></span><span class='path2'></span></i>#}else{#<i class='icon-red_ckbox_tick faicon-red'><span class='path1'></span><span class='path2'></span></i>#}#</div>").Width(Settings.GridButtonColumnWidth);
                       })
                       .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                       .Filterable(filter => filter.Mode(GridFilterMode.Row))
                       .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                       .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                       .Scrollable(s => s.Enabled(true).Height("auto"))
                       .Resizable(resize => resize.Columns(true))
                       .Reorderable(reorder => reorder.Columns(true))
                       .Excel(excel => excel.AllPages(true).FileName(@Helper.GetResourceString("msg_Headquarters") + " " + DateTime.Now + ".xlsx").Filterable(true))
                       .Excel(excel => excel.FileName(@Helper.GetResourceString("msg_Headquarters") + " " + DateTime.Now + ".xlsx").AllPages(true))
                       .DataSource(dataSource => dataSource
                       .Ajax()
                       .Model(model => model.Id(m => m.Id))
                       .ServerOperation(true)
                       .Read(read => read.Action("GetAllHeadquarterListAsync", "SalesTourPlan"))))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }
        // kendo grid filter contains
        FilterContains();


    });
    //Method to data bound event for owner
    function OnCategoryListDataBound(e) {
        SetEmptyRow(e);
    }

    function excelExport() {
        window.kendo.ui.progress($("#div_Progress"), true);       
        var data = { IsToReturnInactiveData: true };
        $.ajax({
            type: 'Post',
            url: '@Url.Action("ExportHeadQuarters", "SalesTourPlan")',
            data: { inputDto: data },
            success: function (responce) {               
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });        
    }

</script>


