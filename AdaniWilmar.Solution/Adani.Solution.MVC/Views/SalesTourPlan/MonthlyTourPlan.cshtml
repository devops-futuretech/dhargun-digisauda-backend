    function AddToGrid() {
        var errorFlag = false;
        var errorMessage = "";
        var gridData = $("#ViewRetailers").data("kendoGrid").dataSource.data();
        var index = $("#hdnassignrowindex").val();
        var uid = $("#hdnUID").val();

        if (($("#ddlDealer").val() != "" && $("#ddlDealer").val() != null) && $("#ddlHQNoVisit").val() != "") {
            errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetResourceString("msg_MTPInvalid")');
                errorFlag = true;
        }
        else if (gridData.length > 0 && $("#ddlDealer").val() != "" && $("#ddlDealer").val()!=null) {

            var gridDataItem = gridData.filter(function (item) {
                return index == "-1" ? (item.InHQNoVisitName !== "" && item.Date === $("#dpDate").val()) : (item.InHQNoVisitName !== "" && item.Date === $("#dpDate").val() && item.uid!=uid);
            });
            if (gridDataItem.length > 0) {
                errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetResourceString("msg_MTPNoVisitPerDay")');
                errorFlag = true;
            }
        }
        else if (gridData.length > 0 && $("#ddlHQNoVisit").val()!="") {
            var gridDataItem = gridData.filter(function (item) {
                return index == "-1" ? item.Date === $("#dpDate").val() : (item.Date === $("#dpDate").val() && item.uid != uid);
            });
            if (gridDataItem.length > 0) {
                errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetResourceString("msg_MTPNoVisitPerDay")');
                errorFlag = true;
            }
            @*else {

                var gridDataItem = gridData.filter(function (item) {

                    return index == "-1" ? (item.Date === $("#dpDate").val() && item.InHQNoVisitName !== "") : (item.Date === $("#dpDate").val() && item.InHQNoVisitName !== "" && item.index!=index);
                });
                if (gridDataItem.length > 0) {
                    errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetResourceString("msg_MTPNoVisitPerDay")');
                    errorFlag = true;
                }
            }*@
        }
        if (!errorFlag){

            if ($("#dpDate").val() === "") {
                errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetSelectMsgRequired("lbl_Date")');
                errorFlag = true;
            }


            @*if ($("#ddlCity").data("kendoDropDownList").value() === "") {
                errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetSelectMsgRequired("lbl_City")');
                errorFlag = true;*@
            //}
            if (!$("#ddlHQNoVisit").val()) {
                if ($("#txtArea").val() === "") {
                    errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetMsgRequired("lbl_Area")');
                    errorFlag = true;
                }
                if ($("#ddlDealer").data("kendoMultiSelect").value() === "") {
                    errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetSelectMsgRequired("lbl_Dealer")');
                    errorFlag = true;
                }
            }

            @*if ($("#ddlHeadquarters").data("kendoDropDownList").value() === "") {
                errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetSelectMsgRequired("msg_Headquarters")');
                errorFlag = true;
            }*@
        }

        if (errorFlag) {
            ShowErrorMessageLeftAlign(errorMessage);
        }
        else {
            //var Citydata = $('#ddlCity').data('kendoAutoComplete');
            //var CitydataValue = Citydata.value();
            //var CitydataItem = Citydata.dataItems();
            //var CityDetails = CitydataItem.filter(x => x.CityName === CitydataValue);
            //CityDetails = CityDetails[0];

            //var multi = $("#ddlDealer").getKendoMultiSelect(),
            //multiDataItems = multi.dataItems(),
            //selectedDealerIds = [];
            //selectedDealerNames = [];

            //for (var i = 0; i < multiDataItems.length; i += 1) {
            //    var currentDealer = multiDataItems[i];

            //    selectedDealerIds.push(currentDealer.Id);
            //    selectedDealerNames.push(currentDealer.Name);
            //}
            var Dealerdata = $('#ddlDealer').data('kendoMultiSelect');
            var dealerList = Dealerdata.value();
            var DealerdataItem = Dealerdata.dataItems();

            var weekday = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            var selecteddate = new Date($("#dpDate").val());

            var grid = $("#ViewRetailers").data("kendoGrid");
            var datasource = grid.dataSource;
            var gridData = $("#ViewRetailers").data("kendoGrid").dataSource.data();

            if (index == "-1") {
                if (dealerList.length > 0) {
                    $.each(dealerList, function (did, dval) {
                        var DealerDetails = DealerdataItem.filter(x => x.Id === dval);
                        DealerDetails = DealerDetails[0];
                        datasource.insert(gridData.length, {
                            Date: $("#dpDate").val(),
                            DayId: 0,
                            Day: weekday[selecteddate.getDay()],
                            TownId: $("#ddlCity").data("kendoDropDownList").value(),
                            Town: ($("#ddlCity").data("kendoDropDownList").value()) ? $("#ddlCity").data("kendoDropDownList").text() : "",
                            Area: $("#txtArea").val(),
                            //DealerId: $("#ddlDealer").data("kendoMultiSelect").value(),
                            //Dealer: ($("#ddlDealer").data("kendoMultiSelect").value()) ? $("#ddlDealer").data("kendoMultiSelect").text() : "",
                            DealerId: dval,
                            Dealer: DealerDetails.Name,
                            //HeadquartersId: $("#ddlHeadquarters").data("kendoDropDownList").value(),
                            //Headquarters: $("#ddlHeadquarters").data("kendoDropDownList").text(),
                            Remarks: $("#txtHeaderRemarks").val(),
                            Id: 0,
                            //InHQNoVisitId: 0,
                            //InHQNoVisitName: "",
                            InHQNoVisitId: $("#ddlHQNoVisit").data("kendoDropDownList").value(),
                            InHQNoVisitName: ($("#ddlHQNoVisit").data("kendoDropDownList").value()) ? $("#ddlHQNoVisit").data("kendoDropDownList").text() : "",
                        });
                    });
                }
                else {
                    datasource.insert(gridData.length, {
                        Date: $("#dpDate").val(),
                        DayId: 0,
                        Day: weekday[selecteddate.getDay()],
                        TownId: $("#ddlCity").data("kendoDropDownList").value(),
                        Town: ($("#ddlCity").data("kendoDropDownList").value()) ? $("#ddlCity").data("kendoDropDownList").text() : "",
                        Area: $("#txtArea").val(),
                        DealerId: 0,
                        Dealer: "",
                        //HeadquartersId: $("#ddlHeadquarters").data("kendoDropDownList").value(),
                        //Headquarters: $("#ddlHeadquarters").data("kendoDropDownList").text(),
                        Remarks: $("#txtHeaderRemarks").val(),
                        Id: 0,
                        //InHQNoVisitId: 0,
                        //InHQNoVisitName: "",
                        InHQNoVisitId: $("#ddlHQNoVisit").data("kendoDropDownList").value(),
                        InHQNoVisitName: ($("#ddlHQNoVisit").data("kendoDropDownList").value()) ? $("#ddlHQNoVisit").data("kendoDropDownList").text() : "",
                    });
                }
            } else {
                var updategridData = $("#ViewRetailers").data("kendoGrid").dataSource.data()[index];
                updategridData.Date = $("#dpDate").val();
                updategridData.DayId = 0;
                updategridData.Day = weekday[selecteddate.getDay()];
                updategridData.TownId = $("#ddlCity").data("kendoDropDownList").value();
                updategridData.City = ($("#ddlCity").data("kendoDropDownList").value()) ? $("#ddlCity").data("kendoDropDownList").text() : "";
                updategridData.Area = $("#txtArea").val();
                //updategridData.DealerId = $("#ddlDealer").data("kendoMultiSelect").value();
                //updategridData.Dealer = ($("#ddlDealer").data("kendoMultiSelect").value()) ? $("#ddlDealer").data("kendoMultiSelect").text() : "";
                //updategridData.HeadquartersId = $("#ddlHeadquarters").data("kendoDropDownList").value();
                //updategridData.Headquarters = $("#ddlHeadquarters").data("kendoDropDownList").text();
                updategridData.Remarks = $("#txtHeaderRemarks").val();
                updategridData.InHQNoVisitId = 0;
                updategridData.InHQNoVisitName = "";
                updategridData.InHQNoVisitId = $("#ddlHQNoVisit").data("kendoDropDownList").value();
                updategridData.InHQNoVisitName = ($("#ddlHQNoVisit").data("kendoDropDownList").value()) ? $("#ddlHQNoVisit").data("kendoDropDownList").text() : "";
                if (dealerList.length > 0) {
                    updategridData.DealerId = DealerdataItem[0].Id;
                    updategridData.Dealer = DealerdataItem[0].Name;
                }
                else {
                    updategridData.DealerId = 0;
                    updategridData.Dealer = "";
                }
                $('#ViewRetailers').data('kendoGrid').refresh();
                $("#hdnassignrowindex").val("-1");
                $("#hdnUID").val("");
            }
            clearAll();
        }
    }
