        $("#btnPJPRejected").click(function (e) {
            var errorFlag = false;
            var errorMessage = "";
            if ($("#txtRemarks").val() === "") {
			errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetMsgRequired("lbl_Remarks")');
			errorFlag = true;
            }
            if (errorFlag) {
                ShowErrorMessageLeftAlign(errorMessage);
            }
            else {
                var gridData = $("#ViewRetailers").data("kendoGrid").dataSource.data();
		        if (gridData.length === 0) {
			        errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetResourceString("msg_ProductListError")');
			        errorFlag = true;
		        }
                window.kendo.ui.progress($("#div_Progress"), true);
                var form = $('#frmMonthlyTourPlan')
                var token = $('input[name="__RequestVerificationToken"]', form).val();

                var jsonObj = [];
                $.each(gridData, function (idx2, val2) {
                    item = {}
                    var date = val2.Date.toString();
                    item["Date"] = date;
                    item["DayId"] = val2.DayId;
                    item["Day"] = val2.Day;
                    item["TownId"] = val2.TownId;
                    item["Town"] = val2.Town;
                    item["Area"] = val2.Area;
                    item["DealerId"] = val2.DealerId;
                    item["Dealer"] = val2.Dealer;
                    //item["HeadquartersId"] = val2.HeadquartersId;
                    //item["Headquarters"] = val2.Headquarters;
                    item["Remarks"] = val2.Remarks;
                    item["Id"] = val2.Id;
                    item["InHQNoVisitId"] = val2.InHQNoVisitId;
                    item["InHQNoVisitName"] = val2.InHQNoVisitName;
                    jsonObj.push(item);
                });

                var multi = $("#ddlReason").getKendoMultiSelect(),
                    multiDataItems = multi.dataItems(),
                    selectedReasonIds = [];

                for (var i = 0; i < multiDataItems.length; i += 1) {
                    var currentDealer = multiDataItems[i];
                    selectedReasonIds.push(currentDealer.Id);
                }

                var model = {
                    EncryptedId: $("#hdnMTPId").val(),
                    StatusId: 3,
                    Remarks: $("#txtRemarks").val(),
                    ReasonIds: selectedReasonIds.join(","),
                    MonthlyTourPlanDetailList: jsonObj
                };

                moduleCommon.Common.AjaxCall({
                    url: "/SalesTourPlan/MonthlyTourPlan",
					    type: 'POST',
                    data: { __RequestVerificationToken: token, mtpViewModel: model },
					    success: function (result) {
						    if (result.PostStatus) {
							    var url = '@Url.Action("MonthlyTourPlans", "SalesTourPlan")';
							    window.location.href = url;
						    } else {
							    ShowErrorMessage(result.PostMessage);
							    window.kendo.ui.progress($("#div_Progress"), false);
							    return false;
						    }
					    }
				    });
            }
        });

        FilterContains();
    });


