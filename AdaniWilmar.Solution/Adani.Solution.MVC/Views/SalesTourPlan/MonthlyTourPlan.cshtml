    function setMonth() {
        var model = {
            PJPId: $("#ddlPJP").data("kendoDropDownList").value(),
            MonthId: $("#ddlMonth").data("kendoDropDownList").value()
        };

        moduleCommon.Common.AjaxCall({
            url: "/SalesTourPlan/MonthlyTourPlanDateCalendar",
			type: 'POST',
            data: { pjpViewModel: model },
            success: function (result) {
                var minDate = [];
                var maxDate = [];
                if (result != null) {
                    minDate = result.EffectiveFromstring.split('-');
                    maxDate = result.EffectiveTostring.split('-');
                    $("#dpDate").kendoDatePicker({
                        format: "dd-MMM-yyyy",
                        min: new Date(minDate[2], minDate[1] - 1, minDate[0]),
                        max: new Date(maxDate[2], maxDate[1] - 1, maxDate[0])
                    });
				} else {
					ShowErrorMessage(result.PostMessage);
					window.kendo.ui.progress($("#div_Progress"), false);
					return false;
				}
			}
        });

        var reqdata = {
            PJPId: $("#ddlPJP").data("kendoDropDownList").value()
        }

        @*$.post("@Url.Action("GetDealerListByPJPAsync", "SalesTourPlan")", reqdata, function (data) {
            $("#ddlDealer").data('kendoDropDownList').setDataSource(data);
        });*@


        $.post("@Url.Action("CityByUserPermanentJourneyPlan", "SalesTourPlan")", model, function (data) {
            $("#ddlCity").data('kendoDropDownList').setDataSource(data);
        });
    }
