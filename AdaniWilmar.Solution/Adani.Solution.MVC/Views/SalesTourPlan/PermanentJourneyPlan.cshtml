    function setFinancialYeardateRange() {
        var model = {
            FinancialYearid: $("#ddlYear").data("kendoDropDownList").value()
        };
        window.kendo.ui.progress($("#div_Progress"), true);
        moduleCommon.Common.AjaxCall({
            url: "/SalesTourPlan/PermanentJourneyPlanDateRangeCalendar",
			type: 'POST',
            data: { financialYearIdDto: model },
            success: function (result) {
                var minDate = [];
                var maxDate = [];
                if (result != null) {
                    minDate = result.EffectiveFromstring.split('-');
                    maxDate = result.EffectiveTostring.split('-');
                    $("#StartDate").kendoDatePicker({
                        format: "dd-MMM-yyyy",
                        min: new Date(minDate[2], minDate[1] - 1, minDate[0]),
                        max: new Date(maxDate[2], maxDate[1] - 1, maxDate[0])
                    });
                    $("#EndDate").kendoDatePicker({
                        format: "dd-MMM-yyyy",
                        min: new Date(minDate[2], minDate[1] - 1, minDate[0]),
                        max: new Date(maxDate[2], maxDate[1] - 1, maxDate[0])
                    });
                    window.kendo.ui.progress($("#div_Progress"), false);
				} else {
					ShowErrorMessage(result.PostMessage);
					window.kendo.ui.progress($("#div_Progress"), false);
					return false;
				}
			}
        });
    }

