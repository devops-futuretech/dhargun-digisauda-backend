    function hQNoVisitHideShow() {
        var hqNo = $("#ddlHQNoVisit").val();
        var dealer = $("#ddlRetailer").data("kendoMultiSelect");
        if (hqNo) {
            if (dealer) {
                dealer.value([]);
                dealer.enable(false);
            }
            $("#txtNoOfSubDealer").val('');
            $("#txtNoOfSubDealer").prop('readonly', true);
            $("#txtNoOfWholeSeller").val('');
            $("#txtNoOfWholeSeller").prop('readonly', true);
        } else {
            (dealer) ? dealer.enable(true): "";
            $("#txtNoOfSubDealer").prop('readonly', false);
            $("#txtNoOfWholeSeller").prop('readonly', false);
        }
    }

