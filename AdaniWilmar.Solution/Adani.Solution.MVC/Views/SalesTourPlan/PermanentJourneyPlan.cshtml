    function popupYes() {
        var errorFlag = false;
        var errorMessage = "";
        var gridData = $("#ViewRetailers").data("kendoGrid").dataSource.data();
		if (gridData.length === 0) {
			errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetResourceString("msg_ProductListError")');
			errorFlag = true;
        }

        var NoOfVisit = 0;
        $.each(gridData, function (idx2, val2) {
            NoOfVisit = parseInt(val2.NoOfVisit) + NoOfVisit;
        });
        if (NoOfVisit > 24) {
            errorMessage = ErrorSuccessMessageBind(errorMessage, "No of Visit Should be less than 24");
            errorFlag = true;
        }
        if (errorFlag) {
            ShowErrorMessageLeftAlign(errorMessage);
        }
        else {
            window.kendo.ui.progress($("#div_Progress"), true);
            var form = $('#frmPermanentJourneyPlan')
            var token = $('input[name="__RequestVerificationToken"]', form).val();

            var jsonObj = [];
            $.each(gridData, function (idx2, val2) {
                item = {}
                item["FinancialYearId"] = val2.FinancialYearId;
                item["FinancialYear"] = val2.FinancialYear;
                item["EffectiveFrom"] = new Date(val2.EffectiveFrom).toDateString();
                item["EffectiveTo"] = new Date(val2.EffectiveTo).toDateString();
                //item["TerritoryId"] = val2.TerritoryId;
                //item["Territory"] = val2.Territory;
                //item["MonthId"] = val2.MonthId;
                //item["Month"] = val2.Month;
                item["StateId"] = val2.StateId;
                item["State"] = val2.State;
                item["DistrictId"] = val2.DistrictId;
                item["District"] = val2.District;
                item["CityId"] = val2.CityId;
                item["City"] = val2.City;
                item["NoOfDirectDealer"] = val2.NoOfDirectDealer;
                item["RetailerId"] = val2.RetailerId;
                item["Retailers"] = val2.Retailers;
                item["NoOfSubDealer"] = val2.NoOfSubDealer;
                item["NoOfWholeSeller"] = val2.NoOfWholeSeller;
                item["NoOfVisit"] = val2.NoOfVisit;
                item["Id"] = val2.Id;
                item["InHQNoVisitId"] = val2.InHQNoVisitId;
                item["InHQNoVisitName"] = val2.InHQNoVisitName;
                item["Remarks"] = val2.Remarks;
                jsonObj.push(item);
            });


            var multi = $("#ddlReason").getKendoMultiSelect(),
                multiDataItems = multi.dataItems(),
                selectedReasonIds = [];

            for (var i = 0; i < multiDataItems.length; i += 1) {
                var currentDealer = multiDataItems[i];
                selectedReasonIds.push(currentDealer.Id);
            }

            var StatusId = $('#hdnTempStatus').val();
            var model = {
                EncryptedId: $("#hdnPJPId").val(),
                StatusId: parseInt(StatusId),
                Remarks: $("#txtRemarks").val(),
                PermanentJourneyPlanDetailList: jsonObj,
                ReasonIds: selectedReasonIds.join(","),
                IsEditableForAdmin: @Model.IsEditableForAdmin
            };

            moduleCommon.Common.AjaxCall({
                url: "/SalesTourPlan/PermanentJourneyPlan",
					type: 'POST',
                    data: { __RequestVerificationToken: token, pJPViewModel: model },
					success: function (result) {
						if (result.PostStatus) {
							var url = '@Url.Action("PermanentJourneyPlans", "SalesTourPlan")';
							window.location.href = url;
						} else {
							ShowErrorMessage(result.PostMessage);
							window.kendo.ui.progress($("#div_Progress"), false);
							return false;
						}
					}
				});
        }
    }
