<script type="text/javascript">
    var SetDealerId = 0;
    function RemoveFromGrid(e) {
        var grid = $('#ViewRetailers').data('kendoGrid');
        var dataItem = grid.dataItem($(e).closest("tr"));
        $('#ViewRetailers').data("kendoGrid").dataSource.remove(dataItem);
    }
    function onStateChange(e) {

        $("#ddlDistrict").data("kendoDropDownList").dataSource.read();
        dealerDropdownFill();
        //$("#ddlTerritory").data("kendoDropDownList").dataSource.read();
        //$("#ddlDistrict").data("kendoAutoComplete").value("");
        //$("#ddlDistrict").data("kendoAutoComplete").dataSource.data([]);
        //$("#ddlCity").data("kendoAutoComplete").value("");
        //$("#ddlCity").data("kendoAutoComplete").dataSource.data([]);
    }
    function additionalDistrictByTerritoryInfo() {
        var stateId = $("#ddlState").data("kendoDropDownList").value();
        return {
            territoryId: stateId
        };
       
    }
    function onDistrictChange(e) {
        //$("#ddlCity").data("kendoAutoComplete").dataSource.read();
        //$("#ddlCity").data("kendoAutoComplete").value("");
        //$("#ddlCity").data("kendoAutoComplete").dataSource.data([]);
        $("#ddlCity").data("kendoDropDownList").dataSource.read();
        dealerDropdownFill();
    }

    function onCityChange() {
        var cityId = Number($("#ddlCity").data("kendoDropDownList").value());
        dealerDropdownFill();
        @*var reqdata = {
            cityId: cityId
        }

        $.post("@Url.Action("GetSalesReportingToUsersByCityId", "Role")", reqdata, function (data) {
            $("#ddlRetailer").data('kendoMultiSelect').setDataSource(data);
        });*@



        //var ddlDealer = $("#ddlDealer").data('kendoMultiSelect').dataSource.data();
        //alert(ddlDealer[0].Id + " - " + ddlDealer[1].Id);
        //alert("on city");
        //$("#ddlDealer").data("kendoMultiSelect").dataSource.read();
    }

    function additionalCityByDistrictInfo() {
        //var Districtdata = $('#ddlDistrict').data('kendoAutoComplete');
        //var DistrictdataValue = Districtdata.value();
        var districtId = $("#ddlDistrict").data("kendoDropDownList").value();
        var cityId = Number($("#ddlCity").data("kendoDropDownList").value());
        dealerDropdownFill(cityId);
        //if (DistrictdataValue) {
        //    var DistrictdataItem = Districtdata.dataItems();
        //    var DistrictDetails = DistrictdataItem.filter(x => x.DistrictName === DistrictdataValue);
        //    DistrictDetails = DistrictDetails[0];

        //    districtId = DistrictDetails.DistrictId;
        //    var districtName = $("#ddlDistrict").data("kendoAutoComplete").value();
        //}
        return {
            districtId: districtId
        };
    }
    function additionalCityInfo() {
        var cityId = Number($("#ddlCity").data("kendoDropDownList").value());
        return {
            cityId: cityId
        };
    }
    function dealerDropdownFill() {
        var cityId = 0;
        var districtId = 0;
        var stateId = 0;
        if ($("#ddlCity").data("kendoDropDownList").value() != "") {
            cityId = $("#ddlCity").data("kendoDropDownList").value();
        }

        if ($("#ddlDistrict").data("kendoDropDownList").value() != "") {
            districtId = $("#ddlDistrict").data("kendoDropDownList").value();
        }

        if ($("#ddlState").data("kendoDropDownList").value()) {
            stateId = $("#ddlState").data("kendoDropDownList").value();
        }

        var reqdata = {
            cityId: cityId,
            districtId: districtId,
            stateId: stateId
        };

        $.post("@Url.Action("GetSalesReportingToUsersByCityStateDistrict", "Role")", reqdata, function (data) {
            $("#ddlRetailer").data('kendoMultiSelect').setDataSource(data);
        });
    }
    function fromdateChange() {

        var endPicker = $("#EndDate").data("kendoDatePicker"),
            startDate = $("#StartDate").val();

        if (startDate) {
            startDate = new Date(startDate);
            $("#EndDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }
    }
    function StartDateRange() {
        var dates = new Date();
        dates.setDate(dates.getDate());

