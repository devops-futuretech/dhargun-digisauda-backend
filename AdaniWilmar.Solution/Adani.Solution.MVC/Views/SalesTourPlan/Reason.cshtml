@using Kendo.Mvc.UI;
@using Adani.Solution.DTO.Enums;
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@model Adani.Solution.MVC.Models.ReasonsViewModel
@{
    ViewBag.Title = Helper.GetResourceString("msg_Reasons");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="salestourplanReasons" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("msg_Reasons")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Sales Tour Plan</a><span class="icon-right"></span></li>
        <li><a href="Reasons">@Helper.GetResourceString("msg_Reasons") List</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("msg_Reasons")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <p class="content-group-lg"></p>

            @using (Html.BeginForm("Reason", "SalesTourPlan", FormMethod.Post, new { id = "frmReasons", @class = "form-validate-jquery" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                <fieldset class="content-group">
                    <div class="row form-group">
                        <div class="col-sm-12 mb-3">
                            <label class="custom_label">@Helper.GetResourceString("lbl_Reason")</label>
                            @Html.TextBoxFor(m => m.Reason, new { id = "txtName", tabindex = "1", required = "required", @class = "k-textbox", data_msg_required = Helper.GetMsgRequired("lbl_Name"), @maxlength = (int)InputMaxLength.String })
                        </div>
                        <div class="col-sm-12 mb-3">
                            <label class="custom_label">@Helper.GetResourceString("lbl_Description")</label>
                            @Html.TextAreaFor(m => m.Description, new { id = "txtDescription", tabindex = "2", required = "required", @class = "k-textarea", data_msg_required = Helper.GetMsgRequired("lbl_Description"), @maxlength = (int)InputMaxLength.MaxTextLength })
                        </div>

                        <div class="col-sm-12 mb-3">
                            <label class="custom_label">Status</label>
                            <div class="custom_checkbox_main">
                                @(Html.Kendo().CheckBoxFor(m => m.IsActive).Name("IsActive").HtmlAttributes(new { id = "cbIsActive", tabindex = "3" }))
                                <span class="label-title">@Helper.GetResourceString("lbl_Active")</span>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <div class="text-right">
                    <button type="button" tabindex="5" id="btnCancel" onclick="location.href = '@Url.Action("Reasons", "SalesTourPlan")'" class="k-button k-cancel custom-btns">@Helper.GetResourceString("btn_Cancel")</button>
                    @if (Helper.CheckClaims(Claims.ManageMaster))
                    {
                        <button type="button" tabindex="4" id="btnSaveCategory" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Save") </button>
                    }
                </div>
            }
        </div>
    </div>
</div>
<script>
	$(document).ready(function () {
		 if ('@Model.PostMessage' !== ""){
			   if ('@Model.PostStatus' === '@true') {
					ShowSuccessMessage('@Model.PostMessage');
				} else {
				   ShowErrorMessage('@Model.PostMessage');
				}
		}


         $("#btnSaveCategory").click(function (e) {
			formSubmit();
		});
	});

    function formSubmit() {
        $('#frmReasons').submit();
        var isValid = $("#frmReasons").valid();
		if (isValid) {
			// Animate loader
			window.kendo.ui.progress($("#div_Progress"), true);
		}
	}


</script>
