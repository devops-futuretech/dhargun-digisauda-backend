@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@using Adani.Solution.DTO.Enums;
@using Adani.Solution.MVC.Models;
@model Adani.Solution.MVC.Models.ReasonsViewModel
@{
    ViewBag.Title = Helper.GetResourceString("msg_Reasons");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="salestourplanReasons" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("msg_Reasons")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#"> Sales Tour Plan</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("msg_Reasons")<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
            <div class="period-wrapper">
                @if (Helper.CheckClaims(Claims.ManageMaster))
                {
                    <a href="@Url.Action("ReasonEditRedirect", "SalesTourPlan")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("msg_CreateReason")</a>
                }
            </div>
        </div>*@
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        @*<div class="panel-heading">

        </div>*@
        <div class="panel-body" style="display: block;">
            <div class="row">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick='ExportToExcel("ViewReasons")' type="button">Excel</span>
                            </div>
                        </div>
                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("ViewReasons")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        <div class="period-wrapper">
                            @if (Helper.CheckClaims(Claims.ManageMaster))
                            {
                                <a href="@Url.Action("ReasonEditRedirect", "SalesTourPlan")" class="k-primary k-button custom-btns"><b><i class="icon-plus"></i></b>&ensp;@Helper.GetResourceString("msg_CreateReason")</a>
                            }
                        </div>
                    </div>
                    @(Html.Kendo().Grid<ReasonsViewModel>()
                          .Name("ViewReasons")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.Reason).ClientTemplate(@"<div><a style='text-decoration: underline;' href='" + Url.Action("ReasonEditRedirect", "SalesTourPlan", new { reasonId = "#=Id#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=Reason#</a>  </div>").Title(@Helper.GetResourceString("lbl_Reason")).Width(Settings.GridOtherColumnWidth);
                              columns.Bound(c => c.Description).Title(@Helper.GetResourceString("lbl_Description")).Width(Settings.GridOtherColumnWidth);
                              columns.Bound(t => t.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'>#if(IsActive){#<i class='icon-green_ckbox_tick faicon-green'><span class='path1'></span><span class='path2'></span></i>#}else{#<i class='icon-red_ckbox_tick faicon-red'><span class='path1'></span><span class='path2'></span></i>#}#</div>").Width(Settings.GridButtonColumnWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Excel(excel => excel.FileName(@Helper.GetResourceString("msg_Reasons") + " " + DateTime.Now + ".xlsx").AllPages(true))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Resizable(resize => resize.Columns(true))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(model => model.Id(m => m.Id))
                          .ServerOperation(true)
                          .Read(read => read.Action("GetAllReasonListAsync", "SalesTourPlan"))))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
		$(document).ready(function () {
			 if ('@Model.PostMessage' !== ""){
			   if ('@Model.PostStatus' === '@true') {
					ShowSuccessMessage('@Model.PostMessage');
				} else {
				   ShowErrorMessage('@Model.PostMessage');
				}
		}
            // kendo grid filter contains
			 FilterContains();


        });



        //Method to data bound event for owner
        function OnCategoryListDataBound(e) {
			SetEmptyRow(e);
        }

</script>


