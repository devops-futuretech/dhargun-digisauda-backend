@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@{
    ViewBag.Title = "TodayActivity";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

<input type="hidden" class="currentMenu" value="" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">@Helper.GetResourceString("lbl_TodayActivities")</h2>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">

            <ul class="nav nav-tabs">
                <li class="active"><a data-toggle="tab" href="#DealerVisit" style="font-size: 15px;">Dealer Visit</a></li>
                <li><a data-toggle="tab" href="#WholesalerVisit" style="font-size: 15px;">Wholesaler Visit</a></li>
                <li><a data-toggle="tab" href="#ProspectiveDealerVisit" style="font-size: 15px;">ProspectiveDealer Visit</a></li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade in active">

                    <div class="row">
                        <div class="col-md-12">
                            <div class="text-right">
                                @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                            </div>

                            @(Html.Kendo().Grid<PendingSaudaDto>()
                                        .Name("ViewPendingSaudaDetails")
                                        .Columns(columns =>
                                        {
                                            columns.Bound(c => c.Id).Visible(false);
                                            columns.Bound(c => c.SaudaId).Title(@Helper.GetResourceString("lbl_SaudaNumber")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                            columns.Bound(c => c.Remarks).Title(@Helper.GetResourceString("lbl_Remarks")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                        })
                                        .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                        .Filterable(filter => filter.Mode(GridFilterMode.Row))
                                        .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                                        .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                                        .Selectable(selectable => selectable
                                        .Mode(GridSelectionMode.Multiple)
                                        .Type(GridSelectionType.Row))
                                        .Scrollable(s => s.Enabled(true).Height("auto"))
                                        .Events(events => events.DataBound("onPendingSaudaDetailsDataBound"))
                                        .Reorderable(reorder => reorder.Columns(true))
                                        .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Model(model => model.Id(m => m.Id))
                                        .ServerOperation(true)
                                        .Read(read => read.Action("GetPendingSaudaListAsync", "SalesTourPlan"))))
                        </div>
                    </div>


                </div>
            </div>
            <div id="WholesalerVisit" class="tab-pane fade">

            </div>
            <div id="ProspectiveDealerVisit" class="tab-pane fade">

            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();
    });

    function onPendingSaudaDetailsDataBound(e) {
        SetEmptyRow(e);
    }

</script>