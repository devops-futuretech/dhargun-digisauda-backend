@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@using Adani.Solution.DTO.Enums;
@using Adani.Solution.DTO;
@using Adani.Solution.MVC.Models;
@model Adani.Solution.DTO.UserSalesSaudaTargetDto
@{
    ViewBag.Title = Helper.GetResourceString("msg_Reasons");
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="salestourplanReasons" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">@Helper.GetResourceString("msg_Reasons")</h2>
    <div id="dateFilter" class="col-xs-9">
        <div class="period-wrapper">
            <a href="@Url.Action("UserSalesSaudaTargetEditRedirect", "SalesTourPlan")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateTarget")</a>
        </div>
    </div>
    <div style="clear:both;"></div>
</div>


<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">

        </div>
        <div class="panel-body" style="display: block;">
            <div class="row">
                <div class="col-md-12">
                    <div class="text-right">
                        <button class="k-button k-button-icontext k-grid-excel" onclick='ExportToExcel("ViewCategory")' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                    </div>
                    @(Html.Kendo().Grid<UserSalesSaudaTargetDto>()
                                                        .Name("ViewHeadquarters")
                                                        .Columns(columns =>
                                                        {
                                                            columns.Bound(c => c.UserId).Visible(false);
                                                            columns.Bound(c => c.FinancialYearId).Visible(false);
                                                            columns.Bound(c => c.User).ClientTemplate(@"<div><a style='text-decoration: underline;'  href='" + Url.Action("UserSalesSaudaTargetEditRedirect", "SalesTourPlan", new { userid = "#=UserId#", financialyearid = "#=FinancialYearId#" }) + "' title='" + @Helper.GetResourceString("msg_Edit") + "'>#=User#</a>  </div>").Title(@Helper.GetResourceString("lbl_BDO")).Width(Settings.GridOtherColumnWidth);
                                                            columns.Bound(c => c.FinancialYear).Title(@Helper.GetResourceString("lbl_CalendarDuaration")).Width(Settings.GridOtherColumnWidth);
                                                        })
                                                        .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                                        .Filterable(filter => filter.Mode(GridFilterMode.Row))
                                                        .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                                                        .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                                                        .Scrollable(s => s.Enabled(true).Height("auto"))
                                                        .ClientDetailTemplateId("template")
                                                        .Excel(excel => excel.FileName(@Helper.GetResourceString("msg_Headquarters") + " " + DateTime.Now + ".xlsx").AllPages(true))
                                                        .Reorderable(reorder => reorder.Columns(true))
                                                        .DataSource(dataSource => dataSource
                                                            .Ajax()
                                                            .Model(model => model.Id(m => m.Id))
                                                            .ServerOperation(true)
                                                            .Read(read => read.Action("UserSalesSaudaTargetList", "SalesTourPlan"))))
                    <script id="template" type="text/kendo-tmpl">
                        @(Html.Kendo().Grid<UserSalesSaudaTargetDetailDto>()
                                    .Name("grid_#=UserId#_#=FinancialYearId#")
                                    .Columns(columns =>
                                    {
                                        columns.Bound(c => c.Id).Visible(false);
                                        columns.Bound(c => c.MonthId).Visible(false);
                                        columns.Bound(c => c.Month).Title(@Helper.GetResourceString("lbl_Month")).Width(Settings.GridOtherColumnWidth);
                                        columns.Bound(c => c.SalesTarget).Title(@Helper.GetResourceString("lbl_SalesTarget")).Width(Settings.GridOtherColumnWidth);
                                        columns.Bound(c => c.SaudaTarget).Title(@Helper.GetResourceString("lbl_SaudaTarget")).Width(Settings.GridOtherColumnWidth);
                                    })
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .PageSize(10)
                                        .Read(read => read.Action("UserSalesSaudaTargetDetailList", "SalesTourPlan", new { userid = "#=UserId#", financialyearid = "#=FinancialYearId#" }))
                                    )
                                    //.Pageable()
                                    .Sortable()
                                    .ToClientTemplate())
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
		$(document).ready(function () {
			 if ('@Model.PostMessage' !== ""){
			   if ('@Model.PostStatus' === '@true') {
					ShowSuccessMessage('@Model.PostMessage');
				} else {
				   ShowErrorMessage('@Model.PostMessage');
				}
		}
            // kendo grid filter contains
			 FilterContains();


        });



        //Method to data bound event for owner
        function OnCategoryListDataBound(e) {
			SetEmptyRow(e);
        }

</script>


