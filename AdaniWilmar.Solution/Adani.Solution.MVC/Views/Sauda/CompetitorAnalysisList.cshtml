@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model RoleIdDto
@{
    ViewBag.Title = "CompetitorAnalysis";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="transactionCompetitorAnalysis" />

<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_CompetitorAnalysis")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Transaction</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_CompetitorAnalysis")<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
            <div class="period-wrapper">
                <a href="@Url.Action("CompetitorAnalysisEditRedirect", "Sauda")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateCompetitorAnalysis")</a>
            </div>
        </div>*@
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        @*<div class="panel-body" style="display: block;">*@


            <div class="panel-body" style="display: block;" id="pageLoader">
                <div class=" col-md-12">
                    <div class="panel-group filter-accordion" id="accordion">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse" class="accord" data-parent="#accordion" href="#collapseOne">Filters</a>
                                </h4>
                            </div>
                            <div id="collapseOne" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <div class="row">
                                        <div class="panel-body">
                                            <div class="row" id="dvCompetitorAnalysiss">
                                                <div class="row form-group">
                                                    <div class="col-lg-3 col-sm-6 mb-3">
                                                        <label class="custom_label">
                                                            @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                                                        </label>
                                                        @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                                                    </div>

                                                    <div class="col-lg-3 col-sm-6 mb-3">
                                                        <label class="custom_label">
                                                            @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                                                        </label>
                                                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                                                    </div>

                                                    <div class="col-lg-3 col-sm-6 mb-3">
                                                        <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                                                        @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                                                       
                                                      
                                                    </div>

                                                </div>

                                                <div class="row form-group">
                                                    <div class="col-md-12 text-right">
                                                        <button type="button" onclick="SearchCompetitor()" class="k-primary k-button custom-btns">Search</button>
                                                    </div>
                                                </div>


                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="row form-group"></div>
               
                <div class="row form-group">
                    <div class="col-md-12">
                        <div class="text-right">
                            @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        </div>
                        @(Html.Kendo().Grid<CompetitorAnalysisViewDto>()
                          .Name("ViewCompetitorAnalysis")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.Id).Visible(false);
                              columns.Bound(c => c.SkuName).Title(@Helper.GetResourceString("lbl_SkuName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.SkuCode).Title(@Helper.GetResourceString("lbl_SkuCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.OilType).Title(@Helper.GetResourceString("lbl_OilType")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.OilTypeCode).Title(@Helper.GetResourceString("lbl_OilTypeCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Status).Title(@Helper.GetResourceString("lbl_Status")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.EmamiPrice).Title(@Helper.GetResourceString("lbl_Price")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(o => o.WorkableQuantity).Title(@Helper.GetResourceString("lbl_WorkableQuantity")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(o => o.WorkablePrice).Title(@Helper.GetResourceString("lbl_WorkablePrice") + " (Rs)").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Template(t => t.Id).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Approve")).ClientTemplate(@"<div style='text-align: center;'><a  href='" + Url.Action("CompetitorAnalysisDetailsEditRedirect", "Sauda", new { competitorAnalysisId = "#=Id#" }) + "' title='" + @Helper.GetResourceString("lbl_Approve") + "'><i class='glyphicon glyphicon-eye-open' ></i></a>  </div>").Width(Settings.GridButtonColumnWidth);
                              //columns.Template(t => t.Id).Title(@Helper.GetResourceString("lbl_Approve")).ClientTemplate(@"<div style='text-align: center;'>
                              //                              <i class='glyphicon glyphicon-pencil pointer' ></i></div>").Width(Settings.GridButtonColumnWidth);
                          })
                          .ClientDetailTemplateId("template")
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Selectable(selectable => selectable
                          .Mode(GridSelectionMode.Multiple)
                          .Type(GridSelectionType.Row))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Events(events => events.DataBound("onCompetitorAnalysisListDataBound"))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Resizable(resize => resize.Columns(true))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(model => model.Id(m => m.Id))
                          .ServerOperation(true)
                          .Read(read => read.Action("GetCompetitorAnalysisListAsync", "Sauda").Data("additionalParam"))))
                        <script id="template" type="text/kendo-tmpl">
                        @(Html.Kendo().Grid<CompetitorAnalysisDetailsViewDto>()
                              .Name("grid_#=Id#") // template expression, to be evaluated in the master context
                              .Columns(columns =>
                              {
                                  columns.Bound(o => o.CompetitorName).Width(110);
                                  columns.Bound(o => o.SaudaRate).Width(150);
                                  columns.Bound(o => o.MarketOperatingPrice).Width(150).Title(@Helper.GetResourceString("lbl_MarketOperatingPrice"));

                              })
                              .DataSource(dataSource => dataSource
                              .Ajax()
                              .PageSize(10)
                              .Read(read => read.Action("GetCompetitorAnalysisDetailsListAsync", "Sauda", new { competitorAnalysisId = "#=Id#", isToReturnInactiveData = true }))
                              )
                              .Pageable()
                              .Sortable()
                              .Scrollable(s => s.Enabled(true).Height("auto"))
                              .Reorderable(reorder => reorder.Columns(true))
                              .Resizable(resize => resize.Columns(true))
                              .ToClientTemplate())
                        </script>
                    </div>
                </div>
            </div>
        </div>
</div>
<script>
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();

         if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
		}
    });

    //Method to data bound event for dealer List
    function onCompetitorAnalysisListDataBound(e) {
        SetEmptyRow(e);
    }

    function SearchCompetitor() {
        //window.kendo.ui.progress($("#div_Progress"), true);
        $("#ViewCompetitorAnalysis").data("kendoGrid").dataSource.read();
        //window.kendo.ui.progress($("#div_Progress"), false);
    }

    function additionalParam() {

        var verticalId = 0;
        if ($("#ddlVertical").val() != "") {
            verticalId = $("#ddlVertical").val();
        }

        return {
            isToReturnInactiveData: true,
            verticalId: verticalId,
        };
    }


    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>















