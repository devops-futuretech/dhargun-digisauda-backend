@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@using Adani.Solution.DTO;
@using Adani.Solution.DTO.Enums;
@model RoleIdDto
@{
    ViewBag.Title = "Sauda Conversion Unit And Base Rate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="transactionsaudaconversionunitandbaserate" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title"> @Helper.GetResourceString("lbl_SaudaConversionUnitAndBaseRate")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Transaction</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_SaudaConversionUnitAndBaseRate")<span class="icon-right"></span></li>
    </ol>
    @*<div id="dateFilter" class="col-xs-9">
            <div class="period-wrapper">
                <a href="@Url.Action("SaudaConversionUnitAndBaseRate", "Sauda")" class="k-primary k-button"><b><i class="icon-plus-circle2"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateConversion")</a>
            </div>
        </div>*@
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row form-group">
                <div class="col-lg-3 col-sm-6 mb-3 ">
                    <label class="custom_label"> @Helper.GetResourceString("lbl_FromDate") </label>
                    @(Html.Kendo().DatePicker()
                              .Name("StartDate")
                              .Format(Settings.DateFormat)
                              .Events(e => e.Change("fromChange"))
                              .HtmlAttributes(new { id = "StartDate", onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                </div>
                <div class="col-lg-3 col-sm-6 mb-3 ">
                    <label class="custom_label"> @Helper.GetResourceString("lbl_ToDate") </label>
                    @(Html.Kendo().DatePicker()
                              .Name("EndDate")
                              .Format(Settings.DateFormat)
                              .Events(e => e.Change("onDateChange"))
                              .HtmlAttributes(new { id = "EndDate", onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                </div>

                <div class="col-lg-3 col-sm-6 mb-3">
                    <label class="custom_label">
                        @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                    </label>
                    @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                </div>

                <div class="col-lg-3 col-sm-6 mb-3">
                    <label class="custom_label">
                        @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                    </label>
                    @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                </div>
            </div>

            <div class="row form-group">

                <div class="col-lg-3 col-sm-6 mb-3">
                    <label class="custom_label">  @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                    @if (Model.RoleId == (long)Role.Admin || Model.RoleId == (long)Role.SubAdmin)
                    {
                        // <div class="col-md-3">
                        @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                        //</div>
                    }
                    else
                    {
                        //<div class="col-md-3">
                        @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .Value(Model.VerticalId.ToString())
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%", @readonly = "readonly" }))
                        // </div>
                    }
                </div>
            </div>

            <div class="row form-group">
                <div class="col-md-12 text-right">
                    <button type="button" onclick="SearchSaudaConversion()" class="k-primary k-button custom-btns">Search</button>
                </div>
            </div>
            <div class="row" id="dvUsers">
                <div class="col-md-12">
                    <div class="text-right right-buttons">
                        <div class="export_as">
                            <span>Export as</span>
                            <div class="export-btns">
                                <span class="export-link" onclick='excelExport()' type="button">Excel</span>
                            </div>
                        </div>
                        @*<button class="k-button k-button-icontext k-grid-excel" onclick='excelExport()' type="button"><span class="k-icon k-i-excel"></span>@Helper.GetResourceString("lbl_ExcelExport")</button>&ensp;*@
                        @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        <div class="period-wrapper">
                            <a href="@Url.Action("SaudaConversionUnitAndBaseRate", "Sauda")" class="k-primary k-button"><b><i class="icon-plus"></i></b>&ensp;@Helper.GetResourceString("lbl_CreateConversion")</a>
                        </div>
                    </div>
                    @(Html.Kendo().Grid<SaudaConversionUnitAndDiffRateDto>()
                          .Name("ViewSaudaConversionUnitAndDiffRate")
                          .Columns(columns =>
                          {
                              columns.Bound(c => c.ConversionId).Visible(false);
                              //columns.Bound(c => c.OilTypeId).Visible(false);
                              //columns.Bound(c => c.OilType).Title(@Helper.GetResourceString("lbl_OilType")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                              columns.Bound(c => c.FromPackGroupId).Visible(false);
                              columns.Bound(c => c.FromPackGroup).Title(@Helper.GetResourceString("lbl_FromPackGroup")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.FromSkuId).Visible(false);
                              columns.Bound(c => c.FromSku).Title(@Helper.GetResourceString("lbl_FromSKU")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                              columns.Bound(c => c.FromSkuCode).Title(@Helper.GetResourceString("lbl_FromSkuCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.FromUnit).Format("{0:0.000}").Title(@Helper.GetResourceString("lbl_FromUnit")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ToPackGroupId).Visible(false);
                              columns.Bound(c => c.ToPackGroup).Title(@Helper.GetResourceString("lbl_ToPackGroup")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ToSkuId).Visible(false);
                              columns.Bound(c => c.ToSku).Title(@Helper.GetResourceString("lbl_ToSKU")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                              columns.Bound(c => c.ToSkuCode).Title(@Helper.GetResourceString("lbl_ToSkuCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Unit).Format("{0:0.000}").Title(@Helper.GetResourceString("lbl_ToUnit")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.BasicRate).Title(@Helper.GetResourceString("lbl_BaseRate")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.Source).Title(@Helper.GetResourceString("lbl_SourceName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.State).Title(@Helper.GetResourceString("lbl_State")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ValidFrom).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_ValidFrom")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.ValidTo).Format(Settings.GridDateFormat).Title(@Helper.GetResourceString("lbl_ValidTo")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                              columns.Bound(c => c.IsActive).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Active")).ClientTemplate(@"<div style='text-align: center;'> #if(IsActive == false) { #"
                                                                     + " <a  title='" + @Helper.GetResourceString("msg_Inactive") + "'><i class='icon-cancel-square2 faicon-red' ></i></a>   #}else{#<a title='" + @Helper.GetResourceString("msg_Active") + "'><i  class='icon-checkbox-checked2 faicon-green' ></i></a> #}# </div>").Width(Settings.GridColumnMaxWidth);
                          })
                          .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                          .Filterable(filter => filter.Mode(GridFilterMode.Row))
                          .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                          .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                          .Resizable(resize => resize.Columns(true))
                          .Scrollable(s => s.Enabled(true).Height("auto"))
                          .Excel(excel => excel.AllPages(true).FileName(@Helper.GetResourceString("lbl_Users") + " " + DateTime.Now + ".xlsx").Filterable(true))
                          .Events(events => events.DataBound("onListDataBound"))
                          .Reorderable(reorder => reorder.Columns(true))
                          .Resizable(resize => resize.Columns(true))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          .Model(model => { model.Id(p => p.ConversionId); })
                          .ServerOperation(true)
                          .Read(read => read.Action("GetSaudaConversionUnitAndDiffRateList", "Sauda").Data("additionalInfo"))
                          ))
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
       // kendo grid filter contains
        FilterContains();
        StartDateRange();
    });

    function SearchSaudaConversion() {
        //window.kendo.ui.progress($("#div_Progress"), true);
        $("#ViewSaudaConversionUnitAndDiffRate").data("kendoGrid").dataSource.read();
        //window.kendo.ui.progress($("#div_Progress"), false);
    }

    function StartDateRange() {
        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#StartDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
        $("#EndDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        var endPicker = $("#EndDate").data("kendoDatePicker");
        endPicker.min(dates);
    }

    function fromChange() {
        var endPicker = $("#EndDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#EndDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }

        var grid = $("#ViewSaudaConversionUnitAndDiffRate").data("kendoGrid");
        grid.dataSource.read();
    }

    function onDateChange() {
        var grid = $("#ViewSaudaConversionUnitAndDiffRate").data("kendoGrid");
        grid.dataSource.read();
    }

    function additionalInfo() {
        var verticalId = 0;
        if ($("#ddlVertical").data("kendoDropDownList").value() != "") {
            verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        }
      return {
            Fromdate: ($("#StartDate").val()) ? $("#StartDate").val() : new Date().toDateString(),
            Todate: ($("#EndDate").val()) ? $("#EndDate").val() : new Date().toDateString(),
            VerticalId: verticalId
        };
    }

    function onListDataBound(e) {
        SetEmptyRow(e);
    }

     function excelExport() {
         window.kendo.ui.progress($("#div_Progress"), true);
         var verticalId = 0;
         if ($("#ddlVertical").val() != "") {
             verticalId = $("#ddlVertical").val();
         }
         var data = { StartDate: ($("#StartDate").val()) ? $("#StartDate").val() : new Date().toDateString(), EndDate: ($("#EndDate").val()) ? $("#EndDate").val() : new Date().toDateString(), verticalId: verticalId};
        $.ajax({
            type: 'Post',
            url: '@Url.Action("ExportSaudaConversionUnitAndDiffRate", "Sauda")',
            data: { inputDto: data },
            success: function (responce) {
                if (responce.FileGuid) {
                    window.location.href = '@Url.Action("ExcelDownload", "Pricing")?fileGuid=' + responce.FileGuid + "&fileName=" + responce.FileName;
                } else {
                    ShowErrorMessage("No records found");
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            },
            error: function (responce) {
                ShowErrorMessage("File download failed");
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }
    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        console.log($("#ddlDistributionChannel").data("kendoDropDownList").value());
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>