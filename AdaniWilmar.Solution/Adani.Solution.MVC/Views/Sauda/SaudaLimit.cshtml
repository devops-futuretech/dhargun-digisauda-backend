@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model RoleIdDto
@{
    ViewBag.Title = "SaudaLimit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="transactionsaudaLimit" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">Contract Limit</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Transaction</a><span class="icon-right"></span></li>
        <li class="active">Contract Limit<span class="icon-right"></span></li>
    </ol>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        @*<div class="panel-body" style="display: block;">*@
            <div class="panel-body" style="display: block;" id="pageLoader">
                <div class=" col-md-12">
                    <div class="panel-group filter-accordion" id="accordion">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h4 class="panel-title">
                                    <a data-toggle="collapse" class="accord" data-parent="#accordion" href="#collapseOne">Filters</a>
                                </h4>
                            </div>
                            <div id="collapseOne" class="panel-collapse collapse">
                                <div class="panel-body">
                                    <div class="row">
                                        <div class="panel-body">
                                            <div class="row" id="dvSaudaLimit">
                                                <div class="row form-group">
                                                    <div class="col-lg-3 col-sm-6 mb-3 ">
                                                        <label class="custom_label"> @Helper.GetResourceString("lbl_FromDate") </label>
                                                        @(Html.Kendo().DatePicker()
                              .Name("StartDate")
                              .Value(DateTime.Today)
                              .Format(Settings.DateFormat)
                              .Events(e => e.Change("fromChange"))
                              .HtmlAttributes(new { id = "StartDate", onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                                                    </div>
                                                    <div class="col-lg-3 col-sm-6 mb-3 ">
                                                        <label class="custom_label">@Helper.GetResourceString("lbl_ToDate") </label>
                                                        @(Html.Kendo().DatePicker()
                              .Name("EndDate")
                               .Value(DateTime.Today)
                              //.Value(Settings.DefaultDashboardEndDate)
                              .Format(Settings.DateFormat)
                              .HtmlAttributes(new { id = "EndDate", onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                                                    </div>

                                                    <div class="col-lg-3 col-sm-6 mb-3">
                                                        <label class="custom_label">  @Helper.GetResourceString("lbl_Status") </label>
                                                        @(Html.Kendo().DropDownList()
                              .Name("Status")
                              .OptionLabel("Select status")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .Events(e => e.Change("statusChanged"))
                              .DataSource(source => source.Read(resd => resd.Action("GetSelectiveStatus", "Lookup"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlStatus", @class = "form-control", tabindex = "3", @style = "width:100%" }))
                                                    </div>

                                                    <div class="col-lg-3 col-sm-6 mb-3">
                                                        <label class="custom_label">
                                                            @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                                                        </label>
                                                        @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { id = "ddlSalesOrganization" , tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                                                    </div>
                                                </div>

                                                <div class="row form-group">

                                                    <div class="col-lg-3 col-sm-6 mb-3">
                                                        <label class="custom_label">
                                                            @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                                                        </label>
                                                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { id = "ddlDistributionChannel" , @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                                                    </div>

                                                    <div class="col-lg-3 col-sm-6 mb-3">
                                                        <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                                                        @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                                                    </div>
                                                </div>
                                                <div class="row form-group">
                                                    <div class="col-md-12 text-right">
                                                        <button type="button" tabindex="4" id="btnGenerateSaudaLimit" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Search") </button>
                                                    </div>
                                                </div>


                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="row form-group"></div>
                
                <div class="row">
                    <div class="row form-group">
                        <div class="col-md-12">
                            <div class="text-right">
                                @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                            </div>
                            @(Html.Kendo().Grid<SaudaLimitRequestHistoryDto>()
                              .Name("ViewSaudaLimitRequest")
                              .Columns(columns =>
                              {
                                  columns.Template(c => c.StatusId)
                                                            .ClientTemplate("#if(StatusId == 1){#<div class='text-center'><input type='checkbox' class='chkbxApproveOrReject' value=#=Id# onclick=\"CheckedLimitRequest(this,'#=Id#');\" /></div>#}#")
                                                            .HeaderTemplate("<div class='text-center'><input type='checkbox' id='masterCBAllLimit' onclick=\"LimitSelectAll(this)\"/></div>").Width("40px");
                                  columns.Bound(c => c.Id).Visible(false);
                                  columns.Bound(c => c.DealerName).Title(@Helper.GetResourceString("lbl_DealerName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                  columns.Bound(c => c.ActualLimit).Title(@Helper.GetResourceString("lbl_ActualLimit") + " (MT)").Format(Settings.DecimalFormat4).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                  columns.Bound(c => c.RequestQuantityLimit).Title(@Helper.GetResourceString("lbl_RequestQuantityLimit") + " (MT)").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                  columns.Bound(c => c.CreatedByName).Title(@Helper.GetResourceString("lbl_CreatedBy")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                  columns.Bound(c => c.Status).Title(@Helper.GetResourceString("lbl_Status")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                                  columns.Bound(c => c.Remarks).Title(@Helper.GetResourceString("lbl_Remarks")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth250);
                              })
                              .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                              .Filterable(filter => filter.Mode(GridFilterMode.Row))
                              .Editable(editable => editable.Mode(GridEditMode.InCell))
                              .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                              .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                              .Selectable(selectable => selectable
                              .Mode(GridSelectionMode.Multiple)
                              .Type(GridSelectionType.Row))
                              .Scrollable(s => s.Enabled(true).Height("auto"))
                              .Events(events => events.Change("onSaudaLimitRequestChange").DataBound("onSaudaLimitRequestDataBound").Edit("onEdit"))
                              .Reorderable(reorder => reorder.Columns(true))
                              .Resizable(resize => resize.Columns(true))
                              .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(model => {
                                  model.Id(m => m.Id);
                                  model.Field(p => p.DealerName).Editable(false);
                                  model.Field(p => p.ActualLimit).Editable(false);
                                  model.Field(p => p.Status).Editable(false);
                                  model.Field(p => p.Remarks).Editable(false);
                                  model.Field(p => p.CreatedByName).Editable(false);
                                  model.Field(p => p.RequestQuantityLimit).Editable(true);
                              })
                              //.Model(model => model.Id(m => m.Id))
                              .Events(events => events.Error("OnSaudaLimitErrorHandling"))
                              .ServerOperation(true)
                              .Read(read => read.Action("GetSaudaLimitListAsync", "Sauda").Data("AdditionalInfo"))))
                        </div>
                    </div>
                    <div class="text-right marginT20">
                        <button type="submit" id="btnApproveSaudaLimit" tabindex="5" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Approve") </button>
                        <button type="submit" id="btnRejectSaudaLimit" tabindex="6" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Reject") </button>
                    </div>
                    <div id="addRemarkPopoup" class="modal fade" role="dialog">
                        <div class="modal-dialog">
                            <!-- Modal content-->

                            <div class="modal-content">
                                <div class="modal-header">
                                    <button type="button" class="close model-header-color" data-dismiss="modal">&times;</button>
                                    <h6 class="panel-title model-header-color"><span class="text-semibold">Remark</span></h6>
                                </div>
                                <div class="modal-body">
                                    <div class="row form-group">
                                        <div class="col-lg-3 col-sm-6 mb-3">
                                            @Helper.GetResourceString("lbl_Remark") <span class="text-danger">*</span>
                                        </div>
                                        <div class="col-md-8">
                                            @Html.TextArea("Remarks", null, new { @class = "form-control", @rows = 5, @cols = 80, id = "txtRemark", required = "required", data_msg_required = Helper.GetMsgRequired("lbl_Remark"), @maxlength = (int)InputMaxLength.String })
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button id="btnSave" type="button" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Save")</button>
                                    <button id="btnDirtyCancel" type="button" onclick="popupClose();" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Cancel")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header" style="font-size:16px;color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" style="font-size: 26px;color:#fff;">&times;</button>
                    <h4 class="modal-title">Notes:</h4>
                </div>
                <div class="modal-body" style="font-size: 14px;line-break: normal;line-height: 2.5;">
                    <p>1. Sauda which has Sauda Number can only be Approve / Reject.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function onEdit(e) {
        var StatusId = e.model.StatusId;
        if (StatusId != '@((int)Status.Pending)') {
            $(e.container).find("input[name='RequestQuantityLimit']").attr('disabled', 'disabled');
        }

    }

    var checkedLimitRequestIds = [];
    $(document).ready(function () {


        setFromToDateRange("StartDate", "EndDate", emamiGlobal.constant.IndentDateRange);
        //$("#btnApproveSaudaLimit").prop("disabled", true);
        //$("#btnRejectSaudaLimit").prop("disabled", true);
        $("#masterCBAllLimit").hide();

        //$('#myModal').modal({
        //    show: 'true'
        //});

        // kendo grid filter contains
        FilterContains();

        StartDateRange();

         if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
        }

        $("#btnApproveSaudaLimit").click(function (e) {
            if (checkedLimitRequestIds != '') {
                ApproveSaudaRequestLimit();
            }
            else {
                ShowErrorMessage("Please select a limit request");
            }
        });

        $("#btnRejectSaudaLimit").click(function (e) {
            //window.kendo.ui.progress($("#div_Progress"), true);
            $("#txtRemark").val('');
            if ((checkedLimitRequestIds != '')) {
                RejectSaudaRequestLimit();
            }
            else {
                ShowErrorMessage("Please select a limit request");
            }
            //window.kendo.ui.progress($("#div_Progress"), false);
        });

        $("#btnSave").click(function (e) {
            if (!$("#txtRemark").val()) {
                ShowErrorMessage("Please enter the reason");
                return false;
            }
            SaveSaudaRequestLimit();
        });

        $("#btnGenerateSaudaLimit").on('click', function () {
            window.kendo.ui.progress($("#div_Progress"), true);
            onDateChange();
            window.kendo.ui.progress($("#div_Progress"), false);
        });


    });

    //Method to data bound event for sauda limit
    function onSaudaLimitRequestDataBound(e) {
        SetEmptyRow(e);
        this.element.find('tbody tr').each(function () {
            var row = $(this);
            if (row.length && row.find('td:eq(3)').length) {
                row.find('td:eq(3)').addClass('Kendo-Grid-Editable');
            }
        });
        $("#masterCBAllLimit").prop('checked', false);
        $('input:checkbox.' + 'chkbxApproveOrReject').each(function () {
            if ($.inArray(this.value, checkedLimitRequestIds) > -1) {
                this.checked = true;
            }
            else {
                this.checked = false;
            }
        });
        //checkAllMaster('masterCBAllLimit', 'chkbxApproveOrReject');
    }


    function LimitSelectAll(ele) {
        onSelectAllClickEvent('chkbxApproveOrReject', 'masterCBAllLimit');
        var masterCheckBox = $(ele).is(':checked');
        $('input:checkbox.' + 'chkbxApproveOrReject').each(function () {
            var rValue = this.value;
            if (masterCheckBox) {
                if ($.inArray(rValue, checkedLimitRequestIds) > -1) {

                } else {
                    checkedLimitRequestIds.push(rValue);
                }
            }
            else {
                if ($.inArray(rValue, checkedLimitRequestIds) > -1) {
                    checkedLimitRequestIds = jQuery.grep(checkedLimitRequestIds, function (cVaule) {
                        return cVaule != rValue;
                    });
                }
            }
        });
    }

    function onDateChange() {
        var SaudaLimitRequest = $("#ViewSaudaLimitRequest").data("kendoGrid");
        SaudaLimitRequest.dataSource.read();
        if (SaudaLimitRequest.dataSource.page() != 1) {
            $('#ViewSaudaLimitRequest').data('kendoGrid').dataSource.page(1);
        }
        checkedLimitRequestIds = [];
        var statusId = $("#ddlStatus").data("kendoDropDownList").value();
        if (Number(statusId) === emamiGlobal.Status.Pending || Number(statusId) === 0) {
            $("#btnApproveSaudaLimit").prop("disabled", false);
            $("#btnRejectSaudaLimit").prop("disabled", false);
            $("#masterCBAllLimit").show();
        } else {
            $("#btnApproveSaudaLimit").prop("disabled", true);
            $("#btnRejectSaudaLimit").prop("disabled", true);
            $("#masterCBAllLimit").hide();
        }
    }

    function AdditionalInfo()
    {
        var fromDate = new Date();
        var toDate = new Date();

        if ($("#StartDate").val().length > 0)
            fromDate = $("#StartDate").val();

        if ($("#EndDate").val().length > 0)
            toDate = $("#EndDate").val();

        var verticalId = 0;
        if ($("#ddlVertical").val() != "") {
            verticalId = $("#ddlVertical").val();
        }

        var salesOrganizationId = 0;
        if ($("#ddlSalesOrganization").val() != "") {
            salesOrganizationId = $("#ddlSalesOrganization").val();
        }

        var distributionChannelId = 0;
        if ($("#ddlDistributionChannel").val() != "") {
            distributionChannelId = $("#ddlDistributionChannel").val();
        }

        return {
            FromDate: fromDate,
            ToDate: toDate,
            StatusId: Number($("#ddlStatus").val()),
            DivisionId: verticalId,
            SalesOrganizationId: salesOrganizationId,
            DistributionChannelId: distributionChannelId
        }
    }

    function CheckedLimitRequest(ele, Id)
    {
        if ($(ele).is(':checked'))
            checkedLimitRequestIds.push(Id);
        else {
            checkedLimitRequestIds = jQuery.grep(checkedLimitRequestIds, function (cVaule) {
                return cVaule != Id;
            });
        }
    }

    function ApproveSaudaRequestLimit() {
        window.kendo.ui.progress($("#div_Progress"), true);
        var gridData = $("#ViewSaudaLimitRequest").data("kendoGrid").dataSource.data();
        var jsonObj = [];
        for (var i = 0; i < checkedLimitRequestIds.length; i++) {
            var selectedlists = $.grep(gridData, function (p) { return p.Id == checkedLimitRequestIds[i]; })
                .map(function (p) { return p.RequestQuantityLimit; });
            item = {}
            item["Id"] = checkedLimitRequestIds[i];
            item["RequestedLimitRequest"] = selectedlists[0];
            jsonObj.push(item);
        }
        $.ajax({
            url: '/Sauda/ApproveorRejectSaudaLimit',
            type: 'POST',
            data: { checkedLimitRequestIds: jsonObj, status : '@((int)Status.Approved)' },
            success: function (result) {
                if (!result.PostStatus) {
                    checkedLimitRequestIds=[];
                    var SaudaLimitRequest = $("#ViewSaudaLimitRequest").data("kendoGrid");
                    SaudaLimitRequest.dataSource.read();
                    $("#masterCBAllLimit").prop('checked', false);
                    ShowErrorMessage(result.PostMessage);
                    return false;
                }
                else {
                    checkedLimitRequestIds = [];
                    var SaudaLimitRequest = $("#ViewSaudaLimitRequest").data("kendoGrid");
                    SaudaLimitRequest.dataSource.read();
                    $("#masterCBAllLimit").prop('checked', false);
                    ShowSuccessMessage(result.PostMessage);
                }
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function onSaudaLimitRequestChange(e) {
        var selected = this.select()[0],
            item = this.dataItem(selected);
    }

    function statusChanged(e) {

    }

    function RejectSaudaRequestLimit()
    {
        var gridData = $("#ViewSaudaLimitRequest").data("kendoGrid").dataSource.data();
        var jsonObj = [];
        for (var i = 0; i < checkedLimitRequestIds.length; i++) {
            var selectedlists = $.grep(gridData, function (p) { return p.Id == checkedLimitRequestIds[i]; })
                .map(function (p) { return p.RequestQuantityLimit; });
            item = {}
            item["Id"] = checkedLimitRequestIds[i];
            item["RequestedLimitRequest"] = selectedlists[0];
            jsonObj.push(item);
        }
        var remark = '';
        if (checkedLimitRequestIds != '')
        {
            $('#addRemarkPopoup').modal('show');
        }
        else {
            window.kendo.ui.progress($("#div_Progress"), true);
            $.ajax({
                url: '/Sauda/ApproveorRejectSaudaLimit',
                type: 'POST',
                data: { checkedLimitRequestIds: jsonObj, status: '@((int)Status.Rejected)', remark: $('#txtRemark').val() },
                success: function (result) {
                    if (!result.PostStatus) {
                        checkedLimitRequestIds = [];
                        var SaudaLimitRequest = $("#ViewSaudaLimitRequest").data("kendoGrid");
                        SaudaLimitRequest.dataSource.read();
                        $("#masterCBAllLimit").prop('checked', false);
                        ShowErrorMessage(result.PostMessage);
                        return false;
                    }
                    else {
                        checkedLimitRequestIds = [];
                        var SaudaLimitRequest = $("#ViewSaudaLimitRequest").data("kendoGrid");
                        SaudaLimitRequest.dataSource.read();
                        $("#masterCBAllLimit").prop('checked', false);
                        ShowSuccessMessage(result.PostMessage);
                    }
                    window.kendo.ui.progress($("#div_Progress"), false);
                }
            });
        }
    }

    function SaveSaudaRequestLimit()
    {
        window.kendo.ui.progress($("#div_Progress"), true);
        var gridData = $("#ViewSaudaLimitRequest").data("kendoGrid").dataSource.data();
        var jsonObj = [];
        for (var i = 0; i < checkedLimitRequestIds.length; i++) {
            var selectedlists = $.grep(gridData, function (p) { return p.Id == checkedLimitRequestIds[i]; })
                .map(function (p) { return p.RequestQuantityLimit; });
            item = {}
            item["Id"] = checkedLimitRequestIds[i];
            item["RequestedLimitRequest"] = selectedlists[0];
            jsonObj.push(item);
        }
        $.ajax({
            url: '/Sauda/ApproveorRejectSaudaLimit',
            type: 'POST',
            data: { checkedLimitRequestIds: jsonObj, status: '@((int)Status.Rejected)', remark: $('#txtRemark').val()},
            success: function (result) {
                if (!result.PostStatus) {
                    checkedLimitRequestIds = [];
                    var SaudaLimitRequest = $("#ViewSaudaLimitRequest").data("kendoGrid");
                    SaudaLimitRequest.dataSource.read();
                    $("#masterCBAllLimit").prop('checked', false);
                    ShowErrorMessage(result.PostMessage);
                    return false;
                }
                else {
                    checkedLimitRequestIds = [];
                    var SaudaLimitRequest = $("#ViewSaudaLimitRequest").data("kendoGrid");
                    SaudaLimitRequest.dataSource.read();
                    $("#masterCBAllLimit").prop('checked', false);
                    ShowSuccessMessage(result.PostMessage);
                }
                $("#txtRemark").val('');
                window.kendo.ui.progress($("#div_Progress"), false);
            }
        });
    }

    function OnSaudaLimitErrorHandling(e) {
        if (e.errors) {
            var message = "";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            ShowErrorMessage(message);
        }
    }

    function StartDateRange() {
        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#StartDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
        $("#EndDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        var endPicker = $("#EndDate").data("kendoDatePicker");
        endPicker.min(dates);
    }

    function fromChange() {
        var endPicker = $("#EndDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#EndDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }
        setToDateRangeBasedOnFromDate(startDate, "EndDate", emamiGlobal.constant.IndentDateRange);
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }


</script>

