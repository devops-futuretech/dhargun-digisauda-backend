@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model RoleIdDto
@{
    ViewBag.Title = "SpecialRateApproval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="dvAlert" class="alert-margin-left-right"></div>
<input type="hidden" class="currentMenu" value="transactionSpecialRate" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_SpecialRate")</h2>
    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Transaction</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_SpecialRate")<span class="icon-right"></span></li>
    </ol>
</div>
<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <div class="row" id="dvSpecialRate">
                <div class="row form-group">
                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_FromDate") </label>
                        @(Html.Kendo().DatePicker()
                              .Name("StartDate")
                              .Value(DateTime.Today)
                              .Format(Settings.DateFormat)
                              .Events(e => e.Change("fromChange"))
                              .HtmlAttributes(new { id = "StartDate", onkeydown = "return isFocus(event);", tabindex = "1", style = "width: 100%" }))
                    </div>
                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_ToDate") </label>
                        @(Html.Kendo().DatePicker()
                              .Name("EndDate")
                              .Value(DateTime.Today)
                              //.Value(Settings.DefaultDashboardEndDate)
                              .Format(Settings.DateFormat)
                              .HtmlAttributes(new { id = "EndDate", onkeydown = "return isFocus(event);", tabindex = "2", style = "width: 100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3 ">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Status") </label>
                        @(Html.Kendo().DropDownList()
                              .Name("Status")
                              .OptionLabel("Select status")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .DataSource(source => source.Read(resd => resd.Action("GetSpecialrateCompetitorSelectiveStatus", "Lookup"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlStatus", @class = "form-control", tabindex = "3", @style = "width:100%" }))
                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                    .Name("ddlSalesOrganization")
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new { tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                    </div>
                </div>

                <div class="row form-group">

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label">
                            @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                           .Name("ddlDistributionChannel")
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new { @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                    </div>

                    <div class="col-lg-3 col-sm-6 mb-3">
                        <label class="custom_label"> @Helper.GetResourceString("lbl_Vertical") <span class="text-danger"></span> </label>
                        @if (Model.RoleId == (long)Role.Admin || Model.RoleId == (long)Role.SubAdmin)
                        {
                            // <div class="col-md-3">
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                              .OptionLabel(@Helper.GetResourceString("plho_All"))
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%" }))
                            // </div>
                        }
                        else
                        {
                            //  <div class="col-md-3">
                            @(Html.Kendo().DropDownList().Name("VerticalId")
                                          .OptionLabel(@Helper.GetResourceString("plho_All"))
                                          .DataTextField("Name")
                                          .DataValueField("Id")
                                          .Value(Model.VerticalId.ToString())
                                          .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                          .ServerFiltering(false))
                                          .HtmlAttributes(new { id = "ddlVertical", tabindex = "5", @class = "", @style = "width:100%", @readonly = "readonly" }))
                            //  </div>
                        }
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-12 text-right">
                        <button type="button" tabindex="4" id="btnGenerateSpecialRate" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Search") </button>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-md-12">
                        <div class="text-right">
                            @(Html.Kendo().CheckBox().Name("chkKendoFilterShowHide").HtmlAttributes(new { id = "chkKendoFilterShowHide" }).Label(@Helper.GetResourceString("msg_ShowFilter")))
                        </div>
                        @(Html.Kendo().Grid<SpecialRateApprovalOutputDto>()
                              .Name("ViewSpecialRateRequest")
                              .Columns(columns =>
                              {
                                  //columns.Template(c => c.HasAccessToProceed).ClientTemplate("#if(HasAccessToProceed == true){#<div class='text-center'><input type='checkbox' class='chkbxAllClient' value=#=Id# onclick=\"CheckedLimitRequest(this,'#=Id#');\" /></div>#}#")
                                        // .HeaderTemplate("<div class='text-center'><input type='checkbox' id='masterChkbxAll' onclick=\"LimitSelectAll(this)\"/></div>").Width("40px");
                                  columns.Template(@<text></text>).ClientTemplate("<div class='text-center' style='display: #= HasAccessToProceed == true ? 'block' : 'none' #'><input type='checkbox' class='chkbxAllClient'  value=#=Id# onclick=\"findCheckedItemsSaveItToHidden(this,'#=Id#','hdSelectedIds','masterChkbxAll','chkbxAllClient','lblSelectedCount');\"/></div>")
                                                       .HeaderTemplate("<div class='text-center' style='display: #= HasAccessToProceed == true ? 'block' : 'none' #'><input type='checkbox' id='masterChkbxAll' onclick=\"masterfindCheckedItemsSaveItToHidden(this,'hdSelectedIds','chkbxAllClient','lblSelectedCount')\"/></div>").Width("40px");
                                  columns.Bound(c => c.Id).Visible(false);
                                   columns.Bound(c => c.HasAccessToProceed).Visible(false);
                                  columns.Bound(c => c.OilTypeName).Title(@Helper.GetResourceString("lbl_OilTypeName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.SkuName).Title(@Helper.GetResourceString("lbl_SkuName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                                  columns.Bound(c => c.SkuCode).Title(@Helper.GetResourceString("lbl_SkuCode")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridColumnMaxWidth);
                                  columns.Bound(c => c.FreightRoute).Title(@Helper.GetResourceString("lbl_FreightRoute")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.IncoTerms).Title(@Helper.GetResourceString("lbl_IncoTerms")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.Quantity).Title(@Helper.GetResourceString("lbl_QuantityPerCase")).Format(Settings.DecimalFormat4).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.FinalPrice).Title(@Helper.GetResourceString("lbl_FinalPrice") + " (Rs/Case)").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.SpecialPrice).Title(@Helper.GetResourceString("lbl_SpecialPrice") + " (Rs/Case)").Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.DealerName).Title(@Helper.GetResourceString("lbl_DealerName")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.Status).Title(@Helper.GetResourceString("lbl_Status")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.LTD_SR).Title(@Helper.GetResourceString("lbl_LTDSR")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.Remarks).Title(@Helper.GetResourceString("lbl_Remarks")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.CreatedBy).Title(@Helper.GetResourceString("lbl_CreatedBy")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.RequestedTo).Title(@Helper.GetResourceString("lbl_RequestedTo")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                                  columns.Bound(c => c.ApprovedBy).Title(@Helper.GetResourceString("lbl_ApprovedBy")).Filterable(ftb => ftb.Cell(cell => cell.Operator(Settings.FilterOperator).SuggestionOperator(Settings.FilterSuggestion))).Width(Settings.GridOtherColumnWidth);
                              })
                              .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                              .Filterable(filter => filter.Mode(GridFilterMode.Row))
                              .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                              .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                              .Selectable(selectable => selectable
                              .Mode(GridSelectionMode.Multiple)
                              .Type(GridSelectionType.Row))
                              .Scrollable(s => s.Enabled(true).Height("auto"))
                              .Events(events => events.Change("onSpecialRateRequestChange").DataBound("onSpecialRateRequestDataBound"))
                              .Reorderable(reorder => reorder.Columns(true))
                              .Resizable(resize => resize.Columns(true))
                              .DataSource(dataSource => dataSource
                              .Ajax()
                              .Model(model => model.Id(m => m.Id))
                              .Sort(s => s.Add("Id").Descending())
                              .Events(events => events.Error("OnSpecialRateErrorHandling"))
                              .ServerOperation(true)
                              .Read(read => read.Action("GetSpecialRateApprovalList", "Sauda").Data("AdditionalInfo"))))
                    </div>
                </div>
                @Html.Hidden("hdSelectedIds")

                @if (Helper.CheckClaims(Claims.RequestSpecialRate))
                {
                    <div class="row form-group">
                        <div class="col-md-12 text-right">
                            <button type="button" tabindex="5" id="btnZHReject" class="k-primary k-button custom-btns">Reject</button>
                            <button type="button" tabindex="6" id="btnZHRequest" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_RequestForApproval") </button>
                        </div>
                    </div>

                }
                else if (Helper.CheckClaims(Claims.ApproveSpecialRate))
                {
                    <div class="row form-group">
                        <div class="col-md-4 text-right">
                            @Helper.GetResourceString("lbl_Remarks") @*<span class="text-danger">*</span>*@
                        </div>
                        <div class="col-md-4">
                            @Html.TextArea("Remarks", null, new { @class = "form-control", @rows = 5, @cols = 80, id = "txtRemarks", @maxlength = (int)InputMaxLength.String })
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-md-12 text-right">
                            <button type="button" id="btnNSMReject" class="k-button custom-btns">Reject</button>
                            <button type="button" id="btnNSMApprove" class="k-primary k-button custom-btns">@Helper.GetResourceString("btn_Approve") </button>
                        </div>
                    </div>
                }
            </div>

            <div id="zhRequestForApproval" class="modal fade" role="dialog">
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close model-header-color" data-dismiss="modal">&times;</button>
                            <h6 class="panel-title model-header-color"><span class="text-semibold">Request for Approval</span></h6>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to request for Approval <span class="description"></span>
                        </div>
                        <div class="modal-footer">
                            <button id="btnConfirmRequest" type="button" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Confirm")</button>
                            <button id="btnRequestCancel" type="button" onclick="popupClose();" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Cancel")</button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="dvNsmApprove" class="modal fade" role="dialog">
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close model-header-color" data-dismiss="modal">&times;</button>
                            <h6 class="panel-title model-header-color"><span class="text-semibold">Approve Special Rate</span></h6>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to Approve the Special Rate? <span class="description"></span>
                        </div>
                        <div class="modal-footer">
                            <button id="btnNsmConfirmApprove" type="button" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Confirm")</button>
                            <button id="btnCancel" type="button" onclick="popupClose();" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Cancel")</button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="dvReject" class="modal fade" role="dialog">
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close model-header-color" data-dismiss="modal">&times;</button>
                            <h6 class="panel-title model-header-color"><span class="text-semibold">Approve Special Rate</span></h6>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to Reject the Special Rate? <span class="description"></span>
                        </div>
                        <div class="modal-footer">
                            <button id="btnConfirmReject" type="button" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Confirm")</button>
                            <button id="btnCancel" type="button" onclick="popupClose();" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Cancel")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var checkedLimitRequestIds = [];
    $(document).ready(function () {
        // kendo grid filter contains
        FilterContains();

        StartDateRange();

        $('#txtRemarks').val('');

         if ('@TempData["SuccessMessage"]'.length) {
			ShowSuccessMessage('@TempData["SuccessMessage"]');
        }

        $("#btnZHRequest").on('click', function () {

            window.kendo.ui.progress($("#div_Progress"), true);
            var selectedIds = [];

            if ($("#hdSelectedIds").val()) {
                selectedIds = $("#hdSelectedIds").val().split(",");
            }

            if (selectedIds && selectedIds.length > 0) {
                $("#zhRequestForApproval").modal('show');
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_SelectAnyRecordToProceed")');
            }
            window.kendo.ui.progress($("#div_Progress"), false);
        });

        $("#btnConfirmRequest").on('click', function () {

            //var selectedOrders = [];
            //selectedOrders = $("#hdSelectedIds").val().split(",");
            //if (selectedOrders == '') {
            //    ShowErrorMessage("Please select any record");
            //    return false;
            //}

            var IsApproved = false;
            var gridData = $("#ViewSpecialRateRequest").data("kendoGrid").dataSource.data();
            for (var i = 0; i < gridData.length; i++) {
                if (gridData[i].HasAccessToProceed == true) {
                    IsApproved = true;
                }
            }
            if (!IsApproved) {
                ShowErrorMessage('@Helper.GetResourceString("msg_AlreadyRequestedForSpecialRateApproval")');
            }
            else {
                  var selectedIds = [];
            if ($("#hdSelectedIds").val()) {
                selectedIds = $("#hdSelectedIds").val().split(",");
            }
            if (selectedIds && selectedIds.length > 0) {
                var model = {
                    SpecialRateIds: $("#hdSelectedIds").val().split(",")
                };

                window.kendo.ui.progress($("#div_Progress"), true);
                moduleCommon.Common.AjaxCall({
                    url: "/Sauda/ZHProceedSpecialRateForApproval",
                    type: 'POST',
                    data: { inputDto: model },
                    success: function (result) {
                        if (result.PostStatus) {
                            ShowSuccessMessage('@Helper.GetResourceString("msg_SpecialRateRequestSuccess")');
                            $("#hdSelectedIds").val('');
                        } else {
                            ShowErrorMessage('@Helper.GetResourceString("msg_SpecialRateApprovalError")');
                            return false;
                        }
                        window.kendo.ui.progress($("#div_Progress"), false);
                    }
                });
                //checkedLimitRequestIds = [];
                $("#masterChkbxAll").prop('checked', false);
                var specialRateGrid = $("#ViewSpecialRateRequest").data("kendoGrid");
                specialRateGrid.dataSource.read();
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_SelectAnyRecordToProceed")');
            }
            //window.kendo.ui.progress($("#div_Progress"), false);
            }


        });

        $("#btnNSMApprove").on('click', function () {
            window.kendo.ui.progress($("#div_Progress"), true);

            var selectedIds = [];
            if ($("#hdSelectedIds").val()) {
                selectedIds = $("#hdSelectedIds").val().split(",");
            }
            if (selectedIds && selectedIds.length > 0) {
                $("#dvNsmApprove").modal('show');
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_SelectAnyRecordToProceed")');
            }
            window.kendo.ui.progress($("#div_Progress"), false);
        });

        $("#btnNsmConfirmApprove").on('click', function () {

            var selectedIds = [];
            if ($("#hdSelectedIds").val()) {
                selectedIds = $("#hdSelectedIds").val().split(",");
            }
            if (selectedIds && selectedIds.length > 0) {
                var remarks = $('#txtRemarks').val();
                //if (remarks !== '') {
                    var model = {
                        SpecialRateIds: $("#hdSelectedIds").val().split(","),
                        Remarks: $('#txtRemarks').val()
                    };

                window.kendo.ui.progress($("#div_Progress"), true);
                    moduleCommon.Common.AjaxCall({
                        url: "/Sauda/ApproveSpecialRate",
                        type: 'POST',
                        data: { inputDto: model },
                        success: function (result) {
                            if (result.PostStatus) {
                                var specialRateGrid = $("#ViewSpecialRateRequest").data("kendoGrid");
                                specialRateGrid.dataSource.read();
                                ShowSuccessMessage('@Helper.GetResourceString("msg_SpecialRateApproveSuccess")');
                                $('#txtRemarks').val('');
                                $("#hdSelectedIds").val('');
                            } else {
                                ShowErrorMessage('@Helper.GetResourceString("msg_SpecialRateApprovalError")');
                                return false;
                            }
                            window.kendo.ui.progress($("#div_Progress"), false);
                        }
                    });
                //}
                //else {
                //    ShowErrorMessage('@Helper.GetResourceString("msg_RemarksRequired")');
                //}
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_SelectAnyRecordToProceed")');
            }
            //window.kendo.ui.progress($("#div_Progress"), false);
        });

        $("#btnNSMReject").on('click', function () {
            window.kendo.ui.progress($("#div_Progress"), true);
            var selectedIds = [];
            if ($("#hdSelectedIds").val()) {
                selectedIds = $("#hdSelectedIds").val().split(",");
            }
            if (selectedIds && selectedIds.length > 0) {
                $("#dvReject").modal('show');
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_SelectAnyRecordToProceed")');
            }
            window.kendo.ui.progress($("#div_Progress"), false);
        });

        $("#btnZHReject").on('click', function () {
            window.kendo.ui.progress($("#div_Progress"), true);
            var selectedIds = [];
            if ($("#hdSelectedIds").val()) {
                selectedIds = $("#hdSelectedIds").val().split(",");
            }
            if (selectedIds && selectedIds.length > 0) {
                $("#dvReject").modal('show');
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_SelectAnyRecordToProceed")');
            }
            window.kendo.ui.progress($("#div_Progress"), false);
        });

        $("#btnConfirmReject").on('click', function () {

            var selectedIds = [];
            if ($("#hdSelectedIds").val()) {
                selectedIds = $("#hdSelectedIds").val().split(",");
            }

            if (selectedIds && selectedIds.length > 0) {
                var remarks = $('#txtRemarks').val();
                var model = {
                    SpecialRateIds: $("#hdSelectedIds").val().split(","),
                    Remarks: $('#txtRemarks').val()
                };

                window.kendo.ui.progress($("#div_Progress"), true);
                moduleCommon.Common.AjaxCall({
                    url: "/Sauda/RejectSpecialRate",
                    type: 'POST',
                    data: { inputDto: model },
                    success: function (result) {
                        if (result.PostStatus) {
                            var specialRateGrid = $("#ViewSpecialRateRequest").data("kendoGrid");
                            specialRateGrid.dataSource.read();
                            ShowSuccessMessage('@Helper.GetResourceString("msg_SpecialRateRejectSuccess")');
                            $("#hdSelectedIds").val('');
                        } else {
                            ShowErrorMessage('@Helper.GetResourceString("msg_SpecialRateApprovalError")');
                            return false;
                        }
                        window.kendo.ui.progress($("#div_Progress"), false);
                    }
                });
                @*}
                else {
                    ShowErrorMessage('@Helper.GetResourceString("msg_RemarksRequired")');
                }*@
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_SelectAnyRecordToProceed")');
            }
            //window.kendo.ui.progress($("#div_Progress"), false);
        });

        $("#btnGenerateSpecialRate").on('click', function () {
            window.kendo.ui.progress($("#div_Progress"), true);
            onDateChange();
            $('#txtRemarks').val('');
            window.kendo.ui.progress($("#div_Progress"), false);
        });

    });

    function isNullCheck() {

    }

    //Method to data bound event for dealer List
    function onSpecialRateRequestDataBound(e) {
        SetEmptyRow(e);
        //$("#masterChkbxAll").prop('checked', false);
        //$('input:checkbox.' + 'chkbxAllClient').each(function () {
        //    if ($.inArray(this.value, checkedLimitRequestIds) > -1) {
        //        this.checked = true;
        //    }
        //    else {
        //        this.checked = false;
        //    }
        //});
        //checkAllMaster('masterChkbxAll', 'chkbxAllClient');

        var items = e.sender.items();
        items.each(function () {
            var row = $(this);
            var dataItem = e.sender.dataItem(row);
            if (dataItem != undefined && !dataItem.HasChildren) {
                row.find(".k-hierarchy-cell").html("");
            }
        });
        var selectedOrders = [];
        if ($("#hdSelectedIds").val()) {
            selectedOrders = $("#hdSelectedIds").val().split(",");
        }
        $("#masterChkbxAll").prop('checked', false);
        $('input:checkbox.' + 'chkbxAllClient').each(function () {
            if ($.inArray(this.value, selectedOrders) > -1) {
                this.checked = true;
            }
            else {
                this.checked = false;
            }
        });
    }


    function LimitSelectAll(ele) {
        onSelectAllClickEvent('chkbxAllClient', 'masterChkbxAll');
        var masterCheckBox = $(ele).is(':checked');
        $('input:checkbox.' + 'chkbxAllClient').each(function () {
            var rValue = this.value;
            if (masterCheckBox) {
                if ($.inArray(rValue, checkedLimitRequestIds) > 0) {
                    var rt = this.value;
                } else {
                    checkedLimitRequestIds.push(rValue);
                }
            }
            else {
                if ($.inArray(rValue, checkedLimitRequestIds) > -1) {
                    checkedLimitRequestIds = jQuery.grep(checkedLimitRequestIds, function (cValue) {
                        return cValue !== rValue;
                    });
                }
            }
        });
    }

    function onDateChange() {
        window.kendo.ui.progress($("#div_Progress"), true);
        var SpecialRateRequest = $("#ViewSpecialRateRequest").data("kendoGrid");
        SpecialRateRequest.dataSource.read();
        if (SpecialRateRequest.dataSource.page() !== 1) {
            $('#ViewSpecialRateRequest').data('kendoGrid').dataSource.page(1);
        }
        window.kendo.ui.progress($("#div_Progress"), false);
    }

    function AdditionalInfo()
    {
        var fromDate = new Date();
        var toDate = new Date();
        var departmentId = 0;

        if ($("#StartDate").val().length > 0)
            fromDate = $("#StartDate").val()

        if ($("#EndDate").val().length > 0)
            toDate = $("#EndDate").val()

        return {
            FromDate: fromDate,
            ToDate: toDate,
            StatusId: Number($("#ddlStatus").val()),
            verticalId: $("#ddlVertical").val()
        }
    }

    function CheckedLimitRequest(ele, Id) {
        if ($(ele).is(':checked'))
            checkedLimitRequestIds.push(Id);
        else {
            checkedLimitRequestIds = jQuery.grep(checkedLimitRequestIds, function (cValue) {
                return cValue !== Id;
            });
        }
    }


    function onSpecialRateRequestChange(e) {
        var selected = this.select()[0],
            item = this.dataItem(selected);
    }

    function OnSpecialRateErrorHandling(e) {
        if (e.errors) {
            var message = "";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            ShowErrorMessage(message);
        }
    }

    function StartDateRange() {
        var dates = new Date();
        dates.setDate(dates.getDate());

        $("#StartDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));
        $("#EndDate").val(kendo.toString(kendo.parseDate(dates), emamiGlobal.constant.DateFormat));

        var endPicker = $("#EndDate").data("kendoDatePicker");
        endPicker.min(dates);
    }

    function fromChange() {
        var endPicker = $("#EndDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            $("#EndDate").val(kendo.toString(kendo.parseDate(startDate), emamiGlobal.constant.DateFormat));
            endPicker.min(startDate);
        }
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>



