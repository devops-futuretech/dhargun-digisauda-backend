    @*dirty tracking confirmation popup*@
    <div id="confirmationPopoup" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close model-header-color" data-dismiss="modal">&times;</button>
                    <h6 class="panel-title model-header-color"><span class="text-semibold">@Helper.GetResourceString("lbl_dirtyConfirmationHeader")</span></h6>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            @Helper.GetResourceString("msg_dirtyConfirmationMessage")
                            @*You have pending unsaved changes. If you navigate away from this page without first saving your data, the changes will be lost.*@
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnDirtyOk" type="button" class="k-button" data-dismiss="modal">Ok</button>
                    <button id="btnDirtyCancel" type="button" onclick="popupClose();" class="k-button" data-dismiss="modal">@Helper.GetResourceString("btn_Cancel")</button>
                </div>
            </div>
        </div>
    </div>

    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header" style="font-size:16px;color:#fff;">
                    <button type="button" class="close" data-dismiss="modal" style="font-size: 26px;color:#fff;">&times;</button>
                    <h4 class="modal-title">Precautionary Steps before booking Sauda:</h4>
                </div>
                <div class="modal-body" style="font-size: 14px;line-break: normal;line-height: 2.5;">
                    <p>1. Need to create or import the geographical data (Zone,State,Territory,District and City).</p>
                    <p>2. Need to create or import the freight zone and freight route.</p>
                    <p>3. Need to create the Headquarters for EAL user creation.</p>
                    <p>4. After plant & depot integrated from SAP, Need to map the plant and Depot in DS portal</p>
                    <p>5. After SKU integrated from SAP, Need to update the  following fields : Pack Size, Pack Size Quantity, Sub Category, Pack Group,Process cost (Required for Specialty fat)</p>
                    <p>6. Ingredient master for specialty fat to be included and mapped with SKU</p>
                    <p>7. After Customer and broker integrated from SAP, Need to update the following fields:  SaudaValidityPeriod,Incoterms,TransportModeId,SaudaBookingTypeId,SaudaLimit, Plant, Depot, freight Zone freight Route</p>
                    <p>8. After update the customer and Broker, Need to map the dealer/broker with plant/Depot.</p>
                    <p>9. Create the EAL user and map the StateTrader with respective dealer/broker.</p>
                    <p>10. Need to update the density for liter conversion in oil type.</p>
                    <p>11. Configure the Role Hierarchy.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>


    <div id="userProfileImage" class="modal fade" role="dialog">
        <div id="uploadErrorMsg" class="alert alert-danger" style="display:none;"></div>


        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close closeDealer" data-dismiss="modal">&times;</button>
                    <h6 class="panel-title"><span class="text-semibold">Upload Profile Image</span></h6>
                </div>
                @using (Html.BeginForm("ProfileUpload", "Lookup", FormMethod.Post, new { id = "frmUploadProfilePhoto", @class = "form-validate-jquery" }))
                {
                    <div class="row form-group" id="dvIssueAttachments">
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">   Media <span class="text-danger"></span>  </label>
                            @(Html.Kendo().Upload()
                       .Name("files").Multiple(false)
                       .HtmlAttributes(new { id = "fpMediaImage", tabindex = "5",/*required = "required",*/ aria_label = "files", accept = "image/*" }))
                            <label style="font-size: 12px; font-weight: bold !important;"> File format must be jpeg, png, jpg </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" onclick="popupClose();" class="k-button closeDealer custom-btns k-cancel" data-dismiss="modal">@Helper.GetResourceString("btn_Close")</button>
                        <button type="submit" id="btnSave" tabindex="23" class="k-button k-cancel custom-btns">Upload</button>
                    </div>
                }

            </div>
            @*<button type="button" id="btnSave" tabindex="22" class="k-primary k-button custom-btns">@(Model != null && Model.Id == 0 ? @Helper.GetResourceString("btn_SaveUser") : @Helper.GetResourceString("btn_UpdateUser"))</button>*@


        </div>
    </div>
    <script>
        $(document).ready(function () {
            $('[data-toggle=offcanvas]').click(function () {
                $('.row-offcanvas').toggleClass('active');
            });

            $('#profileImage').on('click', function (e) {
                $('#userProfileImage').modal('show');
            });

            //$("#btnSave").click(function () {
            //    var isValidForm = $("#frmIssueRegister").valid();
            //    if (isValidForm) {
            //        window.kendo.ui.progress($("#div_Progress"), true);
            //        $("#frmIssueRegister").submit();
            //        //window.kendo.ui.progress($("#div_Progress"), false);
            //    }
            //});
            isFormChanged('isNotChanged');

            $("#layoutMenu").on("click", "a", function (event) {
                event.preventDefault();
                if ($(this).attr("href")) {
                    isFormChangeOrNot($(this).attr("href"));
                }
            });

            $("#btnDirtyOk").click(function () {
                isFormChanged('isNotChanged');
                window.location.href = $("#btnDirtyOk").val();
            });

            $.ajax({
                type: 'Get',
                url: '@Url.Action("GetProfileImageUrl", "Lookup")',
                success: function (response) {
                    if (response.PostStatus) {
                        console.log(response);
                        if (response.ProfilePath == null) {
                            $("#profilephoto").attr("src", "/images/user-image.png");
                        } else {
                            $("#profilephoto").attr("src", response.ProfilePath);
                        }

                } else {
                    $("#profilephoto").attr("src", "/images/user-image.png");
                }
            },
                error: function (responce) {
                    $("#profilephoto").attr("src", "/images/user-image.png");
            }
        });

            $("#helpModal").click(function () {
                //$('#myModal').modal({
                //    show: 'true'
                //});
            });
        });
    </script>
    <style>
        .k-grid-pager {
            padding: 1px !important;
        }

        .modal-dialog {
            width: 70%;
        }
    </style>
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
        $(document).ready(function () {
            var message = '@TempData["ErrorMessage"]';
            $('#globalErrorMsg').text(message).fadeIn();

            // Optional: auto-hide after 5 seconds
            setTimeout(function () {
                $('#globalErrorMsg').fadeOut();
            }, 5000);
        });
        </script>
    }
    <style>
        #globalErrorMsg {
            font-size: 14px;
            padding: 10px 15px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0,0,0,0.2);
        }
    </style>



    <div id="globalErrorMsg" class="alert alert-danger" style="display:none; position: fixed; top: 70px; right: 20px; z-index: 1050; min-width: 250px;"></div>

</body>
</html>