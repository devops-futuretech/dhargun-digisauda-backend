@using Kendo.Mvc.UI
@using Adani.Solution.MVC.Helpers
@using Adani.Solution.MVC.Common
@using Adani.Solution.DTO.Enums
@using Adani.Solution.DTO
@model Adani.Solution.DTO.QuestionDto
@{
    ViewBag.Title = "QuestionSurvey";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" class="currentMenu" value="updatesQuestion" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="col-xs-3">@Helper.GetResourceString("lbl_ViewQuestionSurvey")</h2>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <fieldset class="content-group">

                <div class="row form-group">
                    <div class="col-md-3 text-right control-label">
                        @Helper.GetResourceString("lbl_Question"):
                    </div>
                    <div class="col-md-4 control-link">
                        @*@Html.TextBoxFor(m => m.Question, new { id = "txtQuestion", @readonly = true, @class = "form-control", @maxlength = (int)InputMaxLength.String })*@
                        <span><b>@Model.Question</b></span>
                    </div>
                </div>

                <div class="row form-group">
                    <div class="col-md-3 text-right control-label">
                        @Helper.GetResourceString("lbl_Comments")
                    </div>
                    <div class="col-md-7" style="padding-top: 07px;">
                        @if (Model != null && Model.Comments != null && Model.Comments.Any())
                        {
                            <div class="demo-section k-content wide">
                                @(Html.Kendo().ListView<QuestionDto>()
                                                      .Name("ViewQuestion")
                                                      .TagName("div")
                                                      .BindTo(Model.Comments)
                                                      .ClientTemplateId("template")
                                                      .DataSource(dataSource => dataSource
                                                      .ServerOperation(false)
                                                      .PageSize(4)
                                                      .Model(model => { model.Id(p => p.Comments.FirstOrDefault().QuestionSurveyId); })
                                                      .Batch(true)
                                                      )
                                                      .Pageable()
                                                      .Editable()
                                )
                                <script type="text/x-kendo-tmpl" id="template">
                                    <div class="product-view k-widget">
                                        <dl>
                                            <dd>#:Comments#</dd>
                                            <dt>Who </dt>
                                            <dd>#:CreatedUserName#</dd>
                                            <dt>When</dt>
                                            <dd>#:CreatedDate#</dd>
                                        </dl>
                                    </div>
                                </script>
                            </div>
                        }
                        else
                        {
                            <i> There are no comments yet on this issue. </i>
                        }
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
</div>

<style>
    .product-view dl {
        margin: 10px 10px 0;
        padding: 0;
        overflow: hidden;
    }

    .product-view dt, dd {
        margin: 0;
        padding: 0;
        width: 100%;
        line-height: 24px;
        font-size: 18px;
    }

    .product-view dt {
        font-size: 11px;
        height: 16px;
        line-height: 16px;
        text-transform: uppercase;
        opacity: 0.5;
    }

    .product-view dd {
        height: 46px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

        .product-view dd .k-widget,
        .product-view dd .k-textbox {
            font-size: 14px;
        }

    .k-listview {
        border-width: 1px 0 0;
        padding: 0;
        overflow: hidden;
        min-height: 298px;
    }
</style>


