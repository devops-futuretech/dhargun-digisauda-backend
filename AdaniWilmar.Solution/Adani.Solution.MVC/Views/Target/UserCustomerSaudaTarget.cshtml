@using Kendo.Mvc.UI;
@using Adani.Solution.DTO.Enums;
@using Adani.Solution.DTO;
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.MVC.Common;
@model Adani.Solution.DTO.UserCustomerSaudaTargetDto
@{
    ViewBag.Title = "UserCustomerSaudaTarget";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" class="currentMenu" value="tptargetUserCustomerSaudaTarget" />
<div id="main-section-header" class="row">
    <h2 id="team-efficiency" class="main-title">@Helper.GetResourceString("lbl_UserCustomerSaudaTarget")</h2>

    <ol class="breadcrumb custom_breadcrumb">
        <li><a href="#">Target</a><span class="icon-right"></span></li>
        <li><a href="UserCustomerSaudaTargetList">@Helper.GetResourceString("lbl_UserCustomerSaudaTarget") List</a><span class="icon-right"></span></li>
        <li class="active">@Helper.GetResourceString("lbl_UserCustomerSaudaTarget")<span class="icon-right"></span></li>
    </ol>
    <div style="clear:both;"></div>
</div>

<div class="content main-section-content row">
    <div class="panel panel-flat" id="dvSaudaTarget">
        <div class="panel-heading">
        </div>
        <div class="panel-body" style="display: block;">
            <p class="content-group-lg"></p>
            @using (Html.BeginForm("AddOrUpdateUserCustomerSaudaTarget", "Target", FormMethod.Post, new { id = "frmUserCustomerSaudaTarget", @class = "form-validate-jquery" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.LoginUserId, new { id = "hdnLoginUserId" })
                @Html.HiddenFor(m => m.LoginUserName, new { id = "hdnLoginUserName" })
                <fieldset class="content-group">
                    <div class="row form-group">
                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label"> @Helper.GetResourceString("lbl_AssignedTo") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().DropDownListFor(m => m.AssignedToId)
                                  .OptionLabel(@Helper.GetResourceString("plho_SelectUser"))
                                  .DataTextField("Name")
                                  .DataValueField("Id")
                                  .Filter("Contains")
                                  .Events(e => e.Change("onAssignedToChange"))
                                  .DataSource(source => source.Read(read => read.Action("GetSalesReportingToUsersByLoggedInUserId", "Role"))
                                  .ServerFiltering(false))
                                  .HtmlAttributes(new { id = "ddlAssignedTo", tabindex = "1", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_AssignedTo"), @style = "width:100%" }))
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">  @Helper.GetResourceString("lbl_CalendarDuaration") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().DropDownListFor(m => m.FinancialYearId)
                                  .OptionLabel(@Helper.GetPlaceHolderSelectMsg("lbl_Year"))
                                  .DataTextField("Year")
                                  .DataValueField("Id")
                                  .DataSource(source => source.Read(read => read.Action("GetActiveFinancialYearListAsync", "SalesTourPlan"))
                                  .ServerFiltering(true))
                                  .HtmlAttributes(new { id = "ddlFinancialYear", tabindex = "2", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Year"), onchange = "onchangeFinancialYear();", @class = "", @style = "width:100%" }))
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">
                                @Helper.GetResourceString("lbl_SalesOrganization") <span class="text-danger">*</span>
                            </label>
                            @(Html.Kendo().DropDownListFor(m => m.SalesOrganizationId)
                    .OptionLabel("Select Sales Organization")
                    .DataTextField("SalesOrganizationName")
                    .Events(e => e.Change("onSaleChange"))
                    .DataValueField("Id")
                    .DataSource(source => source.Read(read => read.Action("GetSalesOrganizationddl", "Lookup"))
                    ).HtmlAttributes(new {id= "ddlSalesOrganization", tabindex = "5", @class = "form-control", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_SalesOrganization"), @style = "width:100%" })
                )

                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">
                                @Helper.GetResourceString("lbl_DistributionChannel") <span class="text-danger">*</span>
                            </label>
                            @(Html.Kendo().DropDownListFor(m => m.DistributionChannelId)
                          .OptionLabel("Select Distribution")
                          .Events(events => events.Change("onDistributionChange").DataBound("OnDistributionDataBound"))
                          .DataTextField("DistributionChannelName")
                          .DataValueField("Id")
                          .DataSource(source => source.Read(read => read.Action("GetDistributionChannelddl", "Lookup").Data("distParam"))
                          .ServerFiltering(true))
                          .HtmlAttributes(new {id= "ddlDistributionChannel", @class = "", tabindex = "6", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_DistributionChannel"), @style = "width:100%" }))

                        </div>
                    </div>

                    <div class="row form-group">

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">  @Helper.GetResourceString("lbl_Vertical") <span class="text-danger">*</span> </label>
                            @(Html.Kendo().DropDownListFor(m => m.VerticalId)
                                  .OptionLabel(@Helper.GetResourceString("plho_SelectVertical"))
                                  .DataTextField("Name")
                                  .DataValueField("Id")
                                  .Events(e => e.Change("onVerticalTypeChange").DataBound("verticalDataBound"))
                                  .DataSource(source => source.Read(resd => resd.Action("GetVerticalDetailsdd", "Lookup").Data("verticalParam"))
                                  .ServerFiltering(false))
                                  .HtmlAttributes(new { id = "ddlVertical", @class = "", tabindex = "3", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_Vertical"), @style = "width:100%" }))
                        </div>

                        <div class="col-lg-3 col-sm-6 mb-3">
                            <label class="custom_label">  @Helper.GetResourceString("lbl_OilType") </label>
                            @(Html.Kendo().DropDownListFor(m => m.OilTypeId)
                                  .DataTextField("Name")
                                  .DataValueField("Id")
                                  .OptionLabel(@Helper.GetResourceString("plho_SelectOilType"))
                                  .DataSource(source => source.Read(read => read.Action("GetOilTypesBasedOnAssignedSaudaTarget", "Target", new { isToReturnInactiveData = false }).Data("oilTypeAdditionalInfo"))
                                  .ServerFiltering(true))
                                  .HtmlAttributes(new { id = "ddlOilType", tabindex = "4", @class = "", required = "required", data_msg_required = Helper.GetSelectMsgRequired("lbl_OilType"), @style = "width:100%" }))
                        </div>
                    </div>
                    <div id="dv_detail">
                    </div>
                    @{
                        if (Model.UserTargetDetail.Any())
                        {
                            if (Model.UserTargetDetail.Count > 0)
                            {
                                <div id="dv_detailpartial">
                                    @Html.Partial("_userCustomerSaudaTargetPartial", Model)
                                </div>
                            }
                        }
                    }
                </fieldset>
                <div class="row form-group"> </div>
                <div class="row form-group">
                    <div class="col-md-12 text-right">
                        @if (Helper.CheckClaims(Claims.ManageTarget))
                        {
                            <button type="button" tabindex="5" id="btnAddTargetToGrid" class="k-primary k-button custom-btns">@Helper.GetResourceString("Btn_AddSaudaTargetToGrid")</button>
                        }
                    </div>
                </div>
                <div class="panel-heading">
                    <h3 class="panel-title">@Helper.GetResourceString("lbl_MappedSaudaTargetList")</h3>
                </div>
                <div class="panel-body" style="display: block;">
                    <div class="row" id="dvtable">
                        <table id="tblTarget" border="1">
                            <thead>
                                <tr></tr>
                            </thead>
                            <tbody> <tr></tr></tbody>
                        </table>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="row" id="dvDealers" hidden>
                        <div class="col-md-12">
                            @(Html.Kendo().Grid<MapSaudaTargetDetailDto>()
                                  .Name("ViewTargets")
                                  .Columns(columns =>
                                  {
                                      columns.Bound(c => c.AssignedFromId).Visible(false);
                                      columns.Bound(c => c.AssignedToId).Visible(false);
                                      columns.Bound(c => c.FinancialYearId).Visible(false);
                                      columns.Bound(c => c.VerticalId).Visible(false);
                                      columns.Bound(c => c.SalesOrganizationId).Visible(false);
                                      columns.Bound(c => c.DistributionChannelId).Visible(false);
                                      columns.Bound(c => c.OilTypeId).Visible(false);
                                      columns.Bound(c => c.MonthId).Visible(false);
                                      columns.Bound(c => c.AssignedFromUser).Title(Helper.GetResourceString("lbl_AssignedFrom")).Width(Settings.GridOtherColumnWidth);
                                      columns.Bound(c => c.AssignedToUser).Title(Helper.GetResourceString("lbl_AssignedTo")).Width(Settings.GridOtherColumnWidth);
                                      columns.Bound(c => c.FinancialYear).Title(Helper.GetResourceString("lbl_FinancialYear")).Width(Settings.GridOtherColumnWidth);
                                      columns.Bound(c => c.Vertical).Title(Helper.GetResourceString("lbl_Vertical")).Width(Settings.GridOtherColumnWidth);
                                      columns.Bound(c => c.OilType).Title(Helper.GetResourceString("lbl_OilType")).Width(Settings.GridOtherColumnWidth);
                                      columns.Bound(c => c.Month).Title(Helper.GetResourceString("lbl_Month")).Width(Settings.GridOtherColumnWidth);
                                      columns.Bound(c => c.MonthAndYear).Visible(false);
                                      columns.Bound(c => c.Year).Title(Helper.GetResourceString("lbl_Year")).Width(Settings.GridOtherColumnWidth);
                                      columns.Bound(c => c.Target).Title(Helper.GetResourceString("lbl_Target")).Width(Settings.GridOtherColumnWidth);
                                              //columns.Template(c => c.DealerId).HeaderTemplate("").Title(@Helper.GetResourceString("lbl_Action")).ClientTemplate("<div style='text-align: center;'><a class='icon-eye cursor-pointer' onclick=\"openMappedDetails(this)\"></a><a style='padding-left: 4px;' class='icon-cross cursor-pointer' onclick='RemoveDataFromGrid(this)'></a></div>").Width(Settings.GridOtherColumnWidth);
                                          })
                                  .NoRecords(e => e.Template(@Helper.GetResourceString("msg_NoRecordsFound")))
                                  .Filterable(filter => filter.Mode(GridFilterMode.Row))
                                  .Sortable(sort => sort.SortMode(GridSortMode.MultipleColumn))
                                  .Pageable(pageable => pageable.Refresh(true).PageSizes(Settings.GridPageSizes))
                                  .Selectable(selectable => selectable
                                  .Mode(GridSelectionMode.Multiple)
                                  .Type(GridSelectionType.Row))
                                  .Scrollable(s => s.Enabled(true).Height("auto"))
                                  .Events(events => events.DataBound("onListDataBound"))
                                  .Reorderable(reorder => reorder.Columns(true))
                                  .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .ServerOperation(false)
                                  .Sort(sort => sort.Add("OilTypeId").Descending())
                                  .Model(model => model.Id(m => m.OilTypeId))
                                  .Read(read => read.Action("GetSaudaTargetEmptyListAsync", "Target"))))
                        </div>
                    </div>
                    <div class="row form-group"></div>
                    <div class="row form-group" id="dvSaveTarget">
                        <div class="col-md-12 text-center">
                            <button type="button" tabindex="6" id="btnCancel" onclick="location.href = '@Url.Action("UserCustomerSaudaTargetList", "Target")'" class="k-button">Cancel</button>
                            <button type="button" tabindex="7" id="btnSaveTarget" class="k-primary k-button">@Helper.GetResourceString("btn_SaveUserCustomerSaudaTarget") <i class="icon-arrow-right14 position-right"></i></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }

        @*if ('@Model.VerticalId' > 0) {
            $("#ddlVertical").data("kendoDropDownList").readonly(true);
        }*@

        $('#dvSaveTarget').hide();

        if ($("#ViewTargets").data("kendoGrid").dataSource.data().length > 0) {
            $('#dvSaveTarget').show();
        }

        $('#btnAddTargetToGrid').on('click', function (e) {
            var isValid = $('#frmUserCustomerSaudaTarget').valid();
            $('input[type="text"].dynamicTarget').each(function () {
                if (!CheckValueIsZero(this.value)) {
                    ShowErrorMessage('@Helper.GetResourceString("msg_TargetShouldNotBeZero")');
                    isValid = false;
                }
            });
            if (isValid) {
                // Animate loader
                window.kendo.ui.progress($("#dvSaudaTarget"), true);
                AddDataToGrid();
                window.kendo.ui.progress($("#dvSaudaTarget"), false);

            }
        });

        $('#btnSaveTarget').click(function () {
            if ($("#ViewTargets").data("kendoGrid").dataSource.data().length > 0) {
                window.kendo.ui.progress($("#dvSaudaTarget"), true);
                $.ajax(
                    {
                        url: "/Target/SaveUserCustomerSaudaTarget",
                        type: 'POST',
                        data: {
                            inputDtoList: JSON.parse(JSON.stringify($("#ViewTargets").data("kendoGrid").dataSource.data()))
                        },
                        success: function (result) {

                            if (result.IsSuccess) {
                                ShowSuccessMessage(result.Message);
                                window.location.href = result.redirectUrl;
                            }
                            else
                                if (result.Message != "")
                                    ShowErrorMessage(result.Message);
                                else
                                    ShowErrorMessage('@Helper.GetResourceString("msg_AddTargetError")');
                            window.kendo.ui.progress($("#dvSaudaTarget"), false);
                        }
                    });
            }
            else {
                ShowErrorMessage('@Helper.GetResourceString("msg_TargetNoDataSaveError")');
            }
        });
    });

    function AddHeaderDataToTable() {
        $('#tblTarget').find('thead tr').append('<th style="padding-right: 20px;"> Target </th>');
        $('#tblTarget').find('thead tr').append('<th style="padding-right: 20px;"> OilType </th>');
        var k = 0;
        $('input[type="text"].dynamicTarget').each(function () {
            var hdnMonthAndYear;
            if (typeof $('#SaudaTarget' + (k + 1)).val() !== 'undefined' &&
                $('#SaudaTarget' + (k + 1)).val() !== '') {
                hdnMonthAndYear = $('#hdnMonthAndYear' + (k + 1)).val();
                $('#tblTarget').find('thead tr').append('<th style="padding-right: 20px;">' + hdnMonthAndYear + '</th>');
            }
            k++;
        });
    }

    function AddRowDataToTable() {
        var m = 0;
        var jj = m + 1;
        var $tblBody = $('#tblTarget tbody');
        var $tblRow = $('<tr id="row_' + jj + '">');
        $tblRow.append('' + '<td style="padding-right: 20px;">SaudaTarget</td>');
        var ddlOilType = $("#ddlOilType").data("kendoDropDownList").text();
        $tblRow.append('' + '<td style="padding-right: 20px;">' + ddlOilType + '</td>');
        $('input[type="text"].dynamicTarget').each(function () {
            var txtSaudaTarget;
            if (typeof $('#SaudaTarget' + (m + 1)).val() !== 'undefined' &&
                $('#SaudaTarget' + (m + 1)).val() !== '') {
                txtSaudaTarget = $('#SaudaTarget' + (m + 1)).val();
                $tblRow.append('' +
                    '<td style="padding-right: 20px;">' + txtSaudaTarget + '</td>'
                );
            }
            m++;
        });
        $tblBody.append($tblRow);
    }

    function onListDataBound(e) {
        SetEmptyRow(e);

        if ($("#ViewTargets").data("kendoGrid").dataSource.data().length > 0) {
            $('#dvSaveTarget').show();
        }
    }

    function RemoveDataFromGrid(e) {
        var grid = $("#ViewTargets").data("kendoGrid");
        var row = $(e).closest("tr");
        windowDelete.center().open();

        $("#yes").click(function () {
            grid.removeRow(row);
            windowDelete.close();
        });

        $("#no").click(function () {
            windowDelete.close();
        });
    }

    function AddDataToGrid() {
        var grid = $("#ViewTargets").data("kendoGrid");
        var ddlOilTypeValue = $("#ddlOilType").data("kendoDropDownList").value(),
            viewOilType = grid.dataSource.view();
        var ddlVerticalValue = $("#ddlVertical").data("kendoDropDownList").value(),
            viewVertical = grid.dataSource.view();
        var gridDataItem = grid.dataSource.data().filter(function (item) {
            return item.OilTypeId === ddlOilTypeValue && item.VerticalId === ddlVerticalValue;
        });

        if (gridDataItem.length > 0) {
            ShowErrorMessage('@Helper.GetResourceString("msg_TargetAlreadyAddedForSelectedOiltype")');
        }
        else {
            AddRowDataToTable();
            var k = 0;
            $('input[type="text"].dynamicTarget').each(function () {
                var ddlAssignedTo = $("#ddlAssignedTo").data("kendoDropDownList").text();
                var ddlAssignedToId = $("#ddlAssignedTo").data("kendoDropDownList").value();
                var ddlFinancialYear = $("#ddlFinancialYear").data("kendoDropDownList").text();
                var ddlFinancialYearId = $("#ddlFinancialYear").data("kendoDropDownList").value();
                var ddlVertical = $("#ddlVertical").data("kendoDropDownList").text();
                var ddlVerticalId = $("#ddlVertical").data("kendoDropDownList").value();
                var ddlSalesOrganizationId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
                var ddlDistributionChannelId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
                var ddlOilType = $("#ddlOilType").data("kendoDropDownList").text();
                var ddlOilTypeId = $("#ddlOilType").data("kendoDropDownList").value();
                var hdnLoginUserId = $('#hdnLoginUserId').val();
                var hdnLoginUserName = $('#hdnLoginUserName').val();

                var txtSaudaTarget; var hdnMonthName;
                var hdnMonthAndYear; var hdnMonthId;
                var hdnYear;

                if (typeof $('#SaudaTarget' + (k + 1)).val() !== 'undefined' &&
                    $('#SaudaTarget' + (k + 1)).val() !== '') {
                    txtSaudaTarget = $('#SaudaTarget' + (k + 1)).val();
                    hdnMonthName = $('#hdnMonthName' + (k + 1)).val();
                    hdnMonthAndYear = $('#hdnMonthAndYear' + (k + 1)).val();
                    hdnMonthId = $('#hdnMonthId' + (k + 1)).val();
                    hdnYear = $('#hdnYear' + (k + 1)).val();
                }

                var datasource = grid.dataSource;
                var total = datasource.data().length;

                datasource.insert(total, {
                    AssignedFromId: hdnLoginUserId,
                    AssignedToId: ddlAssignedToId,
                    FinancialYearId: ddlFinancialYearId,
                    VerticalId: ddlVerticalId,
                    SalesOrganizationId: ddlSalesOrganizationId,
                    DistributionChannelId: ddlDistributionChannelId,
                    OilTypeId: ddlOilTypeId,
                    MonthId: hdnMonthId,
                    AssignedFromUser: hdnLoginUserName,
                    AssignedToUser: ddlAssignedTo,
                    FinancialYear: ddlFinancialYear,
                    Vertical: ddlVertical,
                    OilType: ddlOilType,
                    Month: hdnMonthName,
                    MonthAndYear: hdnMonthAndYear,
                    Year: hdnYear,
                    Target: txtSaudaTarget
                });
                k++;
            });
            ResetFields();
        }
    }

    function ResetFields() {
        $('.dynamicTarget').val('');
        $("#ddlOilType").data("kendoDropDownList").select(-1);
        var ddlAssignedTo = $("#ddlAssignedTo").data("kendoDropDownList");
        ddlAssignedTo.readonly();
        var ddlFinancialYear = $("#ddlFinancialYear").data("kendoDropDownList");
        ddlFinancialYear.readonly();
        var ddlVertical = $("#ddlVertical").data("kendoDropDownList");
        //ddlVertical.readonly();
    }

    function onAssignedToChange() {
        if (Number($("#ddlAssignedTo").data("kendoDropDownList").value()) > 0 && Number($("#ddlFinancialYear").data("kendoDropDownList").value()) > 0) {
            onchangeFinancialYear();
        }
    }

    function onchangeFinancialYear() {
        var errorFlag = false;
        var errorMessage = "";
        $("#ddlOilType").data("kendoDropDownList").dataSource.read();
        if ($("#ddlAssignedTo").data("kendoDropDownList").value() === "") {
            errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetSelectMsgRequired("lbl_AssignedTo")');
            errorFlag = true;
        }
        if ($("#ddlFinancialYear").data("kendoDropDownList").value() === "") {
            errorMessage = ErrorSuccessMessageBind(errorMessage, '@Helper.GetSelectMsgRequired("lbl_CalendarDuaration")');
            errorFlag = true;
        }
        if (errorFlag) {
            ShowErrorMessageLeftAlign(errorMessage);
        } else {
            var FinancialYearId = $("#ddlFinancialYear").data("kendoDropDownList").value();

            $.ajax({
                url: "/Target/GetUserCustomerSaudaTargetMonthsByFinancialYear",
                type: 'POST',
                data: { financialYearId: FinancialYearId },
                success: function (result) {
                    if (result !== null) {
                        $("#dv_detail").html(result);
                        AddHeaderDataToTable();
                    }
                }
            });
        }
    }

    function onVerticalTypeChange() {
        $("#ddlOilType").data("kendoDropDownList").dataSource.read();
    }

    //Verticle data onBound events
    function verticalDataBound() {
        if ('@Model.Id' > 0) {
            $("#ddlOilType").data("kendoDropDownList").dataSource.read();
        }
    }

    function oilTypeAdditionalInfo() {
        var verticalId = $("#ddlVertical").data("kendoDropDownList").value();
        //return {
        //    verticalId: Number(verticalId)
        //};

        var ddlFinancialYear = $("#ddlFinancialYear").data("kendoDropDownList").value();
        return {
            financialYearId: Number(ddlFinancialYear),
            verticalId: Number(verticalId)
        };
    }

    function onSaleChange() {
        $("#ddlDistributionChannel").data("kendoDropDownList").dataSource.read();
    }
    function onDistributionChange(e) {
        $("#ddlVertical").data("kendoDropDownList").dataSource.read();
    }

    function OnDistributionDataBound(e) {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        if (distId > 0) {
            $("#ddlVertical").data("kendoDropDownList").dataSource.read();
        }
    }

    function verticalParam() {
        var distId = $("#ddlDistributionChannel").data("kendoDropDownList").value();
        return {
            distId: Number(distId)
        };
    }

    function distParam() {
        var saleId = $("#ddlSalesOrganization").data("kendoDropDownList").value();
        return {
            saleId: Number(saleId)
        };
    }

</script>


<style>
    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: #dddddd;
    }
</style>