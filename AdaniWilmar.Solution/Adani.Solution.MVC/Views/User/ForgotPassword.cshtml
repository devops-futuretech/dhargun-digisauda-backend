@using Adani.Solution.MVC.Common;
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.DTO.Enums;
@using CaptchaMvc.HtmlHelpers
@model Adani.Solution.MVC.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = Helper.GetResourceString("msg_ForgotPassword");
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div>
    <!-- Simple login form -->
    @using (Html.BeginForm("ForgotPassword", "User", FormMethod.Post, new { id = "frmForgotPassword", @class = "form-validate-jquery" }))
    {
        @Html.AntiForgeryToken()

        <div class="panel panel-body login-form">
            <div class="text-center">
                @Html.Partial("LogoView")
                <div></div>
                <h6 class="content-group text-left mt-2" style="padding: 10px;"><span class="user-heading2"> @Helper.GetResourceString("msg_ForgotPassword") </span><br /> <small class="display-block small-desc">@Helper.GetResourceString("msg_EnterYourCredentialsBelow")</small></h6>
            </div>
            <div class="form-group"></div>

            <div class="form-group">
                <div class="col-lg-12">
                    <div class="input-group">
                        <span class="input-group-addon"><i class="icon-user"></i></span>
                        <label for="">Username</label>
                        @Html.TextBoxFor(m => m.Username, new
                        {
                            id = "txtUser",
                            required = "required",@*onFocusout = "ValidateEmailOrMobileNumber()",*@@class = "k-textbox",
placeholder = Helper.GetResourceString("lbl_Username"),
data_msg_required = Helper.GetMsgRequired("lbl_Username"),
@maxlength = (int)InputMaxLength.String
})

                    </div>
                </div>
            </div>

            <div class="form-group" id="dvVertical">
                <div class="col-lg-12">
                    <div class="input-group">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-stats"></i></span>
                        @(Html.Kendo().DropDownListFor(m => m.VerticalId)
                              //.OptionLabel("Select Vertical Type")
                              .DataTextField("Name")
                              .DataValueField("Id")
                              .Events(e => e.DataBound("verticleDataBound"))
                              .DataSource(source => source.Read(resd => resd.Action("GetVerticalListBasedOnUserAsync", "User").Data("verticalAdditionalInfo"))
                              .ServerFiltering(false))
                              .HtmlAttributes(new { id = "ddlVertical", @class = "form-control", data_msg_required = Helper.GetSelectMsgRequired("lbl_VerticleType"), @style = "width:100%" }))
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="col-lg-12 capatchaCont">
                    @{
                        var captcha = Html.Captcha(@Helper.GetResourceString("msg_TryAnother"), @Helper.GetResourceString("msg_EnterTheTextYouSeeAbove"), Settings.CaptchaSringLength, "Is required field.", false);
                        @captcha
                    }
                </div>
            </div>
            <div class="form-group">
                <button id="btnForgotPassword" type="button" class="k-primary k-button btn-block">@Helper.GetResourceString("lbl_RequestOTP") </button>
            </div>
            <div class="text-center">
                <a class="a-ChangePassword" href="@Url.Action("Login","User")">@Helper.GetResourceString("msg_Signin")?</a>
            </div>
        </div>
        <div class="bottom-logo text-center pb-4">
            <div class="icon-object border-slate-300 text-slate-300 pt-3">
                <a href="/"><img src="/images/adani_logo.png" class="logo-small"></a>
            </div>
            <div class="small-desc pt-3">This site is for the use of internal customers & traders of AWL.</div>
        </div>
        @Html.Partial("Footer")
    }
    <!-- /simple login form -->

</div>

<script>
    $(document).ready(function () {
        if ('@Model.PostMessage' !== "") {
            if ('@Model.PostStatus' === '@true') {
                ShowSuccessMessage('@Model.PostMessage');
            } else {
                ShowErrorMessage('@Model.PostMessage');
            }
        }
        $("#dvVertical").hide();

        $("#btnForgotPassword").click(function (e) {
            formSubmit();
        });

        $("#txtUser").focusout(function () {
            window.kendo.ui.progress($("#div_Progress"), true);
            if ($("#txtUser").val().length > 0) {
                $("#ddlVertical").data("kendoDropDownList").dataSource.read();
            }
            window.kendo.ui.progress($("#div_Progress"), false);
        });
    });

    function formSubmit() {
        $("#CaptchaInputText").prop('required', true);
        $('#frmForgotPassword').submit();
        var isValid = $("#frmForgotPassword").valid();
        if (isValid) {
            // Animate loader
            window.kendo.ui.progress($("#div_Progress"), true);
        }
    }


    function verticalAdditionalInfo() {
        return {
            username: $("#txtUser").val()
        };
    }

    //Verticle data onBound events
    function verticleDataBound() {
        if ($("#ddlVertical").data("kendoDropDownList").ul.children().length > 0)
            $("#dvVertical").show();
        else
            $("#dvVertical").hide();
    }
</script>


