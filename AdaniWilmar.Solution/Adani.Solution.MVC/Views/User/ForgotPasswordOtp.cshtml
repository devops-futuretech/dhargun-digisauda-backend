@using Adani.Solution.MVC.Common;
@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.DTO.Enums;
@using CaptchaMvc.HtmlHelpers
@model Adani.Solution.MVC.Models.ForgotPasswordViewModel

@{
    ViewBag.Title = "ForgotPasswordOtp";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div>
    <!-- Simple login form -->
    @using (Html.BeginForm("ForgotPasswordOtp", "User", FormMethod.Post, new { id = "frmForgotPasswordOtp", @class = "form-validate-jquery" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)
        @Html.HiddenFor(m => m.IsResendOTP, new { id = "hdnIsResendOtp" })

    <div class="panel panel-body login-form">
        <div class="text-center">
            @Html.Partial("LogoView")
            <div></div>
            <h6 class="content-group text-left mt-2" style="padding: 10px;"><span class="user-heading2"> @Helper.GetResourceString("msg_VerifyOTP") </span><br /></h6>
        </div>
        <div class="form-group"></div>
       
        @if (!string.IsNullOrWhiteSpace(Model.Message) && Model.IsPageLoad)
        {
            <div class="marginT40 text-center">
                <h4 class="processTextColor a-ChangePassword">@Model.Message</h4>
            </div>
        }

        <div class="form-group marginT20">
            <div class="col-lg-12">
                <div class="input-group">
                    <span class="input-group-addon"><i class="icon-user"></i></span>
                    <label for="">Username</label>
                    @Html.TextBoxFor(m => m.Username, new { id = "txtUsername", @class = "k-textbox" })
                    @Html.HiddenFor(m => m.Username)
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-lg-12">
                <div class="input-group">
                    <label for="">Password</label>
                    @Html.PasswordFor(m => m.Password, new { id = "txtPassword", required = "required", @type = "Password", @class = "k-textbox", placeholder = Helper.GetResourceString("lbl_Password"), onkeypress = "return RestrictSpaceOnPassword()", data_msg_required = Helper.GetMsgRequired("lbl_Password"), @maxlength = (int)InputMaxLength.Password })
                    <span class="input-group-addon toggle-password" id="toggle_pass"><i id="icps" class="fa fa-eye toggle-password"></i></span>
                </div>
            </div>
        </div>


        <div class="form-group">
            <div class="col-lg-12">
                <div class="input-group">
                    @Html.TextBoxFor(m => m.OtpNumber, new { id = "txtOtp", required = "required", @class = "k-textbox", placeholder = Helper.GetResourceString("lbl_OTP"), data_msg_required = Helper.GetMsgRequired("lbl_OTP"), @maxlength = (int)InputMaxLength.Otp })

                </div>
            </div>
        </div>


        <div class="form-group">
            <div class="col-md-12 mb-2">
                <a href="#" data-toggle="tab"><h4 class="loginTitle marginB0 a-ChangePassword resend-otp" onclick="ResendOtpOpen()">@Helper.GetResourceString("lbl_ResendOTP")</h4></a>
            </div>
            <div class="col-md-12">
                <button id="btnForgotPasswordOtp" type="button" class="k-primary k-button btn-block">@Helper.GetResourceString("lbl_Changepassword")</button>
            </div>
        </div>


        <div id="dv_ResendOtp">
            <div class="form-group">
                <div class="col-md-12 capatchaCont">
                    <br />
                    <p class="processTextColor marginB0">@Helper.GetResourceString("lbl_FilloutCapatcha")</p>
                    @{
                        var captcha = Html.Captcha(@Helper.GetResourceString("msg_TryAnother"), @Helper.GetResourceString("msg_EnterTheTextYouSeeAbove"), Settings.CaptchaSringLength, "Is required field.", false);
                        @captcha
                    }
                </div>
            </div>
            <div class="bottom">
                <span><a id="aResendOtp" class="k-primary k-button btn-rounded"><i class="fa fa-undo"></i>@Helper.GetResourceString("btn_ResendOtp")</a></span>
            </div>
        </div>

    </div>
        <div class="bottom-logo text-center pb-4">
            <div class="icon-object border-slate-300 text-slate-300 pt-3">
                <a href="/"><img src="/images/adani_logo.png" class="logo-small"></a>
            </div>
            <div class="small-desc pt-3">This site is for the use of internal customers & traders of AWL.</div>
        </div>
        @Html.Partial("Footer")
    }
    <!-- /simple login form -->

</div>

<script>
    $(document).ready(function () {
        $("#dv_ResendOtp").hide();
        $("#txtUsername").attr('disabled', true);
		 if ('@Model.PostMessage' !== "" && '@Model.IsPageLoad' === '@false'){
			   if ('@Model.PostStatus' === '@true') {
					ShowSuccessMessage('@Model.PostMessage');
				} else {
					ShowErrorMessage('@Model.PostMessage');
				}
		}
         $("#btnForgotPasswordOtp").click(function (e) {
			formSubmit();
         });

         //Method to resend otp click event
         $("#aResendOtp").on('click', function () {
             $("#hdnIsResendOtp").val(true);
             $("#CaptchaInputText").prop('required', true);
             $("#txtPassword").prop('required', false);
             $("#txtOtp").prop('required', false);
             $("#frmForgotPasswordOtp").submit();
             var isValid = $("#frmForgotPasswordOtp").valid();
             if (isValid) {
                 // Animate loader
                 window.kendo.ui.progress($("#dvForgotPasswordOtp"), true);
             }
         });

        $("#toggle_pass").click(() => {

            if ($("#txtPassword").attr("type") == "Password") {
                $('#icps').toggleClass("fa-eye");
                $('#icps').toggleClass("fa-eye-slash");
                $("#txtPassword").attr("type", "text");
            } else {
                $('#icps').toggleClass("fa-eye-slash");
                $('#icps').toggleClass("fa-eye");
                $("#txtPassword").attr("type", "Password");
            }
        });

	});

    function formSubmit() {
        $("#hdnIsResendOtp").val(false);
        $("#CaptchaInputText").prop('required', false);
        $("#txtPassword").prop('required', true);
        $("#txtOtp").prop('required', true);
        $("#frmForgotPasswordOtp").submit();
        var isValid = $("#frmForgotPasswordOtp").valid();
        if (isValid) {
            // Animate loader
            window.kendo.ui.progress($("#div_Progress"), true);
        }
	}

    function ResendOtpOpen() {
        $("#dv_ResendOtp").slideToggle();
    }

</script>

