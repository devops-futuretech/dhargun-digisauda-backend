@using Adani.Solution.MVC.Helpers;
@using Adani.Solution.DTO.Enums;
@model Adani.Solution.MVC.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "SuccessMessage";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div>

    <div class="panel panel-body login-form">
        <div class="text-center">
            @Html.Partial("LogoView")
            <div></div>
            <h6 class="content-group" style="padding: 10px;"><span class="user-heading2"> @Helper.GetResourceString("msg_ForgotPassword") </span><br /></h6>
        </div>
        <div class="form-group"></div>
        <div class="form-group">
            <div class="col-lg-12">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="marginT40 text-center">
                        <h4 class="processTextColor">@TempData["SuccessMessage"]</h4>
                        <a href="@Url.Action("Login", "User")" class="k-primary k-button btn-rounded marginT20">@Helper.GetResourceString("msg_BacktoLogin")</a>
                    </div>
                }
            </div>
        </div>



    </div>
    <div class="bottom-logo text-center pb-4">
        <div class="icon-object border-slate-300 text-slate-300 pt-3">
            <a href="/"><img src="/images/adani_logo.png" class="logo-small"></a>
        </div>
        <div class="small-desc pt-3">This site is for the use of internal customers & traders of AWL.</div>
    </div>
    @Html.Partial("Footer")


</div>

