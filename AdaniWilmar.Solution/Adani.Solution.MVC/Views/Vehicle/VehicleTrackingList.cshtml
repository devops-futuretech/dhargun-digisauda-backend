        function AdditionalInfo()
        {
            var customerCodeList = $("#ddlDealer").val() ? $("#ddlDealer").val() : "";
            var doNumberList = $("#ddlDoNumber").val() ? $("#ddlDoNumber").val().join() : "";

            var multiSelect = $("#ddlDoNumber").data("kendoMultiSelect");

            var selectedItems = multiSelect.dataItems();
            var values = selectedItems.map(function (item) {
                return item.Value;
            });

            var texts = selectedItems.map(function (item) {
                return item.Id;
            });

            var joinedValues = values.join();
            var joinedTexts = texts.join();


            var data = {
                CustomerCodeList: customerCodeList,
                DoNumberList: joinedValues,
                BillingNoList: joinedTexts
            };
            console.log(data);
            return data;
    }
