          $("#DOSelectAll").click(function () {
            var dropdown = $("#ddlDoNumber").data("kendoMultiSelect");
            if (dropdown) {
                var allIds = dropdown.dataSource.data().map(function (dataItem) { return dataItem.Value; });            //Select all ids from dropdown
                console.log(allIds);
                if ($("#DOSelectAll").is(":checked")) {
                    dropdown.value(allIds);
                } else {
                    dropdown.value([]);
                }
            }
              $("#ddlDoNumber").data("kendoMultiSelect").dataSource.read();
        });
        $("#DealerSelectAll").click(function () {
            var dropdown = $("#ddlDealer").data("kendoMultiSelect");
            if (dropdown) {
                var allIds = dropdown.dataSource.data().map(function (dataItem) { return dataItem.Code; });            //Select all ids from dropdown
                if ($("#DealerSelectAll").is(":checked")) {
                    dropdown.value(allIds);
